import React, { useState, useEffect, useCallback } from 'react';
import { BACKEND_URL } from '../config/api';
import authFetch from './authFetch';
import { Plus, RefreshCw, ChevronDown, ChevronUp, X, Search } from 'lucide-react';

const STATUS = {
  open: ['Open', 'bg-blue-100 text-blue-800'],
  awaiting_brand_response: ['Awaiting brand', 'bg-yellow-100 text-yellow-800'],
  brand_ticket_created: ['Brand ticket created', 'bg-purple-100 text-purple-800'],
  in_progress: ['In progress', 'bg-orange-100 text-orange-800'],
  resolved: ['Resolved', 'bg-green-100 text-green-800'],
  closed: ['Closed', 'bg-gray-100 text-gray-800'],
};
const STORE_STATUS = {
  open: ['Open', 'bg-blue-100 text-blue-800 border-blue-300'],
  in_progress: ['In Progress', 'bg-orange-100 text-orange-800 border-orange-300'],
  closed: ['Closed', 'bg-green-100 text-green-800 border-green-300'],
};
const EMPTY = {
  customer_name: '', customer_phone: '', customer_email: '', address: '', city: 'Bangalore', pincode: '',
  brand: 'Bosch', model: '', product_name: '', issue_type: 'installation', issue_description: '',
  preferred_date: '', preferred_time_slot: 'Morning (9AM-12PM)',
};
const fmt = (d) => (d ? new Date(d).toLocaleString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '');
const inputCls = 'w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500';

const dash = (v) => (v === undefined || v === null || v === '' ? '-' : v);
const fmtDate = (d) => (d ? new Date(d).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : '-');
const Detail = ({ label, value }) => (
  <div>
    <div className="text-xs text-gray-500">{label}</div>
    <div className="text-sm text-gray-900 break-words">{dash(value)}</div>
  </div>
);

const selCls = 'border border-gray-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500';

export default function StoreServiceTickets({ storeData }) {
  const [tickets, setTickets] = useState([]);
  const [loading, setLoading] = useState(true);
  const [open, setOpen] = useState(null);
  const [showForm, setShowForm] = useState(false);
  const [form, setForm] = useState(EMPTY);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState('');
  const [filter, setFilter] = useState('all');
  const [q, setQ] = useState('');
  const [brandF, setBrandF] = useState('all');
  const [issueF, setIssueF] = useState('all');
  const [srcF, setSrcF] = useState('all');
  const [mailF, setMailF] = useState('all');
  const [fromD, setFromD] = useState('');
  const [toD, setToD] = useState('');

  const load = useCallback(async () => {
    setLoading(true);
    try {
      const r = await authFetch(`${BACKEND_URL}/api/store-service/tickets`);
      const d = await r.json();
      if (r.ok) setTickets(d.tickets || []);
    } catch (e) {
      console.error('Failed to load service tickets', e);
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => { load(); }, [load]);

  const set = (k) => (e) => setForm({ ...form, [k]: e.target.value });
  const [resend, setResend] = useState({ for: null, address: '', city: 'Bangalore', pincode: '', busy: false, msg: '' });
  const mailHint = (e) => (/401|credit|limit/i.test(e || '') ? 'Email provider daily limit reached. Try again later.' : (e || ''));
  const doResend = async (t) => {
    const needsAddr = t.source !== 'customer' && !t.address;
    if (needsAddr && resend.for !== t.ticket_number) {
      setResend({ for: t.ticket_number, address: '', city: 'Bangalore', pincode: '', busy: false, msg: '' });
      return;
    }
    if (needsAddr && !resend.address.trim()) { setResend({ ...resend, msg: 'Enter the customer address' }); return; }
    setResend({ ...resend, for: t.ticket_number, busy: true, msg: '' });
    try {
      const r = await authFetch(`${BACKEND_URL}/api/store-service/tickets/${t.ticket_number}/resend-mail`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(needsAddr ? { address: resend.address, city: resend.city, pincode: resend.pincode } : {}),
      });
      const d = await r.json();
      if (!r.ok) { setResend((x) => ({ ...x, busy: false, msg: typeof d.detail === 'string' ? d.detail : 'Could not resend' })); return; }
      if (d.company_mail_status === 'sent') {
        setResend({ for: null, address: '', city: 'Bangalore', pincode: '', busy: false, msg: '' });
      } else {
        setResend((x) => ({ ...x, busy: false, msg: 'Still not sent: ' + mailHint(d.error) }));
      }
      load();
    } catch (e) {
      setResend((x) => ({ ...x, busy: false, msg: 'Could not reach the server' }));
    }
  };
  const sStatus = (t) => (STORE_STATUS[t.store_status] ? t.store_status : 'open');
  const counts = tickets.reduce((a, t) => { const s = sStatus(t); a[s] = (a[s] || 0) + 1; return a; }, {});
  const norm = (v) => String(v || '').toLowerCase();
  const localDay = (d) => (d ? new Date(d).toLocaleDateString('en-CA') : '');
  const matches = (t) => {
    if (filter !== 'all' && sStatus(t) !== filter) return false;
    if (brandF !== 'all' && !norm(t.brand || t.product_name).includes(brandF)) return false;
    if (issueF !== 'all' && t.issue_type !== issueF) return false;
    if (srcF === 'customer' && t.source !== 'customer') return false;
    if (srcF === 'store' && t.source === 'customer') return false;
    if (mailF === 'failed' && t.company_mail_status !== 'failed') return false;
    const day = localDay(t.created_at);
    if (fromD && day < fromD) return false;
    if (toD && day > toD) return false;
    const terms = norm(q).split(/\s+/).filter(Boolean);
    if (terms.length) {
      const hay = norm([t.ticket_number, t.customer_name, t.customer_phone, t.customer_email, t.contact_email, t.product_name, t.model,
        t.brand_complaint_number, t.issue_description, t.invoice_number, (t.products || []).map((p) => `${p.product_name} ${p.model}`).join(' ')].join(' '));
      if (!terms.every((w) => hay.includes(w))) return false;
    }
    return true;
  };
  const shown = tickets.filter(matches);
  const anyFilter = q || brandF !== 'all' || issueF !== 'all' || srcF !== 'all' || mailF !== 'all' || fromD || toD || filter !== 'all';
  const clearAll = () => { setQ(''); setBrandF('all'); setIssueF('all'); setSrcF('all'); setMailF('all'); setFromD(''); setToD(''); setFilter('all'); };
  const changeStatus = async (ticketNumber, status) => {
    const prev = tickets;
    setTickets(tickets.map((t) => (t.ticket_number === ticketNumber ? { ...t, store_status: status } : t)));
    try {
      const r = await authFetch(`${BACKEND_URL}/api/store-service/tickets/${ticketNumber}/status`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status }),
      });
      if (!r.ok) setTickets(prev);
    } catch (e) {
      setTickets(prev);
    }
  };

  const submit = async (e) => {
    e.preventDefault();
    setError('');
    if (form.customer_phone.replace(/\D/g, '').length < 10) { setError('Enter a 10-digit phone number'); return; }
    setSaving(true);
    try {
      const r = await authFetch(`${BACKEND_URL}/api/store-service/tickets`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...form, store_code: storeData?.code }),
      });
      const d = await r.json();
      if (!r.ok) {
        setError(typeof d.detail === 'string' ? d.detail : 'Please check the form fields');
      } else {
        setShowForm(false);
        setForm(EMPTY);
        load();
      }
    } catch (err) {
      setError('Could not reach the server');
    } finally {
      setSaving(false);
    }
  };

  return (
    <div className="space-y-4">
      <div className="bg-white rounded-xl shadow-sm p-4 flex items-center justify-between">
        <div>
          <h3 className="text-lg font-semibold text-gray-800">Service Tickets</h3>
          <p className="text-sm text-gray-500">Raise service requests for customers and track the brand's replies.</p>
        </div>
        <div className="flex gap-2">
          <button onClick={load} className="p-2 border rounded-lg text-gray-600 hover:bg-gray-50" title="Refresh">
            <RefreshCw className="w-4 h-4" />
          </button>
          <button onClick={() => setShowForm(true)} className="flex items-center gap-1 bg-blue-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-blue-700">
            <Plus className="w-4 h-4" /> New Ticket
          </button>
        </div>
      </div>

      <div className="flex gap-2 flex-wrap">
          {[['all', 'All', tickets.length], ['open', 'Open', counts.open || 0], ['in_progress', 'In Progress', counts.in_progress || 0], ['closed', 'Closed', counts.closed || 0]].map(([k, l, n]) => (
            <button key={k} onClick={() => setFilter(k)} className={`px-3 py-1 rounded-full text-sm border ${filter === k ? 'bg-blue-600 text-white border-blue-600' : 'bg-white text-gray-700 border-gray-300'}`}>{l} ({n})</button>
          ))}
        </div>
        <div className="bg-white rounded-xl shadow-sm p-3 space-y-2">
          <div className="relative">
            <Search className="w-4 h-4 absolute left-3 top-3 text-gray-400" />
            <input className={inputCls + ' pl-9'} placeholder="Search ticket no, customer, phone, product, model, SR no..." value={q} onChange={(e) => setQ(e.target.value)} />
          </div>
          <div className="flex gap-2 flex-wrap items-center">
            <select className={selCls} value={brandF} onChange={(e) => setBrandF(e.target.value)}>
              <option value="all">All brands</option><option value="bosch">Bosch</option><option value="siemens">Siemens</option>
            </select>
            <select className={selCls} value={issueF} onChange={(e) => setIssueF(e.target.value)}>
              <option value="all">All issue types</option><option value="installation">Installation</option><option value="repair">Repair</option>
              <option value="warranty">Warranty</option><option value="general">General</option>
            </select>
            <select className={selCls} value={srcF} onChange={(e) => setSrcF(e.target.value)}>
              <option value="all">Store + customer</option><option value="store">Raised by store</option><option value="customer">Customer requests</option>
            </select>
            <select className={selCls} value={mailF} onChange={(e) => setMailF(e.target.value)}>
              <option value="all">Any mail status</option><option value="failed">Mail failed</option>
            </select>
            <input type="date" className={selCls} value={fromD} onChange={(e) => setFromD(e.target.value)} title="From date" />
            <input type="date" className={selCls} value={toD} onChange={(e) => setToD(e.target.value)} title="To date" />
            {anyFilter && <button onClick={clearAll} className="text-sm text-blue-600 hover:underline">Clear all</button>}
            <span className="text-xs text-gray-500 ml-auto">Showing {shown.length} of {tickets.length}</span>
          </div>
        </div>
        {loading ? (
        <div className="bg-white rounded-xl shadow-sm p-8 text-center text-gray-500">Loading...</div>
      ) : shown.length === 0 ? (
        <div className="bg-white rounded-xl shadow-sm p-8 text-center text-gray-500">{tickets.length === 0 ? 'No service tickets yet.' : 'No tickets match your search or filters.'}</div>
      ) : (
        shown.map((t) => {
          const [label, cls] = STATUS[t.status] || STATUS.open;
          const msgs = [...(t.company_messages || [])].reverse();
          const isOpen = open === t.ticket_number;
          return (
            <div key={t.ticket_number} className="bg-white rounded-xl shadow-sm p-4">
              <div className="flex items-start justify-between gap-3">
                <div>
                  <div className="flex items-center gap-2 flex-wrap">
                    <span className="font-semibold text-gray-900">{t.ticket_number}</span>
                    {t.status !== 'open' && <span className={`text-xs px-2 py-0.5 rounded-full ${cls}`}>{label}</span>}
                      <span className={`text-xs px-2 py-0.5 rounded-full border ${STORE_STATUS[sStatus(t)][1]}`}>{STORE_STATUS[sStatus(t)][0]}</span>
                    {t.company_mail_status === 'failed' && <span className="text-xs px-2 py-0.5 rounded-full bg-red-100 text-red-800">Mail failed</span>}
                    {t.store_code && <span className="text-xs text-gray-500">{t.store_code}</span>}
                      {t.source === 'customer' && <span className="text-xs px-2 py-0.5 rounded-full bg-pink-100 text-pink-800">Customer request</span>}
                  </div>
                  <div className="text-sm text-gray-800 mt-1">{t.product_name}</div>
                  <div className="text-sm text-gray-600">{t.customer_name} • {t.customer_phone}</div>
                  <div className="text-xs text-gray-500 mt-1">Created {fmt(t.created_at)} • {t.issue_type}</div>
                    <div className="text-xs text-gray-600 mt-1">Preferred: {fmtDate(t.preferred_date)} • {dash(t.preferred_time_slot)}</div>
                    <div className="flex gap-1 mt-2">
                      {Object.entries(STORE_STATUS).map(([k, [l, c]]) => (
                        <button key={k} onClick={() => changeStatus(t.ticket_number, k)} className={`text-xs px-2 py-1 rounded border ${sStatus(t) === k ? c + ' font-semibold' : 'bg-white text-gray-500 border-gray-300 hover:bg-gray-50'}`}>{l}</button>
                      ))}
                    </div>
                  {t.company_mail_status === 'failed' && (
                      <div className="mt-2 text-xs">
                        <div className="text-red-700">Mail to the brand was not sent{t.company_mail_error ? ': ' + mailHint(t.company_mail_error) : ''}</div>
                        {resend.for === t.ticket_number && t.source !== 'customer' && !t.address && (
                          <div className="mt-1 space-y-1 max-w-sm">
                            <textarea className={inputCls} rows={2} placeholder="Customer address *" value={resend.address} onChange={(e) => setResend({ ...resend, address: e.target.value })} />
                            <div className="grid grid-cols-2 gap-2">
                              <input className={inputCls} placeholder="City" value={resend.city} onChange={(e) => setResend({ ...resend, city: e.target.value })} />
                              <input className={inputCls} placeholder="Pincode" value={resend.pincode} onChange={(e) => setResend({ ...resend, pincode: e.target.value })} />
                            </div>
                          </div>
                        )}
                        <button onClick={() => doResend(t)} disabled={resend.busy && resend.for === t.ticket_number} className="mt-1 px-3 py-1 rounded bg-red-600 text-white disabled:opacity-60">
                          {resend.busy && resend.for === t.ticket_number ? 'Sending...' : 'Resend mail'}
                        </button>
                        {resend.for === t.ticket_number && resend.msg && <div className="text-red-600 mt-1">{resend.msg}</div>}
                      </div>
                    )}
                    {t.brand_complaint_number && (
                    <div className="text-sm mt-2">Company Service Request No: <span className="font-semibold text-green-700">{t.brand_complaint_number}</span></div>
                  )}
                </div>
                <button onClick={() => setOpen(isOpen ? null : t.ticket_number)} className="text-gray-500 p-1">
                  {isOpen ? <ChevronUp className="w-5 h-5" /> : <ChevronDown className="w-5 h-5" />}
                </button>
              </div>
              {isOpen && (
                <div className="mt-3 border-t pt-3 space-y-2">
                  <div className="grid grid-cols-2 md:grid-cols-3 gap-3">
                      <Detail label="Customer name" value={t.customer_name} />
                      <Detail label="Phone" value={t.customer_phone} />
                      <Detail label="Email" value={t.contact_email || t.customer_email} />
                      <Detail label="Address" value={t.address} />
                      <Detail label="City" value={t.city} />
                      <Detail label="Pincode" value={t.pincode} />
                      <Detail label="Brand" value={t.brand} />
                      <Detail label="Model number" value={t.model_number || t.model} />
                      <Detail label="Product" value={t.product_name} />
                      <Detail label="Service type" value={t.issue_type} />
                      <Detail label="Preferred date" value={fmtDate(t.preferred_date)} />
                      <Detail label="Time slot" value={t.preferred_time_slot} />
                      <Detail label="Created at" value={fmt(t.created_at)} />
                      <Detail label="Company SR no." value={t.brand_complaint_number} />
                    </div>
                    {t.issue_description && <div className="text-sm text-gray-700"><b>Issue:</b> {t.issue_description}</div>}
                  {msgs.length === 0 ? (
                    <div className="text-sm text-gray-500">Awaiting reply from the brand.</div>
                  ) : (
                    msgs.map((m, i) => (
                      <div key={i} className="bg-gray-50 rounded-lg p-3">
                        <div className="text-xs text-gray-500 mb-1">Reply from brand • {fmt(m.at)}{m.sr_number ? ` • SR ${m.sr_number}` : ''}</div>
                        <div className="text-sm text-gray-800 whitespace-pre-wrap">{m.text}</div>
                      </div>
                    ))
                  )}
                </div>
              )}
            </div>
          );
        })
      )}

      {showForm && (
        <div className="fixed inset-0 bg-black/40 z-50 flex items-center justify-center p-4">
          <form onSubmit={submit} className="bg-white rounded-xl w-full max-w-xl max-h-[90vh] overflow-y-auto p-5 space-y-3">
            <div className="flex items-center justify-between">
              <h4 className="text-lg font-semibold">New Service Ticket{storeData?.name ? ` • ${storeData.name}` : ''}</h4>
              <button type="button" onClick={() => setShowForm(false)}><X className="w-5 h-5" /></button>
            </div>
            <div className="grid grid-cols-2 gap-3">
              <input required className={inputCls} placeholder="Customer name *" value={form.customer_name} onChange={set('customer_name')} />
              <input required className={inputCls} placeholder="Phone (10 digits) *" value={form.customer_phone} onChange={set('customer_phone')} />
            </div>
            <input className={inputCls} placeholder="Customer email (optional)" value={form.customer_email} onChange={set('customer_email')} />
            <textarea required className={inputCls} rows={2} placeholder="Address *" value={form.address} onChange={set('address')} />
            <div className="grid grid-cols-2 gap-3">
              <input className={inputCls} placeholder="City" value={form.city} onChange={set('city')} />
              <input className={inputCls} placeholder="Pincode" value={form.pincode} onChange={set('pincode')} />
            </div>
            <div className="grid grid-cols-2 gap-3">
              <select className={inputCls} value={form.brand} onChange={set('brand')}>
                <option>Bosch</option>
                <option>Siemens</option>
              </select>
              <input required className={inputCls} placeholder="Model number *" value={form.model} onChange={set('model')} />
            </div>
            <input required className={inputCls} placeholder="Product (e.g. Washing Machine) *" value={form.product_name} onChange={set('product_name')} />
            <select className={inputCls} value={form.issue_type} onChange={set('issue_type')}>
              <option value="installation">Installation &amp; Demo</option>
              <option value="repair">Repair</option>
              <option value="warranty">Warranty</option>
              <option value="general">General</option>
            </select>
            {form.issue_type !== 'installation' && (
              <textarea required className={inputCls} rows={3} placeholder="Describe the issue *" value={form.issue_description} onChange={set('issue_description')} />
            )}
            <div className="grid grid-cols-2 gap-3">
              <input type="date" className={inputCls} value={form.preferred_date} onChange={set('preferred_date')} />
              <select className={inputCls} value={form.preferred_time_slot} onChange={set('preferred_time_slot')}>
                <option>Morning (9AM-12PM)</option>
                <option>Afternoon (12PM-4PM)</option>
                <option>Evening (4PM-7PM)</option>
              </select>
            </div>
            {error && <div className="text-sm text-red-600">{error}</div>}
            <div className="flex gap-3 pt-1">
              <button type="button" onClick={() => setShowForm(false)} className="flex-1 border rounded-lg py-2 text-sm">Cancel</button>
              <button type="submit" disabled={saving} className="flex-1 bg-blue-600 text-white rounded-lg py-2 text-sm disabled:opacity-60">
                {saving ? 'Submitting...' : 'Submit Ticket'}
              </button>
            </div>
          </form>
        </div>
      )}
    </div>
  );
}

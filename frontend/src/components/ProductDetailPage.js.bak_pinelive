import React, { useState, useEffect, useMemo } from 'react';
import { BACKEND_URL } from '../config/api';
import { useParams, useNavigate } from 'react-router-dom';
import { 
  ChevronLeft, ChevronRight, Heart, Share2, Star, 
  ShoppingCart, MessageCircle, CheckCircle, Shield, 
  Truck, RefreshCw, Award, Package, Loader2, ArrowLeft,
  Zap, Box, Info, Phone
} from 'lucide-react';
import { useCart } from '../hooks/useCart';
import SEOHead, { SEOConfigs } from './SEOHead';
import Breadcrumbs, { generateBreadcrumbs } from './Breadcrumbs';
import { generateProductSchema, generateFAQSchema } from './SEOSchemas';
import ReviewsSection from './ReviewsSection';
import Header from './Header';
import Footer from './Footer';
import PincodeChecker from './PincodeChecker';
import WhyBuyStrip from './WhyBuyStrip';
import InstallationBadge from './InstallationBadge';
import OffersDisplay from './OffersDisplay';
import { AISummarySection } from './AISummarySection';
import { ProductCompareModal } from './ProductCompareModal';
import CategoryPage from './CategoryPage';


const ProductDetailPage = () => {
  const { productId, category, brand, slug, modelNumber } = useParams();
  const navigate = useNavigate();
  const { addToCart, cartCount, cartTotal } = useCart();
  
  const [product, setProduct] = useState(null);
  const [brandFallback, setBrandFallback] = useState(null);
  const [showCompare, setShowCompare] = useState(false);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);
  const [selectedImageIndex, setSelectedImageIndex] = useState(0);
  const [quantity, setQuantity] = useState(1);
  const [activeTab, setActiveTab] = useState('overview');
  const [isWishlisted, setIsWishlisted] = useState(false);
  const [addingToCart, setAddingToCart] = useState(false);

  useEffect(() => {
    // Scroll to top when product page opens
    window.scrollTo(0, 0);
    fetchProduct();
  }, [productId, category, brand, slug, modelNumber]);

  const fetchProduct = async () => {
  setLoading(true);
  setError(null);
  setBrandFallback(null);
  try {
      let url;
      // Determine the identifier: modelNumber (new clean URL), slug (legacy SEO), or productId
      const identifier = modelNumber || slug;

      // Brand listing URL like /chimney/bosch
      if (
        category &&
        modelNumber &&
        !/[0-9]/.test(modelNumber)
      ) {
        const capitalizedBrand = modelNumber
          .split('-')
          .map(word => word.charAt(0).toUpperCase() + word.slice(1))
          .join(' ');

        setBrandFallback({
          category,
          brand: capitalizedBrand
        });

        setLoading(false);
        return;
      }
      if (category && brand && slug) {
        // New URL structure: /category/brand/short-slug — direct slug lookup
        url = `${BACKEND_URL}/api/product/by-slug/${encodeURIComponent(category)}/${encodeURIComponent(slug)}`;
      } else if (category && identifier) {
        // Try model number first, then fall back to slug
        url = `${BACKEND_URL}/api/product/by-model/${encodeURIComponent(category)}/${encodeURIComponent(identifier)}`;
        const response = await fetch(url);
        if (response.ok) {
          const data = await response.json();
          if (data.status === 'success' && data.product) {
            setProduct(data.product);
            setLoading(false);
            return;
          }
        }
        // Fall back to slug-based lookup
        url = `${BACKEND_URL}/api/product/by-slug/${encodeURIComponent(category)}/${encodeURIComponent(identifier)}`;
      } else if (productId) {
        url = `${BACKEND_URL}/api/products/${productId}`;
      } else {
        setError('Product not found');
        setLoading(false);
        return;
      }
      
      const response = await fetch(url);
      const data = await response.json();
      
      if (data.status === 'success' && data.product) {
        setProduct(data.product);
      } else if (data.id || data.name) {
        setProduct(data);
      } else if (category && modelNumber && !/[0-9]/.test(modelNumber)) {
  // Genuinely looks like a brand name (no digits), not a malformed model number
  const capitalizedBrand = modelNumber
    .split('-')
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
  setBrandFallback({ category, brand: capitalizedBrand });
  setLoading(false);
  return;
} else {
  // Looked like it could be a product, both lookups failed — show a real error
  setError('Product not found');
}
    } catch (err) {
      console.error('Error fetching product:', err);
      setError('Failed to load product details');
    } finally {
      setLoading(false);
    }
  };

  const handleAddToCart = async () => {
    if (!product) return;
    setAddingToCart(true);
    try {
      await addToCart(product.id, quantity);
      // Show success feedback
    } catch (err) {
      console.error('Failed to add to cart:', err);
    } finally {
      setAddingToCart(false);
    }
  };

  const handleBuyNow = async () => {
    await handleAddToCart();
    navigate('/cart');
  };

  const handleShare = async () => {
    if (navigator.share) {
      try {
        await navigator.share({
          title: product?.name,
          text: `Check out ${product?.name} at Aditya Retail`,
          url: window.location.href
        });
      } catch (err) {
        console.log('Share cancelled');
      }
    } else {
      navigator.clipboard.writeText(window.location.href);
      alert('Link copied to clipboard!');
    }
  };

  const handleAIChat = () => {
    // Navigate to AI chat with product context
    sessionStorage.setItem('aiChatProduct', JSON.stringify(product));
    window.dispatchEvent(new CustomEvent('openAIChat', { detail: { product } }));
  };

  const stockQuantity = product ? (product.stock || product.stock_quantity || product.current_stock || 0) : 0;

  // Generate product-level FAQ items (must be before early returns for hooks rules)
  const productFAQs = useMemo(() => {
    if (!product) return [];
    const brand = product.brand || 'this brand';
    return [
      { question: `What is the warranty on ${product.name}?`, answer: `${product.name} comes with the original ${brand} manufacturer warranty. Warranty duration varies by product — typically 1 to 5 years. Contact us for specific warranty details.` },
      { question: `Is ${product.name} available for delivery?`, answer: stockQuantity > 0 ? `Yes, ${product.name} is currently in stock and available for delivery. Standard delivery takes 3-7 business days.` : `${product.name} is currently out of stock. Please check back soon or contact us for availability updates.` },
      { question: `Does ${product.name} come with installation?`, answer: `Basic installation guidance is provided. Professional installation services are available at additional cost. Contact our team for details.` },
    ];
  }, [product, stockQuantity]);

  // Build all schemas for product page
  const productSchemas = useMemo(() => {
    if (!product) return [];
    const schemas = [];
    schemas.push(generateProductSchema(product));
    const faqSchema = generateFAQSchema(productFAQs);
    if (faqSchema) schemas.push(faqSchema);
    return schemas;
  }, [product, productFAQs]);

  if (loading) {
    return (
      <div className="min-h-screen bg-gray-50">
        <Header cartCount={cartCount} cartTotal={cartTotal} />
        <div className="flex items-center justify-center h-96">
          <Loader2 className="w-12 h-12 text-blue-600 animate-spin" />
        </div>
        <Footer />
      </div>
    );
  }
  if (brandFallback) {
    return (
      <div className="min-h-screen bg-gray-50">
        <Header cartCount={cartCount} cartTotal={cartTotal} />
        <CategoryPage
          overrideCategoryName={brandFallback.category}
          overrideBrandParam={brandFallback.brand}
          onViewProduct={() => {}}
          onAddToCart={async (p) => { await addToCart(p.id, 1); }}
          onAISalesChat={() => {}}
        />
        <Footer />
      </div>
    );
  }
  if (error || !product) {
    return (
      <div className="min-h-screen bg-gray-50">
        <Header cartCount={cartCount} cartTotal={cartTotal} />
        <div className="max-w-4xl mx-auto px-4 py-16 text-center">
          <h1 className="text-2xl font-bold text-gray-900 mb-4">Product Not Found</h1>
          <p className="text-gray-600 mb-8">{error || 'The product you are looking for does not exist.'}</p>
          <button
            onClick={() => navigate('/')}
            className="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700"
          >
            <ArrowLeft className="w-5 h-5" />
            Back to Home
          </button>
        </div>
        <Footer />
      </div>
    );
  }

  const images = product.images?.length > 0 ? product.images : [product.image || '/placeholder-product.png'];
  const discountPercentage = product.original_price && product.price && product.original_price > product.price
    ? Math.round(((product.original_price - product.price) / product.original_price) * 100)
    : (product.originalPrice && product.price && product.originalPrice > product.price
      ? Math.round(((product.originalPrice - product.price) / product.originalPrice) * 100)
      : 0);

  const originalPrice = product.original_price || product.originalPrice || product.mrp;

  const categoryName = product.category || 'Products';
  const breadcrumbs = generateBreadcrumbs.product(product, categoryName);

  return (
    <div className="min-h-screen bg-gray-50">
      <SEOHead 
        {...SEOConfigs.product(product)}
        schemas={productSchemas}
      />
      
      <Header cartCount={cartCount} cartTotal={cartTotal} />
      
      <main className="max-w-7xl mx-auto px-4 py-6">
        {/* Breadcrumbs */}
        <Breadcrumbs items={breadcrumbs} />
        
        {/* Back Button */}
        <button
          onClick={() => navigate(-1)}
          className="flex items-center gap-2 text-gray-600 hover:text-gray-900 mb-6"
        >
          <ArrowLeft className="w-5 h-5" />
          Back
        </button>

        <div className="bg-white rounded-xl shadow-sm overflow-hidden">
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-4 md:gap-8 p-4 md:p-6">
            {/* Image Gallery */}
            <div className="space-y-3 md:space-y-4">
              {/* Main Image */}
              <div className="relative aspect-square bg-gray-100 rounded-lg overflow-hidden">
                <img
                  src={images[selectedImageIndex]}
                  alt={product.name}
                  className="w-full h-full object-contain"
                  onError={(e) => { e.target.src = '/placeholder-product.png'; }}
                />
                
                {/* Navigation Arrows */}
                {images.length > 1 && (
                  <>
                    <button
                      onClick={() => setSelectedImageIndex((prev) => (prev - 1 + images.length) % images.length)}
                      className="absolute left-2 top-1/2 -translate-y-1/2 p-1.5 md:p-2 bg-white/80 rounded-full shadow hover:bg-white"
                    >
                      <ChevronLeft className="w-5 h-5 md:w-6 md:h-6" />
                    </button>
                    <button
                      onClick={() => setSelectedImageIndex((prev) => (prev + 1) % images.length)}
                      className="absolute right-2 top-1/2 -translate-y-1/2 p-1.5 md:p-2 bg-white/80 rounded-full shadow hover:bg-white"
                    >
                      <ChevronRight className="w-5 h-5 md:w-6 md:h-6" />
                    </button>
                  </>
                )}

                {/* Discount Badge */}
                {discountPercentage > 0 && (
                  <div className="absolute top-3 md:top-4 left-3 md:left-4 bg-red-600 text-white px-2 md:px-3 py-1 rounded-full text-xs md:text-sm font-bold">
                    -{discountPercentage}% OFF
                  </div>
                )}

                {/* Wishlist & Share */}
                <div className="absolute top-3 md:top-4 right-3 md:right-4 flex gap-2">
                  <button
                    onClick={() => setIsWishlisted(!isWishlisted)}
                    className={`p-1.5 md:p-2 rounded-full shadow ${isWishlisted ? 'bg-red-500 text-white' : 'bg-white text-gray-600 hover:text-red-500'}`}
                  >
                    <Heart className={`w-4 h-4 md:w-5 md:h-5 ${isWishlisted ? 'fill-current' : ''}`} />
                  </button>
                  <button
                    onClick={handleShare}
                    className="p-1.5 md:p-2 bg-white rounded-full shadow text-gray-600 hover:text-blue-600"
                  >
                    <Share2 className="w-4 h-4 md:w-5 md:h-5" />
                  </button>
                </div>
              </div>

              {/* Thumbnail Gallery */}
              {images.length > 1 && (
                <div className="flex gap-2 overflow-x-auto pb-2">
                  {images.map((img, idx) => (
                    <button
                      key={idx}
                      onClick={() => setSelectedImageIndex(idx)}
                      className={`flex-shrink-0 w-16 h-16 md:w-20 md:h-20 rounded-lg overflow-hidden border-2 ${
                        selectedImageIndex === idx ? 'border-blue-600' : 'border-gray-200'
                      }`}
                    >
                      <img
                        src={img}
                        alt={`${product.name} - View ${idx + 1}`}
                        className="w-full h-full object-contain"
                        onError={(e) => { e.target.src = '/placeholder-product.png'; }}
                      />
                    </button>
                  ))}
                </div>
              )}

              {/* AI Summary */}
              <AISummarySection productId={product.id} />
            </div>

            {/* Product Info */}
            <div className="space-y-4 md:space-y-6">
              {/* Brand & Category */}
              <div className="flex flex-wrap items-center gap-2 md:gap-3">
                <span className="px-2 md:px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-xs md:text-sm font-medium">
                  {product.brand}
                </span>
                <span className="px-2 md:px-3 py-1 bg-gray-100 text-gray-600 rounded-full text-xs md:text-sm">
                  {product.category?.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase())}
                </span>
              </div>

              {/* Title */}
              <h1 className="text-xl md:text-2xl lg:text-3xl font-bold text-gray-900">
                {product.name}
              </h1>

              {/* Model Number */}
              {(product.model_number || product.modelNumber) && (
                <p className="text-sm md:text-base text-gray-500">
                  Model: {product.model_number || product.modelNumber}
                </p>
              )}

              {/* Rating */}
              <div className="flex items-center gap-2 flex-wrap">
                <div className="flex items-center">
                  {[...Array(5)].map((_, i) => (
                    <Star
                      key={i}
                      className={`w-4 h-4 md:w-5 md:h-5 ${i < Math.floor(product.rating || 4.5) ? 'text-yellow-400 fill-yellow-400' : 'text-gray-300'}`}
                    />
                  ))}
                </div>
                <span className="text-sm md:text-base text-gray-600">
                  {product.rating || '4.5'} ({product.reviews_count || product.reviewsCount || '12'} reviews)
                </span>
              </div>

              {/* Price */}
              <div className="flex flex-wrap items-end gap-2 md:gap-3">
                <span className="text-2xl md:text-3xl font-bold text-gray-900">
                  ₹{(product.price || 0).toLocaleString('en-IN')}
                </span>
                {originalPrice && originalPrice > product.price && (
                  <span className="text-lg md:text-xl text-gray-400 line-through">
                    ₹{originalPrice.toLocaleString('en-IN')}
                  </span>
                )}
                {discountPercentage > 0 && (
                  <span className="text-sm md:text-lg text-green-600 font-semibold">
                    Save ₹{((originalPrice || 0) - (product.price || 0)).toLocaleString('en-IN')}
                  </span>
                )}
              </div>

              {/* Stock Status */}
              <div className={`flex items-center gap-2 ${stockQuantity > 0 ? 'text-green-600' : 'text-red-600'}`}>
                {stockQuantity > 0 ? (
                  <>
                    <CheckCircle className="w-4 h-4 md:w-5 md:h-5" />
                    <span className="text-sm md:text-base font-medium">In Stock ({stockQuantity} available)</span>
                  </>
                ) : (
                  <>
                    <Info className="w-4 h-4 md:w-5 md:h-5" />
                    <span className="text-sm md:text-base font-medium">Out of Stock</span>
                  </>
                )}
              </div>

              {/* Quantity & Add to Cart */}
              <div className="flex flex-col sm:flex-row gap-3 md:gap-4">
                <div className="flex items-center border rounded-lg">
                  <button
                    onClick={() => setQuantity(Math.max(1, quantity - 1))}
                    className="px-3 md:px-4 py-2 text-gray-600 hover:bg-gray-100"
                    disabled={quantity <= 1}
                  >
                    -
                  </button>
                  <span className="px-3 md:px-4 py-2 font-medium text-sm md:text-base">{quantity}</span>
                  <button
                    onClick={() => setQuantity(Math.min(stockQuantity, quantity + 1))}
                    className="px-3 md:px-4 py-2 text-gray-600 hover:bg-gray-100"
                    disabled={quantity >= stockQuantity}
                  >
                    +
                  </button>
                </div>
                
                <button
                  onClick={handleAddToCart}
                  disabled={stockQuantity === 0 || addingToCart}
                  className="flex-1 flex items-center justify-center gap-2 px-4 md:px-6 py-2.5 md:py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 disabled:bg-gray-400 disabled:cursor-not-allowed text-sm md:text-base"
                >
                  {addingToCart ? (
                    <Loader2 className="w-4 h-4 md:w-5 md:h-5 animate-spin" />
                  ) : (
                    <ShoppingCart className="w-4 h-4 md:w-5 md:h-5" />
                  )}
                  <span className="hidden sm:inline">Add to Cart</span>
                  <span className="sm:hidden">Add</span>
                </button>
                
                <button
                  onClick={handleBuyNow}
                  disabled={stockQuantity === 0}
                  className="flex-1 px-4 md:px-6 py-2.5 md:py-3 bg-amber-600 text-white rounded-lg hover:bg-amber-700 disabled:bg-gray-400 disabled:cursor-not-allowed text-sm md:text-base"
                >
                  Buy Now
                </button>
              </div>

              {/* AI Chat Button */}
              <button
                onClick={handleAIChat}
                className="w-full flex items-center justify-center gap-2 px-4 md:px-6 py-2.5 md:py-3 bg-gradient-to-r from-purple-600 to-indigo-600 text-white rounded-lg hover:from-purple-700 hover:to-indigo-700 text-sm md:text-base"
              >
                <MessageCircle className="w-4 h-4 md:w-5 md:h-5" />
                <span className="hidden sm:inline">Chat with Sales Agent about this product</span>
                <span className="sm:hidden">Ask Sales Agent</span>
              </button>

              {/* AI Compare Button */}
              <button
                onClick={() => setShowCompare(true)}
                className="w-full flex items-center justify-center gap-2 px-4 md:px-6 py-2.5 md:py-3 border-2 border-indigo-500 text-indigo-600 rounded-lg hover:bg-indigo-50 text-sm md:text-base font-medium"
                data-testid="compare-product-btn"
              >
                ⚖️
                <span className="hidden sm:inline">Compare with another product (AI)</span>
                <span className="sm:hidden">Compare (AI)</span>
              </button>

              {/* Pincode Delivery Checker */}
              <PincodeChecker weight={product.weight || product.weight_kg || 1} />

              {/* Available Offers (AI-extracted from brand PDFs) */}
              <OffersDisplay productId={product.id} />

              {/* Installation by Brand Badge (large appliances only) */}
              <InstallationBadge product={product} />

              {/* Trust Badges */}
              <div className="grid grid-cols-2 sm:grid-cols-4 gap-3 md:gap-4 pt-4 border-t">
                <div className="flex flex-col items-center text-center">
                  <Truck className="w-6 h-6 md:w-8 md:h-8 text-blue-600 mb-1 md:mb-2" />
                  <span className="text-xs text-gray-600">Free Delivery</span>
                </div>
                <div className="flex flex-col items-center text-center">
                  <Shield className="w-6 h-6 md:w-8 md:h-8 text-green-600 mb-1 md:mb-2" />
                  <span className="text-xs text-gray-600">
                    {typeof product.warranty === 'string' 
                      ? product.warranty 
                      : (product.warranty?.period || product.warranty_period || '2 Year')} Warranty
                  </span>
                </div>
                <div className="flex flex-col items-center text-center">
                  <RefreshCw className="w-6 h-6 md:w-8 md:h-8 text-amber-600 mb-1 md:mb-2" />
                  <span className="text-xs text-gray-600">Easy Returns</span>
                </div>
                <div className="flex flex-col items-center text-center">
                  <Award className="w-6 h-6 md:w-8 md:h-8 text-purple-600 mb-1 md:mb-2" />
                  <span className="text-xs text-gray-600">Genuine Product</span>
                </div>
              </div>
            </div>
          </div>

          {/* Tabs Section */}
          <div className="border-t">
            <div className="flex overflow-x-auto border-b">
              {['overview', 'specifications', 'documents', 'reviews'].map((tab) => (
                <button
                  key={tab}
                  onClick={() => setActiveTab(tab)}
                  className={`px-6 py-4 font-medium whitespace-nowrap ${
                    activeTab === tab
                      ? 'text-blue-600 border-b-2 border-blue-600'
                      : 'text-gray-600 hover:text-gray-900'
                  }`}
                >
                  {tab.charAt(0).toUpperCase() + tab.slice(1)}
                </button>
              ))}
            </div>

            <div className="p-6">
              {activeTab === 'overview' && (
                <div className="prose max-w-none">
                  <h3 className="text-xl font-semibold mb-4">Product Description</h3>
                  <p className="text-gray-700">
                    {product.description || `The ${product.name} from ${product.brand} is a premium quality product designed to meet your everyday needs. With advanced features and reliable performance, this product offers excellent value for money.`}
                  </p>
                  
                  {/* Long Description */}
                  {product.long_description && (
                    <p className="text-gray-700 mt-4">
                      {product.long_description}
                    </p>
                  )}
                  
                  {/* Key Features */}
                  {product.key_features && Array.isArray(product.key_features) && product.key_features.length > 0 && (
                    <div className="mt-6">
                      <h4 className="font-semibold mb-3">Key Features</h4>
                      <ul className="list-disc pl-5 space-y-2">
                        {product.key_features.map((feature, idx) => (
                          <li key={idx} className="text-gray-700">{feature}</li>
                        ))}
                      </ul>
                    </div>
                  )}
                  
                  {/* Highlights */}
                  {product.highlights && Array.isArray(product.highlights) && product.highlights.length > 0 && (
                    <div className="mt-6">
                      <h4 className="font-semibold mb-3">Highlights</h4>
                      <ul className="list-disc pl-5 space-y-2">
                        {product.highlights.map((highlight, idx) => (
                          <li key={idx} className="text-gray-700">{highlight}</li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              )}

              {activeTab === 'specifications' && (
                <div>
                  <h3 className="text-xl font-semibold mb-4">Technical Specifications</h3>
                  {product.specifications ? (
                    // Handle nested object format (categories with sub-specs)
                    typeof product.specifications === 'object' && !Array.isArray(product.specifications) ? (
                      <div className="space-y-6">
                        {Object.entries(product.specifications).map(([category, specs], catIdx) => (
                          <div key={catIdx} className="border rounded-lg overflow-hidden">
                            <div className="bg-gray-100 px-4 py-3 font-semibold text-gray-800">
                              {category}
                            </div>
                            <div className="divide-y">
                              {typeof specs === 'object' && specs !== null ? (
                                Object.entries(specs).map(([key, value], specIdx) => (
                                  <div key={specIdx} className="flex justify-between px-4 py-3">
                                    <span className="text-gray-600">{key}</span>
                                    <span className="font-medium text-gray-900">{String(value)}</span>
                                  </div>
                                ))
                              ) : (
                                <div className="flex justify-between px-4 py-3">
                                  <span className="text-gray-600">{category}</span>
                                  <span className="font-medium text-gray-900">{String(specs)}</span>
                                </div>
                              )}
                            </div>
                          </div>
                        ))}
                      </div>
                    ) : Array.isArray(product.specifications) && product.specifications.length > 0 ? (
                      // Handle flat array format
                      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                        {product.specifications.map((spec, idx) => (
                          <div key={idx} className="flex justify-between py-3 border-b">
                            <span className="text-gray-600">{spec.name || spec.key}</span>
                            <span className="font-medium text-gray-900">{spec.value}</span>
                          </div>
                        ))}
                      </div>
                    ) : (
                      <p className="text-gray-500">Specifications not available</p>
                    )
                  ) : (
                    <p className="text-gray-500">Specifications not available</p>
                  )}
                </div>
              )}

              {activeTab === 'documents' && (
                <div>
                  <h3 className="text-xl font-semibold mb-4">Product Documents</h3>
                  {product.documents && Array.isArray(product.documents) && product.documents.length > 0 ? (
                    <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                      {product.documents.map((doc, idx) => (
                        <a
                          key={idx}
                          href={doc.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          className="flex items-center gap-3 p-4 border rounded-lg hover:bg-gray-50 hover:border-blue-300 transition-colors"
                        >
                          <div className="flex-shrink-0 w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center">
                            <svg className="w-6 h-6 text-red-600" fill="currentColor" viewBox="0 0 20 20">
                              <path fillRule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clipRule="evenodd" />
                            </svg>
                          </div>
                          <div className="flex-1 min-w-0">
                            <p className="font-medium text-gray-900 truncate">{doc.name}</p>
                            <p className="text-sm text-gray-500">{doc.type || 'PDF'}</p>
                            {doc.description && (
                              <p className="text-xs text-gray-400 truncate mt-1">{doc.description}</p>
                            )}
                          </div>
                          <svg className="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                          </svg>
                        </a>
                      ))}
                    </div>
                  ) : (
                    <p className="text-gray-500">No documents available for this product</p>
                  )}
                </div>
              )}

              {activeTab === 'reviews' && (
                <ReviewsSection productId={product.id} />
              )}
            </div>
          </div>
        </div>

        {/* Contact for Bulk Orders */}
        <div className="mt-8 bg-gradient-to-r from-blue-600 to-indigo-600 rounded-xl p-6 text-white">
          <div className="flex flex-col md:flex-row items-center justify-between gap-4">
            <div>
              <h3 className="text-xl font-bold">Need Bulk Orders?</h3>
              <p className="text-blue-100">Contact us for special pricing on bulk purchases</p>
            </div>
            <a
              href="tel:+919844577440"
              className="flex items-center gap-2 px-6 py-3 bg-white text-blue-600 rounded-lg font-semibold hover:bg-blue-50"
            >
              <Phone className="w-5 h-5" />
              Call Now
            </a>
          </div>
        </div>
        {/* Product FAQ Section */}
        {/* AI FAQ Section */}
        <div className="mt-8" data-testid="product-faq-section">
          <h2 className="text-xl font-bold text-gray-900 mb-4">
            Frequently Asked Questions
          </h2>
          <div className="space-y-3">
            {productFAQs.map((faq, idx) => (
              <details key={idx} className="bg-white rounded-lg shadow-sm group" data-testid={`product-faq-${idx}`}>
                <summary className="px-6 py-4 cursor-pointer font-semibold text-gray-900 hover:bg-gray-50 transition-colors list-none flex items-center justify-between">
                  {faq.question}
                  <svg className="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform flex-shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 9l-7 7-7-7" /></svg>
                </summary>
                <div className="px-6 pb-4 text-gray-700 border-t border-gray-100">
                  <p className="pt-3">{faq.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </main>

      {showCompare && product && (
        <ProductCompareModal product={product} onClose={() => setShowCompare(false)} />
      )}

      <Footer />
    </div>
  );
};

export default ProductDetailPage;

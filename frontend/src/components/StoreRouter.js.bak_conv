import React, { useState, useEffect, useMemo, useRef } from 'react';
import { BACKEND_URL } from '../config/api';
import { useNavigate, useLocation } from 'react-router-dom';
import { 
  Store, ShoppingCart, Package, TrendingUp, AlertTriangle, Truck,
  FileText, Receipt, Users, ArrowRightLeft, BarChart3, Calendar,
  LogOut, RefreshCw, ChevronDown, Search, Eye, Check, X, Clock, Home,
  Plus, Printer, Download, Wrench, ArrowLeft, ExternalLink, ClipboardList,
  DollarSign, CreditCard, Edit2, Sparkles, Camera, Save
} from 'lucide-react';
import PORequestsTab from './PORequestsTab';
import NotificationBell from './NotificationBell';
import ProfessionalInvoice from './ProfessionalInvoice';
import GoodsReceiptNote from './GoodsReceiptNote';
import QuotationManagement from './QuotationManagement';
import MaterialTransferDC from './MaterialTransferDC';
import PurchaseManagement from './PurchaseManagement';
import CustomerPOManagement from './CustomerPOManagement';
import { PendingPaymentsList, PaymentReceiptModal, PaymentHistoryModal } from './PaymentReceipts';
import { showToast } from '../utils/toast';

// Helper function to safely extract error message from API response
const getErrorMessage = (detail, fallback = 'Operation failed') => {
  if (!detail) return fallback;
  if (typeof detail === 'string') return detail;
  if (Array.isArray(detail)) {
    return detail.map(err => `${err.loc ? err.loc.join('.') : 'Field'}: ${err.msg}`).join(', ');
  }
  if (typeof detail === 'object') return JSON.stringify(detail);
  return fallback;
};


// Route to tab mapping
const ROUTE_TAB_MAP = {
  '/store/dashboard': 'overview',
  '/store/orders': 'orders',
  '/store/pending-sos': 'pending-sos',
  '/store/inventory': 'inventory',
  '/store/transfers': 'transfers',
  '/store/material-transfer': 'material-transfer',
  '/store/po-requests': 'po-requests',
  '/store/reports': 'reports',
  '/store/deliveries': 'deliveries',
  '/store/service': 'service',
  '/store/invoices': 'invoices',
  '/store/all-invoices': 'all-invoices',
  '/store/quotations': 'quotations',
  '/store/customer-pos': 'customer-pos',
  '/store/customers': 'customers',
  '/store/grn': 'grn',
  '/store/purchase-bills': 'purchase-bills',
  '/store/purchase-orders': 'purchase-orders',
  '/store/payments': 'payments'
};

const StoreRouter = () => {
  const navigate = useNavigate();
  const location = useLocation();
  const [storeUser, setStoreUser] = useState(null);
  const [storeData, setStoreData] = useState(null);
  const [loading, setLoading] = useState(true);
  const [period, setPeriod] = useState('today');
  const [dashboardData, setDashboardData] = useState(null);
  const [showScanInvoiceModal, setShowScanInvoiceModal] = useState(false);
  const [showScanInvoiceReviewModal, setShowScanInvoiceReviewModal] = useState(false);
  const [scanInvoiceFile, setScanInvoiceFile] = useState(null);
  const [scanningInvoice, setScanningInvoice] = useState(false);
  const [savingScannedInvoice, setSavingScannedInvoice] = useState(false);
  const [scannedInvoiceData, setScannedInvoiceData] = useState(null);
  const scanInvoiceFileInputRef = useRef(null);
  const [inventory, setInventory] = useState(null);
  const [orders, setOrders] = useState([]);
  // Smart pagination state for Sales Orders
  const currentFY = (() => {
    const now = new Date();
    const year = now.getMonth() >= 3 ? now.getFullYear() : now.getFullYear() - 1;
    return `${String(year).slice(2)}-${String(year + 1).slice(2)}`;
  })();
  const [ordersFY, setOrdersFY] = useState(currentFY);
  const [ordersSearch, setOrdersSearch] = useState('');
  const [ordersPage, setOrdersPage] = useState(1);
  const [ordersTotalCount, setOrdersTotalCount] = useState(0);
  const [ordersHasMore, setOrdersHasMore] = useState(false);
  const [ordersLoading, setOrdersLoading] = useState(false);
  const ORDERS_PAGE_SIZE = 200;
  const [transfers, setTransfers] = useState([]);
  const [reportData, setReportData] = useState(null);
  const [showReceiveStock, setShowReceiveStock] = useState(false);
  const [showCreateTransfer, setShowCreateTransfer] = useState(false);
  const [showAddCustomer, setShowAddCustomer] = useState(false);
  const [showEditCustomer, setShowEditCustomer] = useState(false);
  const [selectedProduct, setSelectedProduct] = useState(null);
  const [selectedCustomer, setSelectedCustomer] = useState(null);
  const [selectedOrder, setSelectedOrder] = useState(null);
  const [showViewOrder, setShowViewOrder] = useState(false);
  const [showProfessionalInvoice, setShowProfessionalInvoice] = useState(false);
  const [showStockTransferModal, setShowStockTransferModal] = useState(false);
  const [stores, setStores] = useState([]);
  const [allProducts, setAllProducts] = useState([]);  // All products from database
  const [transferItems, setTransferItems] = useState([{ product_id: '', product_name: '', quantity: 1 }]);
  const [transferNotes, setTransferNotes] = useState('');
  const [transferUrgency, setTransferUrgency] = useState('normal');
  const [transferLoading, setTransferLoading] = useState(false);
  const [customers, setCustomers] = useState([]);
  
  // Delivery Management State
  const [pendingDeliveryOrders, setPendingDeliveryOrders] = useState([]);
  const [deliveryChallans, setDeliveryChallans] = useState([]);
  const [deliveryPersons, setDeliveryPersons] = useState([]);
  const [deliveryLoading, setDeliveryLoading] = useState(false);
  const [showCreateChallanModal, setShowCreateChallanModal] = useState(false);
  const [selectedDeliveryOrder, setSelectedDeliveryOrder] = useState(null);
  
  // Assign Delivery Person Modal State (for direct invoice assignment)
  const [showAssignDeliveryModal, setShowAssignDeliveryModal] = useState(false);
  const [selectedInvoiceForDelivery, setSelectedInvoiceForDelivery] = useState(null);
  const [assignDeliveryForm, setAssignDeliveryForm] = useState({
    delivery_person_id: '',
    delivery_person_name: '',
    expected_delivery_date: new Date().toISOString().split('T')[0],
    delivery_notes: ''
  });
  const [assigningDelivery, setAssigningDelivery] = useState(false);
  
  // Create Challan Form State
  const [challanFormData, setChallanFormData] = useState({
    delivery_person_id: '',
    vehicle_number: '',
    expected_date: new Date(Date.now() + 2 * 24 * 60 * 60 * 1000).toISOString().split('T')[0]
  });
  const [selectedChallanForPreview, setSelectedChallanForPreview] = useState(null);
  
  // Challan Filter State
  const [challanStatusFilter, setChallanStatusFilter] = useState('');
  const [challanDriverFilter, setChallanDriverFilter] = useState('');
  
  // Delivery Person Management State
  const [showAddDeliveryPersonModal, setShowAddDeliveryPersonModal] = useState(false);
  const [deliveryPersonForm, setDeliveryPersonForm] = useState({
    full_name: '', email: '', password: '', phone: '', vehicle_number: '', address: ''
  });
  const [deliveryPersonLoading, setDeliveryPersonLoading] = useState(false);

  // Warehouse-only: Delivery Management store filter
  const [deliveryStoreFilter, setDeliveryStoreFilter] = useState('all');
  const [deliverySearch, setDeliverySearch] = useState('');
  
  // Warehouse-specific: Pending SOs (not immediate) and Immediate SOs (for conversion)
  const [pendingSOs, setPendingSOs] = useState([]);
  const [immediateSOs, setImmediateSOs] = useState([]);
  // Warehouse filter state
  const [whSearch, setWhSearch] = useState('');
  const [whStoreFilter, setWhStoreFilter] = useState('all');

  // Derived: filter SOs by selected store + search query (applies to both Pending and Immediate)
  const applyWarehouseFilters = (list) => {
    const q = (whSearch || '').toLowerCase().trim();
    return (list || []).filter(so => {
      if (whStoreFilter !== 'all' && so.store_code !== whStoreFilter) return false;
      if (!q) return true;
      const hay = [
        so.invoice_number,
        so.customer?.name, so.customer?.phone,
        so.customer_name, so.customer_phone,
      ].filter(Boolean).join(' ').toLowerCase();
      return hay.includes(q);
    });
  };
  const filteredPendingSOs = useMemo(() => applyWarehouseFilters(pendingSOs),
    [pendingSOs, whSearch, whStoreFilter]);
  const filteredImmediateSOs = useMemo(() => applyWarehouseFilters(immediateSOs),
    [immediateSOs, whSearch, whStoreFilter]);

  // Warehouse-only: Delivery store options + filtered pending delivery orders
  const deliveryStoreOptions = useMemo(() => {
    const codes = new Set();
    (pendingDeliveryOrders || []).forEach(o => { if (o.store_code) codes.add(o.store_code); });
    return Array.from(codes).sort();
  }, [pendingDeliveryOrders]);
  const filteredPendingDeliveryOrders = useMemo(() => {
    const q = (deliverySearch || '').toLowerCase().trim();
    return (pendingDeliveryOrders || []).filter(o => {
      if (deliveryStoreFilter !== 'all' && o.store_code !== deliveryStoreFilter) return false;
      if (!q) return true;
      const hay = [
        o.invoice_number,
        o.customer?.name, o.customer?.phone,
      ].filter(Boolean).join(' ').toLowerCase();
      return hay.includes(q);
    });
  }, [pendingDeliveryOrders, deliveryStoreFilter, deliverySearch]);
  // Stores derived from both lists (unique)
  const warehouseStoreOptions = useMemo(() => {
    const codes = new Set();
    [...pendingSOs, ...immediateSOs].forEach(so => { if (so.store_code) codes.add(so.store_code); });
    return Array.from(codes).sort();
  }, [pendingSOs, immediateSOs]);
  const [convertedInvoices, setConvertedInvoices] = useState([]); // Invoices converted from SOs
  const [allStoreInvoices, setAllStoreInvoices] = useState([]); // ALL invoices from ALL stores (warehouse view)
  const [allInvoicesLoading, setAllInvoicesLoading] = useState(false);
  const [stockTransferRequests, setStockTransferRequests] = useState([]);
  const [incomingTransfers, setIncomingTransfers] = useState([]); // DCs coming TO this store
  const [showReceiveTransferModal, setShowReceiveTransferModal] = useState(false);
  const [selectedTransferForReceive, setSelectedTransferForReceive] = useState(null);
  const [receiveTransferForm, setReceiveTransferForm] = useState({
    goods_condition: 'good',
    receiver_remarks: ''
  });
  const [receivingTransfer, setReceivingTransfer] = useState(false);
  const [approvingTransfer, setApprovingTransfer] = useState(false); // For approving stock transfers
  const [selectedSOForConversion, setSelectedSOForConversion] = useState(null);
  const [conversionData, setConversionData] = useState({ ship_from_address: '', e_way_bill_number: '', selected_store_id: '' });
  const [selectedItemsForConversion, setSelectedItemsForConversion] = useState({}); // {product_id: {selected: true, quantity: X}}
  const [allStores, setAllStores] = useState([]);
  const [selectedInvoiceForPreview, setSelectedInvoiceForPreview] = useState(null);

  // Determine active tab from URL
  const activeTab = ROUTE_TAB_MAP[location.pathname] || 'overview';

  useEffect(() => {
    const user = localStorage.getItem('storeUser');
    const store = localStorage.getItem('storeData');
    
    if (!user || !store) {
      navigate('/store/login');
      return;
    }
    
    setStoreUser(JSON.parse(user));
    setStoreData(JSON.parse(store));
  }, [navigate]);

  useEffect(() => {
    if (storeData) {
      fetchDashboardData();
      fetchInventory();
      fetchOrders();
      fetchTransfers();
      fetchStores();
      if (activeTab === 'customers') {
        fetchCustomers();
      }
      // Fetch delivery data for warehouse dashboard or deliveries tab
      if (activeTab === 'deliveries' || storeData?.is_warehouse) {
        fetchDeliveryData();
      }
      // Fetch warehouse-specific data
      if (storeData?.is_warehouse) {
        fetchPendingSOs();
        fetchImmediateSOs();
        fetchConvertedInvoices(); // Fetch converted invoices for warehouse
        fetchAllStoreInvoices(); // NEW: all invoices, all stores
        fetchStockTransferRequests();
      } else {
        // For non-warehouse stores, also fetch their invoices
        fetchConvertedInvoices();
        // Fetch this store's own Pending SOs + Immediate SOs
        fetchPendingSOs();
        fetchImmediateSOs();
        // Fetch incoming material transfers for stores
        if (activeTab === 'transfers' || activeTab === 'material-transfer') {
          fetchIncomingTransfers();
        }
      }
    }
  }, [storeData, period, activeTab]);

  const fetchStores = async () => {
    try {
      const response = await fetch(`${BACKEND_URL}/api/stores/`);
      const data = await response.json();
      if (data.status === 'success' || data.stores) {
        const storesList = data.stores || [];
        // Filter out current store for transfers
        setStores(storesList.filter(s => s.id !== storeData?.id));
        // Keep all stores for Ship From dropdown
        setAllStores(storesList);
      }
    } catch (error) {
      console.error('Error fetching stores:', error);
    }
  };

  // Fetch all products from database for stock transfer
  const fetchAllProducts = async () => {
    try {
      const response = await fetch(`${BACKEND_URL}/api/products?limit=1000`);
      const data = await response.json();
      if (data.status === 'success' || Array.isArray(data)) {
        setAllProducts(Array.isArray(data) ? data : (data.products || []));
      }
    } catch (error) {
      console.error('Error fetching products:', error);
    }
  };

  // Fetch Pending SOs (not immediate delivery) - for warehouse "Pending SOs" section
  const fetchPendingSOs = async () => {
    try {
      const url = storeData?.is_warehouse
        ? `${BACKEND_URL}/api/invoices/offline/sales-orders/pending`
        : `${BACKEND_URL}/api/invoices/offline/sales-orders/pending?store_code=${storeData?.code}`;
      const response = await fetch(url);
      const data = await response.json();
      if (data.status === 'success') {
        setPendingSOs(data.sales_orders || []);
      }
    } catch (error) {
      console.error('Error fetching pending SOs:', error);
    }
  };

  // Fetch Immediate SOs (for conversion to invoice) - for warehouse "SO to Invoice" section
  const fetchImmediateSOs = async () => {
    try {
      const url = storeData?.is_warehouse
        ? `${BACKEND_URL}/api/invoices/offline/sales-orders/immediate`
        : `${BACKEND_URL}/api/invoices/offline/sales-orders/immediate?store_code=${storeData?.code}`;
      const response = await fetch(url);
      const data = await response.json();
      if (data.status === 'success') {
        setImmediateSOs(data.sales_orders || []);
      }
    } catch (error) {
      console.error('Error fetching immediate SOs:', error);
    }
  };

  // Fetch Converted Invoices - invoices that were converted from Sales Orders
  // For Warehouse: fetch ONLY invoices converted from SOs (not direct store invoices)
  // For Store: fetch only invoices for this store
  const fetchConvertedInvoices = async () => {
    try {
      let url;
      if (storeData?.is_warehouse) {
        // Warehouse should ONLY see invoices that were converted from SOs
        // These have converted_from_so=true or original_so_number set
        url = `${BACKEND_URL}/api/invoices/offline/?document_type=invoice&converted_from_so=true&limit=5000`;
      } else {
        // Store sees its own invoices
        url = `${BACKEND_URL}/api/invoices/offline/?document_type=invoice&store_code=${storeData?.code}&limit=5000`;
      }
      const response = await fetch(url);
      const data = await response.json();
      if (data.status === 'success') {
        const invoices = data.invoices || [];
        setConvertedInvoices(invoices);
      }
    } catch (error) {
      console.error('Error fetching converted invoices:', error);
    }
  };

  const fetchAllStoreInvoices = async () => {
    setAllInvoicesLoading(true);
    try {
      const url = `${BACKEND_URL}/api/invoices/offline/?document_type=invoice&limit=5000`;
      const response = await fetch(url);
      const data = await response.json();
      if (data.status === 'success') {
        setAllStoreInvoices(data.invoices || []);
      }
    } catch (error) {
      console.error('Error fetching all store invoices:', error);
    } finally {
      setAllInvoicesLoading(false);
    }
  };

  // ===== AI Scan Invoice (store-locked, always saves as Sales Invoice for this store) =====
  const handleScanInvoiceFileSelect = (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    const allowed = ['.pdf', '.png', '.jpg', '.jpeg', '.webp'];
    const lower = file.name.toLowerCase();
    if (!allowed.some(ext => lower.endsWith(ext))) {
      alert('Unsupported file type. Please upload PDF, PNG, JPG, or WEBP.');
      return;
    }
    setScanInvoiceFile(file);
  };

  const handleScanInvoiceSubmit = async () => {
    if (!scanInvoiceFile) {
      alert('Please select a file first');
      return;
    }
    setScanningInvoice(true);
    try {
      const formData = new FormData();
      formData.append('file', scanInvoiceFile);
      formData.append('store_code', storeData?.code || '');

      const response = await fetch(`${BACKEND_URL}/api/tally-import/scan-sales-order`, {
        method: 'POST',
        body: formData
      });
      const data = await response.json();

      if (data.status === 'success') {
        setScannedInvoiceData({ ...data.extracted_data, store_code: storeData?.code });
        setShowScanInvoiceModal(false);
        setShowScanInvoiceReviewModal(true);
      } else {
        alert(data.detail || data.message || 'Scan failed. Please try again or enter details manually.');
      }
    } catch (error) {
      console.error('Scan error:', error);
      alert('Failed to scan file');
    } finally {
      setScanningInvoice(false);
    }
  };

  const updateScannedInvoiceField = (field, value) => {
    setScannedInvoiceData(prev => ({ ...prev, [field]: value }));
  };

  const updateScannedInvoiceCustomer = (field, value) => {
    setScannedInvoiceData(prev => ({
      ...prev,
      customer: { ...(prev.customer || {}), [field]: value }
    }));
  };

  const updateScannedInvoiceItem = (idx, field, value) => {
    setScannedInvoiceData(prev => {
      const items = [...(prev.items || [])];
      items[idx] = { ...items[idx], [field]: value };
      return { ...prev, items };
    });
  };

  const handleSaveScannedInvoice = async () => {
    if (!scannedInvoiceData || !scannedInvoiceData.so_number) {
      alert('Invoice number is required');
      return;
    }
    setSavingScannedInvoice(true);
    try {
      const payload = { ...scannedInvoiceData, store_code: storeData?.code };
      const response = await fetch(`${BACKEND_URL}/api/tally-import/save-scanned-invoice-store`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await response.json();

      if (data.status === 'success') {
        alert(`Sales Invoice ${data.so.so_number} created successfully!`);
        setShowScanInvoiceReviewModal(false);
        setScannedInvoiceData(null);
        setScanInvoiceFile(null);
        fetchConvertedInvoices();
      } else {
        alert(getErrorMessage(data.detail, 'Failed to save invoice'));
      }
    } catch (error) {
      console.error('Save error:', error);
      alert('Failed to save Sales Invoice');
    } finally {
      setSavingScannedInvoice(false);
    }
  };

  // Fetch Stock Transfer Requests that need challans
  const fetchStockTransferRequests = async () => {
    try {
      const response = await fetch(`${BACKEND_URL}/api/delivery-challans/stock-transfer-requests?warehouse_id=${storeData?.id}`);
      const data = await response.json();
      if (data.status === 'success') {
        setStockTransferRequests(data.transfers || []);
      }
    } catch (error) {
      console.error('Error fetching stock transfer requests:', error);
    }
  };

  // Handle Stock Transfer Approval (for warehouse/admin)
  const handleApproveTransfer = async (transferId, status) => {
    if (!confirm(`Are you sure you want to ${status} this stock transfer request?`)) return;
    
    setApprovingTransfer(true);
    try {
      const response = await fetch(`${BACKEND_URL}/api/inventory/transfer/${transferId}/approve`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          status: status,
          notes: status === 'approved' ? 'Approved by warehouse' : 'Rejected by warehouse'
        })
      });
      
      const data = await response.json();
      if (data.status === 'success') {
        alert(`Transfer ${status} successfully!`);
        // Refresh transfers list
        fetchTransfers();
        // If approved, also refresh stock transfer requests for challan creation
        if (status === 'approved') {
          fetchStockTransferRequests();
        }
      } else {
        alert(data.detail || `Failed to ${status} transfer`);
      }
    } catch (error) {
      console.error('Error approving transfer:', error);
      alert('Failed to process transfer. Please try again.');
    } finally {
      setApprovingTransfer(false);
    }
  };

  // Fetch Incoming Material Transfers (DCs sent TO this store that are pending receipt)
  const fetchIncomingTransfers = async () => {
    if (!storeData?.code) return;
    try {
      // Fetch material transfer DCs where this store is the destination and status is not delivered
      const response = await fetch(`${BACKEND_URL}/api/delivery-challans/material-transfer/list?to_location=${storeData.code}&status=dispatched&limit=5000`);
      const data = await response.json();
      if (data.status === 'success') {
        setIncomingTransfers(data.challans || []);
      }
    } catch (error) {
      console.error('Error fetching incoming transfers:', error);
    }
  };

  // Fetch delivery data for warehouse/delivery management
  const fetchDeliveryData = async () => {
    setDeliveryLoading(true);
    try {
      const storeParam = storeData?.is_warehouse ? '' : `&store_code=${storeData?.code}`;
      // Fetch invoices ready for delivery (new flow - direct invoice assignment)
      const readyForDeliveryResponse = await fetch(`${BACKEND_URL}/api/invoices/offline/invoices/ready-for-delivery?limit=5000${storeParam}`);
      const readyForDeliveryData = await readyForDeliveryResponse.json();
      if (readyForDeliveryData.status === 'success') {
        setPendingDeliveryOrders(readyForDeliveryData.invoices || []);
      }
      
      // Fetch invoices out for delivery (assigned to delivery persons)
      const outForDeliveryResponse = await fetch(`${BACKEND_URL}/api/invoices/offline/invoices/out-for-delivery?limit=5000${storeParam}`);
      const outForDeliveryData = await outForDeliveryResponse.json();
      if (outForDeliveryData.status === 'success') {
        setDeliveryChallans(outForDeliveryData.invoices || []);
      }

      // Fetch delivery persons (using public endpoint)
      const personsResponse = await fetch(`${BACKEND_URL}/api/auth/delivery-persons/list`);
      if (personsResponse.ok) {
        const personsData = await personsResponse.json();
        setDeliveryPersons(personsData.delivery_persons || []);
      }
    } catch (error) {
      console.error('Error fetching delivery data:', error);
    } finally {
      setDeliveryLoading(false);
    }
  };

  // Create delivery person from warehouse
  const handleCreateDeliveryPerson = async (e) => {
    e.preventDefault();
    setDeliveryPersonLoading(true);
    try {
      const response = await fetch(`${BACKEND_URL}/api/auth/delivery-person/create-from-warehouse`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(deliveryPersonForm)
      });
      const data = await response.json();
      if (response.ok && data.status === 'success') {
        alert(`Delivery person "${deliveryPersonForm.full_name}" created successfully!`);
        setShowAddDeliveryPersonModal(false);
        setDeliveryPersonForm({ full_name: '', email: '', password: '', phone: '', vehicle_number: '', address: '' });
        fetchDeliveryData(); // Refresh delivery persons list
      } else {
        alert(getErrorMessage(data.detail, 'Failed to create delivery person'));
      }
    } catch (error) {
      console.error('Error creating delivery person:', error);
      alert('Failed to create delivery person');
    } finally {
      setDeliveryPersonLoading(false);
    }
  };

  // Assign delivery person directly to invoice (new flow)
  const handleAssignDeliveryToInvoice = async () => {
    if (!selectedInvoiceForDelivery || !assignDeliveryForm.delivery_person_id) {
      alert('Please select a delivery person');
      return;
    }
    
    setAssigningDelivery(true);
    try {
      const response = await fetch(`${BACKEND_URL}/api/invoices/offline/invoices/assign-delivery`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          invoice_id: selectedInvoiceForDelivery.id,
          delivery_person_id: assignDeliveryForm.delivery_person_id,
          delivery_person_name: assignDeliveryForm.delivery_person_name,
          assigned_by: storeData?.code || 'warehouse',
          expected_delivery_date: assignDeliveryForm.expected_delivery_date,
          delivery_notes: assignDeliveryForm.delivery_notes
        })
      });
      const data = await response.json();
      if (data.status === 'success') {
        alert(`Delivery assigned successfully to ${assignDeliveryForm.delivery_person_name}!`);
        setShowAssignDeliveryModal(false);
        setSelectedInvoiceForDelivery(null);
        setAssignDeliveryForm({
          delivery_person_id: '',
          delivery_person_name: '',
          expected_delivery_date: new Date().toISOString().split('T')[0],
          delivery_notes: ''
        });
        fetchDeliveryData(); // Refresh data
      } else {
        alert(getErrorMessage(data.detail, 'Failed to assign delivery'));
      }
    } catch (error) {
      console.error('Error assigning delivery:', error);
      alert('Error assigning delivery person');
    } finally {
      setAssigningDelivery(false);
    }
  };

  // Handle receiving incoming material transfer
  const handleReceiveTransfer = async () => {
    if (!selectedTransferForReceive) return;
    
    setReceivingTransfer(true);
    try {
      const response = await fetch(`${BACKEND_URL}/api/delivery-challans/material-transfer/${selectedTransferForReceive.id}/receive`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          challan_id: selectedTransferForReceive.id,
          received_by: storeUser?.id || storeData?.code,
          received_by_name: storeUser?.name || storeData?.name,
          goods_condition: receiveTransferForm.goods_condition,
          receiver_remarks: receiveTransferForm.receiver_remarks || 'Goods received in good condition'
        })
      });
      const data = await response.json();
      if (data.status === 'success') {
        alert(`Transfer ${selectedTransferForReceive.challan_number} received successfully! Stock updated.`);
        setShowReceiveTransferModal(false);
        setSelectedTransferForReceive(null);
        setReceiveTransferForm({ goods_condition: 'good', receiver_remarks: '' });
        fetchIncomingTransfers(); // Refresh incoming transfers
        fetchInventory(); // Refresh inventory as stock was added
      } else {
        alert(getErrorMessage(data.detail, 'Failed to receive transfer'));
      }
    } catch (error) {
      console.error('Error receiving transfer:', error);
      alert('Failed to receive transfer');
    } finally {
      setReceivingTransfer(false);
    }
  };

  // Create delivery challan from order
  const handleCreateChallan = async (order, deliveryPersonId, vehicleNumber, expectedDate) => {
    try {
      const response = await fetch(`${BACKEND_URL}/api/delivery-challans/create`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          invoice_id: order.id,
          delivery_person_id: deliveryPersonId,
          vehicle_number: vehicleNumber,
          expected_delivery_date: expectedDate,
          created_by: storeData?.code || 'warehouse'
        })
      });
      const data = await response.json();
      if (data.status === 'success') {
        alert(`Delivery challan ${data.challan_number} created successfully!`);
        setShowCreateChallanModal(false);
        setSelectedDeliveryOrder(null);
        fetchDeliveryData(); // Refresh data
      } else {
        alert(getErrorMessage(data.detail, 'Failed to create challan'));
      }
    } catch (error) {
      console.error('Error creating challan:', error);
      alert('Error creating delivery challan');
    }
  };

  // Update challan status
  const handleUpdateChallanStatus = async (challanId, newStatus) => {
    try {
      const response = await fetch(`${BACKEND_URL}/api/delivery-challans/${challanId}/status`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: newStatus })
      });
      const data = await response.json();
      if (data.status === 'success') {
        fetchDeliveryData();
      }
    } catch (error) {
      console.error('Error updating challan status:', error);
    }
  };

  const fetchDashboardData = async () => {
    try {
      const response = await fetch(
        `${BACKEND_URL}/api/stores/${storeData.id}/dashboard?period=${period}`
      );
      const data = await response.json();
      if (data.status === 'success') {
        setDashboardData(data.summary);
      }
    } catch (error) {
      console.error('Error fetching dashboard:', error);
    } finally {
      setLoading(false);
    }
  };

  const fetchInventory = async () => {
    try {
      const response = await fetch(
        `${BACKEND_URL}/api/inventory/store/${storeData.id}?low_stock_only=false`
      );
      const data = await response.json();
      if (data.status === 'success') {
        setInventory(data);
      }
    } catch (error) {
      console.error('Error fetching inventory:', error);
    }
  };

  const fetchOrders = async ({ append = false, page = 1, fy = ordersFY, search = ordersSearch } = {}) => {
    setOrdersLoading(true);
    try {
      const params = new URLSearchParams({
        store_code: storeData.code,
        document_type: 'sales_order',
        page: page,
        limit: ORDERS_PAGE_SIZE,
        ...(fy && { fy }),
        ...(search && search.trim() && { search: search.trim() }),
      });
      const response = await fetch(`${BACKEND_URL}/api/invoices/offline/?${params}`);
      const data = await response.json();
      if (data.status === 'success') {
        const formattedOrders = (data.invoices || []).map(inv => ({
          id: inv.id,
          order_number: inv.invoice_number,
          document_type: inv.document_type,
          customer_name: inv.customer?.name || inv.customer_name,
          customer_phone: inv.customer?.phone || inv.customer_phone,
          customer_email: inv.customer?.email || inv.customer_email,
          customer_address: inv.customer?.address || inv.customer?.billing_address || inv.customer_address,
          customer_city: inv.customer?.city || inv.customer?.billing_city || inv.customer_city,
          customer_state: inv.customer?.state || inv.customer?.billing_state || inv.customer_state,
          customer_pincode: inv.customer?.pincode || inv.customer?.billing_pincode || inv.customer_pincode,
          customer_gstin: inv.customer?.gst_number || inv.customer_gst,
          shipping_name: inv.customer?.shipping_name || inv.customer?.name || inv.customer_name,
          shipping_address: inv.customer?.shipping_address || inv.customer?.address || inv.customer?.billing_address || inv.customer_address,
          shipping_city: inv.customer?.shipping_city || inv.customer?.city || inv.customer?.billing_city || inv.customer_city,
          shipping_state: inv.customer?.shipping_state || inv.customer?.state || inv.customer?.billing_state || inv.customer_state,
          shipping_pincode: inv.customer?.shipping_pincode || inv.customer?.pincode || inv.customer?.billing_pincode || inv.customer_pincode,
          shipping_phone: inv.customer?.shipping_phone || inv.customer?.phone || inv.customer_phone,
          total_amount: inv.total_amount,
          order_status: inv.status,
          payment_status: inv.payment_status,
          payment_mode: inv.payment_mode,
          created_at: inv.created_at,
          order_source: inv.order_source,
          items: inv.items,
          subtotal: inv.subtotal,
          tax_total: inv.tax_total,
          discount_amount: inv.discount,
          delivery_charges: inv.delivery_charges,
          round_off: inv.round_off
        }));
        if (append) {
          setOrders(prev => [...prev, ...formattedOrders]);
        } else {
          setOrders(formattedOrders);
        }
        setOrdersTotalCount(data.total || formattedOrders.length);
        setOrdersHasMore((data.invoices || []).length === ORDERS_PAGE_SIZE);
        setOrdersPage(page);
      }
    } catch (error) {
      console.error('Error fetching orders:', error);
    } finally {
      setOrdersLoading(false);
    }
  };

  const fetchTransfers = async () => {
    try {
      const response = await fetch(
        `${BACKEND_URL}/api/inventory/transfers?store_id=${storeData.id}`
      );
      const data = await response.json();
      if (data.status === 'success') {
        setTransfers(data.transfers || []);
      }
    } catch (error) {
      console.error('Error fetching transfers:', error);
    }
  };

  const fetchReportData = async (reportType) => {
    try {
      let url = '';
      // Use store_code for offline_invoices compatibility
      const storeFilter = `store_id=${storeData.code}`;
      
      if (reportType === 'daily') {
        url = `${BACKEND_URL}/api/reports/sales/daily?${storeFilter}`;
      } else if (reportType === 'monthly') {
        url = `${BACKEND_URL}/api/reports/sales/monthly?${storeFilter}`;
      } else if (reportType === 'item-wise') {
        url = `${BACKEND_URL}/api/reports/sales/by-item?${storeFilter}&limit=20`;
      }
      
      const response = await fetch(url);
      const data = await response.json();
      if (data.status === 'success') {
        setReportData({ type: reportType, data });
      }
    } catch (error) {
      console.error('Error fetching report:', error);
    }
  };

  const fetchCustomers = async () => {
    try {
      // Fetch all customers (not filtered by store) so they're available across all stores
      const response = await fetch(`${BACKEND_URL}/api/customers?limit=500`);
      const data = await response.json();
      if (data.customers) {
        setCustomers(data.customers);
      }
    } catch (error) {
      console.error('Error fetching customers:', error);
    }
  };

  const handleStockTransferSubmit = async (toStoreId) => {
    if (!toStoreId) {
      alert('Please select a destination store');
      return;
    }
    
    const validItems = transferItems.filter(item => item.product_name && item.quantity > 0);
    if (validItems.length === 0) {
      alert('Please add at least one item');
      return;
    }

    setTransferLoading(true);
    try {
      const response = await fetch(`${BACKEND_URL}/api/stock-transfer/request`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          from_store_id: storeData.id,
          to_store_id: toStoreId,
          items: validItems.map(item => ({
            product_id: item.product_id || item.product_name,
            product_name: item.product_name,
            quantity: parseInt(item.quantity),
            unit_price: 0
          })),
          notes: transferNotes,
          urgency: transferUrgency
        })
      });

      const data = await response.json();
      
      if (data.transfer_id || data.status === 'success') {
        alert(`Stock transfer request ${data.transfer_number || ''} created successfully!`);
        setShowStockTransferModal(false);
        setTransferItems([{ product_id: '', product_name: '', quantity: 1 }]);
        setTransferNotes('');
        setTransferUrgency('normal');
        fetchTransfers();
      } else {
        alert(getErrorMessage(data.detail, 'Failed to create transfer request'));
      }
    } catch (error) {
      console.error('Error creating transfer:', error);
      alert('Error creating transfer request');
    } finally {
      setTransferLoading(false);
    }
  };

  const handleLogout = () => {
    localStorage.removeItem('storeToken');
    localStorage.removeItem('storeUser');
    localStorage.removeItem('storeData');
    navigate('/store/login');
  };

  const formatCurrency = (amount) => {
    return new Intl.NumberFormat('en-IN', {
      style: 'currency',
      currency: 'INR',
      maximumFractionDigits: 0
    }).format(amount || 0);
  };

  const formatDate = (dateStr) => {
    if (!dateStr) return 'N/A';
    return new Date(dateStr).toLocaleDateString('en-IN', {
      day: '2-digit',
      month: 'short',
      year: 'numeric'
    });
  };

  // Different tabs for Warehouse vs Store
  const warehouseTabs = [
    { id: 'overview', label: 'Overview', icon: BarChart3, path: '/store/dashboard' },
    { id: 'deliveries', label: 'Delivery Management', icon: Truck, path: '/store/deliveries' },
    { id: 'orders', label: 'Pending SOs', icon: ShoppingCart, path: '/store/orders' },
    { id: 'payments', label: 'Payments', icon: CreditCard, path: '/store/payments' },
    { id: 'inventory', label: 'Stock Management', icon: Package, path: '/store/inventory' },
    { id: 'transfers', label: 'Stock Transfers', icon: ArrowRightLeft, path: '/store/transfers' },
    { id: 'material-transfer', label: 'Material Transfer DC', icon: FileText, path: '/store/material-transfer' },
    { id: 'grn', label: 'Goods Receipt', icon: Package, path: '/store/grn' },
    { id: 'purchase-bills', label: 'Purchase Bills', icon: FileText, path: '/store/purchase-bills' },
    { id: 'purchase-orders', label: 'Purchase Orders', icon: FileText, path: '/store/purchase-orders' },
    { id: 'po-requests', label: 'PO Requests', icon: FileText, path: '/store/po-requests' }
  ];

  const storeTabs = [
    { id: 'overview', label: 'Overview', icon: BarChart3, path: '/store/dashboard' },
    { id: 'orders', label: 'Sales Orders', icon: ShoppingCart, path: '/store/orders' },
    { id: 'pending-sos', label: 'Pending SOs', icon: Clock, path: '/store/pending-sos' },
    { id: 'invoices', label: 'Sales Invoices', icon: Receipt, path: '/store/invoices' },
    { id: 'payments', label: 'Payments', icon: CreditCard, path: '/store/payments' },
    { id: 'quotations', label: 'Quotations', icon: FileText, path: '/store/quotations' },
    { id: 'customer-pos', label: 'Customer POs', icon: ClipboardList, path: '/store/customer-pos' },
    { id: 'inventory', label: 'Inventory', icon: Package, path: '/store/inventory' },
    { id: 'transfers', label: 'Stock Transfers', icon: ArrowRightLeft, path: '/store/transfers' },
    { id: 'material-transfer', label: 'Material Transfer DC', icon: Truck, path: '/store/material-transfer' },
    { id: 'po-requests', label: 'PO Requests', icon: FileText, path: '/store/po-requests' },
    { id: 'grn', label: 'Goods Receipt', icon: Package, path: '/store/grn' },
    { id: 'reports', label: 'Reports', icon: BarChart3, path: '/store/reports' },
    { id: 'customers', label: 'Customers', icon: Users, path: '/store/customers' }
  ];

  // Select tabs based on whether this is a warehouse or store
  const tabs = storeData?.is_warehouse ? warehouseTabs : storeTabs;

  // Download Invoice PDF function
  const handleDownloadInvoicePDF = async (invoice) => {
    try {
      const invoiceId = invoice.id || invoice._id;
      const response = await fetch(`${BACKEND_URL}/api/invoice-pdf/offline/${invoiceId}`);
      
      if (response.ok) {
        const blob = await response.blob();
        const url = window.URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = `${invoice.invoice_number || invoice.document_number || 'Invoice'}.pdf`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        window.URL.revokeObjectURL(url);
      } else {
        // Fallback to print if PDF generation fails
        alert('PDF download not available. Please use the Print option.');
      }
    } catch (error) {
      console.error('Error downloading PDF:', error);
      alert('Failed to download PDF. Please use the Print option.');
    }
  };

  if (!storeUser || !storeData) {
    return (
      <div className="min-h-screen bg-gray-50 flex items-center justify-center">
        <div className="text-center">
          <div className="animate-spin w-12 h-12 border-4 border-teal-500 border-t-transparent rounded-full mx-auto mb-4"></div>
          <p className="text-gray-600">Loading store dashboard...</p>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gray-50">
      {/* Header */}
      <header className="bg-gradient-to-r from-teal-700 to-emerald-700 text-white shadow-lg">
        <div className="max-w-7xl mx-auto px-4 py-4">
          <div className="flex items-center justify-between">
            <div className="flex items-center gap-4">
              <div className="p-2 bg-white/10 rounded-lg">
                {storeData?.is_warehouse ? (
                  <Truck className="w-6 h-6" />
                ) : (
                  <Store className="w-6 h-6" />
                )}
              </div>
              <div>
                <h1 className="text-xl font-bold">{storeData.name}</h1>
                <p className="text-teal-100 text-sm">
                  {storeData?.is_warehouse ? 'Warehouse' : 'Store'} Code: {storeData.code}
                </p>
              </div>
            </div>
            
            <div className="flex items-center gap-4">
              <NotificationBell 
                userRole={storeUser?.role || 'store_manager'}
                storeId={storeData?.id}
                userId={storeUser?.id}
              />
              
              <div className="text-right hidden sm:block">
                <p className="text-sm font-medium">{storeUser.first_name} {storeUser.last_name}</p>
                <p className="text-teal-200 text-xs">{storeUser.role?.replace('_', ' ')}</p>
              </div>
              <button
                onClick={() => navigate('/')}
                className="p-2 hover:bg-white/10 rounded-lg transition-colors"
                title="Go to Main Website"
              >
                <Home className="w-5 h-5" />
              </button>
              <button
                onClick={handleLogout}
                className="p-2 hover:bg-white/10 rounded-lg transition-colors"
                title="Logout"
                data-testid="store-logout-btn"
              >
                <LogOut className="w-5 h-5" />
              </button>
            </div>
          </div>

          {/* Tabs */}
          <div className="flex gap-1 mt-4 overflow-x-auto pb-1">
            {tabs.map((tab) => (
              <button
                key={tab.id}
                onClick={() => navigate(tab.path)}
                data-testid={`store-tab-${tab.id}`}
                className={`flex items-center gap-2 px-4 py-2 rounded-t-lg transition-colors whitespace-nowrap ${
                  activeTab === tab.id
                    ? 'bg-white text-teal-700 font-medium'
                    : 'text-teal-100 hover:bg-white/10'
                }`}
              >
                <tab.icon className="w-4 h-4" />
                {tab.label}
              </button>
            ))}
          </div>
        </div>
      </header>

      {/* Main Content */}
      <main className="max-w-7xl mx-auto px-4 py-6">
        {/* Back Button for non-overview tabs */}
        {activeTab !== 'overview' && (
          <button
            onClick={() => navigate('/store/dashboard')}
            className="mb-4 flex items-center gap-2 text-gray-600 hover:text-teal-600 transition-colors"
          >
            <ArrowLeft className="w-4 h-4" />
            Back to Dashboard
          </button>
        )}

        {/* Overview Tab */}
        {activeTab === 'overview' && (
          <div className="space-y-6">
            {/* Period Selector */}
            <div className="flex items-center justify-between">
              <h2 className="text-xl font-semibold text-gray-800">Dashboard Overview</h2>
              <select
                value={period}
                onChange={(e) => setPeriod(e.target.value)}
                className="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500"
              >
                <option value="today">Today</option>
                <option value="week">This Week</option>
                <option value="month">This Month</option>
                <option value="year">This Year</option>
              </select>
            </div>

            {/* Stats Grid - Different for Warehouse vs Store */}
            {storeData?.is_warehouse ? (
              /* Warehouse Stats */
              <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div className="bg-white rounded-xl shadow-sm p-6 border-l-4 border-amber-500">
                  <div className="flex items-center justify-between">
                    <div>
                      <p className="text-sm text-gray-500">Pending Orders</p>
                      <p className="text-2xl font-bold text-gray-800">
                        {pendingDeliveryOrders.length || 0}
                      </p>
                    </div>
                    <ShoppingCart className="w-10 h-10 text-amber-500/20" />
                  </div>
                  <p className="text-xs text-gray-400 mt-2">SOs awaiting processing</p>
                </div>

                <div className="bg-white rounded-xl shadow-sm p-6 border-l-4 border-blue-500">
                  <div className="flex items-center justify-between">
                    <div>
                      <p className="text-sm text-gray-500">Deliveries Pending</p>
                      <p className="text-2xl font-bold text-gray-800">
                        {deliveryChallans.filter(c => c.status === 'pending' || c.status === 'in_transit').length || 0}
                      </p>
                    </div>
                    <Truck className="w-10 h-10 text-blue-500/20" />
                  </div>
                  <p className="text-xs text-gray-400 mt-2">Out for delivery</p>
                </div>

                <div className="bg-white rounded-xl shadow-sm p-6 border-l-4 border-green-500">
                  <div className="flex items-center justify-between">
                    <div>
                      <p className="text-sm text-gray-500">Delivered Today</p>
                      <p className="text-2xl font-bold text-gray-800">
                        {deliveryChallans.filter(c => c.status === 'delivered').length || 0}
                      </p>
                    </div>
                    <Check className="w-10 h-10 text-green-500/20" />
                  </div>
                  <p className="text-xs text-gray-400 mt-2">Completed deliveries</p>
                </div>

                <div className="bg-white rounded-xl shadow-sm p-6 border-l-4 border-purple-500">
                  <div className="flex items-center justify-between">
                    <div>
                      <p className="text-sm text-gray-500">Stock Transfers</p>
                      <p className="text-2xl font-bold text-gray-800">
                        {transfers.filter(t => t.status === 'pending').length || 0}
                      </p>
                    </div>
                    <ArrowRightLeft className="w-10 h-10 text-purple-500/20" />
                  </div>
                  <p className="text-xs text-gray-400 mt-2">Pending transfers</p>
                </div>
              </div>
            ) : (
              /* Store Stats */
              <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div className="bg-white rounded-xl shadow-sm p-6 border-l-4 border-emerald-500">
                  <div className="flex items-center justify-between">
                    <div>
                      <p className="text-sm text-gray-500">Total Sales</p>
                      <p className="text-2xl font-bold text-gray-800">
                        {formatCurrency(dashboardData?.total_sales)}
                      </p>
                    </div>
                    <TrendingUp className="w-10 h-10 text-emerald-500/20" />
                  </div>
                  <p className="text-xs text-gray-400 mt-2">{dashboardData?.order_count || 0} orders</p>
                </div>

                <div className="bg-white rounded-xl shadow-sm p-6 border-l-4 border-blue-500">
                  <div className="flex items-center justify-between">
                    <div>
                      <p className="text-sm text-gray-500">Purchases</p>
                      <p className="text-2xl font-bold text-gray-800">
                        {formatCurrency(dashboardData?.total_purchases)}
                      </p>
                    </div>
                    <Receipt className="w-10 h-10 text-blue-500/20" />
                  </div>
                  <p className="text-xs text-gray-400 mt-2">{dashboardData?.purchase_count || 0} bills</p>
                </div>

                <div className="bg-white rounded-xl shadow-sm p-6 border-l-4 border-orange-500">
                  <div className="flex items-center justify-between">
                    <div>
                      <p className="text-sm text-gray-500">Pending Deliveries</p>
                      <p className="text-2xl font-bold text-gray-800">
                        {dashboardData?.pending_deliveries || 0}
                      </p>
                    </div>
                    <Truck className="w-10 h-10 text-orange-500/20" />
                  </div>
                  <p className="text-xs text-gray-400 mt-2">Awaiting dispatch</p>
                </div>

                <div className="bg-white rounded-xl shadow-sm p-6 border-l-4 border-red-500">
                  <div className="flex items-center justify-between">
                    <div>
                      <p className="text-sm text-gray-500">Low Stock Items</p>
                      <p className="text-2xl font-bold text-gray-800">
                        {dashboardData?.low_stock_items || 0}
                      </p>
                    </div>
                    <AlertTriangle className="w-10 h-10 text-red-500/20" />
                  </div>
                  <p className="text-xs text-gray-400 mt-2">Need restock</p>
                </div>
              </div>
            )}

            {/* Quick Actions - Different for Warehouse vs Store */}
            {storeData?.is_warehouse ? (
              /* Warehouse Quick Actions */
              <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
                <button
                  onClick={() => navigate('/store/deliveries')}
                  data-testid="quick-deliveries"
                  className="p-4 bg-gradient-to-r from-purple-500 to-purple-600 rounded-xl shadow-sm hover:shadow-md transition-shadow text-left text-white"
                >
                  <Truck className="w-8 h-8 mb-2" />
                  <p className="font-medium">Delivery Management</p>
                  <p className="text-sm text-purple-100">Manage deliveries</p>
                </button>
                
                <button
                  onClick={() => navigate('/store/orders')}
                  className="p-4 bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow text-left"
                >
                  <ShoppingCart className="w-8 h-8 text-teal-600 mb-2" />
                  <p className="font-medium text-gray-800">Pending SOs</p>
                  <p className="text-sm text-gray-500">View orders from stores</p>
                </button>
                
                <button
                  onClick={() => navigate('/store/inventory')}
                  className="p-4 bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow text-left"
                >
                  <Package className="w-8 h-8 text-blue-600 mb-2" />
                  <p className="font-medium text-gray-800">Inventory</p>
                  <p className="text-sm text-gray-500">Warehouse stock</p>
                </button>
                
                <button
                  onClick={() => navigate('/store/transfers')}
                  className="p-4 bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow text-left"
                >
                  <ArrowRightLeft className="w-8 h-8 text-orange-600 mb-2" />
                  <p className="font-medium text-gray-800">Stock Transfers</p>
                  <p className="text-sm text-gray-500">Transfer to stores</p>
                </button>
              </div>
            ) : (
              /* Store Quick Actions */
              <div className="grid grid-cols-2 md:grid-cols-5 gap-4">
                <button
                  onClick={() => navigate('/store/create-order')}
                  data-testid="quick-create-order"
                  className="p-4 bg-gradient-to-r from-teal-500 to-teal-600 rounded-xl shadow-sm hover:shadow-md transition-shadow text-left text-white"
                >
                  <Plus className="w-8 h-8 mb-2" />
                  <p className="font-medium">Create Order</p>
                  <p className="text-sm text-teal-100">New sales order</p>
                </button>
              
                <button
                  onClick={() => navigate('/store/orders')}
                  className="p-4 bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow text-left"
                >
                  <ShoppingCart className="w-8 h-8 text-teal-600 mb-2" />
                  <p className="font-medium text-gray-800">View Orders</p>
                  <p className="text-sm text-gray-500">Manage sales orders</p>
                </button>
              
                <button
                  onClick={() => navigate('/store/inventory')}
                  className="p-4 bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow text-left"
                >
                  <Package className="w-8 h-8 text-blue-600 mb-2" />
                  <p className="font-medium text-gray-800">Stock Check</p>
                  <p className="text-sm text-gray-500">View inventory</p>
                </button>
              
                <button
                  onClick={() => navigate('/store/transfers')}
                  className="p-4 bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow text-left"
                >
                  <ArrowRightLeft className="w-8 h-8 text-purple-600 mb-2" />
                  <p className="font-medium text-gray-800">Stock Transfer</p>
                  <p className="text-sm text-gray-500">Request/receive stock</p>
                </button>
              
                <button
                  onClick={() => navigate('/store/reports')}
                  className="p-4 bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow text-left"
                >
                  <BarChart3 className="w-8 h-8 text-emerald-600 mb-2" />
                  <p className="font-medium text-gray-800">Reports</p>
                  <p className="text-sm text-gray-500">Sales & analytics</p>
                </button>
              </div>
            )}
          </div>
        )}

        {/* Orders Tab */}
        {(activeTab === 'orders' || activeTab === 'pending-sos') && (
          <div className="space-y-6">
            {/* Shared filter bar for both Pending + SO-to-Invoice sections */}
            {(activeTab === 'pending-sos' || (activeTab === 'orders' && storeData?.is_warehouse)) && (
              <div className="bg-white rounded-xl shadow-sm p-4 flex flex-wrap items-center gap-3">
                <div className="flex items-center gap-2 min-w-[220px]">
                  <Store className="w-4 h-4 text-gray-400" />
                  <select
                    value={whStoreFilter}
                    onChange={(e) => setWhStoreFilter(e.target.value)}
                    className="flex-1 px-3 py-2 text-sm border rounded-lg focus:ring-2 focus:ring-amber-500 bg-white"
                    data-testid="wh-store-filter"
                  >
                    <option value="all">All Stores ({warehouseStoreOptions.length})</option>
                    {warehouseStoreOptions.map((code) => (
                      <option key={code} value={code}>{code}</option>
                    ))}
                  </select>
                </div>
                <div className="relative flex-1 min-w-[220px]">
                  <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" />
                  <input
                    type="text"
                    placeholder="Search by SO #, customer name or phone..."
                    value={whSearch}
                    onChange={(e) => setWhSearch(e.target.value)}
                    className="w-full pl-9 pr-3 py-2 text-sm border rounded-lg focus:ring-2 focus:ring-amber-500"
                    data-testid="wh-search-input"
                  />
                </div>
                {(whSearch || whStoreFilter !== 'all') && (
                  <button
                    onClick={() => { setWhSearch(''); setWhStoreFilter('all'); }}
                    className="px-3 py-2 text-sm bg-gray-100 hover:bg-gray-200 rounded-lg text-gray-700"
                    data-testid="wh-clear-filter-btn"
                  >
                    Clear Filters
                  </button>
                )}
                <button
                  onClick={() => { fetchPendingSOs(); fetchImmediateSOs(); }}
                  className="ml-auto p-2 text-gray-500 hover:bg-gray-100 rounded-lg"
                  title="Refresh both lists"
                  data-testid="wh-refresh-btn"
                >
                  <RefreshCw className="w-5 h-5" />
                </button>
              </div>
            )}

            {/* Pending SOs - shown for both Warehouse (all stores) and Store (own store only) */}
            {(activeTab === 'pending-sos' || (activeTab === 'orders' && storeData?.is_warehouse)) && (
              <div className="bg-white rounded-xl shadow-sm">
                <div className="p-4 border-b bg-amber-50">
                  <div className="flex items-center justify-between flex-wrap gap-2">
                    <div>
                      <h2 className="text-lg font-semibold text-amber-800">Pending Sales Orders</h2>
                      <p className="text-sm text-amber-600">
                        SOs scheduled for <strong>future delivery</strong> — waiting until the expected delivery date arrives
                      </p>
                    </div>
                    <p className="text-xs text-amber-700 font-medium" data-testid="pending-sos-count">
                      Showing {filteredPendingSOs.length} of {pendingSOs.length}
                    </p>
                  </div>
                </div>
                
                <div className="overflow-x-auto">
                  <table className="w-full">
                    <thead className="bg-gray-50">
                      <tr>
                        <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">SO #</th>
                        <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Customer</th>
                        <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Store</th>
                        <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Amount</th>
                        <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Expected</th>
                        <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                        <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-gray-200">
                      {filteredPendingSOs.map((so) => (
                        <tr key={so.id} className="hover:bg-gray-50">
                          <td className="px-4 py-3 text-sm font-medium text-amber-600">{so.invoice_number}</td>
                          <td className="px-4 py-3 text-sm">
                            <div>{so.customer?.name}</div>
                            <div className="text-xs text-gray-500">{so.customer?.phone}</div>
                          </td>
                          <td className="px-4 py-3 text-sm">{so.store_code}</td>
                          <td className="px-4 py-3 text-sm font-medium">{formatCurrency(so.total_amount)}</td>
                          <td className="px-4 py-3 text-sm">{so.expected_delivery_date || '-'}</td>
                          <td className="px-4 py-3">
                            <span className="px-2 py-1 text-xs font-medium rounded-full bg-amber-100 text-amber-700">
                              Scheduled
                            </span>
                          </td>
                          <td className="px-4 py-3">
                            <div className="flex items-center gap-2">
                              <button
                                onClick={() => { setSelectedOrder(so); setShowViewOrder(true); }}
                                className="flex items-center gap-1 text-xs text-blue-600 hover:text-blue-800"
                                data-testid={`view-pending-${so.id}`}
                                title="View order details"
                              >
                                <Eye className="w-3.5 h-3.5" /> View
                              </button>
                              <button
                                onClick={async () => {
                                  if (!window.confirm(
                                    `Move ${so.invoice_number} to "Ready for Conversion"?\n\n` +
                                    `This marks the order as immediate delivery — it will move to the SO to Invoice section ` +
                                    `where you can convert it to an invoice and dispatch it.`
                                  )) return;
                                  try {
                                    const res = await fetch(`${BACKEND_URL}/api/invoices/offline/${so.id}`, {
                                      method: 'PUT',
                                      headers: {
                                        'Content-Type': 'application/json',
                                        'Authorization': `Bearer ${localStorage.getItem('storeToken')}`
                                      },
                                      body: JSON.stringify({ immediate_delivery: true, edited_by: storeData?.name || 'store_manager' })
                                    });
                                    const data = await res.json();
                                    if (data.status === 'success') {
                                      fetchPendingSOs();
                                      fetchImmediateSOs();
                                    } else {
                                      alert('Failed: ' + (data.detail || 'Unknown error'));
                                    }
                                  } catch (e) {
                                    alert('Error: ' + e.message);
                                  }
                                }}
                                className="flex items-center gap-1 text-xs text-purple-600 hover:text-purple-800 font-medium"
                                data-testid={`ready-${so.id}`}
                                title="Move to SO to Invoice section for conversion"
                              >
                                <Check className="w-3.5 h-3.5" /> Mark Ready
                              </button>
                            </div>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>

                  {filteredPendingSOs.length === 0 && (
                    <div className="p-8 text-center text-gray-500">
                      {pendingSOs.length === 0 ? 'No pending scheduled SOs' : 'No SOs match the current filters'}
                    </div>
                  )}
                </div>
              </div>
            )}

            {/* SO to Invoice Conversion */}
            {(activeTab === 'pending-sos' || (activeTab === 'orders' && storeData?.is_warehouse)) && (
              <div className="bg-white rounded-xl shadow-sm">
                <div className="p-4 border-b bg-purple-50">
                  <div className="flex items-center justify-between flex-wrap gap-2">
                    <div>
                      <h2 className="text-lg font-semibold text-purple-800">SO to Invoice Conversion</h2>
                      <p className="text-sm text-purple-600">Sales Orders marked for <strong>immediate delivery</strong> - ready for invoice conversion</p>
                    </div>
                    <p className="text-xs text-purple-700 font-medium" data-testid="immediate-sos-count">
                      Showing {filteredImmediateSOs.length} of {immediateSOs.length}
                    </p>
                  </div>
                </div>

                <div className="overflow-x-auto">
                  <table className="w-full">
                    <thead className="bg-gray-50">
                      <tr>
                        <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">SO #</th>
                        <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Customer</th>
                        <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Store</th>
                        <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Amount</th>
                        <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Expected</th>
                        <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-gray-200">
                      {filteredImmediateSOs.map((so) => (
                        <tr key={so.id} className="hover:bg-gray-50">
                          <td className="px-4 py-3 text-sm font-medium text-purple-600">{so.invoice_number}</td>
                          <td className="px-4 py-3 text-sm">
                            <div>{so.customer?.name}</div>
                            <div className="text-xs text-gray-500">{so.customer?.phone}</div>
                          </td>
                          <td className="px-4 py-3 text-sm">{so.store_code}</td>
                          <td className="px-4 py-3 text-sm font-medium">{formatCurrency(so.total_amount)}</td>
                          <td className="px-4 py-3 text-sm">{so.expected_delivery_date || '-'}</td>
                          <td className="px-4 py-3">
                            <button
                              onClick={() => {
                                const allSelected = {};
                                so.items?.forEach(item => {
                                  allSelected[item.product_id] = { selected: true, quantity: item.quantity };
                                });
                                setSelectedItemsForConversion(allSelected);
                                setSelectedSOForConversion(so);
                              }}
                              className="px-3 py-1 bg-purple-600 text-white rounded text-xs hover:bg-purple-700"
                            >
                              Convert to Invoice
                            </button>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>

                  {filteredImmediateSOs.length === 0 && (
                    <div className="p-8 text-center text-gray-500">
                      {immediateSOs.length === 0 ? 'No immediate delivery SOs pending conversion' : 'No SOs match the current filters'}
                    </div>
                  )}
                </div>
              </div>
            )}

            {/* Converted Invoices */}
            {(activeTab === 'pending-sos' || (activeTab === 'orders' && storeData?.is_warehouse)) && (
              <div className="bg-white rounded-xl shadow-sm">
                <div className="p-4 border-b flex items-center justify-between">
                  <h2 className="text-lg font-semibold text-gray-800">Converted Invoices</h2>
                  <button
                    onClick={() => { fetchConvertedInvoices(); fetchImmediateSOs(); }}
                    className="p-2 text-gray-500 hover:bg-gray-100 rounded-lg"
                    title="Refresh"
                  >
                    <RefreshCw className="w-5 h-5" />
                  </button>
                </div>

                <div className="overflow-x-auto">
                  <table className="w-full">
                    <thead className="bg-gray-50">
                      <tr>
                        <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Invoice #</th>
                        <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Orig. SO</th>
                        <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Customer</th>
                        <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Store</th>
                        <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                        <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Amount</th>
                        <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                        <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-gray-200">
                      {convertedInvoices.length > 0 ? (
                        convertedInvoices.map((inv) => (
                          <tr key={inv.id} className="hover:bg-gray-50">
                            <td className="px-4 py-3 text-sm font-medium text-green-600">
                              {inv.invoice_number}
                            </td>
                            <td className="px-4 py-3 text-sm text-purple-600">
                              {inv.original_so_number || '-'}
                            </td>
                            <td className="px-4 py-3 text-sm text-gray-800">
                              <div>{inv.customer?.name || 'N/A'}</div>
                              <div className="text-xs text-gray-500">{inv.customer?.phone}</div>
                            </td>
                            <td className="px-4 py-3 text-sm">{inv.store_code}</td>
                            <td className="px-4 py-3 text-sm text-gray-500">
                              {formatDate(inv.converted_to_invoice_at || inv.created_at)}
                            </td>
                            <td className="px-4 py-3 text-sm font-medium text-gray-800">
                              {formatCurrency(inv.total_amount)}
                            </td>
                            <td className="px-4 py-3">
                              <span className={`px-2 py-1 text-xs font-medium rounded-full ${
                                inv.status === 'completed' ? 'bg-green-100 text-green-700' :
                                inv.status === 'pending_delivery' ? 'bg-amber-100 text-amber-700' :
                                'bg-gray-100 text-gray-700'
                              }`}>
                                {inv.status?.replace('_', ' ') || 'Completed'}
                              </span>
                            </td>
                            <td className="px-4 py-3">
                              <div className="flex items-center gap-2">
                                <button
                                  onClick={() => setSelectedInvoiceForPreview(inv)}
                                  className="text-blue-600 hover:text-blue-800 text-sm flex items-center gap-1"
                                  title="Preview"
                                >
                                  <Eye className="w-4 h-4" />
                                </button>
                                <button
                                  onClick={() => setSelectedInvoiceForPreview(inv)}
                                  className="text-teal-600 hover:text-teal-800 text-sm flex items-center gap-1"
                                  title="Print"
                                >
                                  <Printer className="w-4 h-4" />
                                </button>
                                {inv.status !== 'delivered' && inv.status !== 'out_for_delivery' && !inv.assigned_delivery_person && (
                                  <button
                                    onClick={() => {
                                      setSelectedInvoiceForDelivery(inv);
                                      setShowAssignDeliveryModal(true);
                                    }}
                                    className="px-2 py-1 bg-purple-600 text-white text-xs rounded hover:bg-purple-700 flex items-center gap-1"
                                    title="Assign Delivery Person"
                                  >
                                    <Truck className="w-3 h-3" />
                                    Assign
                                  </button>
                                )}
                                {(inv.status === 'out_for_delivery' || inv.assigned_delivery_person) && (
                                  <span className="px-2 py-1 bg-blue-100 text-blue-700 text-xs rounded flex items-center gap-1">
                                    <Truck className="w-3 h-3" />
                                    Assigned
                                  </span>
                                )}
                              </div>
                            </td>
                          </tr>
                        ))
                      ) : (
                        <tr>
                          <td colSpan="8" className="px-4 py-8 text-center text-gray-500">
                            <Receipt className="w-12 h-12 mx-auto mb-2 text-gray-300" />
                            <p>No converted invoices yet</p>
                            <p className="text-sm">Invoices will appear here after you convert SOs above</p>
                          </td>
                        </tr>
                      )}
                    </tbody>
                  </table>
                </div>
              </div>
            )}

            {/* Regular Orders List - Sales Orders tab only */}
            {activeTab === 'orders' && (
            <div className="bg-white rounded-xl shadow-sm">
              <div className="p-4 border-b">
                <div className="flex items-center justify-between flex-wrap gap-2 mb-3">
                  <div>
                    <h2 className="text-lg font-semibold text-gray-800">
                      {storeData?.is_warehouse ? 'All Orders' : 'All Sales Orders'}
                    </h2>
                    <p className="text-xs text-gray-500 mt-0.5" data-testid="orders-count-info">
                      Showing {orders.length} of {ordersTotalCount} order{ordersTotalCount !== 1 ? 's' : ''}
                      {ordersFY && ordersFY !== 'all' && <span className="ml-1">· FY {ordersFY}</span>}
                    </p>
                  </div>
                  <div className="flex items-center gap-2">
                    {!storeData?.is_warehouse && (
                      <button
                        onClick={() => navigate('/store/create-order')}
                        className="flex items-center gap-2 px-4 py-2 bg-teal-600 text-white rounded-lg hover:bg-teal-700 transition-colors text-sm"
                        data-testid="create-order-btn"
                      >
                        <Plus className="w-4 h-4" />
                        Create Order
                      </button>
                    )}
                    <button
                      onClick={() => {
                        const params = new URLSearchParams({
                          store_code: storeData.code,
                          document_type: 'sales_order',
                          ...(ordersFY && { fy: ordersFY }),
                          ...(ordersSearch && ordersSearch.trim() && { search: ordersSearch.trim() }),
                        });
                        window.open(`${BACKEND_URL}/api/invoices/offline/export/csv?${params}`, '_blank');
                      }}
                      className="flex items-center gap-2 px-3 py-2 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 transition-colors text-sm"
                      data-testid="export-csv-btn"
                      title="Download all matching orders as CSV"
                    >
                      <Download className="w-4 h-4" />
                      Export CSV
                    </button>
                  </div>
                </div>
                {/* FY + Search filters */}
                <div className="flex flex-wrap gap-2 items-center">
                  <select
                    value={ordersFY}
                    onChange={(e) => {
                      const newFY = e.target.value;
                      setOrdersFY(newFY);
                      fetchOrders({ append: false, page: 1, fy: newFY, search: ordersSearch });
                    }}
                    className="px-3 py-2 text-sm border rounded-lg focus:ring-2 focus:ring-teal-500 bg-white"
                    data-testid="orders-fy-filter"
                  >
                    <option value={currentFY}>FY {currentFY} (Current)</option>
                    {(() => {
                      const opts = [];
                      const curStart = 2000 + parseInt(currentFY.split('-')[0], 10);
                      for (let y = curStart - 1; y >= curStart - 5; y--) {
                        const fyStr = `${String(y).slice(2)}-${String(y + 1).slice(2)}`;
                        opts.push(<option key={fyStr} value={fyStr}>FY {fyStr}</option>);
                      }
                      return opts;
                    })()}
                    <option value="all">All Time</option>
                  </select>
                  <div className="relative flex-1 min-w-[200px] max-w-[400px]">
                    <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" />
                    <input
                      type="text"
                      placeholder="Search SO number, customer name or phone..."
                      value={ordersSearch}
                      onChange={(e) => setOrdersSearch(e.target.value)}
                      onKeyDown={(e) => {
                        if (e.key === 'Enter') {
                          fetchOrders({ append: false, page: 1, fy: ordersFY, search: ordersSearch });
                        }
                      }}
                      className="w-full pl-9 pr-3 py-2 text-sm border rounded-lg focus:ring-2 focus:ring-teal-500"
                      data-testid="orders-search-input"
                    />
                  </div>
                  <button
                    onClick={() => fetchOrders({ append: false, page: 1, fy: ordersFY, search: ordersSearch })}
                    disabled={ordersLoading}
                    className="px-3 py-2 text-sm bg-teal-600 hover:bg-teal-700 disabled:opacity-60 text-white rounded-lg"
                    data-testid="orders-apply-filter-btn"
                  >
                    {ordersLoading ? 'Loading...' : 'Apply'}
                  </button>
                  {(ordersSearch || ordersFY !== currentFY) && (
                    <button
                      onClick={() => {
                        setOrdersSearch('');
                        setOrdersFY(currentFY);
                        fetchOrders({ append: false, page: 1, fy: currentFY, search: '' });
                      }}
                      className="px-3 py-2 text-sm bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg"
                      data-testid="orders-reset-filter-btn"
                    >
                      Reset
                    </button>
                  )}
                </div>
              </div>
              
              <div className="overflow-x-auto">
                <table className="w-full">
                  <thead className="bg-gray-50">
                    <tr>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Order #</th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Customer</th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Amount</th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Source</th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-gray-200">
                    {orders.map((order) => (
                      <tr key={order.id} className="hover:bg-gray-50">
                        <td className="px-4 py-3 text-sm font-medium text-teal-600">
                          {order.order_number || order.id?.slice(0, 8)}
                        </td>
                        <td className="px-4 py-3 text-sm text-gray-800">
                          <div>{order.customer_name || 'N/A'}</div>
                          <div className="text-xs text-gray-500">{order.customer_phone}</div>
                        </td>
                        <td className="px-4 py-3 text-sm text-gray-500">
                          {formatDate(order.created_at)}
                        </td>
                        <td className="px-4 py-3 text-sm font-medium text-gray-800">
                          {formatCurrency(order.total_amount)}
                        </td>
                        <td className="px-4 py-3 text-sm">
                          <span className="px-2 py-1 text-xs bg-purple-100 text-purple-700 rounded">
                            {order.order_source?.replace('_', ' ') || '-'}
                          </span>
                        </td>
                        <td className="px-4 py-3">
                          <span className={`px-2 py-1 text-xs font-medium rounded-full ${
                            order.order_status === 'delivered' || order.order_status === 'completed' ? 'bg-green-100 text-green-700' :
                            order.order_status === 'shipped' ? 'bg-blue-100 text-blue-700' :
                            order.order_status === 'processing' || order.order_status === 'pending_delivery' ? 'bg-yellow-100 text-yellow-700' :
                            'bg-gray-100 text-gray-700'
                          }`}>
                            {order.order_status?.replace('_', ' ') || 'pending'}
                          </span>
                        </td>
                        <td className="px-4 py-3">
                          <div className="flex items-center gap-2">
                            <button
                              onClick={() => {
                                setSelectedOrder(order);
                                setShowViewOrder(true);
                              }}
                              className="flex items-center gap-1 text-sm text-teal-600 hover:text-teal-800"
                            >
                              <Eye className="w-4 h-4" />
                              View
                            </button>
                            {order.order_status !== 'delivered' && order.order_status !== 'completed' && (
                              <button
                                onClick={() => {
                                  // Navigate to edit SO - use invoice creation with prefilled data
                                  navigate(`/store/edit-order/${order.id}`);
                                }}
                                className="flex items-center gap-1 text-sm text-amber-600 hover:text-amber-800"
                              >
                                <Edit2 className="w-4 h-4" />
                                Edit
                              </button>
                            )}
                          </div>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                
                {orders.length === 0 && (
                  <div className="p-8 text-center text-gray-500">
                    No orders found for this store
                  </div>
                )}
                {/* Load More button — appears when there might be more records */}
                {ordersHasMore && (
                  <div className="p-4 border-t flex justify-center">
                    <button
                      onClick={() => fetchOrders({ append: true, page: ordersPage + 1, fy: ordersFY, search: ordersSearch })}
                      disabled={ordersLoading}
                      className="px-6 py-2 bg-teal-600 hover:bg-teal-700 disabled:opacity-60 text-white rounded-lg text-sm font-medium"
                      data-testid="orders-load-more-btn"
                    >
                      {ordersLoading ? 'Loading…' : `Load More (${ordersTotalCount - orders.length} remaining)`}
                    </button>
                  </div>
                )}
              </div>
            </div>
            )}
          </div>
        )}

        {/* Invoices Tab */}
        {activeTab === 'all-invoices' && (
          <div className="space-y-6">
            <div className="bg-white rounded-xl shadow-sm">
              <div className="p-4 border-b bg-teal-50">
                <div className="flex items-center justify-between flex-wrap gap-2">
                  <div>
                    <h2 className="text-lg font-semibold text-teal-800">All Invoices (All Stores)</h2>
                    <p className="text-sm text-teal-600">Every invoice created across every store — small or large</p>
                  </div>
                  <div className="flex items-center gap-3">
                    <p className="text-xs text-teal-700 font-medium" data-testid="all-invoices-count">
                      Showing {applyWarehouseFilters(allStoreInvoices).length} of {allStoreInvoices.length}
                    </p>
                    <button
                      onClick={fetchAllStoreInvoices}
                      className="p-2 text-teal-600 hover:bg-teal-100 rounded-lg"
                      title="Refresh"
                      data-testid="all-invoices-refresh-btn"
                    >
                      <RefreshCw className="w-4 h-4" />
                    </button>
                  </div>
                </div>
              </div>

              <div className="p-4 border-b flex flex-wrap items-center gap-3">
                <div className="flex items-center gap-2 min-w-[220px]">
                  <Store className="w-4 h-4 text-gray-400" />
                  <select
                    value={whStoreFilter}
                    onChange={(e) => setWhStoreFilter(e.target.value)}
                    className="flex-1 px-3 py-2 text-sm border rounded-lg focus:ring-2 focus:ring-teal-500 bg-white"
                  >
                    <option value="all">All Stores</option>
                    {warehouseStoreOptions.map((code) => (
                      <option key={code} value={code}>{code}</option>
                    ))}
                  </select>
                </div>
                <div className="relative flex-1 min-w-[220px]">
                  <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" />
                  <input
                    type="text"
                    placeholder="Search by Invoice #, customer name or phone..."
                    value={whSearch}
                    onChange={(e) => setWhSearch(e.target.value)}
                    className="w-full pl-9 pr-3 py-2 text-sm border rounded-lg focus:ring-2 focus:ring-teal-500"
                  />
                </div>
                {(whSearch || whStoreFilter !== 'all') && (
                  <button
                    onClick={() => { setWhSearch(''); setWhStoreFilter('all'); }}
                    className="px-3 py-2 text-sm bg-gray-100 hover:bg-gray-200 rounded-lg text-gray-700"
                  >
                    Clear Filters
                  </button>
                )}
              </div>

              <div className="overflow-x-auto">
                <table className="w-full">
                  <thead className="bg-gray-50">
                    <tr>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Invoice #</th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Customer</th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Store</th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Amount</th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-gray-200">
                    {applyWarehouseFilters(allStoreInvoices).map((inv) => (
                      <tr key={inv.id} className="hover:bg-gray-50">
                        <td className="px-4 py-3 text-sm font-medium text-teal-600">
                          {inv.invoice_number}
                        </td>
                        <td className="px-4 py-3 text-sm text-gray-800">
                          <div>{inv.customer?.name || 'N/A'}</div>
                          <div className="text-xs text-gray-500">{inv.customer?.phone}</div>
                        </td>
                        <td className="px-4 py-3 text-sm">{inv.store_code}</td>
                        <td className="px-4 py-3 text-sm text-gray-500">
                          {formatDate(inv.converted_to_invoice_at || inv.created_at)}
                        </td>
                        <td className="px-4 py-3 text-sm font-medium text-gray-800">
                          {formatCurrency(inv.total_amount)}
                        </td>
                        <td className="px-4 py-3">
                          <div className="flex items-center gap-2">
                            <button
                              onClick={() => setSelectedInvoiceForPreview(inv)}
                              className="text-blue-600 hover:text-blue-800 text-sm flex items-center gap-1"
                              title="View"
                              data-testid={`view-all-invoice-${inv.id}`}
                            >
                              <Eye className="w-4 h-4" />
                            </button>
                            <button
                              onClick={() => handleDownloadInvoicePDF(inv)}
                              className="text-gray-600 hover:text-gray-800 text-sm flex items-center gap-1"
                              title="Download PDF"
                            >
                              <Download className="w-4 h-4" />
                            </button>
                          </div>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>

                {allInvoicesLoading && (
                  <div className="p-8 text-center text-gray-500">Loading invoices...</div>
                )}
                {!allInvoicesLoading && allStoreInvoices.length === 0 && (
                  <div className="p-8 text-center text-gray-500">No invoices found</div>
                )}
                {!allInvoicesLoading && allStoreInvoices.length > 0 && applyWarehouseFilters(allStoreInvoices).length === 0 && (
                  <div className="p-8 text-center text-gray-500">No invoices match the current filters</div>
                )}
              </div>
            </div>
          </div>
        )}

        {activeTab === 'invoices' && (
          <div className="space-y-6">
            {storeData?.is_warehouse ? (
              <div className="bg-white rounded-xl shadow-sm p-8 text-center text-gray-500">
                <Receipt className="w-12 h-12 mx-auto mb-2 text-gray-300" />
                <p className="font-medium">SO to Invoice conversion has moved</p>
                <p className="text-sm">Manage sales orders and invoices together on the Pending SOs page.</p>
                <button
                  onClick={() => navigate('/store/orders')}
                  className="mt-4 px-4 py-2 bg-amber-600 text-white rounded-lg hover:bg-amber-700 text-sm"
                >
                  Go to Pending SOs
                </button>
              </div>
            ) : (
            <div className="bg-white rounded-xl shadow-sm">
              <div className="p-4 border-b flex items-center justify-between">
                <h2 className="text-lg font-semibold text-gray-800">Sales Invoices</h2>
                <div className="flex items-center gap-2">
                  <button
                    onClick={fetchConvertedInvoices}
                    className="p-2 text-gray-500 hover:bg-gray-100 rounded-lg"
                    title="Refresh"
                  >
                    <RefreshCw className="w-5 h-5" />
                  </button>
                  <button
                    onClick={() => setShowScanInvoiceModal(true)}
                    className="flex items-center gap-2 px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors"
                  >
                    <Sparkles className="w-4 h-4" />
                    Scan Invoice
                  </button>
                  <button
                    onClick={() => navigate('/store/create-order')}
                    className="flex items-center gap-2 px-4 py-2 bg-teal-600 text-white rounded-lg hover:bg-teal-700 transition-colors"
                  >
                    <Plus className="w-4 h-4" />
                    Create Invoice
                  </button>
                </div>
              </div>

              <div className="overflow-x-auto">
                <table className="w-full">
                  <thead className="bg-gray-50">
                    <tr>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Invoice #</th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Customer</th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Store</th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Amount</th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-gray-200">
                    {convertedInvoices.length > 0 ? (
                      convertedInvoices.map((inv) => (
                        <tr key={inv.id} className="hover:bg-gray-50">
                          <td className="px-4 py-3 text-sm font-medium text-teal-600">
                            <button
                              onClick={() => setSelectedInvoiceForPreview(inv)}
                              className="hover:underline"
                            >
                              {inv.invoice_number}
                            </button>
                          </td>
                          <td className="px-4 py-3 text-sm text-gray-800">
                            <div>{inv.customer?.name || 'N/A'}</div>
                            <div className="text-xs text-gray-500">{inv.customer?.phone}</div>
                          </td>
                          <td className="px-4 py-3 text-sm">{inv.store_code || storeData?.code}</td>
                          <td className="px-4 py-3 text-sm text-gray-500">
                            {formatDate(inv.created_at)}
                          </td>
                          <td className="px-4 py-3 text-sm font-medium text-gray-800">
                            {formatCurrency(inv.total_amount)}
                          </td>
                          <td className="px-4 py-3">
                            <span className={`px-2 py-1 text-xs font-medium rounded-full ${
                              inv.status === 'delivered' ? 'bg-green-100 text-green-700' :
                              inv.status === 'pending_delivery' ? 'bg-amber-100 text-amber-700' :
                              'bg-blue-100 text-blue-700'
                            }`}>
                              {inv.status?.replace('_', ' ') || 'Pending'}
                            </span>
                          </td>
                          <td className="px-4 py-3">
                            <div className="flex items-center gap-2">
                              <button
                                onClick={() => setSelectedInvoiceForPreview(inv)}
                                className="text-teal-600 hover:text-teal-800"
                                title="View"
                              >
                                <Eye className="w-4 h-4" />
                              </button>
                              {(() => {
                                const createdAt = inv.created_at ? new Date(inv.created_at) : null;
                                const toISTDateString = (d) => {
                                  const ist = new Date(d.getTime() + (5.5 * 60 * 60 * 1000));
                                  return ist.toISOString().slice(0, 10);
                                };
                                const editExpired = createdAt
                                  ? toISTDateString(new Date()) > toISTDateString(createdAt)
                                  : false;
                                return editExpired ? (
                                  <span
                                    className="text-gray-300 cursor-not-allowed"
                                    title="Edit window closed (24 hours after creation)"
                                  >
                                    <Edit2 className="w-4 h-4" />
                                  </span>
                                ) : (
                                  <button
                                    onClick={() => navigate(`/store/edit-invoice/${inv.id}`)}
                                    className="text-amber-600 hover:text-amber-800"
                                    title="Edit (available for 24 hours after creation)"
                                  >
                                    <Edit2 className="w-4 h-4" />
                                  </button>
                                );
                              })()}
                            </div>
                          </td>
                        </tr>
                      ))
                    ) : (
                      <tr>
                        <td colSpan="7" className="px-4 py-8 text-center text-gray-500">
                          <Receipt className="w-12 h-12 mx-auto mb-2 text-gray-300" />
                          <p>No invoices found</p>
                          <p className="text-sm">Invoices are generated when orders are delivered.</p>
                        </td>
                      </tr>
                    )}
                  </tbody>
                </table>
              </div>
            </div>
            )}
          </div>
        )}

      {/* Scan Invoice Modal (AI-powered, store-locked to this store) */}
      {showScanInvoiceModal && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
          <div className="bg-white rounded-xl w-full max-w-lg shadow-2xl">
            <div className="p-6 border-b flex items-center justify-between bg-gradient-to-r from-purple-600 to-indigo-600 text-white rounded-t-xl">
              <h2 className="text-xl font-semibold flex items-center gap-2">
                <Sparkles className="w-5 h-5" />
                AI Sales Invoice Scanner
              </h2>
              <button onClick={() => { setShowScanInvoiceModal(false); setScanInvoiceFile(null); }} className="text-white/80 hover:text-white">
                <X className="w-5 h-5" />
              </button>
            </div>

            <div className="p-6 space-y-4">
              <div className="bg-purple-50 rounded-lg p-4 text-sm text-purple-800">
                <p className="font-medium mb-2">How AI Scan Works:</p>
                <ol className="list-decimal list-inside space-y-1">
                  <li>Upload a PDF or photo of your Sales Invoice</li>
                  <li>AI will read and extract: invoice number, date, customer, items, amounts</li>
                  <li>Review and edit the extracted data</li>
                  <li>Save to create the invoice for {storeData?.name || 'your store'}</li>
                </ol>
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">
                  Upload Sales Invoice Document
                </label>
                <input
                  type="file"
                  ref={scanInvoiceFileInputRef}
                  accept=".pdf,.png,.jpg,.jpeg,.webp"
                  onChange={handleScanInvoiceFileSelect}
                  className="hidden"
                />
                <div
                  onClick={() => scanInvoiceFileInputRef.current?.click()}
                  className="border-2 border-dashed border-purple-300 rounded-lg p-6 text-center cursor-pointer hover:border-purple-500 hover:bg-purple-50 transition-colors"
                >
                  {scanInvoiceFile ? (
                    <div className="flex items-center justify-center gap-2 text-purple-700">
                      <Camera className="w-6 h-6" />
                      <span className="font-medium">{scanInvoiceFile.name}</span>
                      <button
                        onClick={(e) => { e.stopPropagation(); setScanInvoiceFile(null); }}
                        className="ml-2 text-red-500 hover:text-red-700"
                      >
                        <X className="w-4 h-4" />
                      </button>
                    </div>
                  ) : (
                    <>
                      <Camera className="w-10 h-10 mx-auto mb-2 text-purple-400" />
                      <p className="text-gray-600">Click to upload PDF or image of your invoice</p>
                      <p className="text-xs text-gray-400 mt-1">Supported: PDF, PNG, JPG, WEBP</p>
                    </>
                  )}
                </div>
              </div>
            </div>

            <div className="p-6 border-t flex justify-end gap-3">
              <button
                onClick={() => { setShowScanInvoiceModal(false); setScanInvoiceFile(null); }}
                className="px-4 py-2 border rounded-lg hover:bg-gray-50"
              >
                Cancel
              </button>
              <button
                onClick={handleScanInvoiceSubmit}
                disabled={scanningInvoice || !scanInvoiceFile}
                className="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 disabled:opacity-50 flex items-center gap-2"
              >
                {scanningInvoice ? (
                  <>
                    <RefreshCw className="w-4 h-4 animate-spin" />
                    Scanning with AI...
                  </>
                ) : (
                  <>
                    <Sparkles className="w-4 h-4" />
                    Scan Document
                  </>
                )}
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Review Scanned Invoice Data Modal */}
      {showScanInvoiceReviewModal && scannedInvoiceData && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4 overflow-y-auto">
          <div className="bg-white rounded-xl w-full max-w-3xl shadow-2xl my-8">
            <div className="p-6 border-b flex items-center justify-between bg-gradient-to-r from-green-600 to-emerald-600 text-white rounded-t-xl">
              <h2 className="text-xl font-semibold flex items-center gap-2">
                <Eye className="w-5 h-5" />
                Review Extracted Data (Sales Invoice)
              </h2>
              <button onClick={() => { setShowScanInvoiceReviewModal(false); setScannedInvoiceData(null); }} className="text-white/80 hover:text-white">
                <X className="w-5 h-5" />
              </button>
            </div>

            <div className="p-6 space-y-6 max-h-[70vh] overflow-y-auto">
              <div className="grid grid-cols-2 gap-4">
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">Invoice Number *</label>
                  <input
                    type="text"
                    value={scannedInvoiceData.so_number || ''}
                    onChange={(e) => updateScannedInvoiceField('so_number', e.target.value)}
                    className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-green-500"
                  />
                </div>
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">Invoice Date</label>
                  <input
                    type="date"
                    value={scannedInvoiceData.so_date || ''}
                    onChange={(e) => updateScannedInvoiceField('so_date', e.target.value)}
                    className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-green-500"
                  />
                </div>
                <div className="col-span-2">
                  <label className="block text-sm font-medium text-gray-700 mb-1">Store</label>
                  <input
                    type="text"
                    disabled
                    value={storeData?.name || storeData?.code || ''}
                    className="w-full px-3 py-2 border rounded-lg bg-gray-100 text-gray-600"
                  />
                </div>
              </div>

              <div>
                <h3 className="font-medium text-gray-800 mb-3">Customer Details</h3>
                <div className="grid grid-cols-2 gap-4">
                  <div>
                    <label className="block text-sm text-gray-600 mb-1">Name</label>
                    <input
                      type="text"
                      value={scannedInvoiceData.customer?.name || ''}
                      onChange={(e) => updateScannedInvoiceCustomer('name', e.target.value)}
                      className="w-full px-3 py-2 border rounded-lg text-sm"
                    />
                  </div>
                  <div>
                    <label className="block text-sm text-gray-600 mb-1">Phone</label>
                    <input
                      type="text"
                      value={scannedInvoiceData.customer?.phone || ''}
                      onChange={(e) => updateScannedInvoiceCustomer('phone', e.target.value)}
                      className="w-full px-3 py-2 border rounded-lg text-sm"
                    />
                  </div>
                  <div className="col-span-2">
                    <label className="block text-sm text-gray-600 mb-1">Address</label>
                    <input
                      type="text"
                      value={scannedInvoiceData.customer?.billing_address || ''}
                      onChange={(e) => updateScannedInvoiceCustomer('billing_address', e.target.value)}
                      className="w-full px-3 py-2 border rounded-lg text-sm"
                    />
                  </div>
                </div>
              </div>

              <div>
                <h3 className="font-medium text-gray-800 mb-3">Items ({scannedInvoiceData.items?.length || 0})</h3>
                <div className="space-y-3">
                  {scannedInvoiceData.items?.map((item, idx) => (
                    <div key={idx} className="bg-gray-50 rounded-lg p-3">
                      <div className="grid grid-cols-4 gap-2">
                        <div className="col-span-2">
                          <label className="block text-xs text-gray-500 mb-1">Product</label>
                          <input
                            type="text"
                            value={item.product_name || ''}
                            onChange={(e) => updateScannedInvoiceItem(idx, 'product_name', e.target.value)}
                            className="w-full px-2 py-1 border rounded text-sm"
                          />
                        </div>
                        <div>
                          <label className="block text-xs text-gray-500 mb-1">Qty</label>
                          <input
                            type="number"
                            value={item.quantity || 0}
                            onChange={(e) => updateScannedInvoiceItem(idx, 'quantity', parseInt(e.target.value) || 0)}
                            className="w-full px-2 py-1 border rounded text-sm"
                          />
                        </div>
                        <div>
                          <label className="block text-xs text-gray-500 mb-1">Unit Price</label>
                          <input
                            type="number"
                            value={item.unit_price || 0}
                            onChange={(e) => updateScannedInvoiceItem(idx, 'unit_price', parseFloat(e.target.value) || 0)}
                            className="w-full px-2 py-1 border rounded text-sm"
                          />
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              <div className="bg-green-50 rounded-lg p-4">
                <div className="grid grid-cols-3 gap-4 text-sm">
                  <div>
                    <span className="text-gray-600">Subtotal:</span>
                    <span className="ml-2 font-medium">₹{(scannedInvoiceData.subtotal || 0).toLocaleString('en-IN')}</span>
                  </div>
                  <div>
                    <span className="text-gray-600">Tax:</span>
                    <span className="ml-2 font-medium">₹{(scannedInvoiceData.total_tax || 0).toLocaleString('en-IN')}</span>
                  </div>
                  <div>
                    <span className="text-gray-600 font-medium">Grand Total:</span>
                    <span className="ml-2 font-bold text-green-700">₹{(scannedInvoiceData.grand_total || 0).toLocaleString('en-IN')}</span>
                  </div>
                </div>
              </div>
            </div>

            <div className="p-6 border-t flex justify-end gap-3">
              <button
                onClick={() => { setShowScanInvoiceReviewModal(false); setScannedInvoiceData(null); }}
                className="px-4 py-2 border rounded-lg hover:bg-gray-50"
              >
                Cancel
              </button>
              <button
                onClick={handleSaveScannedInvoice}
                disabled={savingScannedInvoice || !scannedInvoiceData.so_number}
                className="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 disabled:opacity-50 flex items-center gap-2"
              >
                {savingScannedInvoice ? (
                  <>
                    <RefreshCw className="w-4 h-4 animate-spin" />
                    Saving...
                  </>
                ) : (
                  <>
                    <Save className="w-4 h-4" />
                    Create Sales Invoice
                  </>
                )}
              </button>
            </div>
          </div>
        </div>
      )}


        {/* Inventory Tab */}
        {activeTab === 'inventory' && (
          <div className="bg-white rounded-xl shadow-sm">
            <div className="p-4 border-b flex items-center justify-between">
              <div>
                <h2 className="text-lg font-semibold text-gray-800">Store Inventory</h2>
                <p className="text-sm text-gray-500">
                  {inventory?.summary?.total_products || 0} products | {inventory?.summary?.total_stock || 0} units
                </p>
              </div>
              <div className="flex items-center gap-3">
                <span className="text-sm text-gray-500">
                  Stock Value: {formatCurrency(inventory?.summary?.total_stock_value)}
                </span>
                <button
                  onClick={() => setShowReceiveStock(true)}
                  className="flex items-center gap-2 px-4 py-2 bg-teal-600 text-white rounded-lg hover:bg-teal-700 transition-colors"
                >
                  <Plus className="w-4 h-4" />
                  Receive Stock
                </button>
              </div>
            </div>
            
            {/* Quick Stats */}
            <div className="grid grid-cols-4 gap-4 p-4 border-b bg-gray-50">
              <div className="text-center">
                <p className="text-2xl font-bold text-teal-600">{inventory?.summary?.total_products || 0}</p>
                <p className="text-xs text-gray-500">Total Products</p>
              </div>
              <div className="text-center">
                <p className="text-2xl font-bold text-blue-600">{inventory?.summary?.total_stock || 0}</p>
                <p className="text-xs text-gray-500">Total Units</p>
              </div>
              <div className="text-center">
                <p className="text-2xl font-bold text-orange-600">{inventory?.summary?.low_stock_count || 0}</p>
                <p className="text-xs text-gray-500">Low Stock Items</p>
              </div>
              <div className="text-center">
                <p className="text-2xl font-bold text-green-600">{formatCurrency(inventory?.summary?.total_stock_value || 0)}</p>
                <p className="text-xs text-gray-500">Stock Value</p>
              </div>
            </div>
            
            <div className="overflow-x-auto">
              <table className="w-full">
                <thead className="bg-gray-50">
                  <tr>
                    <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Product</th>
                    <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">SKU</th>
                    <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Category</th>
                    <th className="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Price</th>
                    <th className="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Store Qty</th>
                    <th className="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Value</th>
                    <th className="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Actions</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-gray-200">
                  {inventory?.products?.length > 0 ? (
                    inventory.products.slice(0, 50).map((item) => (
                      <tr key={item.product_id} className={`hover:bg-gray-50 ${item.is_low_stock ? 'bg-red-50' : ''}`}>
                        <td className="px-4 py-3 text-sm text-gray-800">
                          {item.product_name}
                          {item.is_low_stock && (
                            <span className="ml-2 text-xs text-red-600 font-medium">(Low Stock)</span>
                          )}
                        </td>
                        <td className="px-4 py-3 text-sm text-gray-500">{item.sku}</td>
                        <td className="px-4 py-3 text-sm text-gray-500">{item.category}</td>
                        <td className="px-4 py-3 text-sm text-right text-gray-800">
                          {formatCurrency(item.price)}
                        </td>
                        <td className={`px-4 py-3 text-sm text-right font-medium ${item.is_low_stock ? 'text-red-600' : 'text-gray-800'}`}>
                          {item.quantity}
                        </td>
                        <td className="px-4 py-3 text-sm text-right text-gray-800">
                          {formatCurrency(item.stock_value)}
                        </td>
                        <td className="px-4 py-3 text-center">
                          <button
                            onClick={() => {
                              setSelectedProduct(item);
                              setShowReceiveStock(true);
                            }}
                            className="text-xs text-teal-600 hover:text-teal-800 font-medium"
                          >
                            + Add Stock
                          </button>
                        </td>
                      </tr>
                    ))
                  ) : (
                    <tr>
                      <td colSpan="7" className="px-4 py-8 text-center text-gray-500">
                        <Package className="w-12 h-12 mx-auto mb-2 text-gray-300" />
                        <p>No inventory found for this store</p>
                        <p className="text-sm">Use "Receive Stock" to add products or request a Stock Transfer</p>
                      </td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </div>
        )}

        {/* Transfers Tab */}
        {activeTab === 'transfers' && (
          <div className="space-y-6">
            {/* Incoming Material Transfers Section (for non-warehouse stores) */}
            {!storeData?.is_warehouse && incomingTransfers.length > 0 && (
              <div className="bg-white rounded-xl shadow-sm border-l-4 border-orange-500">
                <div className="p-4 border-b flex items-center justify-between bg-orange-50">
                  <div className="flex items-center gap-2">
                    <Truck className="w-5 h-5 text-orange-600" />
                    <h2 className="text-lg font-semibold text-gray-800">Incoming Material Transfers</h2>
                    <span className="px-2 py-0.5 bg-orange-500 text-white text-xs font-bold rounded-full">
                      {incomingTransfers.length} Pending
                    </span>
                  </div>
                  <button
                    onClick={fetchIncomingTransfers}
                    className="p-2 text-gray-500 hover:bg-orange-100 rounded-lg"
                    title="Refresh"
                  >
                    <RefreshCw className="w-4 h-4" />
                  </button>
                </div>
                
                <div className="overflow-x-auto">
                  <table className="w-full">
                    <thead className="bg-gray-50">
                      <tr>
                        <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">DC Number</th>
                        <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">From</th>
                        <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Items</th>
                        <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                        <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">E-Way Bill</th>
                        <th className="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Actions</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-gray-200">
                      {incomingTransfers.map((transfer) => (
                        <tr key={transfer.id} className="hover:bg-orange-50">
                          <td className="px-4 py-3">
                            <span className="font-medium text-orange-700">{transfer.challan_number}</span>
                            <p className="text-xs text-gray-500">{transfer.transfer_type?.replace(/_/g, ' ')}</p>
                          </td>
                          <td className="px-4 py-3 text-sm text-gray-800">
                            {transfer.from_location?.name || transfer.from_location?.code}
                          </td>
                          <td className="px-4 py-3 text-sm text-gray-500">
                            {transfer.items?.length || 0} items
                            <span className="text-xs block text-gray-400">
                              {transfer.items?.reduce((sum, item) => sum + (item.quantity || 0), 0)} units
                            </span>
                          </td>
                          <td className="px-4 py-3 text-sm text-gray-500">
                            {formatDate(transfer.created_at)}
                          </td>
                          <td className="px-4 py-3 text-sm">
                            {transfer.e_way_bill?.number ? (
                              <span className="text-green-600 font-mono text-xs">{transfer.e_way_bill.number}</span>
                            ) : (
                              <span className="text-gray-400 text-xs">N/A</span>
                            )}
                          </td>
                          <td className="px-4 py-3 text-center">
                            <button
                              onClick={() => {
                                setSelectedTransferForReceive(transfer);
                                setShowReceiveTransferModal(true);
                              }}
                              className="px-4 py-1.5 bg-green-600 text-white text-sm font-medium rounded-lg hover:bg-green-700 transition-colors flex items-center gap-1 mx-auto"
                            >
                              <Check className="w-4 h-4" />
                              Receive
                            </button>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}
            
            <div className="bg-white rounded-xl shadow-sm">
              <div className="p-4 border-b flex items-center justify-between">
                <h2 className="text-lg font-semibold text-gray-800">Stock Transfer Requests</h2>
                <button
                  onClick={() => { fetchAllProducts(); setShowStockTransferModal(true); }}
                  className="flex items-center gap-2 px-4 py-2 bg-teal-600 text-white rounded-lg hover:bg-teal-700 transition-colors"
                >
                  <Plus className="w-4 h-4" />
                  Request Stock Transfer
                </button>
              </div>
              
              <div className="overflow-x-auto">
                <table className="w-full">
                  <thead className="bg-gray-50">
                    <tr>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Transfer #</th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">From</th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">To</th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Items</th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                      {storeData?.is_warehouse && (
                        <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
                      )}
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-gray-200">
                    {transfers.length > 0 ? (
                      transfers.map((transfer) => (
                        <tr key={transfer.id} className="hover:bg-gray-50">
                          <td className="px-4 py-3 text-sm font-medium text-teal-600">
                            {transfer.transfer_number}
                          </td>
                          <td className="px-4 py-3 text-sm text-gray-800">
                            {transfer.from_store_name}
                          </td>
                          <td className="px-4 py-3 text-sm text-gray-800">
                            {transfer.to_store_name}
                          </td>
                          <td className="px-4 py-3 text-sm text-gray-500">
                            {transfer.items?.length || 0} items
                          </td>
                          <td className="px-4 py-3 text-sm text-gray-500">
                            {formatDate(transfer.created_at)}
                          </td>
                          <td className="px-4 py-3">
                            <span className={`px-2 py-1 text-xs font-medium rounded-full ${
                              transfer.status === 'completed' ? 'bg-green-100 text-green-700' :
                              transfer.status === 'approved' ? 'bg-blue-100 text-blue-700' :
                              transfer.status === 'pending' ? 'bg-yellow-100 text-yellow-700' :
                              transfer.status === 'rejected' ? 'bg-red-100 text-red-700' :
                              transfer.status === 'in_transit' ? 'bg-purple-100 text-purple-700' :
                              'bg-gray-100 text-gray-700'
                            }`}>
                              {transfer.status}
                            </span>
                          </td>
                          {/* Actions column - only for warehouse */}
                          {storeData?.is_warehouse && (
                            <td className="px-4 py-3">
                              {transfer.status === 'pending' && (
                                <div className="flex items-center gap-2">
                                  <button
                                    onClick={() => handleApproveTransfer(transfer.id, 'approved')}
                                    disabled={approvingTransfer}
                                    className="px-2 py-1 bg-green-600 text-white text-xs rounded hover:bg-green-700 disabled:opacity-50"
                                  >
                                    Approve
                                  </button>
                                  <button
                                    onClick={() => handleApproveTransfer(transfer.id, 'rejected')}
                                    disabled={approvingTransfer}
                                    className="px-2 py-1 bg-red-600 text-white text-xs rounded hover:bg-red-700 disabled:opacity-50"
                                  >
                                    Reject
                                  </button>
                                </div>
                              )}
                              {transfer.status === 'approved' && (
                                <span className="text-xs text-green-600">Ready for Challan</span>
                              )}
                            </td>
                          )}
                        </tr>
                      ))
                    ) : (
                      <tr>
                        <td colSpan={storeData?.is_warehouse ? 7 : 6} className="px-4 py-8 text-center text-gray-500">
                          <ArrowRightLeft className="w-12 h-12 mx-auto mb-2 text-gray-300" />
                          <p>No stock transfers found</p>
                          <p className="text-sm">Click "Request Stock Transfer" to request stock from warehouse</p>
                        </td>
                      </tr>
                    )}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        )}

        {/* Purchase Orders Tab */}
        {activeTab === 'purchase-orders' && (
          <PurchaseManagement />
        )}

        {/* PO Requests Tab */}
        {activeTab === 'po-requests' && (
          <PORequestsTab storeData={storeData} formatCurrency={formatCurrency} />
        )}

        {/* GRN Tab - Goods Receipt Notes */}
        {activeTab === 'grn' && (
          <GoodsReceiptNote warehouseId={storeData?.id} />
        )}

        {/* Material Transfer DC Tab */}
        {activeTab === 'material-transfer' && (
          <MaterialTransferDC 
            storeCode={storeData?.code} 
            storeName={storeData?.name} 
            isWarehouse={storeData?.is_warehouse}
          />
        )}

        {/* Purchase Bills Tab */}
        {activeTab === 'purchase-bills' && (
          <PurchaseBillsTab storeData={storeData} formatCurrency={formatCurrency} />
        )}

        {/* Reports Tab */}
        {activeTab === 'reports' && (
          <div className="space-y-6">
            <div className="grid grid-cols-3 gap-4">
              <button
                onClick={() => fetchReportData('daily')}
                className="p-4 bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow text-left"
              >
                <Calendar className="w-8 h-8 text-blue-600 mb-2" />
                <p className="font-medium text-gray-800">Daily Report</p>
                <p className="text-sm text-gray-500">Today's sales breakdown</p>
              </button>
              
              <button
                onClick={() => fetchReportData('monthly')}
                className="p-4 bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow text-left"
              >
                <BarChart3 className="w-8 h-8 text-emerald-600 mb-2" />
                <p className="font-medium text-gray-800">Monthly Report</p>
                <p className="text-sm text-gray-500">This month's trend</p>
              </button>
              
              <button
                onClick={() => fetchReportData('item-wise')}
                className="p-4 bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow text-left"
              >
                <Package className="w-8 h-8 text-purple-600 mb-2" />
                <p className="font-medium text-gray-800">Item-wise Sales</p>
                <p className="text-sm text-gray-500">Product performance</p>
              </button>
            </div>

            {reportData && (
              <div className="bg-white rounded-xl shadow-sm p-6">
                <h3 className="text-lg font-semibold text-gray-800 mb-4">
                  {reportData.type === 'daily' && 'Daily Sales Report'}
                  {reportData.type === 'monthly' && 'Monthly Sales Report'}
                  {reportData.type === 'item-wise' && 'Item-wise Sales Report'}
                </h3>
                
                <div className="grid grid-cols-3 gap-4 mb-6">
                  <div className="p-4 bg-gray-50 rounded-lg">
                    <p className="text-sm text-gray-500">Total Revenue</p>
                    <p className="text-xl font-bold text-gray-800">
                      {formatCurrency(reportData.data.summary?.total_revenue || reportData.data.summary?.total_sales)}
                    </p>
                  </div>
                  <div className="p-4 bg-gray-50 rounded-lg">
                    <p className="text-sm text-gray-500">Total Orders</p>
                    <p className="text-xl font-bold text-gray-800">
                      {reportData.data.summary?.total_orders || 0}
                    </p>
                  </div>
                  <div className="p-4 bg-gray-50 rounded-lg">
                    <p className="text-sm text-gray-500">Avg Order Value</p>
                    <p className="text-xl font-bold text-gray-800">
                      {formatCurrency(reportData.data.summary?.average_order_value || reportData.data.summary?.avg_order_value)}
                    </p>
                  </div>
                </div>

                {reportData.type === 'item-wise' && reportData.data.items && (
                  <table className="w-full">
                    <thead className="bg-gray-50">
                      <tr>
                        <th className="px-4 py-2 text-left text-xs font-medium text-gray-500">Product</th>
                        <th className="px-4 py-2 text-right text-xs font-medium text-gray-500">Qty Sold</th>
                        <th className="px-4 py-2 text-right text-xs font-medium text-gray-500">Revenue</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y">
                      {reportData.data.items.slice(0, 10).map((item, idx) => (
                        <tr key={idx}>
                          <td className="px-4 py-2 text-sm">{item.product_name || item._id}</td>
                          <td className="px-4 py-2 text-sm text-right">{item.quantity_sold}</td>
                          <td className="px-4 py-2 text-sm text-right font-medium">
                            {formatCurrency(item.total_revenue)}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                )}
              </div>
            )}
          </div>
        )}

        {/* Payments Tab */}
        {activeTab === 'payments' && (
          <div className="space-y-6">
            <PendingPaymentsList storeCode={storeData?.code} />
          </div>
        )}

        {/* Customers Tab */}
        {activeTab === 'customers' && (
          <div className="bg-white rounded-xl shadow-sm">
            <div className="p-4 border-b flex items-center justify-between">
              <h2 className="text-lg font-semibold text-gray-800">Store Customers</h2>
              <div className="flex items-center gap-2">
                <button
                  onClick={fetchCustomers}
                  className="p-2 text-gray-500 hover:bg-gray-100 rounded-lg"
                >
                  <RefreshCw className="w-5 h-5" />
                </button>
                <button
                  onClick={() => setShowAddCustomer(true)}
                  className="flex items-center gap-2 px-4 py-2 bg-teal-600 text-white rounded-lg hover:bg-teal-700 transition-colors"
                >
                  <Plus className="w-4 h-4" />
                  Add Customer
                </button>
              </div>
            </div>
            
            <div className="overflow-x-auto">
              <table className="w-full">
                <thead className="bg-gray-50">
                  <tr>
                    <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
                    <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Phone</th>
                    <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Email</th>
                    <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">City</th>
                    <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Total Orders</th>
                    <th className="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Actions</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-gray-200">
                  {customers.length > 0 ? (
                    customers.map((customer) => (
                      <tr key={customer.id} className="hover:bg-gray-50">
                        <td className="px-4 py-3 text-sm font-medium text-gray-800">
                          {customer.name || `${customer.first_name || ''} ${customer.last_name || ''}`}
                        </td>
                        <td className="px-4 py-3 text-sm text-gray-500">{customer.phone || 'N/A'}</td>
                        <td className="px-4 py-3 text-sm text-gray-500">{customer.email || 'N/A'}</td>
                        <td className="px-4 py-3 text-sm text-gray-500">{customer.city || 'N/A'}</td>
                        <td className="px-4 py-3 text-sm text-gray-800">{customer.total_orders || 0}</td>
                        <td className="px-4 py-3 text-center">
                          <button
                            onClick={() => {
                              setSelectedCustomer(customer);
                              setShowEditCustomer(true);
                            }}
                            className="text-xs text-teal-600 hover:text-teal-800 font-medium"
                          >
                            Edit
                          </button>
                        </td>
                      </tr>
                    ))
                  ) : (
                    <tr>
                      <td colSpan="6" className="px-4 py-8 text-center text-gray-500">
                        <Users className="w-12 h-12 mx-auto mb-2 text-gray-300" />
                        <p>No customers found for this store</p>
                        <p className="text-sm">Click "Add Customer" to add a new customer</p>
                      </td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </div>
        )}

        {/* Quotations Tab - Full Implementation */}
        {activeTab === 'quotations' && (
          <QuotationManagement 
            storeId={storeData?.id} 
            storeName={storeData?.name} 
            isEmbedded={true} 
          />
        )}

        {/* Customer POs Tab */}
        {activeTab === 'customer-pos' && (
          <CustomerPOManagement />
        )}

        {/* Service Tab - Placeholder */}
        {activeTab === 'service' && (
          <div className="bg-white rounded-xl shadow-sm p-8 text-center">
            <Wrench className="w-16 h-16 text-gray-300 mx-auto mb-4" />
            <h3 className="text-lg font-medium text-gray-800 mb-2">Service Tickets</h3>
            <p className="text-gray-500">Manage customer service requests and track resolutions.</p>
          </div>
        )}

        {/* Deliveries Tab - Full Implementation */}
        {activeTab === 'deliveries' && (
          <div className="space-y-6">
            {/* Warehouse-only: Store filter for Delivery Management */}
            {storeData?.is_warehouse && (
              <div className="bg-white rounded-xl shadow-sm p-4 flex flex-wrap items-center gap-3">
                <div className="flex items-center gap-2 min-w-[220px]">
                  <Store className="w-4 h-4 text-gray-400" />
                  <select
                    value={deliveryStoreFilter}
                    onChange={(e) => setDeliveryStoreFilter(e.target.value)}
                    className="flex-1 px-3 py-2 text-sm border rounded-lg focus:ring-2 focus:ring-amber-500 bg-white"
                    data-testid="delivery-store-filter"
                  >
                    <option value="all">All Stores ({deliveryStoreOptions.length})</option>
                    {deliveryStoreOptions.map((code) => (
                      <option key={code} value={code}>{code}</option>
                    ))}
                  </select>
                </div>
                <div className="relative flex-1 min-w-[220px]">
                  <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" />
                  <input
                    type="text"
                    placeholder="Search by invoice #, customer name or phone..."
                    value={deliverySearch}
                    onChange={(e) => setDeliverySearch(e.target.value)}
                    className="w-full pl-9 pr-3 py-2 text-sm border rounded-lg focus:ring-2 focus:ring-amber-500"
                    data-testid="delivery-search"
                  />
                </div>
              </div>
            )}
            {/* Stats Cards */}
            <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
              <div className="bg-white rounded-xl shadow-sm p-4">
                <div className="flex items-center gap-3">
                  <div className="p-3 bg-amber-100 rounded-lg">
                    <Clock className="w-6 h-6 text-amber-600" />
                  </div>
                  <div>
                    <p className="text-sm text-gray-500">Pending Orders</p>
                    <p className="text-2xl font-bold text-gray-800">{filteredPendingDeliveryOrders.length}</p>
                  </div>
                </div>
              </div>
              <div className="bg-white rounded-xl shadow-sm p-4">
                <div className="flex items-center gap-3">
                  <div className="p-3 bg-blue-100 rounded-lg">
                    <Truck className="w-6 h-6 text-blue-600" />
                  </div>
                  <div>
                    <p className="text-sm text-gray-500">Active Challans</p>
                    <p className="text-2xl font-bold text-gray-800">
                      {deliveryChallans.filter(c => c.status === 'pending' || c.status === 'in_transit').length}
                    </p>
                  </div>
                </div>
              </div>
              <div className="bg-white rounded-xl shadow-sm p-4">
                <div className="flex items-center gap-3">
                  <div className="p-3 bg-green-100 rounded-lg">
                    <Check className="w-6 h-6 text-green-600" />
                  </div>
                  <div>
                    <p className="text-sm text-gray-500">Delivered</p>
                    <p className="text-2xl font-bold text-gray-800">
                      {deliveryChallans.filter(c => c.status === 'delivered').length}
                    </p>
                  </div>
                </div>
              </div>
              <div className="bg-white rounded-xl shadow-sm p-4">
                <div className="flex items-center justify-between">
                  <div className="flex items-center gap-3">
                    <div className="p-3 bg-purple-100 rounded-lg">
                      <Users className="w-6 h-6 text-purple-600" />
                    </div>
                    <div>
                      <p className="text-sm text-gray-500">Delivery Persons</p>
                      <p className="text-2xl font-bold text-gray-800">{deliveryPersons.length}</p>
                    </div>
                  </div>
                  <button
                    onClick={() => setShowAddDeliveryPersonModal(true)}
                    className="px-3 py-1.5 bg-purple-600 text-white text-sm rounded-lg hover:bg-purple-700 transition-colors flex items-center gap-1"
                    data-testid="add-delivery-person-btn"
                  >
                    <Plus className="w-4 h-4" />
                    Add
                  </button>
                </div>
              </div>
            </div>

            {/* Delivery Persons List - Collapsible Section */}
            {deliveryPersons.length > 0 && (
              <div className="bg-white rounded-xl shadow-sm overflow-hidden">
                <div className="p-4 border-b bg-purple-50 flex items-center justify-between">
                  <div className="flex items-center gap-2">
                    <Users className="w-5 h-5 text-purple-600" />
                    <h3 className="font-semibold text-gray-800">Delivery Personnel</h3>
                    <span className="px-2 py-0.5 bg-purple-200 text-purple-800 text-xs rounded-full">
                      {deliveryPersons.length}
                    </span>
                  </div>
                  <button
                    onClick={fetchDeliveryData}
                    className="p-2 hover:bg-purple-100 rounded-lg transition-colors"
                    title="Refresh Delivery Personnel"
                  >
                    <RefreshCw className={`w-4 h-4 text-purple-600 ${deliveryLoading ? 'animate-spin' : ''}`} />
                  </button>
                </div>
                <div className="p-4">
                  <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
                    {deliveryPersons.map((person) => (
                      <div key={person.id} className="border rounded-lg p-3 flex items-center gap-3 hover:bg-gray-50">
                        <div className="w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center">
                          <span className="text-purple-700 font-semibold">
                            {person.full_name?.charAt(0)?.toUpperCase() || 'D'}
                          </span>
                        </div>
                        <div className="flex-1 min-w-0">
                          <p className="font-medium text-gray-800 truncate">{person.full_name}</p>
                          <p className="text-xs text-gray-500 truncate">{person.phone}</p>
                          {person.vehicle_number && (
                            <p className="text-xs text-purple-600">{person.vehicle_number}</p>
                          )}
                        </div>
                        <span className={`px-2 py-0.5 text-xs rounded-full ${
                          person.is_active !== false ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-600'
                        }`}>
                          {person.is_active !== false ? 'Active' : 'Inactive'}
                        </span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            )}

            {/* Invoices Ready for Delivery - Need Delivery Person Assignment */}
            <div className="bg-white rounded-xl shadow-sm overflow-hidden">
              <div className="p-4 border-b bg-amber-50 flex items-center justify-between">
                <div className="flex items-center gap-2">
                  <Clock className="w-5 h-5 text-amber-600" />
                  <h3 className="font-semibold text-gray-800">Invoices Ready for Delivery</h3>
                  <span className="px-2 py-0.5 bg-amber-200 text-amber-800 text-xs rounded-full">
                    {filteredPendingDeliveryOrders.length}
                  </span>
                </div>
                <button
                  onClick={fetchDeliveryData}
                  className="p-2 hover:bg-amber-100 rounded-lg transition-colors"
                  title="Refresh"
                >
                  <RefreshCw className={`w-4 h-4 text-amber-600 ${deliveryLoading ? 'animate-spin' : ''}`} />
                </button>
              </div>
              {deliveryLoading ? (
                <div className="p-8 text-center">
                  <RefreshCw className="w-8 h-8 text-gray-400 animate-spin mx-auto mb-2" />
                  <p className="text-gray-500">Loading...</p>
                </div>
              ) : filteredPendingDeliveryOrders.length === 0 ? (
                <div className="p-8 text-center">
                  <Check className="w-12 h-12 text-green-300 mx-auto mb-2" />
                  <p className="text-gray-500">No invoices pending delivery assignment</p>
                </div>
              ) : (
                <div className="overflow-x-auto">
                  <table className="w-full text-sm">
                    <thead className="bg-gray-50">
                      <tr>
                        <th className="px-4 py-3 text-left">Invoice #</th>
                        <th className="px-4 py-3 text-left">Customer</th>
                        <th className="px-4 py-3 text-left">Address</th>
                        <th className="px-4 py-3 text-left">Store</th>
                        <th className="px-4 py-3 text-center">Payment</th>
                        <th className="px-4 py-3 text-right">Amount</th>
                        <th className="px-4 py-3 text-center">Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                      {filteredPendingDeliveryOrders.map((invoice) => (
                        <tr key={invoice.id} className="border-t hover:bg-gray-50">
                          <td className="px-4 py-3">
                            <span className="font-medium text-green-700">{invoice.invoice_number}</span>
                            <p className="text-xs text-gray-500">{invoice.items?.length || 0} items</p>
                          </td>
                          <td className="px-4 py-3">
                            <p className="font-medium">{invoice.customer?.name}</p>
                            <p className="text-xs text-gray-500">{invoice.customer?.phone}</p>
                          </td>
                          <td className="px-4 py-3">
                            <p className="text-gray-600 text-xs">
                              {invoice.customer?.shipping_address || invoice.customer?.billing_address || '-'}
                            </p>
                            <p className="text-xs text-gray-500">
                              {invoice.customer?.shipping_city || invoice.customer?.billing_city}, {invoice.customer?.shipping_pincode || invoice.customer?.billing_pincode}
                            </p>
                          </td>
                          <td className="px-4 py-3">
                            <span className="px-2 py-1 bg-blue-100 text-blue-700 text-xs rounded">
                              {invoice.store_code}
                            </span>
                          </td>
                          <td className="px-4 py-3 text-center">
                            <span className={`px-2 py-1 text-xs rounded ${
                              invoice.is_cod ? 'bg-orange-100 text-orange-700' : 'bg-green-100 text-green-700'
                            }`}>
                              {invoice.is_cod ? 'COD' : invoice.payment_mode?.toUpperCase() || 'PAID'}
                            </span>
                          </td>
                          <td className="px-4 py-3 text-right font-medium">
                            {formatCurrency(invoice.total_amount)}
                          </td>
                          <td className="px-4 py-3 text-center">
                            <button
                              onClick={() => {
                                setSelectedInvoiceForDelivery(invoice);
                                setShowAssignDeliveryModal(true);
                              }}
                              className="px-3 py-1.5 bg-teal-600 text-white text-xs rounded-lg hover:bg-teal-700 flex items-center gap-1 mx-auto"
                              data-testid="assign-delivery-btn"
                            >
                              <Truck className="w-3 h-3" />
                              Assign Delivery
                            </button>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>

            {/* Out for Delivery - Invoices assigned to delivery persons */}
            <div className="bg-white rounded-xl shadow-sm overflow-hidden">
              <div className="p-4 border-b bg-blue-50 flex items-center justify-between">
                <div className="flex items-center gap-2">
                  <Truck className="w-5 h-5 text-blue-600" />
                  <h3 className="font-semibold text-gray-800">Out for Delivery</h3>
                  <span className="px-2 py-0.5 bg-blue-200 text-blue-800 text-xs rounded-full">
                    {deliveryChallans.length}
                  </span>
                </div>
                {/* Filters */}
                <div className="flex items-center gap-3">
                  {/* Status Filter */}
                  <select
                    value={challanStatusFilter || ''}
                    onChange={(e) => setChallanStatusFilter(e.target.value)}
                    className="px-3 py-1.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500"
                  >
                    <option value="">All Status</option>
                    <option value="out_for_delivery">Out for Delivery</option>
                    <option value="delivered">Delivered</option>
                  </select>
                  {/* Driver Filter */}
                  <select
                    value={challanDriverFilter || ''}
                    onChange={(e) => setChallanDriverFilter(e.target.value)}
                    className="px-3 py-1.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500"
                  >
                    <option value="">All Drivers</option>
                    {deliveryPersons.map((dp) => (
                      <option key={dp.id} value={dp.id}>{dp.full_name}</option>
                    ))}
                  </select>
                </div>
              </div>
              {deliveryChallans.length === 0 ? (
                <div className="p-8 text-center">
                  <FileText className="w-12 h-12 text-gray-300 mx-auto mb-2" />
                  <p className="text-gray-500">No deliveries in progress</p>
                </div>
              ) : (
                <div className="overflow-x-auto">
                  <table className="w-full text-sm">
                    <thead className="bg-gray-50">
                      <tr>
                        <th className="px-4 py-3 text-left">Invoice #</th>
                        <th className="px-4 py-3 text-left">Customer</th>
                        <th className="px-4 py-3 text-left">Delivery Person</th>
                        <th className="px-4 py-3 text-left">Assigned At</th>
                        <th className="px-4 py-3 text-left">Status</th>
                        <th className="px-4 py-3 text-right">Amount</th>
                        <th className="px-4 py-3 text-center">Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                      {deliveryChallans
                        .filter(invoice => {
                          // Apply status filter
                          if (challanStatusFilter && invoice.status !== challanStatusFilter) return false;
                          // Apply driver filter
                          if (challanDriverFilter && invoice.assigned_delivery_person !== challanDriverFilter) return false;
                          return true;
                        })
                        .map((invoice) => (
                        <tr key={invoice.id} className="border-t hover:bg-gray-50">
                          <td className="px-4 py-3">
                            <button
                              onClick={() => setSelectedInvoiceForPreview(invoice)}
                              className="font-medium text-green-700 hover:text-green-900 hover:underline"
                            >
                              {invoice.invoice_number}
                            </button>
                            <p className="text-xs text-gray-500">{invoice.items?.length || 0} items</p>
                          </td>
                          <td className="px-4 py-3">
                            <p className="font-medium">{invoice.customer?.name}</p>
                            <p className="text-xs text-gray-500">{invoice.customer?.phone}</p>
                          </td>
                          <td className="px-4 py-3">
                            <p className="font-medium text-purple-700">{invoice.assigned_delivery_person_name || 'Not Assigned'}</p>
                          </td>
                          <td className="px-4 py-3 text-xs text-gray-500">
                            {invoice.delivery_assigned_at ? new Date(invoice.delivery_assigned_at).toLocaleString('en-IN', {
                              day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit'
                            }) : '-'}
                          </td>
                          <td className="px-4 py-3">
                            <span className={`px-2 py-1 text-xs rounded-full ${
                              invoice.status === 'delivered' ? 'bg-green-100 text-green-700' :
                              invoice.status === 'out_for_delivery' ? 'bg-blue-100 text-blue-700' :
                              'bg-amber-100 text-amber-700'
                            }`}>
                              {invoice.status?.replace(/_/g, ' ')}
                            </span>
                            {invoice.is_cod && (
                              <span className="ml-1 px-2 py-0.5 text-xs bg-orange-100 text-orange-700 rounded">
                                COD
                              </span>
                            )}
                          </td>
                          <td className="px-4 py-3 text-right font-medium">
                            {formatCurrency(invoice.total_amount)}
                          </td>
                          <td className="px-4 py-3 text-center">
                            <div className="flex items-center justify-center gap-1">
                              {/* View Invoice */}
                              <button
                                onClick={() => setSelectedInvoiceForPreview(invoice)}
                                className="p-1.5 bg-gray-100 text-gray-600 rounded hover:bg-gray-200"
                                title="View Invoice"
                              >
                                <Eye className="w-4 h-4" />
                              </button>
                              {/* Print Invoice */}
                              <button
                                onClick={() => window.open(`${BACKEND_URL}/api/invoices/${invoice.id}/pdf`, '_blank')}
                                className="p-1.5 bg-blue-100 text-blue-600 rounded hover:bg-blue-200"
                                title="Print Invoice"
                              >
                                <Printer className="w-4 h-4" />
                              </button>
                            </div>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          </div>
        )}
      </main>

      {/* View Order Modal */}
      {showViewOrder && selectedOrder && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
          <div className="bg-white rounded-xl shadow-xl w-full max-w-2xl max-h-[90vh] overflow-hidden">
            <div className="p-4 border-b bg-gradient-to-r from-teal-600 to-teal-700 text-white flex items-center justify-between">
              <h2 className="text-lg font-bold flex items-center gap-2">
                <ShoppingCart className="w-5 h-5" />
                Sales Order - {selectedOrder.order_number}
              </h2>
              <button 
                onClick={() => setShowViewOrder(false)}
                className="p-1 hover:bg-white/20 rounded"
              >
                <X className="w-5 h-5" />
              </button>
            </div>
            
            <div className="p-6 overflow-y-auto max-h-[calc(90vh-130px)]">
              {/* Order Info */}
              <div className="grid grid-cols-2 gap-4 mb-4">
                <div className="bg-gray-50 rounded-lg p-3">
                  <p className="text-xs text-gray-500">Customer</p>
                  <p className="font-medium">{selectedOrder.customer_name}</p>
                  <p className="text-sm text-gray-600">{selectedOrder.customer_phone}</p>
                </div>
                <div className="bg-gray-50 rounded-lg p-3">
                  <p className="text-xs text-gray-500">Order Date</p>
                  <p className="font-medium">{formatDate(selectedOrder.created_at)}</p>
                </div>
              </div>

              <div className="grid grid-cols-3 gap-4 mb-4">
                <div className="bg-teal-50 rounded-lg p-3 text-center">
                  <p className="text-xs text-teal-600">Total Amount</p>
                  <p className="text-xl font-bold text-teal-700">{formatCurrency(selectedOrder.total_amount)}</p>
                </div>
                <div className="bg-blue-50 rounded-lg p-3 text-center">
                  <p className="text-xs text-blue-600">Status</p>
                  <p className="text-sm font-medium text-blue-700 capitalize">{selectedOrder.order_status?.replace('_', ' ') || 'pending'}</p>
                </div>
                <div className="bg-purple-50 rounded-lg p-3 text-center">
                  <p className="text-xs text-purple-600">Source</p>
                  <p className="text-sm font-medium text-purple-700 capitalize">{selectedOrder.order_source?.replace('_', ' ') || '-'}</p>
                </div>
              </div>

              {/* Items */}
              {selectedOrder.items && selectedOrder.items.length > 0 && (
                <div className="mt-4">
                  <h3 className="text-sm font-medium text-gray-700 mb-2">Order Items</h3>
                  <div className="border rounded-lg overflow-hidden">
                    <table className="w-full text-sm">
                      <thead className="bg-gray-50">
                        <tr>
                          <th className="px-3 py-2 text-left">Item</th>
                          <th className="px-3 py-2 text-right">Qty</th>
                          <th className="px-3 py-2 text-right">Rate</th>
                          <th className="px-3 py-2 text-right">Total</th>
                        </tr>
                      </thead>
                      <tbody>
                        {selectedOrder.items.map((item, idx) => (
                          <tr key={idx} className="border-t">
                            <td className="px-3 py-2">{item.product_name}</td>
                            <td className="px-3 py-2 text-right">{item.quantity}</td>
                            <td className="px-3 py-2 text-right">{formatCurrency(item.rate)}</td>
                            <td className="px-3 py-2 text-right font-medium">{formatCurrency(item.total)}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              )}
            </div>

            <div className="p-4 border-t bg-gray-50 flex justify-end gap-2">
              <button
                onClick={() => setShowViewOrder(false)}
                className="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300"
              >
                Close
              </button>
              <button
                onClick={() => {
                  setShowViewOrder(false);
                  setShowProfessionalInvoice(true);
                }}
                className="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 flex items-center gap-2"
              >
                <Printer className="w-4 h-4" />
                Print Invoice
              </button>
              <button
                onClick={() => {
                  // Send via WhatsApp
                  const phone = selectedOrder.customer_phone;
                  if (!phone) {
                    alert('Customer phone not available');
                    return;
                  }
                  let formattedPhone = phone.replace(/\D/g, '');
                  if (formattedPhone.length === 10) formattedPhone = '91' + formattedPhone;
                  const message = encodeURIComponent(
                    `Dear ${selectedOrder.customer_name},\n\n` +
                    `Thank you for your order!\n` +
                    `Order: ${selectedOrder.order_number}\n` +
                    `Amount: ${formatCurrency(selectedOrder.total_amount)}\n\n` +
                    `- ${storeData.name}`
                  );
                  window.open(`https://wa.me/${formattedPhone}?text=${message}`, '_blank');
                }}
                className="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 flex items-center gap-2"
              >
                Send WhatsApp
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Professional Invoice Modal */}
      {showProfessionalInvoice && selectedOrder && (
        <ProfessionalInvoice
          invoice={{
            ...selectedOrder,
            invoice_number: selectedOrder.order_number,
            document_type: selectedOrder.document_type || 'sales_order', // Explicitly pass document_type
            customer: {
              name: selectedOrder.customer_name,
              phone: selectedOrder.customer_phone,
              email: selectedOrder.customer_email,
              address: selectedOrder.customer_address,
              city: selectedOrder.customer_city,
              state: selectedOrder.customer_state,
              pincode: selectedOrder.customer_pincode,
              gst_number: selectedOrder.customer_gstin,
              // Shipping details
              shipping_name: selectedOrder.shipping_name,
              shipping_address: selectedOrder.shipping_address,
              shipping_city: selectedOrder.shipping_city,
              shipping_state: selectedOrder.shipping_state,
              shipping_pincode: selectedOrder.shipping_pincode,
              shipping_phone: selectedOrder.shipping_phone
            },
            store_details: {
              name: storeData?.name,
              code: storeData?.code,
              address: storeData?.address,
              city: storeData?.city,
              state: storeData?.state || 'Karnataka',
              pincode: storeData?.pincode,
              gst_number: storeData?.gst_number,
              phone: storeData?.phone
            }
          }}
          onClose={() => setShowProfessionalInvoice(false)}
          onDownload={handleDownloadInvoicePDF}
          onWhatsApp={(inv) => {
            const phone = inv.customer?.phone || selectedOrder.customer_phone;
            if (!phone) {
              alert('Customer phone not available');
              return;
            }
            let formattedPhone = phone.replace(/\D/g, '');
            if (formattedPhone.length === 10) formattedPhone = '91' + formattedPhone;
            const message = encodeURIComponent(
              `Dear ${inv.customer?.name || selectedOrder.customer_name},\n\n` +
              `Thank you for your order!\n` +
              `Invoice: ${inv.invoice_number}\n` +
              `Amount: ${formatCurrency(inv.total_amount)}\n\n` +
              `- ${storeData?.name}`
            );
            window.open(`https://wa.me/${formattedPhone}?text=${message}`, '_blank');
          }}
        />
      )}

      {/* Stock Transfer Request Modal */}
      {showStockTransferModal && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
          <div className="bg-white rounded-xl shadow-xl w-full max-w-2xl max-h-[90vh] overflow-hidden">
            <div className="p-4 border-b bg-gradient-to-r from-teal-600 to-teal-700 text-white flex items-center justify-between">
              <h2 className="text-lg font-bold flex items-center gap-2">
                <ArrowRightLeft className="w-5 h-5" />
                Request Stock Transfer
              </h2>
              <button 
                onClick={() => setShowStockTransferModal(false)}
                className="p-1 hover:bg-white/20 rounded"
              >
                <X className="w-5 h-5" />
              </button>
            </div>
            
            <div className="p-6 overflow-y-auto max-h-[calc(90vh-180px)]">
              {/* From Store (Current) */}
              <div className="mb-4 p-3 bg-teal-50 rounded-lg">
                <p className="text-xs text-teal-600">Requesting From</p>
                <p className="font-medium text-teal-900">{storeData?.name}</p>
              </div>

              {/* To Store Selection */}
              <div className="mb-4">
                <label className="block text-sm font-medium text-gray-700 mb-1">Request Stock From (Warehouse/Store) *</label>
                <select
                  id="toStoreSelect"
                  className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-teal-500"
                  defaultValue=""
                >
                  <option value="">-- Select Source Store/Warehouse --</option>
                  {stores.map(store => (
                    <option key={store.id} value={store.id}>
                      {store.name} ({store.code})
                    </option>
                  ))}
                </select>
              </div>

              {/* Urgency */}
              <div className="mb-4">
                <label className="block text-sm font-medium text-gray-700 mb-1">Urgency</label>
                <select
                  value={transferUrgency}
                  onChange={(e) => setTransferUrgency(e.target.value)}
                  className="w-full px-3 py-2 border rounded-lg"
                >
                  <option value="normal">Normal</option>
                  <option value="urgent">Urgent</option>
                  <option value="critical">Critical</option>
                </select>
              </div>

              {/* Items */}
              <div className="mb-4">
                <div className="flex items-center justify-between mb-2">
                  <label className="block text-sm font-medium text-gray-700">Items to Request *</label>
                  <button
                    onClick={() => setTransferItems([...transferItems, { product_id: '', product_name: '', quantity: 1 }])}
                    className="text-xs text-teal-600 hover:text-teal-800"
                  >
                    + Add Item
                  </button>
                </div>
                <div className="space-y-3">
                  {transferItems.map((item, idx) => (
                    <div key={idx} className="flex gap-2 items-center">
                      <select
                        value={item.product_id}
                        onChange={(e) => {
                          const product = allProducts.find(p => p.id === e.target.value);
                          const newItems = [...transferItems];
                          newItems[idx].product_id = e.target.value;
                          newItems[idx].product_name = product ? (product.name || product.model_number) : '';
                          newItems[idx].sku = product?.sku || product?.model_number || '';
                          setTransferItems(newItems);
                        }}
                        className="flex-1 px-3 py-2 border rounded-lg text-sm"
                      >
                        <option value="">-- Select Product --</option>
                        {allProducts.map(product => (
                          <option key={product.id} value={product.id}>
                            {product.model_number || product.sku || ''} - {product.name?.substring(0, 40)}
                          </option>
                        ))}
                      </select>
                      <input
                        type="number"
                        min="1"
                        placeholder="Qty"
                        value={item.quantity}
                        onChange={(e) => {
                          const newItems = [...transferItems];
                          newItems[idx].quantity = parseInt(e.target.value) || 1;
                          setTransferItems(newItems);
                        }}
                        className="w-20 px-3 py-2 border rounded-lg text-sm"
                      />
                      {transferItems.length > 1 && (
                        <button
                          onClick={() => setTransferItems(transferItems.filter((_, i) => i !== idx))}
                          className="p-2 text-red-500 hover:bg-red-50 rounded"
                        >
                          <X className="w-4 h-4" />
                        </button>
                      )}
                    </div>
                  ))}
                </div>
                {allProducts.length === 0 && (
                  <p className="text-xs text-gray-500 mt-2">Loading products...</p>
                )}
              </div>

              {/* Notes */}
              <div className="mb-4">
                <label className="block text-sm font-medium text-gray-700 mb-1">Notes</label>
                <textarea
                  value={transferNotes}
                  onChange={(e) => setTransferNotes(e.target.value)}
                  className="w-full px-3 py-2 border rounded-lg"
                  rows={2}
                  placeholder="Any additional notes for this request..."
                />
              </div>
            </div>

            <div className="p-4 border-t bg-gray-50 flex justify-between">
              <button
                onClick={() => setShowStockTransferModal(false)}
                className="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300"
              >
                Cancel
              </button>
              <button
                onClick={() => {
                  const toStoreId = document.getElementById('toStoreSelect')?.value;
                  handleStockTransferSubmit(toStoreId);
                }}
                disabled={transferLoading}
                className="px-6 py-2 bg-teal-600 text-white rounded-lg hover:bg-teal-700 flex items-center gap-2 disabled:opacity-50"
              >
                {transferLoading ? (
                  <>
                    <RefreshCw className="w-4 h-4 animate-spin" />
                    Submitting...
                  </>
                ) : (
                  <>
                    <Check className="w-4 h-4" />
                    Submit Request
                  </>
                )}
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Create Delivery Challan Modal */}
      {showCreateChallanModal && selectedDeliveryOrder && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
          <div className="bg-white rounded-xl shadow-xl w-full max-w-lg">
            <div className="p-4 border-b bg-gradient-to-r from-teal-600 to-teal-700 text-white flex items-center justify-between rounded-t-xl">
              <h2 className="text-lg font-bold flex items-center gap-2">
                <Truck className="w-5 h-5" />
                Create Delivery Challan
              </h2>
              <button 
                onClick={() => {
                  setShowCreateChallanModal(false);
                  setSelectedDeliveryOrder(null);
                  setChallanFormData({ delivery_person_id: '', vehicle_number: '', expected_date: new Date(Date.now() + 2 * 24 * 60 * 60 * 1000).toISOString().split('T')[0] });
                }}
                className="p-1 hover:bg-white/20 rounded"
              >
                <X className="w-5 h-5" />
              </button>
            </div>
            
            <form
              onSubmit={(e) => {
                e.preventDefault();
                handleCreateChallan(
                  selectedDeliveryOrder,
                  challanFormData.delivery_person_id,
                  challanFormData.vehicle_number,
                  challanFormData.expected_date
                );
              }}
              className="p-6 space-y-4"
            >
              {/* Order Info */}
              <div className="bg-gray-50 rounded-lg p-4">
                <div className="flex justify-between mb-2">
                  <span className="text-gray-600">Order:</span>
                  <span className="font-semibold text-teal-700">{selectedDeliveryOrder.order_number}</span>
                </div>
                <div className="flex justify-between mb-2">
                  <span className="text-gray-600">Customer:</span>
                  <span className="font-medium">{selectedDeliveryOrder.customer_name}</span>
                </div>
                <div className="flex justify-between mb-2">
                  <span className="text-gray-600">Delivery Address:</span>
                  <span className="text-right text-sm">
                    {selectedDeliveryOrder.customer_city}, {selectedDeliveryOrder.customer_pincode}
                  </span>
                </div>
                <div className="flex justify-between pt-2 border-t">
                  <span className="text-gray-600">Amount:</span>
                  <span className="font-bold text-lg text-teal-700">
                    {formatCurrency(selectedDeliveryOrder.total_amount)}
                  </span>
                </div>
              </div>

              {/* Delivery Person Selection - Auto-fills vehicle number */}
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">
                  Assign Driver *
                </label>
                <select
                  value={challanFormData.delivery_person_id}
                  onChange={(e) => {
                    const selectedPerson = deliveryPersons.find(dp => dp.id === e.target.value);
                    setChallanFormData({
                      ...challanFormData,
                      delivery_person_id: e.target.value,
                      vehicle_number: selectedPerson?.vehicle_number || challanFormData.vehicle_number
                    });
                  }}
                  className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-teal-500 focus:outline-none"
                  required
                >
                  <option value="">-- Select Delivery Person --</option>
                  {deliveryPersons.filter(dp => dp.is_active !== false).map((dp) => (
                    <option key={dp.id} value={dp.id}>
                      {dp.full_name} {dp.vehicle_number ? `(${dp.vehicle_number})` : ''}
                    </option>
                  ))}
                </select>
              </div>

              {/* Vehicle Number - Auto-filled but editable */}
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">
                  Vehicle Number *
                </label>
                <input
                  type="text"
                  value={challanFormData.vehicle_number}
                  onChange={(e) => setChallanFormData({...challanFormData, vehicle_number: e.target.value.toUpperCase()})}
                  placeholder="e.g., KA01AB1234"
                  className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-teal-500 focus:outline-none"
                  required
                />
                <p className="text-xs text-gray-500 mt-1">Auto-filled from driver profile. Edit if using different vehicle.</p>
              </div>

              {/* Expected Delivery Date */}
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">
                  Expected Delivery Date
                </label>
                <input
                  type="date"
                  value={challanFormData.expected_date}
                  onChange={(e) => setChallanFormData({...challanFormData, expected_date: e.target.value})}
                  className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-teal-500 focus:outline-none"
                />
              </div>

              {/* Submit Buttons */}
              <div className="flex justify-end gap-3 pt-4 border-t">
                <button
                  type="button"
                  onClick={() => {
                    setShowCreateChallanModal(false);
                    setSelectedDeliveryOrder(null);
                    setChallanFormData({ delivery_person_id: '', vehicle_number: '', expected_date: new Date(Date.now() + 2 * 24 * 60 * 60 * 1000).toISOString().split('T')[0] });
                  }}
                  className="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  className="px-4 py-2 bg-teal-600 text-white rounded-lg hover:bg-teal-700 flex items-center gap-2"
                >
                  <Truck className="w-4 h-4" />
                  Create Challan
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Receive Stock Modal */}
      {showReceiveStock && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
          <div className="bg-white rounded-xl shadow-xl w-full max-w-2xl max-h-[90vh] overflow-hidden">
            <div className="p-4 border-b bg-gradient-to-r from-green-600 to-green-700 text-white flex items-center justify-between">
              <h2 className="text-lg font-bold flex items-center gap-2">
                <Package className="w-5 h-5" />
                Receive Stock
              </h2>
              <button 
                onClick={() => setShowReceiveStock(false)}
                className="p-1 hover:bg-white/20 rounded"
              >
                <X className="w-5 h-5" />
              </button>
            </div>
            
            <div className="p-6">
              <p className="text-gray-600 mb-6">
                For warehouse stock receipts, please use the <strong>Goods Receipt</strong> module which provides:
              </p>
              <ul className="list-disc list-inside text-gray-600 space-y-2 mb-6">
                <li>Link receipts to Purchase Orders</li>
                <li>Record vendor invoice details</li>
                <li>Track discrepancies (ordered vs received)</li>
                <li>Auto-update inventory levels</li>
              </ul>
              
              <div className="flex gap-3">
                <button
                  onClick={() => setShowReceiveStock(false)}
                  className="flex-1 px-4 py-2 border rounded-lg hover:bg-gray-50"
                >
                  Cancel
                </button>
                <button
                  onClick={() => {
                    setShowReceiveStock(false);
                    navigate('/store/grn');
                  }}
                  className="flex-1 px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700"
                >
                  Go to Goods Receipt
                </button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Add Customer Modal */}
      {showAddCustomer && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
          <div className="bg-white rounded-xl shadow-xl w-full max-w-2xl max-h-[90vh] overflow-hidden">
            <div className="p-4 border-b bg-gradient-to-r from-teal-600 to-teal-700 text-white flex items-center justify-between">
              <h2 className="text-lg font-bold flex items-center gap-2">
                <Users className="w-5 h-5" />
                Add New Customer
              </h2>
              <button 
                onClick={() => setShowAddCustomer(false)}
                className="p-1 hover:bg-white/20 rounded"
              >
                <X className="w-5 h-5" />
              </button>
            </div>
            
            <form onSubmit={async (e) => {
              e.preventDefault();
              const formData = new FormData(e.target);
              try {
                const response = await fetch(`${BACKEND_URL}/api/customers/`, {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({
                    name: formData.get('name'),
                    phone: formData.get('phone'),
                    email: formData.get('email'),
                    customer_type: formData.get('customer_type') || 'B2C',
                    gst_number: formData.get('gst_number'),
                    billing_address: formData.get('billing_address'),
                    billing_city: formData.get('billing_city'),
                    billing_state: formData.get('billing_state'),
                    billing_pincode: formData.get('billing_pincode'),
                    store_code: storeData?.code
                  })
                });
                const data = await response.json();
                if (data.status === 'success') {
                  alert('Customer added successfully!');
                  setShowAddCustomer(false);
                  fetchCustomers();
                } else {
                  alert(getErrorMessage(data.detail, 'Failed to add customer'));
                }
              } catch (error) {
                alert('Error adding customer');
              }
            }} className="p-6 overflow-y-auto max-h-[calc(90vh-80px)]">
              <div className="space-y-4">
                <div className="grid grid-cols-2 gap-4">
                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-1">Customer Name *</label>
                    <input
                      type="text"
                      name="name"
                      required
                      className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-teal-500"
                      placeholder="Enter customer name"
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-1">Phone Number *</label>
                    <input
                      type="tel"
                      name="phone"
                      required
                      maxLength={10}
                      className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-teal-500"
                      placeholder="10 digit mobile"
                    />
                  </div>
                </div>
                
                <div className="grid grid-cols-2 gap-4">
                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-1">Email</label>
                    <input
                      type="email"
                      name="email"
                      className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-teal-500"
                      placeholder="Email address"
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-1">Customer Type</label>
                    <select name="customer_type" className="w-full px-3 py-2 border rounded-lg">
                      <option value="B2C">B2C (Individual)</option>
                      <option value="B2B">B2B (Business)</option>
                    </select>
                  </div>
                </div>
                
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">GST Number (for B2B)</label>
                  <input
                    type="text"
                    name="gst_number"
                    maxLength={15}
                    className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-teal-500"
                    placeholder="15 character GST number"
                  />
                </div>
                
                <div className="border-t pt-4 mt-4">
                  <h3 className="text-sm font-semibold text-gray-800 mb-3">Billing Address</h3>
                  <div className="space-y-3">
                    <input
                      type="text"
                      name="billing_address"
                      className="w-full px-3 py-2 border rounded-lg"
                      placeholder="Street address"
                    />
                    <div className="grid grid-cols-3 gap-3">
                      <input
                        type="text"
                        name="billing_city"
                        className="px-3 py-2 border rounded-lg"
                        placeholder="City"
                      />
                      <input
                        type="text"
                        name="billing_state"
                        className="px-3 py-2 border rounded-lg"
                        placeholder="State"
                      />
                      <input
                        type="text"
                        name="billing_pincode"
                        maxLength={6}
                        className="px-3 py-2 border rounded-lg"
                        placeholder="Pincode"
                      />
                    </div>
                  </div>
                </div>
              </div>
              
              <div className="flex justify-end gap-3 pt-6 border-t mt-6">
                <button
                  type="button"
                  onClick={() => setShowAddCustomer(false)}
                  className="px-4 py-2 border rounded-lg hover:bg-gray-50"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  className="px-6 py-2 bg-teal-600 text-white rounded-lg hover:bg-teal-700"
                >
                  Add Customer
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* SO to Invoice Conversion Modal */}
      {selectedSOForConversion && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
          <div className="bg-white rounded-xl shadow-xl w-full max-w-3xl max-h-[90vh] overflow-hidden">
            <div className="p-4 border-b bg-gradient-to-r from-purple-600 to-purple-700 text-white flex items-center justify-between">
              <h2 className="text-lg font-bold">Convert SO to Invoice</h2>
              <button onClick={() => setSelectedSOForConversion(null)} className="p-1 hover:bg-white/20 rounded">
                <X className="w-5 h-5" />
              </button>
            </div>
            
            <div className="p-6 overflow-y-auto max-h-[calc(90vh-140px)]">
              {/* SO Details */}
              <div className="bg-gray-50 rounded-lg p-4 mb-6">
                <h3 className="font-semibold text-gray-800 mb-3">Sales Order Details</h3>
                <div className="grid grid-cols-2 gap-4 text-sm">
                  <div>
                    <span className="text-gray-500">SO Number:</span>
                    <span className="ml-2 font-medium">{selectedSOForConversion.invoice_number}</span>
                  </div>
                  <div>
                    <span className="text-gray-500">Customer:</span>
                    <span className="ml-2 font-medium">{selectedSOForConversion.customer?.name}</span>
                  </div>
                  <div>
                    <span className="text-gray-500">Phone:</span>
                    <span className="ml-2">{selectedSOForConversion.customer?.phone}</span>
                  </div>
                  <div>
                    <span className="text-gray-500">Total Amount:</span>
                    <span className="ml-2 font-bold text-purple-600">{formatCurrency(selectedSOForConversion.total_amount)}</span>
                  </div>
                </div>
              </div>

              {/* Items with Selection for Partial Conversion */}
              <div className="mb-6">
                <div className="flex items-center justify-between mb-3">
                  <h3 className="font-semibold text-gray-800">Select Items to Convert</h3>
                  <div className="flex items-center gap-2">
                    <button
                      onClick={() => {
                        const allSelected = {};
                        selectedSOForConversion.items?.forEach(item => {
                          allSelected[item.product_id] = { selected: true, quantity: item.quantity };
                        });
                        setSelectedItemsForConversion(allSelected);
                      }}
                      className="px-3 py-1 text-xs bg-purple-100 text-purple-700 rounded hover:bg-purple-200"
                    >
                      Select All
                    </button>
                    <button
                      onClick={() => setSelectedItemsForConversion({})}
                      className="px-3 py-1 text-xs bg-gray-100 text-gray-600 rounded hover:bg-gray-200"
                    >
                      Clear All
                    </button>
                  </div>
                </div>
                <p className="text-xs text-gray-500 mb-3">
                  Select items to include in this invoice. Unselected items will remain in the SO for future delivery.
                </p>
                <table className="w-full text-sm border rounded-lg overflow-hidden">
                  <thead className="bg-gray-100">
                    <tr>
                      <th className="px-3 py-2 text-center w-10">
                        <input
                          type="checkbox"
                          checked={Object.keys(selectedItemsForConversion).length === selectedSOForConversion.items?.length && 
                                   selectedSOForConversion.items?.every(item => selectedItemsForConversion[item.product_id]?.selected)}
                          onChange={(e) => {
                            if (e.target.checked) {
                              const allSelected = {};
                              selectedSOForConversion.items?.forEach(item => {
                                allSelected[item.product_id] = { selected: true, quantity: item.quantity };
                              });
                              setSelectedItemsForConversion(allSelected);
                            } else {
                              setSelectedItemsForConversion({});
                            }
                          }}
                          className="w-4 h-4"
                        />
                      </th>
                      <th className="px-3 py-2 text-left">Product</th>
                      <th className="px-3 py-2 text-left">HSN Code</th>
                      <th className="px-3 py-2 text-center">SO Qty</th>
                      <th className="px-3 py-2 text-center">Convert Qty</th>
                      <th className="px-3 py-2 text-right">Rate</th>
                      <th className="px-3 py-2 text-right">Amount</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y">
                    {selectedSOForConversion.items?.map((item, idx) => {
                      const isSelected = selectedItemsForConversion[item.product_id]?.selected || false;
                      const convertQty = selectedItemsForConversion[item.product_id]?.quantity || item.quantity;
                      const itemAmount = convertQty * (item.rate || item.price || 0);
                      
                      return (
                        <tr key={idx} className={isSelected ? 'bg-purple-50' : ''}>
                          <td className="px-3 py-2 text-center">
                            <input
                              type="checkbox"
                              checked={isSelected}
                              onChange={(e) => {
                                setSelectedItemsForConversion(prev => ({
                                  ...prev,
                                  [item.product_id]: {
                                    selected: e.target.checked,
                                    quantity: e.target.checked ? item.quantity : 0
                                  }
                                }));
                              }}
                              className="w-4 h-4"
                            />
                          </td>
                          <td className="px-3 py-2">{item.product_name}</td>
                          <td className="px-3 py-2 font-mono text-xs">{item.hsn_code || 'N/A'}</td>
                          <td className="px-3 py-2 text-center text-gray-500">{item.quantity}</td>
                          <td className="px-3 py-2 text-center">
                            <input
                              type="number"
                              min="1"
                              max={item.quantity}
                              value={isSelected ? convertQty : ''}
                              disabled={!isSelected}
                              onChange={(e) => {
                                const newQty = Math.min(Math.max(1, parseInt(e.target.value) || 1), item.quantity);
                                setSelectedItemsForConversion(prev => ({
                                  ...prev,
                                  [item.product_id]: {
                                    ...prev[item.product_id],
                                    quantity: newQty
                                  }
                                }));
                              }}
                              className={`w-16 px-2 py-1 text-center border rounded ${isSelected ? 'border-purple-300 bg-white' : 'bg-gray-100 text-gray-400'}`}
                            />
                          </td>
                          <td className="px-3 py-2 text-right">{formatCurrency(item.rate || item.price)}</td>
                          <td className="px-3 py-2 text-right font-medium">
                            {isSelected ? formatCurrency(itemAmount) : '-'}
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                  <tfoot className="bg-purple-100">
                    <tr>
                      <td colSpan="6" className="px-3 py-2 text-right font-semibold">Selected Items Total:</td>
                      <td className="px-3 py-2 text-right font-bold text-purple-700">
                        {formatCurrency(
                          Object.entries(selectedItemsForConversion)
                            .filter(([_, v]) => v.selected)
                            .reduce((sum, [productId, data]) => {
                              const item = selectedSOForConversion.items?.find(i => i.product_id === productId);
                              return sum + (data.quantity * (item?.rate || item?.price || 0));
                            }, 0)
                        )}
                      </td>
                    </tr>
                  </tfoot>
                </table>
              </div>

              {/* Bill From (Store where SO was created) - Read Only */}
              <div className="mb-6 p-4 bg-green-50 rounded-lg">
                <h3 className="font-semibold text-green-800 mb-2">Bill From (Origin Store)</h3>
                <p className="text-sm text-green-700">
                  <strong>{selectedSOForConversion.store_details?.name || selectedSOForConversion.store_code}</strong><br />
                  {selectedSOForConversion.store_details?.address || 'Address not available'}<br />
                  {selectedSOForConversion.store_details?.phone && `Phone: ${selectedSOForConversion.store_details.phone}`}
                  {selectedSOForConversion.store_details?.gst_number && <><br />GST: {selectedSOForConversion.store_details.gst_number}</>}
                </p>
              </div>

              {/* Bill To / Ship To (Customer Address) - Read Only */}
              <div className="mb-6 p-4 bg-blue-50 rounded-lg">
                <h3 className="font-semibold text-blue-800 mb-2">Bill To / Ship To (Customer)</h3>
                <p className="text-sm text-blue-700">
                  <strong>{selectedSOForConversion.customer?.name}</strong><br />
                  {selectedSOForConversion.customer?.shipping_address || selectedSOForConversion.customer?.billing_address || 'N/A'}, {' '}
                  {selectedSOForConversion.customer?.shipping_city || selectedSOForConversion.customer?.billing_city || ''} {' '}
                  {selectedSOForConversion.customer?.shipping_state || selectedSOForConversion.customer?.billing_state || ''} - {' '}
                  {selectedSOForConversion.customer?.shipping_pincode || selectedSOForConversion.customer?.billing_pincode || ''}<br />
                  Phone: {selectedSOForConversion.customer?.shipping_phone || selectedSOForConversion.customer?.phone}
                  {selectedSOForConversion.customer?.gst_number && <><br />GST: {selectedSOForConversion.customer.gst_number}</>}
                </p>
              </div>

              {/* Ship From Address - Dropdown with Stores + Custom Option */}
              <div className="mb-6">
                <h3 className="font-semibold text-gray-800 mb-3">Ship From (Dispatch Location) *</h3>
                <p className="text-xs text-gray-500 mb-2">Select the warehouse/store from where goods will be dispatched</p>
                
                <div className="space-y-3">
                  {/* Store Dropdown */}
                  <select
                    value={conversionData.selected_store_id || ''}
                    onChange={(e) => {
                      const selectedId = e.target.value;
                      if (selectedId === 'custom') {
                        setConversionData({...conversionData, selected_store_id: 'custom', ship_from_address: ''});
                      } else if (selectedId) {
                        // Find the store and auto-fill address
                        const selectedStore = allStores.find(s => s.id === selectedId);
                        if (selectedStore) {
                          const address = `${selectedStore.name}\n${selectedStore.address || ''}\nPhone: ${selectedStore.phone || ''}\nGST: ${selectedStore.gst_number || ''}`;
                          setConversionData({...conversionData, selected_store_id: selectedId, ship_from_address: address.trim()});
                        }
                      } else {
                        setConversionData({...conversionData, selected_store_id: '', ship_from_address: ''});
                      }
                    }}
                    className="w-full px-3 py-2 border rounded-lg bg-white"
                  >
                    <option value="">-- Select Dispatch Location --</option>
                    {allStores.map((store) => (
                      <option key={store.id} value={store.id}>
                        {store.code} - {store.name} {store.is_warehouse ? '(Warehouse)' : ''}
                      </option>
                    ))}
                    <option value="custom">➕ Add Custom Address</option>
                  </select>

                  {/* Show address preview or custom input */}
                  {conversionData.selected_store_id === 'custom' ? (
                    <textarea
                      value={conversionData.ship_from_address}
                      onChange={(e) => setConversionData({...conversionData, ship_from_address: e.target.value})}
                      className="w-full px-3 py-2 border rounded-lg"
                      rows="3"
                      placeholder="Enter custom dispatch address..."
                    />
                  ) : conversionData.ship_from_address ? (
                    <div className="p-3 bg-gray-50 rounded-lg text-sm whitespace-pre-line">
                      {conversionData.ship_from_address}
                    </div>
                  ) : null}
                </div>
              </div>

              {/* E-Way Bill Section - Only for >50K */}
              {selectedSOForConversion.total_amount > 50000 && (
                <div className="mb-6 p-4 bg-amber-50 border border-amber-200 rounded-lg">
                  <div className="flex items-center gap-2 mb-3">
                    <AlertTriangle className="w-5 h-5 text-amber-600" />
                    <h3 className="font-semibold text-amber-800">E-Way Bill Required (Amount &gt; ₹50,000)</h3>
                  </div>
                  <p className="text-sm text-amber-700 mb-4">
                    As per GST rules, an E-Way Bill is mandatory for transporting goods valued above ₹50,000.
                  </p>
                  
                  <div className="space-y-3">
                    <div>
                      <label className="block text-sm font-medium text-amber-800 mb-1">E-Way Bill Number</label>
                      <input
                        type="text"
                        value={conversionData.e_way_bill_number}
                        onChange={(e) => setConversionData({...conversionData, e_way_bill_number: e.target.value})}
                        className="w-full px-3 py-2 border border-amber-300 rounded-lg bg-white"
                        placeholder="Enter 12-digit E-Way Bill number"
                        maxLength={15}
                      />
                    </div>
                    
                    <div className="flex items-center gap-3">
                      <a
                        href="https://ewaybillgst.gov.in/"
                        target="_blank"
                        rel="noopener noreferrer"
                        className="flex items-center gap-2 px-4 py-2 bg-amber-600 text-white rounded-lg hover:bg-amber-700 text-sm"
                      >
                        <ExternalLink className="w-4 h-4" />
                        Generate E-Way Bill
                      </a>
                      <span className="text-xs text-amber-600">Opens E-Way Bill Portal in new tab</span>
                    </div>
                  </div>
                </div>
              )}

              {/* Actions */}
              <div className="flex justify-end gap-3 pt-4 border-t">
                <button
                  onClick={() => {
                    setSelectedSOForConversion(null);
                    setSelectedItemsForConversion({});
                  }}
                  className="px-4 py-2 border rounded-lg hover:bg-gray-50"
                >
                  Cancel
                </button>
                <button
                  onClick={async () => {
                    // Get selected items
                    const selectedItems = Object.entries(selectedItemsForConversion)
                      .filter(([_, data]) => data.selected && data.quantity > 0)
                      .map(([productId, data]) => {
                        const soItem = selectedSOForConversion.items?.find(i => i.product_id === productId);
                        return {
                          product_id: productId,
                          product_name: soItem?.product_name || '',
                          quantity: data.quantity,
                          rate: soItem?.rate || soItem?.price || 0,
                          hsn_code: soItem?.hsn_code || '',
                          gst_rate: soItem?.gst_rate || soItem?.tax_rate || 18,
                          serial_numbers: soItem?.serial_numbers || []
                        };
                      });
                    
                    if (selectedItems.length === 0) {
                      alert('Please select at least one item to convert');
                      return;
                    }
                    
                    // Calculate selected amount for E-Way bill check
                    const selectedAmount = selectedItems.reduce((sum, item) => {
                      const taxAmount = (item.quantity * item.rate) * (item.gst_rate / 100);
                      return sum + (item.quantity * item.rate) + taxAmount;
                    }, 0);
                    
                    // Validate E-Way bill for >50K
                    if (selectedAmount > 50000 && !conversionData.e_way_bill_number) {
                      if (!window.confirm('E-Way Bill is required for invoices above ₹50,000. Continue without E-Way Bill?')) {
                        return;
                      }
                    }
                    
                    // Check if partial or full conversion
                    const isPartialConversion = selectedItems.length < selectedSOForConversion.items?.length ||
                      selectedItems.some(si => {
                        const soItem = selectedSOForConversion.items?.find(i => i.product_id === si.product_id);
                        return si.quantity < (soItem?.quantity || 0);
                      });
                    
                    try {
                      let res, data;
                      let forceConvert = false;
                      
                      if (isPartialConversion) {
                        // Use partial conversion endpoint
                        res = await fetch(`${BACKEND_URL}/api/invoices/offline/sales-orders/partial-convert`, {
                          method: 'POST',
                          headers: { 'Content-Type': 'application/json' },
                          body: JSON.stringify({
                            sales_order_id: selectedSOForConversion.id,
                            selected_items: selectedItems,
                            converted_by: storeUser?.email || storeUser?.name,
                            notes: conversionData.e_way_bill_number ? `E-Way Bill: ${conversionData.e_way_bill_number}` : null
                          })
                        });
                        data = await res.json();
                        
                        if (data.status === 'duplicate_warning') {
                          forceConvert = window.confirm(
                            `⚠️ Possible Duplicate Invoice\n\n${data.message}`
                          );
                          if (forceConvert) {
                            res = await fetch(`${BACKEND_URL}/api/invoices/offline/sales-orders/partial-convert`, {
                              method: 'POST',
                              headers: { 'Content-Type': 'application/json' },
                              body: JSON.stringify({
                                sales_order_id: selectedSOForConversion.id,
                                selected_items: selectedItems,
                                converted_by: storeUser?.email || storeUser?.name,
                                notes: conversionData.e_way_bill_number ? `E-Way Bill: ${conversionData.e_way_bill_number}` : null,
                                force: true
                              })
                            });
                            data = await res.json();
                          } else {
                            return;
                          }
                        }
                        
                        if (data.status === 'success') {
                          const message = data.remaining_items_count > 0 
                            ? `Created Invoice: ${data.new_invoice.invoice_number}. ${data.remaining_items_count} item(s) remain in SO for future delivery.`
                            : `Successfully converted all items to Invoice: ${data.new_invoice.invoice_number}`;
                          alert(message);
                        }
                      } else {
                        // Full conversion - use existing endpoint
                        res = await fetch(`${BACKEND_URL}/api/delivery-challans/convert-so-to-invoice/${selectedSOForConversion.id}`, {
                          method: 'POST',
                          headers: { 'Content-Type': 'application/json' },
                          body: JSON.stringify({
                            ship_from_address: conversionData.ship_from_address,
                            e_way_bill_number: conversionData.e_way_bill_number
                          })
                        });
                        data = await res.json();
                        
                        if (data.status === 'duplicate_warning') {
                          forceConvert = window.confirm(
                            `⚠️ Possible Duplicate Invoice\n\n${data.message}`
                          );
                          if (forceConvert) {
                            res = await fetch(`${BACKEND_URL}/api/delivery-challans/convert-so-to-invoice/${selectedSOForConversion.id}`, {
                              method: 'POST',
                              headers: { 'Content-Type': 'application/json' },
                              body: JSON.stringify({
                                ship_from_address: conversionData.ship_from_address,
                                e_way_bill_number: conversionData.e_way_bill_number,
                                force: true
                              })
                            });
                            data = await res.json();
                          } else {
                            return;
                          }
                        }
                        
                        if (data.status === 'success') {
                          alert(`Successfully converted to Invoice: ${data.new_invoice_number}`);
                        }
                      }
                      
                      if (data.status === 'success') {
                        setSelectedSOForConversion(null);
                        setSelectedItemsForConversion({});
                        setConversionData({ ship_from_address: '', e_way_bill_number: '', selected_store_id: '' });
                        fetchImmediateSOs();
                        fetchConvertedInvoices();
                      } else {
                        alert(getErrorMessage(data.detail, 'Conversion failed'));
                      }
                    } catch (err) {
                      console.error('Conversion error:', err);
                      alert('Error converting SO to Invoice');
                    }
                  }}
                  disabled={Object.values(selectedItemsForConversion).filter(v => v.selected).length === 0}
                  className="px-6 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
                >
                  <FileText className="w-4 h-4" />
                  Convert Selected to Invoice
                </button>
              </div>
            </div>
          </div>
        </div>
      )}
      {/* Invoice Preview Modal */}
      {selectedInvoiceForPreview && (
        <ProfessionalInvoice 
          invoice={selectedInvoiceForPreview}
          onClose={() => setSelectedInvoiceForPreview(null)}
          onDownload={handleDownloadInvoicePDF}
        />
      )}

      {/* Delivery Challan Preview Modal */}
      {selectedChallanForPreview && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4 print:p-0 print:bg-white">
          <div className="bg-white rounded-xl shadow-2xl max-w-3xl w-full max-h-[90vh] overflow-y-auto print:max-h-none print:shadow-none print:rounded-none">
            {/* Modal Header - Hidden on Print */}
            <div className="p-4 border-b bg-gradient-to-r from-teal-600 to-teal-700 text-white flex items-center justify-between rounded-t-xl print:hidden">
              <h2 className="text-lg font-bold flex items-center gap-2">
                <Truck className="w-5 h-5" />
                Delivery Challan Preview
              </h2>
              <button 
                onClick={() => setSelectedChallanForPreview(null)}
                className="p-2 hover:bg-white/20 rounded-full transition-colors"
              >
                <X className="w-5 h-5" />
              </button>
            </div>
            
            {/* Printable Document */}
            <div className="p-6 print:p-8" id="challan-print-content">
              {/* Document Title */}
              <div className="text-center border-b-2 border-teal-600 pb-4 mb-4">
                <h1 className="text-2xl font-bold text-teal-700">DELIVERY CHALLAN</h1>
                <p className="text-lg font-semibold text-gray-700 mt-1">{selectedChallanForPreview.challan_number}</p>
              </div>

              {/* Header Info Row */}
              <div className="grid grid-cols-3 gap-4 mb-4 text-sm">
                <div>
                  <p className="text-gray-500">Date</p>
                  <p className="font-medium">{formatDate(selectedChallanForPreview.created_at)}</p>
                </div>
                <div>
                  <p className="text-gray-500">Invoice/SO Reference</p>
                  <p className="font-semibold text-blue-700">{selectedChallanForPreview.invoice_number || '-'}</p>
                </div>
                <div>
                  <p className="text-gray-500">Status</p>
                  <span className={`px-2 py-0.5 rounded text-xs font-medium ${
                    selectedChallanForPreview.status === 'delivered' ? 'bg-green-100 text-green-700' :
                    selectedChallanForPreview.status === 'in_transit' ? 'bg-blue-100 text-blue-700' :
                    'bg-amber-100 text-amber-700'
                  }`}>
                    {selectedChallanForPreview.status?.replace('_', ' ').toUpperCase()}
                  </span>
                </div>
              </div>

              {/* E-Way Bill - If Available */}
              {selectedChallanForPreview.e_way_bill_number && (
                <div className="bg-purple-50 border border-purple-200 rounded-lg p-3 mb-4">
                  <p className="text-xs font-bold text-purple-700 uppercase tracking-wider">
                    E-Way Bill No: <span className="font-mono text-base">{selectedChallanForPreview.e_way_bill_number}</span>
                  </p>
                </div>
              )}

              {/* From / To Addresses */}
              <div className="grid grid-cols-2 gap-4 mb-4">
                {/* Ship From - Warehouse/Store Address */}
                <div className="bg-emerald-50 border border-emerald-200 rounded-lg p-4">
                  <h3 className="text-xs font-bold text-emerald-700 uppercase tracking-wider border-b border-emerald-200 pb-2 mb-2">
                    Ship From (Pickup Location)
                  </h3>
                  <p className="font-semibold text-sm">{selectedChallanForPreview.ship_from?.name || selectedChallanForPreview.store_details?.name || storeData?.name || 'Aditya Retail'}</p>
                  {(selectedChallanForPreview.ship_from?.gst_number || selectedChallanForPreview.store_details?.gst_number || storeData?.gst_number) && (
                    <p className="text-xs text-blue-600 font-medium">
                      GSTIN: {selectedChallanForPreview.ship_from?.gst_number || selectedChallanForPreview.store_details?.gst_number || storeData?.gst_number}
                    </p>
                  )}
                  <p className="text-xs text-gray-600 mt-1">
                    {selectedChallanForPreview.ship_from?.address || selectedChallanForPreview.ship_from_address || selectedChallanForPreview.store_details?.address || storeData?.address || ''}
                  </p>
                  <p className="text-xs text-gray-600">
                    {selectedChallanForPreview.ship_from?.city || selectedChallanForPreview.store_details?.city || storeData?.city || ''}, 
                    {selectedChallanForPreview.ship_from?.state || selectedChallanForPreview.store_details?.state || storeData?.state || ''} - 
                    {selectedChallanForPreview.ship_from?.pincode || selectedChallanForPreview.store_details?.pincode || storeData?.pincode || ''}
                  </p>
                  {(selectedChallanForPreview.ship_from?.phone || selectedChallanForPreview.store_details?.phone || storeData?.phone) && (
                    <p className="text-xs text-gray-600 mt-1">
                      Phone: {selectedChallanForPreview.ship_from?.phone || selectedChallanForPreview.store_details?.phone || storeData?.phone}
                    </p>
                  )}
                </div>

                {/* Ship To - Customer Delivery Address */}
                <div className="bg-blue-50 border border-blue-200 rounded-lg p-4">
                  <h3 className="text-xs font-bold text-blue-700 uppercase tracking-wider border-b border-blue-200 pb-2 mb-2">
                    Ship To (Delivery Location)
                  </h3>
                  <p className="font-semibold text-sm">{selectedChallanForPreview.ship_to?.name || selectedChallanForPreview.customer?.shipping_name || selectedChallanForPreview.customer?.name || '-'}</p>
                  <p className="text-xs text-gray-600 mt-1">
                    {selectedChallanForPreview.ship_to?.address || selectedChallanForPreview.customer?.shipping_address || selectedChallanForPreview.delivery_address || selectedChallanForPreview.customer?.address || ''}
                  </p>
                  <p className="text-xs text-gray-600">
                    {selectedChallanForPreview.ship_to?.city || selectedChallanForPreview.customer?.shipping_city || selectedChallanForPreview.customer?.city || ''}, 
                    {selectedChallanForPreview.ship_to?.state || selectedChallanForPreview.customer?.shipping_state || selectedChallanForPreview.customer?.state || ''} - 
                    {selectedChallanForPreview.ship_to?.pincode || selectedChallanForPreview.customer?.shipping_pincode || selectedChallanForPreview.customer?.pincode || ''}
                  </p>
                  <p className="text-xs text-gray-600 mt-1">
                    Phone: {selectedChallanForPreview.ship_to?.phone || selectedChallanForPreview.customer?.shipping_phone || selectedChallanForPreview.customer?.phone || '-'}
                  </p>
                </div>
              </div>

              {/* Delivery Person & Vehicle Details */}
              <div className="bg-gray-50 border rounded-lg p-4 mb-4">
                <div className="grid grid-cols-4 gap-4 text-sm">
                  <div>
                    <p className="text-gray-500 text-xs">Driver Name</p>
                    <p className="font-medium">{selectedChallanForPreview.delivery_person_name || 'Not Assigned'}</p>
                  </div>
                  <div>
                    <p className="text-gray-500 text-xs">Vehicle Number</p>
                    <p className="font-medium">{selectedChallanForPreview.vehicle_number || '-'}</p>
                  </div>
                  <div>
                    <p className="text-gray-500 text-xs">Expected Delivery</p>
                    <p className="font-medium">{formatDate(selectedChallanForPreview.expected_delivery_date)}</p>
                  </div>
                  {selectedChallanForPreview.delivered_at && (
                    <div>
                      <p className="text-gray-500 text-xs">Delivered At</p>
                      <p className="font-medium text-green-600">{formatDate(selectedChallanForPreview.delivered_at)}</p>
                    </div>
                  )}
                </div>
              </div>

              {/* Items Table */}
              {selectedChallanForPreview.items?.length > 0 && (
                <div className="border rounded-lg overflow-hidden mb-4">
                  <table className="w-full text-sm">
                    <thead className="bg-gray-100">
                      <tr>
                        <th className="px-4 py-2 text-left border-b">#</th>
                        <th className="px-4 py-2 text-left border-b">Item Description</th>
                        <th className="px-4 py-2 text-center border-b">HSN</th>
                        <th className="px-4 py-2 text-center border-b">Qty</th>
                        <th className="px-4 py-2 text-right border-b">Amount</th>
                      </tr>
                    </thead>
                    <tbody>
                      {selectedChallanForPreview.items.map((item, idx) => (
                        <tr key={idx} className="border-b last:border-b-0">
                          <td className="px-4 py-2">{idx + 1}</td>
                          <td className="px-4 py-2 font-medium">{item.product_name || item.name}</td>
                          <td className="px-4 py-2 text-center text-gray-600">{item.hsn_code || '-'}</td>
                          <td className="px-4 py-2 text-center">{item.quantity}</td>
                          <td className="px-4 py-2 text-right">{formatCurrency(item.total || item.amount || 0)}</td>
                        </tr>
                      ))}
                    </tbody>
                    <tfoot className="bg-gray-50">
                      <tr>
                        <td colSpan="4" className="px-4 py-2 text-right font-bold">Total Amount:</td>
                        <td className="px-4 py-2 text-right font-bold text-teal-700">{formatCurrency(selectedChallanForPreview.total_amount)}</td>
                      </tr>
                    </tfoot>
                  </table>
                </div>
              )}

              {/* Signatures Section */}
              <div className="grid grid-cols-3 gap-4 mt-8 pt-4 border-t text-center text-sm">
                <div>
                  <div className="h-16 border-b border-dashed border-gray-400 mb-2"></div>
                  <p className="text-gray-600">Prepared By</p>
                </div>
                <div>
                  <div className="h-16 border-b border-dashed border-gray-400 mb-2"></div>
                  <p className="text-gray-600">Driver Signature</p>
                </div>
                <div>
                  <div className="h-16 border-b border-dashed border-gray-400 mb-2"></div>
                  <p className="text-gray-600">Received By</p>
                </div>
              </div>
            </div>

            {/* Actions - Hidden on Print */}
            <div className="flex justify-end gap-3 p-4 border-t print:hidden">
              <button
                onClick={() => setSelectedChallanForPreview(null)}
                className="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200"
              >
                Close
              </button>
              <button
                onClick={() => {
                  const printContent = document.getElementById('challan-print-content');
                  const printWindow = window.open('', '_blank');
                  printWindow.document.write(`
                    <html>
                      <head>
                        <title>Delivery Challan - ${selectedChallanForPreview.challan_number}</title>
                        <style>
                          body { font-family: Arial, sans-serif; margin: 20px; }
                          table { width: 100%; border-collapse: collapse; }
                          th, td { padding: 8px; text-align: left; border: 1px solid #ddd; }
                          .text-center { text-align: center; }
                          .text-right { text-align: right; }
                          .font-bold { font-weight: bold; }
                          .grid { display: grid; gap: 16px; }
                          .grid-cols-2 { grid-template-columns: repeat(2, 1fr); }
                          .grid-cols-3 { grid-template-columns: repeat(3, 1fr); }
                          .grid-cols-4 { grid-template-columns: repeat(4, 1fr); }
                          .border { border: 1px solid #ddd; }
                          .rounded-lg { border-radius: 8px; }
                          .p-4 { padding: 16px; }
                          .mb-4 { margin-bottom: 16px; }
                          .bg-emerald-50 { background: #ecfdf5; }
                          .bg-blue-50 { background: #eff6ff; }
                          .bg-gray-50 { background: #f9fafb; }
                        </style>
                      </head>
                      <body>${printContent.innerHTML}</body>
                    </html>
                  `);
                  printWindow.document.close();
                  printWindow.print();
                }}
                className="px-4 py-2 bg-teal-600 text-white rounded-lg hover:bg-teal-700 flex items-center gap-2"
              >
                <Printer className="w-4 h-4" />
                Print
              </button>
              <button
                onClick={() => {
                  // Generate PDF-like download using print
                  const printContent = document.getElementById('challan-print-content');
                  const printWindow = window.open('', '_blank');
                  printWindow.document.write(`
                    <html>
                      <head>
                        <title>DC-${selectedChallanForPreview.challan_number}</title>
                        <style>
                          body { font-family: Arial, sans-serif; margin: 20px; }
                          table { width: 100%; border-collapse: collapse; }
                          th, td { padding: 8px; text-align: left; border: 1px solid #ddd; }
                        </style>
                      </head>
                      <body>${printContent.innerHTML}</body>
                    </html>
                  `);
                  printWindow.document.close();
                  printWindow.print();
                }}
                className="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 flex items-center gap-2"
              >
                <Download className="w-4 h-4" />
                Download PDF
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Assign Delivery Person to Invoice Modal */}
      {showAssignDeliveryModal && selectedInvoiceForDelivery && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
          <div className="bg-white rounded-xl shadow-2xl max-w-lg w-full max-h-[90vh] overflow-y-auto">
            <div className="p-4 border-b bg-teal-600 text-white flex items-center justify-between rounded-t-xl">
              <h2 className="text-lg font-bold flex items-center gap-2">
                <Truck className="w-5 h-5" />
                Assign Delivery Person
              </h2>
              <button 
                onClick={() => {
                  setShowAssignDeliveryModal(false);
                  setSelectedInvoiceForDelivery(null);
                }}
                className="p-1 hover:bg-teal-700 rounded-full transition-colors"
              >
                <X className="w-5 h-5" />
              </button>
            </div>
            
            <div className="p-6 space-y-4">
              {/* Invoice Summary */}
              <div className="bg-gray-50 rounded-lg p-4">
                <div className="flex justify-between items-start mb-2">
                  <div>
                    <p className="text-xs text-gray-500">Invoice</p>
                    <p className="font-bold text-green-700">{selectedInvoiceForDelivery.invoice_number}</p>
                  </div>
                  <div className="text-right">
                    <p className="text-xs text-gray-500">Amount</p>
                    <p className="font-bold text-lg">{formatCurrency(selectedInvoiceForDelivery.total_amount)}</p>
                  </div>
                </div>
                <div className="border-t pt-2 mt-2">
                  <p className="font-medium">{selectedInvoiceForDelivery.customer?.name}</p>
                  <p className="text-sm text-gray-600">{selectedInvoiceForDelivery.customer?.phone}</p>
                  <p className="text-xs text-gray-500 mt-1">
                    {selectedInvoiceForDelivery.customer?.shipping_address || selectedInvoiceForDelivery.customer?.billing_address}
                  </p>
                </div>
                {selectedInvoiceForDelivery.is_cod && (
                  <div className="mt-2 px-2 py-1 bg-orange-100 text-orange-700 text-xs rounded inline-block">
                    COD - Collect {formatCurrency(selectedInvoiceForDelivery.total_amount)}
                  </div>
                )}
              </div>
              
              {/* Delivery Person Selection */}
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">Select Delivery Person *</label>
                <select
                  value={assignDeliveryForm.delivery_person_id}
                  onChange={(e) => {
                    const person = deliveryPersons.find(p => p.id === e.target.value);
                    setAssignDeliveryForm({
                      ...assignDeliveryForm,
                      delivery_person_id: e.target.value,
                      delivery_person_name: person?.full_name || ''
                    });
                  }}
                  className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
                  required
                >
                  <option value="">-- Select Delivery Person --</option>
                  {deliveryPersons.map((person) => (
                    <option key={person.id} value={person.id}>
                      {person.full_name} {person.phone ? `(${person.phone})` : ''} {person.vehicle_number ? `- ${person.vehicle_number}` : ''}
                    </option>
                  ))}
                </select>
              </div>
              
              {/* Expected Delivery Date */}
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">Expected Delivery Date</label>
                <input
                  type="date"
                  value={assignDeliveryForm.expected_delivery_date}
                  onChange={(e) => setAssignDeliveryForm({...assignDeliveryForm, expected_delivery_date: e.target.value})}
                  className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
                  min={new Date().toISOString().split('T')[0]}
                />
              </div>
              
              {/* Delivery Notes */}
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">Delivery Notes (Optional)</label>
                <textarea
                  value={assignDeliveryForm.delivery_notes}
                  onChange={(e) => setAssignDeliveryForm({...assignDeliveryForm, delivery_notes: e.target.value})}
                  className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
                  placeholder="Any special instructions for delivery..."
                  rows={2}
                />
              </div>
              
              {/* Action Buttons */}
              <div className="flex justify-end gap-3 pt-4 border-t">
                <button
                  type="button"
                  onClick={() => {
                    setShowAssignDeliveryModal(false);
                    setSelectedInvoiceForDelivery(null);
                  }}
                  className="px-4 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors"
                >
                  Cancel
                </button>
                <button
                  onClick={handleAssignDeliveryToInvoice}
                  disabled={assigningDelivery || !assignDeliveryForm.delivery_person_id}
                  className="px-6 py-2 bg-teal-600 text-white rounded-lg hover:bg-teal-700 transition-colors flex items-center gap-2 disabled:opacity-50"
                >
                  {assigningDelivery ? (
                    <>
                      <RefreshCw className="w-4 h-4 animate-spin" />
                      Assigning...
                    </>
                  ) : (
                    <>
                      <Truck className="w-4 h-4" />
                      Assign Delivery
                    </>
                  )}
                </button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Add Delivery Person Modal */}
      {showAddDeliveryPersonModal && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
          <div className="bg-white rounded-xl shadow-2xl max-w-md w-full max-h-[90vh] overflow-y-auto">
            <div className="p-4 border-b bg-purple-600 text-white flex items-center justify-between rounded-t-xl">
              <h2 className="text-lg font-bold flex items-center gap-2">
                <Users className="w-5 h-5" />
                Add Delivery Person
              </h2>
              <button 
                onClick={() => setShowAddDeliveryPersonModal(false)}
                className="p-1 hover:bg-purple-700 rounded-full transition-colors"
              >
                <X className="w-5 h-5" />
              </button>
            </div>
            <form onSubmit={handleCreateDeliveryPerson} className="p-6 space-y-4">
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Full Name *</label>
                <input
                  type="text"
                  value={deliveryPersonForm.full_name}
                  onChange={(e) => setDeliveryPersonForm({...deliveryPersonForm, full_name: e.target.value})}
                  className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
                  placeholder="Enter full name"
                  required
                />
              </div>
              <div className="grid grid-cols-2 gap-4">
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">Email *</label>
                  <input
                    type="email"
                    value={deliveryPersonForm.email}
                    onChange={(e) => setDeliveryPersonForm({...deliveryPersonForm, email: e.target.value})}
                    className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
                    placeholder="driver@email.com"
                    required
                  />
                </div>
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">Password *</label>
                  <input
                    type="password"
                    value={deliveryPersonForm.password}
                    onChange={(e) => setDeliveryPersonForm({...deliveryPersonForm, password: e.target.value})}
                    className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
                    placeholder="••••••••"
                    required
                    minLength={6}
                  />
                </div>
              </div>
              <div className="grid grid-cols-2 gap-4">
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">Phone Number *</label>
                  <input
                    type="tel"
                    value={deliveryPersonForm.phone}
                    onChange={(e) => setDeliveryPersonForm({...deliveryPersonForm, phone: e.target.value})}
                    className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
                    placeholder="9876543210"
                    required
                  />
                </div>
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">Vehicle Number</label>
                  <input
                    type="text"
                    value={deliveryPersonForm.vehicle_number}
                    onChange={(e) => setDeliveryPersonForm({...deliveryPersonForm, vehicle_number: e.target.value.toUpperCase()})}
                    className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
                    placeholder="KA01AB1234"
                  />
                </div>
              </div>
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Address</label>
                <textarea
                  value={deliveryPersonForm.address}
                  onChange={(e) => setDeliveryPersonForm({...deliveryPersonForm, address: e.target.value})}
                  className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
                  placeholder="Enter address (optional)"
                  rows={2}
                />
              </div>
              <div className="flex justify-end gap-3 pt-4 border-t">
                <button
                  type="button"
                  onClick={() => setShowAddDeliveryPersonModal(false)}
                  className="px-4 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  disabled={deliveryPersonLoading}
                  className="px-6 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors flex items-center gap-2 disabled:opacity-50"
                >
                  {deliveryPersonLoading ? (
                    <>
                      <RefreshCw className="w-4 h-4 animate-spin" />
                      Creating...
                    </>
                  ) : (
                    <>
                      <Plus className="w-4 h-4" />
                      Create Delivery Person
                    </>
                  )}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Receive Material Transfer Modal */}
      {showReceiveTransferModal && selectedTransferForReceive && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
          <div className="bg-white rounded-xl shadow-2xl max-w-lg w-full max-h-[90vh] overflow-y-auto">
            <div className="p-4 border-b bg-green-600 text-white flex items-center justify-between rounded-t-xl">
              <h2 className="text-lg font-bold flex items-center gap-2">
                <Package className="w-5 h-5" />
                Receive Material Transfer
              </h2>
              <button 
                onClick={() => {
                  setShowReceiveTransferModal(false);
                  setSelectedTransferForReceive(null);
                }}
                className="p-1 hover:bg-green-700 rounded-full transition-colors"
              >
                <X className="w-5 h-5" />
              </button>
            </div>
            
            <div className="p-6 space-y-4">
              {/* Transfer Info */}
              <div className="bg-gray-50 rounded-lg p-4 space-y-2">
                <div className="flex justify-between">
                  <span className="text-gray-600">DC Number:</span>
                  <span className="font-bold text-green-700">{selectedTransferForReceive.challan_number}</span>
                </div>
                <div className="flex justify-between">
                  <span className="text-gray-600">From:</span>
                  <span className="font-medium">{selectedTransferForReceive.from_location?.name}</span>
                </div>
                <div className="flex justify-between">
                  <span className="text-gray-600">Transfer Type:</span>
                  <span className="text-sm">{selectedTransferForReceive.transfer_type?.replace(/_/g, ' ')}</span>
                </div>
                {selectedTransferForReceive.e_way_bill?.number && (
                  <div className="flex justify-between">
                    <span className="text-gray-600">E-Way Bill:</span>
                    <span className="font-mono text-sm text-green-600">{selectedTransferForReceive.e_way_bill.number}</span>
                  </div>
                )}
              </div>
              
              {/* Items List */}
              <div>
                <h3 className="text-sm font-medium text-gray-700 mb-2">Items to Receive:</h3>
                <div className="border rounded-lg divide-y max-h-40 overflow-y-auto">
                  {selectedTransferForReceive.items?.map((item, idx) => (
                    <div key={idx} className="px-3 py-2 flex justify-between items-center">
                      <div>
                        <p className="font-medium text-sm">{item.product_name}</p>
                        {item.serial_numbers?.length > 0 && (
                          <p className="text-xs text-gray-500">S/N: {item.serial_numbers.join(', ')}</p>
                        )}
                      </div>
                      <span className="px-2 py-1 bg-blue-100 text-blue-700 text-sm font-medium rounded">
                        x{item.quantity} {item.unit || 'pcs'}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
              
              {/* Goods Condition */}
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">Goods Condition *</label>
                <div className="flex gap-4">
                  {['good', 'damaged', 'partial'].map((condition) => (
                    <label key={condition} className="flex items-center gap-2 cursor-pointer">
                      <input
                        type="radio"
                        name="goods_condition"
                        value={condition}
                        checked={receiveTransferForm.goods_condition === condition}
                        onChange={(e) => setReceiveTransferForm({...receiveTransferForm, goods_condition: e.target.value})}
                        className="w-4 h-4 text-green-600"
                      />
                      <span className={`capitalize ${
                        condition === 'good' ? 'text-green-600' :
                        condition === 'damaged' ? 'text-red-600' : 'text-yellow-600'
                      }`}>
                        {condition}
                      </span>
                    </label>
                  ))}
                </div>
              </div>
              
              {/* Remarks */}
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">Receiver Remarks (Optional)</label>
                <textarea
                  value={receiveTransferForm.receiver_remarks}
                  onChange={(e) => setReceiveTransferForm({...receiveTransferForm, receiver_remarks: e.target.value})}
                  className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500"
                  placeholder="Any discrepancies or notes about the received goods..."
                  rows={2}
                />
              </div>
              
              {/* Action Buttons */}
              <div className="flex justify-end gap-3 pt-4 border-t">
                <button
                  type="button"
                  onClick={() => {
                    setShowReceiveTransferModal(false);
                    setSelectedTransferForReceive(null);
                  }}
                  className="px-4 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors"
                >
                  Cancel
                </button>
                <button
                  onClick={handleReceiveTransfer}
                  disabled={receivingTransfer}
                  className="px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors flex items-center gap-2 disabled:opacity-50"
                >
                  {receivingTransfer ? (
                    <>
                      <RefreshCw className="w-4 h-4 animate-spin" />
                      Processing...
                    </>
                  ) : (
                    <>
                      <Check className="w-4 h-4" />
                      Confirm Receipt
                    </>
                  )}
                </button>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

// Purchase Bills Tab Component
const getGstStateCodeFromGstin = (gstin) => {
  if (!gstin || typeof gstin !== 'string') return null;
  const code = gstin.trim().substring(0, 2);
  return /^\d{2}$/.test(code) ? code : null;
};

const PurchaseBillsTab = ({ storeData, formatCurrency }) => {
  const [bills, setBills] = useState([]);
  const [loading, setLoading] = useState(true);
  const [showAddBill, setShowAddBill] = useState(false);
  const [summary, setSummary] = useState({ total_value: 0, total_paid: 0, balance_due: 0, pending_count: 0 });
  const [invoiceGRNMatch, setInvoiceGRNMatch] = useState(null);
  const [checkingGRNMatch, setCheckingGRNMatch] = useState(false);
  const [billForm, setBillForm] = useState({
    bill_number: '',
    bill_date: new Date().toISOString().split('T')[0],
    vendor: { name: '', phone: '', email: '', gst_number: '', address: '', city: '', state: '', pincode: '' },
    items: [{ product_name: '', hsn_code: '', quantity: 1, rate: 0, tax_rate: 18, discount_percent: 0 }],
    payment_mode: 'credit',
    payment_status: 'pending',
    due_date: '',
    notes: '',
    po_number: ''
  });
  const [billPOOptions, setBillPOOptions] = useState([]);
  const [showBillPOWarning, setShowBillPOWarning] = useState(false);
  const [tdsRates, setTdsRates] = useState([]);
  const [tdsSearchTerm, setTdsSearchTerm] = useState('');
  const [showTdsDropdown, setShowTdsDropdown] = useState(false);
  const [selectedTds, setSelectedTds] = useState(null);
  const [tdsRateOverride, setTdsRateOverride] = useState('');
  const [tdsNoDeduction, setTdsNoDeduction] = useState(false);

  useEffect(() => {
    fetchBills();
  }, [storeData]);

  useEffect(() => {
    if (!showAddBill) return;
    const fetchPOsForBill = async () => {
      try {
        const response = await fetch(`${BACKEND_URL}/api/purchases/?limit=200`);
        const data = await response.json();
        setBillPOOptions(data.purchases || []);
      } catch (error) {
        console.error('Error fetching purchase orders for bill:', error);
        setBillPOOptions([]);
      }
    };
    fetchPOsForBill();
  }, [showAddBill]);

  useEffect(() => {
    fetch(`${BACKEND_URL}/api/tds/rates`)
      .then(res => res.json())
      .then(data => { if (data.status === 'success') setTdsRates(data.rates || []); })
      .catch(err => console.error('Failed to load TDS rates:', err));
  }, []);

  useEffect(() => {
    if (!showAddBill || !billForm.bill_number || billForm.bill_number.trim().length < 3) {
      setInvoiceGRNMatch(null);
      return;
    }

    const timer = setTimeout(async () => {
      setCheckingGRNMatch(true);

      try {
        const response = await fetch(
          `${BACKEND_URL}/api/grn/lookup-by-invoice/${encodeURIComponent(billForm.bill_number.trim())}`
        );

        const data = await response.json();

        if (data.status === 'success' && data.found) {
          setInvoiceGRNMatch(data.grn);
        } else {
          setInvoiceGRNMatch(null);
        }
      } catch (error) {
        console.error('Error looking up GRN by invoice number:', error);
        setInvoiceGRNMatch(null);
      } finally {
        setCheckingGRNMatch(false);
      }
    }, 500);

    return () => clearTimeout(timer);
  }, [billForm.bill_number, showAddBill]);

  const fillFromMatchedGRN = (grn) => {
    if (!grn) return;

    setBillForm(prev => ({
      ...prev,
      bill_date: grn.vendor_invoice_date || prev.bill_date,
      vendor: {
        ...prev.vendor,
        name: grn.vendor_name || prev.vendor.name,
        gst_number: grn.vendor_gstin || prev.vendor.gst_number
      },
      items: (grn.items || []).map(item => ({
        product_name: item.product_name || '',
        hsn_code: item.hsn_code || '',
        quantity: item.received_quantity ?? item.ordered_quantity ?? 1,
        rate: item.unit_price ?? 0,
        discount_percent: 0,
        tax_rate: 18
      }))
    }));

    showToast.success(`Filled from GRN ${grn.grn_number}`);
    setInvoiceGRNMatch(null);
  };

  const fetchBills = async () => {
    setLoading(true);
    try {
      const response = await fetch(`${BACKEND_URL}/api/purchase-bills/?limit=5000`);
      const data = await response.json();
      const billsData = data.bills || [];
      setBills(billsData);
      
      // Calculate summary from bills
      const totalValue = billsData.reduce((sum, b) => sum + (b.grand_total || 0), 0);
      const totalPaid = billsData.reduce((sum, b) => sum + (b.amount_paid || 0), 0);
      const pendingCount = billsData.filter(b => b.payment_status === 'pending').length;
      
      setSummary({
        total_value: totalValue,
        total_paid: totalPaid,
        balance_due: totalValue - totalPaid,
        pending_count: pendingCount
      });
    } catch (error) {
      console.error('Error fetching purchase bills:', error);
      setBills([]);
    } finally {
      setLoading(false);
    }
  };

  const calculateTotals = () => {
    // Rates entered are GST-INCLUSIVE (the vendor's actual invoice amount),
    // so tax is extracted from the entered rate rather than added on top.
    let subtotal = 0;
    let totalTax = 0;
    let grandTotal = 0;

    let storeGstin = storeData?.gst_number || '';
    if (!storeGstin) {
      try {
        storeGstin = JSON.parse(localStorage.getItem('storeData') || '{}')?.gst_number || '';
      } catch (e) {
        storeGstin = '';
      }
    }
    const storeStateCode = getGstStateCodeFromGstin(storeGstin);
    const vendorStateCode = getGstStateCodeFromGstin(billForm.vendor?.gst_number);
    const isInterState = !!(storeStateCode && vendorStateCode && storeStateCode !== vendorStateCode);

    billForm.items.forEach(item => {
      const itemGross = item.quantity * item.rate;
      const discount = itemGross * (item.discount_percent / 100);
      const inclusiveAfterDiscount = itemGross - discount;
      const taxRate = item.tax_rate || 0;
      const taxable = inclusiveAfterDiscount / (1 + taxRate / 100);
      subtotal += taxable;
      totalTax += inclusiveAfterDiscount - taxable;
      grandTotal += inclusiveAfterDiscount;
    });

    const round2 = (v) => Math.round(v * 100) / 100;

    let tdsRatePercent = 0;
    if (selectedTds && !tdsNoDeduction) {
      if (selectedTds.rate_type === 'percentage') {
        tdsRatePercent = selectedTds.rate_value;
      } else {
        const parsed = parseFloat(tdsRateOverride);
        tdsRatePercent = isNaN(parsed) ? 0 : parsed / 100;
      }
    }
    const tdsDeduction = round2(subtotal * tdsRatePercent);
    const netPayable = round2(grandTotal - tdsDeduction);

    return {
      subtotal: round2(subtotal),
      cgst: isInterState ? 0 : round2(totalTax / 2),
      sgst: isInterState ? 0 : round2(totalTax / 2),
      igst: isInterState ? round2(totalTax) : 0,
      isInterState,
      total_tax: round2(totalTax),
      grand_total: round2(grandTotal),
      tds_deduction: tdsDeduction,
      net_payable: netPayable
    };
  };

  const handleSubmit = async (e) => {
    e.preventDefault();

    if (!billForm.po_number) {
      setShowBillPOWarning(true);
      return;
    }
    setShowBillPOWarning(false);

    const totals = calculateTotals();
    
    try {
      const response = await fetch(`${BACKEND_URL}/api/purchase-bills/create`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ...billForm,
          po_number: billForm.po_number === 'VERBAL' ? null : billForm.po_number,
          po_reference: billForm.po_number,
          is_verbal_purchase: billForm.po_number === 'VERBAL',
          bypass_po_check: billForm.po_number === 'VERBAL',
          subtotal: totals.subtotal,
          cgst: totals.cgst,
          sgst: totals.sgst,
          igst: totals.igst,
          total_tax: totals.total_tax,
          grand_total: totals.grand_total,
          tds: selectedTds ? {
            section: selectedTds.old_section,
            code: selectedTds.code,
            rate_applied: tdsNoDeduction ? 0 : (selectedTds.rate_type === 'percentage' ? selectedTds.rate_value : ((parseFloat(tdsRateOverride) || 0) / 100)),
            deducted: !tdsNoDeduction,
            amount_deducted: tdsNoDeduction ? 0 : totals.tds_deduction
          } : null
        })
      });
      
      const data = await response.json();
      if (data.status === 'success') {
        alert('Purchase bill created successfully!');
        setShowAddBill(false);
        fetchBills();
        setBillForm({
          bill_number: '',
          bill_date: new Date().toISOString().split('T')[0],
          vendor: { name: '', phone: '', email: '', gst_number: '', address: '', city: '', state: '', pincode: '' },
          items: [{ product_name: '', hsn_code: '', quantity: 1, rate: 0, tax_rate: 18, discount_percent: 0 }],
          payment_mode: 'credit',
          payment_status: 'pending',
          due_date: '',
          notes: '',
          po_number: ''
        });
        setSelectedTds(null);
        setTdsSearchTerm('');
        setTdsRateOverride('');
        setTdsNoDeduction(false);
      } else {
        alert(getErrorMessage(data.detail, 'Failed to create purchase bill'));
      }
    } catch (error) {
      alert('Error creating purchase bill');
    }
  };

  const addItem = () => {
    setBillForm({
      ...billForm,
      items: [...billForm.items, { product_name: '', hsn_code: '', quantity: 1, rate: 0, tax_rate: 18, discount_percent: 0 }]
    });
  };

  const updateItem = (index, field, value) => {
    const newItems = [...billForm.items];
    newItems[index][field] = value;
    setBillForm({ ...billForm, items: newItems });
  };

  const removeItem = (index) => {
    if (billForm.items.length > 1) {
      setBillForm({
        ...billForm,
        items: billForm.items.filter((_, i) => i !== index)
      });
    }
  };

  const totals = calculateTotals();

  return (
    <div className="space-y-6">
      {/* Summary Cards */}
      <div className="grid grid-cols-4 gap-4">
        <div className="bg-white rounded-xl shadow-sm p-4 border-l-4 border-blue-500">
          <p className="text-sm text-gray-500">Total Purchase Value</p>
          <p className="text-xl font-bold text-gray-800">{formatCurrency(summary.total_value)}</p>
        </div>
        <div className="bg-white rounded-xl shadow-sm p-4 border-l-4 border-green-500">
          <p className="text-sm text-gray-500">Amount Paid</p>
          <p className="text-xl font-bold text-green-600">{formatCurrency(summary.total_paid)}</p>
        </div>
        <div className="bg-white rounded-xl shadow-sm p-4 border-l-4 border-red-500">
          <p className="text-sm text-gray-500">Balance Payable</p>
          <p className="text-xl font-bold text-red-600">{formatCurrency(summary.balance_due)}</p>
        </div>
        <div className="bg-white rounded-xl shadow-sm p-4 border-l-4 border-amber-500">
          <p className="text-sm text-gray-500">Pending Bills</p>
          <p className="text-xl font-bold text-amber-600">{summary.pending_count}</p>
        </div>
      </div>

      {/* Bills List */}
      <div className="bg-white rounded-xl shadow-sm">
        <div className="p-4 border-b flex items-center justify-between">
          <h2 className="text-lg font-semibold text-gray-800">Purchase Bills / Vendor Invoices</h2>
          <button
            onClick={() => setShowAddBill(true)}
            className="flex items-center gap-2 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700"
          >
            <Plus className="w-4 h-4" />
            Add Purchase Bill
          </button>
        </div>

        {loading ? (
          <div className="p-8 text-center">
            <div className="animate-spin w-8 h-8 border-4 border-blue-500 border-t-transparent rounded-full mx-auto"></div>
          </div>
        ) : bills.length > 0 ? (
          <table className="w-full">
            <thead className="bg-gray-50">
              <tr>
                <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Bill #</th>
                <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Vendor</th>
                <th className="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Amount</th>
                <th className="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Status</th>
                <th className="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Balance</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-gray-200">
              {bills.map((bill) => (
                <tr key={bill.id} className="hover:bg-gray-50">
                  <td className="px-4 py-3 text-sm font-medium text-blue-600">{bill.bill_number}</td>
                  <td className="px-4 py-3 text-sm text-gray-500">{bill.bill_date}</td>
                  <td className="px-4 py-3 text-sm">
                    <div className="font-medium text-gray-800">{bill.vendor?.name}</div>
                    {bill.vendor?.gst_number && (
                      <div className="text-xs text-gray-500">GST: {bill.vendor?.gst_number}</div>
                    )}
                  </td>
                  <td className="px-4 py-3 text-sm font-medium text-right">{formatCurrency(bill.grand_total)}</td>
                  <td className="px-4 py-3 text-center">
                    <span className={`px-2 py-1 rounded-full text-xs font-medium ${
                      bill.payment_status === 'paid' ? 'bg-green-100 text-green-800' :
                      bill.payment_status === 'partial' ? 'bg-amber-100 text-amber-800' :
                      'bg-red-100 text-red-800'
                    }`}>
                      {bill.payment_status?.toUpperCase()}
                    </span>
                  </td>
                  <td className="px-4 py-3 text-sm font-medium text-right text-red-600">
                    {formatCurrency(bill.balance_due || (bill.grand_total - (bill.amount_paid || 0)))}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <div className="p-8 text-center text-gray-500">
            <FileText className="w-12 h-12 mx-auto mb-2 text-gray-300" />
            <p>No purchase bills found</p>
            <p className="text-sm">Click "Add Purchase Bill" to record a vendor invoice</p>
          </div>
        )}
      </div>

      {/* Add Purchase Bill Modal */}
      {showAddBill && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
          <div className="bg-white rounded-xl shadow-xl w-full max-w-4xl max-h-[90vh] overflow-hidden">
            <div className="p-4 border-b bg-gradient-to-r from-blue-600 to-blue-700 text-white flex items-center justify-between">
              <h2 className="text-lg font-bold">Add Purchase Bill</h2>
              <button onClick={() => setShowAddBill(false)} className="p-1 hover:bg-white/20 rounded">
                <X className="w-5 h-5" />
              </button>
            </div>
            
            <form onSubmit={handleSubmit} className="p-6 overflow-y-auto max-h-[calc(90vh-140px)]">
              <div className="grid grid-cols-2 gap-6">
                {/* Bill Info */}
                <div className="space-y-4">
                  <h3 className="font-semibold text-gray-800 border-b pb-2">Bill Details</h3>
                  <div className="grid grid-cols-2 gap-3">
                    <div>
                      <label className="block text-sm font-medium text-gray-700 mb-1">Bill Number *</label>
                      <input
                        type="text"
                        required
                        value={billForm.bill_number}
                        onChange={(e) => setBillForm({...billForm, bill_number: e.target.value})}
                        className="w-full px-3 py-2 border rounded-lg"
                        placeholder="Vendor's invoice #"
                      />

                      {checkingGRNMatch && (
                        <div className="mt-2 text-xs text-purple-600">
                          Checking for matching GRN...
                        </div>
                      )}

                      {invoiceGRNMatch && (
                        <div className="mt-2 rounded-lg border border-purple-200 bg-purple-50 p-3">
                          <div className="text-sm text-purple-900">
                            <span className="font-semibold">Match found:</span> GRN {invoiceGRNMatch.grn_number} from {invoiceGRNMatch.vendor_name}
                            {Array.isArray(invoiceGRNMatch.items) && ` (${invoiceGRNMatch.items.length} item${invoiceGRNMatch.items.length === 1 ? '' : 's'})`}
                          </div>

                          <button
                            type="button"
                            onClick={() => fillFromMatchedGRN(invoiceGRNMatch)}
                            className="mt-2 text-sm font-medium text-purple-700 hover:text-purple-900"
                          >
                            Use this GRN — fill vendor & items
                          </button>
                        </div>
                      )}
                    </div>
                    <div>
                      <label className="block text-sm font-medium text-gray-700 mb-1">Bill Date *</label>
                      <input
                        type="date"
                        required
                        value={billForm.bill_date}
                        onChange={(e) => setBillForm({...billForm, bill_date: e.target.value})}
                        className="w-full px-3 py-2 border rounded-lg"
                      />
                    </div>
                    <div>
                      <label className="block text-sm font-medium text-gray-700 mb-1">Payment Mode</label>
                      <select
                        value={billForm.payment_mode}
                        onChange={(e) => setBillForm({...billForm, payment_mode: e.target.value})}
                        className="w-full px-3 py-2 border rounded-lg"
                      >
                        <option value="credit">Credit</option>
                        <option value="cash">Cash</option>
                        <option value="bank_transfer">Bank Transfer</option>
                        <option value="cheque">Cheque</option>
                      </select>
                    </div>
                    <div>
                      <label className="block text-sm font-medium text-gray-700 mb-1">Due Date</label>
                      <input
                        type="date"
                        value={billForm.due_date}
                        onChange={(e) => setBillForm({...billForm, due_date: e.target.value})}
                        className="w-full px-3 py-2 border rounded-lg"
                      />
                    </div>
                    <div className="col-span-2">
                      <label className="block text-sm font-medium text-gray-700 mb-1">
                        PO Reference * <span className="text-xs text-gray-500">(Select PO or Verbal)</span>
                      </label>
                      <select
                        value={billForm.po_number}
                        onChange={(e) => {
                          const value = e.target.value;
                          setShowBillPOWarning(false);
                          if (value && value !== 'VERBAL') {
                            const selectedPO = billPOOptions.find(po => po.po_number === value);
                            if (selectedPO && selectedPO.vendor) {
                              setBillForm(prev => ({
                                ...prev,
                                po_number: value,
                                vendor: {
                                  ...prev.vendor,
                                  name: selectedPO.vendor.name || prev.vendor.name,
                                  gst_number: selectedPO.vendor.gst_number || prev.vendor.gst_number,
                                  phone: selectedPO.vendor.phone || prev.vendor.phone,
                                  email: selectedPO.vendor.email || prev.vendor.email,
                                  address: selectedPO.vendor.address || prev.vendor.address,
                                  city: selectedPO.vendor.city || prev.vendor.city,
                                  state: selectedPO.vendor.state || prev.vendor.state
                                }
                              }));
                              return;
                            }
                          }
                          setBillForm(prev => ({ ...prev, po_number: value }));
                        }}
                        className={`w-full px-3 py-2 border rounded-lg ${showBillPOWarning ? 'border-red-500 bg-red-50' : 'border-gray-300'}`}
                      >
                        <option value="">-- Select Purchase Order --</option>
                        <option value="VERBAL">📞 VERBAL (No PO - Direct Purchase)</option>
                        <optgroup label="Purchase Orders">
                          {billPOOptions.map(po => (
                            <option key={po.po_number} value={po.po_number}>
                              {po.po_number} - {po.vendor?.name || 'Unknown'} (₹{(po.total_amount || 0).toLocaleString('en-IN')})
                            </option>
                          ))}
                        </optgroup>
                      </select>
                      {showBillPOWarning && (
                        <p className="text-red-600 text-xs mt-1">
                          Please select a PO or choose "VERBAL" for direct purchases.
                        </p>
                      )}
                    </div>
                  </div>
                </div>

                {/* Vendor Info */}
                <div className="space-y-4">
                  <h3 className="font-semibold text-gray-800 border-b pb-2">Vendor Details</h3>
                  <div className="grid grid-cols-2 gap-3">
                    <div className="col-span-2">
                      <label className="block text-sm font-medium text-gray-700 mb-1">Vendor Name *</label>
                      <input
                        type="text"
                        required
                        value={billForm.vendor.name}
                        onChange={(e) => setBillForm({...billForm, vendor: {...billForm.vendor, name: e.target.value}})}
                        className="w-full px-3 py-2 border rounded-lg"
                        placeholder="Company/Supplier name"
                      />
                    </div>
                    <div>
                      <label className="block text-sm font-medium text-gray-700 mb-1">GST Number</label>
                      <input
                        type="text"
                        value={billForm.vendor.gst_number}
                        onChange={(e) => setBillForm({...billForm, vendor: {...billForm.vendor, gst_number: e.target.value.toUpperCase()}})}
                        className="w-full px-3 py-2 border rounded-lg uppercase"
                        placeholder="GST number"
                        maxLength={15}
                      />
                    </div>
                    <div>
                      <label className="block text-sm font-medium text-gray-700 mb-1">Phone</label>
                      <input
                        type="tel"
                        value={billForm.vendor.phone}
                        onChange={(e) => setBillForm({...billForm, vendor: {...billForm.vendor, phone: e.target.value}})}
                        className="w-full px-3 py-2 border rounded-lg"
                        placeholder="Contact number"
                      />
                    </div>
                  </div>
                </div>
              </div>

              {/* TDS Details */}
              <div className="mt-6 bg-purple-50 border border-purple-200 rounded-lg p-4">
                <h3 className="font-semibold text-purple-900 mb-3">TDS Details</h3>
                <div className="relative">
                  <input
                    type="text"
                    placeholder="Search TDS section..."
                    value={selectedTds ? selectedTds.old_section : tdsSearchTerm}
                    onChange={(e) => {
                      setTdsSearchTerm(e.target.value);
                      setSelectedTds(null);
                      setTdsRateOverride('');
                      setTdsNoDeduction(false);
                      setShowTdsDropdown(true);
                    }}
                    onFocus={() => { if (!selectedTds) setShowTdsDropdown(true); }}
                    className="w-full px-3 py-2 border border-gray-300 rounded-lg"
                  />
                  {selectedTds && (
                    <button
                      type="button"
                      onClick={() => { setSelectedTds(null); setTdsSearchTerm(''); setTdsRateOverride(''); setTdsNoDeduction(false); }}
                      className="absolute right-2 top-2 text-gray-400 hover:text-gray-600"
                    >
                      <X className="w-4 h-4" />
                    </button>
                  )}
                  {showTdsDropdown && !selectedTds && tdsSearchTerm.length > 0 && (
                    <div className="absolute z-10 mt-1 w-full bg-white border border-gray-300 rounded-lg shadow-lg max-h-56 overflow-y-auto">
                      {tdsRates
                        .filter(r => r.old_section.toLowerCase().includes(tdsSearchTerm.toLowerCase()))
                        .map(r => (
                          <div
                            key={r.code + r.nature_of_payment}
                            onClick={() => {
                              setSelectedTds(r);
                              setTdsSearchTerm('');
                              setShowTdsDropdown(false);
                              setTdsRateOverride('');
                              setTdsNoDeduction(false);
                            }}
                            className="px-3 py-2 hover:bg-purple-50 cursor-pointer text-sm border-b border-gray-100"
                          >
                            <div className="font-medium">{r.old_section}</div>
                            <div className="text-xs text-gray-500">{r.nature_of_payment} — {r.rate_type === 'percentage' ? `${(r.rate_value * 100).toFixed(2)}%` : r.rate_text}</div>
                          </div>
                        ))}
                      {tdsRates.filter(r => r.old_section.toLowerCase().includes(tdsSearchTerm.toLowerCase())).length === 0 && (
                        <div className="px-3 py-2 text-sm text-gray-400">No matching section</div>
                      )}
                    </div>
                  )}
                </div>

                {selectedTds && (
                  <div className="mt-3 p-3 bg-white border border-purple-200 rounded-lg">
                    <p className="text-sm font-medium text-gray-800">{selectedTds.nature_of_payment}</p>
                    <p className="text-xs text-gray-500 mb-2">Code: {selectedTds.code} | Threshold: {selectedTds.threshold}</p>
                    <div className="flex items-center gap-3 mb-2">
                      <label className="text-sm text-gray-700">Rate:</label>
                      {selectedTds.rate_type === 'percentage' ? (
                        <span className="px-2 py-1 bg-purple-100 text-purple-800 rounded text-sm font-medium">
                          {(selectedTds.rate_value * 100).toFixed(2)}%
                        </span>
                      ) : (
                        <>
                          <input
                            type="number"
                            step="0.01"
                            placeholder="Enter %"
                            value={tdsRateOverride}
                            onChange={(e) => setTdsRateOverride(e.target.value)}
                            disabled={tdsNoDeduction}
                            className="w-24 px-2 py-1 border border-gray-300 rounded text-sm disabled:bg-gray-100"
                          />
                          <span className="text-xs text-gray-500">(rate marked "{selectedTds.rate_text}" — enter manually)</span>
                        </>
                      )}
                    </div>
                    <label className="flex items-center gap-2 text-sm text-gray-700">
                      <input
                        type="checkbox"
                        checked={tdsNoDeduction}
                        onChange={(e) => setTdsNoDeduction(e.target.checked)}
                      />
                      No deduction (threshold already met elsewhere)
                    </label>
                  </div>
                )}
              </div>

              {/* Line Items */}
              <div className="mt-6">
                <div className="flex items-center justify-between mb-3">
                  <h3 className="font-semibold text-gray-800">Line Items</h3>
                  <button type="button" onClick={addItem} className="text-sm text-blue-600 hover:text-blue-800">
                    + Add Item
                  </button>
                </div>
                
                <table className="w-full text-sm">
                  <thead className="bg-gray-50">
                    <tr>
                      <th className="px-2 py-2 text-left">Product</th>
                      <th className="px-2 py-2 text-left w-24">HSN</th>
                      <th className="px-2 py-2 text-center w-16">Qty</th>
                      <th className="px-2 py-2 text-right w-24">Rate</th>
                      <th className="px-2 py-2 text-center w-16">Tax%</th>
                      <th className="px-2 py-2 text-right w-24">Total</th>
                      <th className="w-8"></th>
                    </tr>
                  </thead>
                  <tbody>
                    {billForm.items.map((item, index) => {
                      // Rate is GST-inclusive: line total = qty x rate (after discount)
                      const lineTotal = (item.quantity * item.rate) * (1 - (item.discount_percent || 0) / 100);
                      return (
                        <tr key={index} className="border-b">
                          <td className="px-2 py-2">
                            <input
                              type="text"
                              value={item.product_name}
                              onChange={(e) => updateItem(index, 'product_name', e.target.value)}
                              className="w-full px-2 py-1 border rounded"
                              placeholder="Product name"
                              required
                            />
                          </td>
                          <td className="px-2 py-2">
                            <input
                              type="text"
                              value={item.hsn_code}
                              onChange={(e) => updateItem(index, 'hsn_code', e.target.value)}
                              className="w-full px-2 py-1 border rounded"
                              placeholder="HSN"
                            />
                          </td>
                          <td className="px-2 py-2">
                            <input
                              type="number"
                              value={item.quantity}
                              onChange={(e) => updateItem(index, 'quantity', parseInt(e.target.value) || 0)}
                              className="w-full px-2 py-1 border rounded text-center"
                              min="1"
                            />
                          </td>
                          <td className="px-2 py-2">
                            <input
                              type="number"
                              value={item.rate}
                              onChange={(e) => updateItem(index, 'rate', parseFloat(e.target.value) || 0)}
                              className="w-full px-2 py-1 border rounded text-right"
                              step="0.01"
                            />
                          </td>
                          <td className="px-2 py-2">
                            <select
                              value={item.tax_rate}
                              onChange={(e) => updateItem(index, 'tax_rate', parseFloat(e.target.value))}
                              className="w-full px-2 py-1 border rounded"
                            >
                              <option value="0">0%</option>
                              <option value="5">5%</option>
                              <option value="12">12%</option>
                              <option value="18">18%</option>
                              <option value="28">28%</option>
                            </select>
                          </td>
                          <td className="px-2 py-2 text-right font-medium">
                            ₹{lineTotal.toFixed(2)}
                          </td>
                          <td className="px-2 py-2">
                            {billForm.items.length > 1 && (
                              <button type="button" onClick={() => removeItem(index)} className="text-red-500 hover:text-red-700">
                                <X className="w-4 h-4" />
                              </button>
                            )}
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>

                {/* Totals */}
                <div className="mt-4 flex justify-end">
                  <div className="w-64 space-y-2 text-sm">
                    <div className="flex justify-between">
                      <span>Subtotal:</span>
                      <span>₹{totals.subtotal.toFixed(2)}</span>
                    </div>
                    {totals.isInterState ? (
                      <div className="flex justify-between text-gray-600" data-testid="bill-igst-row">
                        <span>IGST:</span>
                        <span>₹{totals.igst.toFixed(2)}</span>
                      </div>
                    ) : (
                      <>
                        <div className="flex justify-between text-gray-600" data-testid="bill-cgst-row">
                          <span>CGST:</span>
                          <span>₹{totals.cgst.toFixed(2)}</span>
                        </div>
                        <div className="flex justify-between text-gray-600" data-testid="bill-sgst-row">
                          <span>SGST:</span>
                          <span>₹{totals.sgst.toFixed(2)}</span>
                        </div>
                      </>
                    )}
                    <div className="flex justify-between font-bold text-lg border-t pt-2">
                      <span>Grand Total:</span>
                      <span data-testid="bill-grand-total">₹{totals.grand_total.toFixed(2)}</span>
                    </div>
                    {selectedTds && (
                      <>
                        <div className="flex justify-between text-purple-700">
                          <span>TDS {tdsNoDeduction ? '(no deduction)' : `(${(selectedTds.rate_type === 'percentage' ? (selectedTds.rate_value * 100) : (parseFloat(tdsRateOverride) || 0)).toFixed(2)}%)`}:</span>
                          <span>- ₹{totals.tds_deduction.toFixed(2)}</span>
                        </div>
                        <div className="flex justify-between font-semibold border-t pt-2">
                          <span>Net Payable:</span>
                          <span className="text-purple-700">₹{totals.net_payable.toFixed(2)}</span>
                        </div>
                      </>
                    )}
                  </div>
                </div>
              </div>

              {/* Notes */}
              <div className="mt-4">
                <label className="block text-sm font-medium text-gray-700 mb-1">Notes</label>
                <textarea
                  value={billForm.notes}
                  onChange={(e) => setBillForm({...billForm, notes: e.target.value})}
                  className="w-full px-3 py-2 border rounded-lg"
                  rows="2"
                  placeholder="Any additional notes..."
                ></textarea>
              </div>

              {/* Actions */}
              <div className="mt-6 flex justify-end gap-3">
                <button type="button" onClick={() => setShowAddBill(false)} className="px-4 py-2 border rounded-lg hover:bg-gray-50">
                  Cancel
                </button>
                <button type="submit" className="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                  Save Purchase Bill
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
};

export default StoreRouter;

import React, { useState, useEffect, useRef } from 'react';
import { BACKEND_URL } from '../config/api';
import { Receipt, Plus, Trash2, Save, Search, User, MapPin, CreditCard, Lock, X, Package, DollarSign, AlertCircle, Check, Sparkles, Camera, RefreshCw } from 'lucide-react';
import DocumentActions from './DocumentActions';


const OfflineInvoiceCreation = ({ storeId: propStoreId, storeOnly = false, prefilledData = null, forcedDocumentType = null }) => {
  // storeOnly mode: when true, the store is locked and can't be changed (for store users)
  const [products, setProducts] = useState([]);
  const [hsnCodes, setHsnCodes] = useState([]);
  const [stores, setStores] = useState([]);
  const [selectedStore, setSelectedStore] = useState(null);
  const [message, setMessage] = useState({ type: '', text: '' });
  const [loading, setLoading] = useState(false);
  const [productSearch, setProductSearch] = useState({});
  const [createdInvoice, setCreatedInvoice] = useState(null);
  const [isStoreLocked, setIsStoreLocked] = useState(storeOnly);
  
  // Add New Product Modal State
  const [showAddProductModal, setShowAddProductModal] = useState(false);
  const [addProductForIndex, setAddProductForIndex] = useState(null);
  const [newProduct, setNewProduct] = useState({
    name: '',
    brand: '',
    model_number: '',
    price: 0,
    hsn_code: '',
    category: '',
    description: '',
    current_stock: 0
  });
  const [addProductLoading, setAddProductLoading] = useState(false);
  const [hsnSuggestions, setHsnSuggestions] = useState({});  // Store HSN suggestions per item index
  const [newProductHsnSuggestions, setNewProductHsnSuggestions] = useState([]);  // HSN suggestions for Add Product modal
  const [manualHsnMode, setManualHsnMode] = useState(false);  // Toggle for manual HSN entry
  const [manualHsnGstRate, setManualHsnGstRate] = useState(18);  // GST rate for manual HSN
  
  // Customer search
  const [existingCustomers, setExistingCustomers] = useState([]);
  const [customerSearchTerm, setCustomerSearchTerm] = useState('');
  const [showCustomerDropdown, setShowCustomerDropdown] = useState(false);
  const [searchingCustomers, setSearchingCustomers] = useState(false);
  
  const [customerDetails, setCustomerDetails] = useState({
    customer_type: 'B2C', // B2B or B2C
    name: '',
    phone: '',  // Primary phone (mandatory)
    alternate_phones: [],  // Additional phone numbers
    email: '',
    gst_number: '',
    msme_udyam_number: '',
    // Billing Address
    billing_name: '',
    billing_address: '',
    billing_city: '',
    billing_state: '',
    billing_pincode: '',
    // Shipping Address
    shipping_same_as_billing: true,
    shipping_name: '',
    shipping_address: '',
    shipping_city: '',
    shipping_state: '',
    shipping_pincode: '',
    shipping_phone: '',  // Delivery contact phone
    shipping_location_link: '',  // Google Maps link for delivery
    // Legacy (for backward compatibility)
    address: '',
    city: '',
    state: '',
    pincode: '',
    location_link: ''
  });

  const [invoiceItems, setInvoiceItems] = useState([{
    product_id: '',
    product_name: '',
    hsn_code: '',
    quantity: 1,
    rate: 0,
    discount: 0,
    tax_rate: 18.0,
    has_serial_tracking: false,
    serial_numbers: [],
    available_serials: [],
    manual_serials: ''
  }]);

  const [invoiceDetails, setInvoiceDetails] = useState({
    payment_mode: 'cash',
    discount: 0,
    delivery_charges: 0,
    round_off: 0,
    coupon_code: '',
    notes: '',
    document_type: forcedDocumentType || 'invoice',  // 'invoice' or 'sales_order'
    store_code: '',
    is_cod: false,
    is_pod: false,
    order_source: '',  // Order origin tracking
    payment_details: null,  // Transaction details for card/UPI/bank
    expected_delivery_date: '',  // Expected delivery date for SO
    immediate_delivery: true,  // If true, goes to SO to Invoice. If false, goes to Pending SOs
    // Split payment support
    payments: [{ mode: 'cash', amount: '', reference: '' }],  // Multiple payment entries
    total_advance: 0  // Total advance amount received
  });

  // Document number preview state
  const [nextDocumentNumber, setNextDocumentNumber] = useState('');
  const [loadingDocNumber, setLoadingDocNumber] = useState(false);

  // E-Way Bill / E-Invoice generation state
  const [isGeneratingEwb, setIsGeneratingEwb] = useState(false);
  const [ewbError, setEwbError] = useState('');
  const [isGeneratingEinvoice, setIsGeneratingEinvoice] = useState(false);
  const [einvoiceError, setEinvoiceError] = useState('');
  const [einvoiceResult, setEinvoiceResult] = useState(null); // { irn, ack_no, ack_date, signed_qr_code }
  const [ewbVehicleNumber, setEwbVehicleNumber] = useState('');
  const [ewbDistance, setEwbDistance] = useState('');

  // Scan & Autofill from PDF state
  const [showScanAutofillModal, setShowScanAutofillModal] = useState(false);
  const [scanAutofillFile, setScanAutofillFile] = useState(null);
  const [scanningAutofill, setScanningAutofill] = useState(false);
  const scanAutofillFileInputRef = useRef(null);

  // Fetch next document number preview
  const fetchNextDocumentNumber = async (storeId, docType) => {
    if (!storeId) return;
    setLoadingDocNumber(true);
    try {
      const response = await fetch(`${BACKEND_URL}/api/document-numbering/preview/${storeId}/${docType}`);
      if (response.ok) {
        const data = await response.json();
        setNextDocumentNumber(data.preview || data.next_number || '');
      }
    } catch (error) {
      console.error('Error fetching document number:', error);
    } finally {
      setLoadingDocNumber(false);
    }
  };

  // Fetch document number when store or document type changes
  useEffect(() => {
    if (selectedStore?.id) {
      fetchNextDocumentNumber(selectedStore.id, invoiceDetails.document_type);
    }
  }, [selectedStore?.id, invoiceDetails.document_type]);

  useEffect(() => {
    fetchProducts();
    fetchHSNCodes();
    // Only fetch stores list if not in storeOnly mode
    if (!storeOnly) {
      fetchStores();
    }
  }, [storeOnly]);

  // Handle store user mode - get store from localStorage
  useEffect(() => {
    if (storeOnly) {
      const storeDataStr = localStorage.getItem('storeData');
      if (storeDataStr) {
        try {
          const storeData = JSON.parse(storeDataStr);
          // Use the store data directly from login
          const storeForInvoice = {
            id: storeData.id,
            code: storeData.code,
            name: storeData.name,
            type: storeData.type || 'Store',
            address: storeData.address || '',
            city: storeData.city || '',
            pincode: storeData.pincode || '',
            state: storeData.state || '',
            phone: storeData.phone || '',
            email: storeData.email || '',
            whatsapp: storeData.whatsapp || '',
            invoice_prefix: storeData.invoice_prefix || storeData.code,
            so_prefix: storeData.so_prefix || `${storeData.code}SO`,
            gst_number: storeData.gst_number || ''
          };
          setSelectedStore(storeForInvoice);
          setStores([storeForInvoice]); // Add to stores list for UI
          setInvoiceDetails(prev => ({ ...prev, store_code: storeForInvoice.code }));
          setIsStoreLocked(true);
        } catch (e) {
          console.error('Error parsing store data:', e);
        }
      }
    }
  }, [storeOnly]);

  // Handle prop-based store selection (for store users - fallback)
  useEffect(() => {
    if (propStoreId && stores.length > 0 && !storeOnly) {
      // Try to find store by ID first, then by code
      let store = stores.find(s => s.id === propStoreId);
      if (!store) {
        // propStoreId might actually be the store code
        store = stores.find(s => s.code === propStoreId);
      }
      if (store) {
        setSelectedStore(store);
        setInvoiceDetails(prev => ({ ...prev, store_code: store.code }));
        setIsStoreLocked(true);
      }
    }
  }, [propStoreId, stores, storeOnly]);

  // Handle prefilled data from Customer PO
  useEffect(() => {
    if (prefilledData && prefilledData.fromCustomerPO) {
      // Set document type
      if (prefilledData.documentType) {
        setInvoiceDetails(prev => ({ ...prev, document_type: prefilledData.documentType }));
      }
      
      // Set customer details
      if (prefilledData.customer) {
        const cust = prefilledData.customer;
        setCustomer({
          name: cust.name || '',
          phone: cust.phone || '',
          email: cust.email || '',
          gst_number: cust.gst_number || '',
          address: cust.address || cust.billing_address || '',
          billing_address: cust.billing_address || cust.address || '',
          billing_city: cust.billing_city || '',
          billing_state: cust.billing_state || '',
          billing_pincode: cust.billing_pincode || '',
          city: '',
          state: '',
          pincode: '',
          shipping_same_as_billing: true,
          shipping_address: '',
          shipping_city: '',
          shipping_state: '',
          shipping_pincode: '',
          shipping_phone: '',
          shipping_location_link: ''
        });
      }
      
      // Set items from Customer PO
      if (prefilledData.items && prefilledData.items.length > 0) {
        const newItems = prefilledData.items.map(item => ({
          product_id: item.product_id || '',
          product_name: item.product_name || '',
          brand: item.brand || '',
          model_number: item.model_number || '',
          category: '',
          hsn_code: item.hsn_code || '',
          use_manual_hsn: !!item.hsn_code,
          manual_hsn_code: item.hsn_code || '',
          quantity: item.quantity || 1,
          unit_price: item.unit_price || 0,
          mrp: item.unit_price || 0,
          discount_percent: 0,
          gst_rate: item.gst_rate || 18,
          has_serial_tracking: false,
          serial_numbers: [],
          manual_serials: ''
        }));
        setItems(newItems);
      }
      
      // Set notes with Customer PO reference
      setInvoiceDetails(prev => ({
        ...prev,
        notes: `Customer PO: ${prefilledData.customerPONumber}${prev.notes ? '\n' + prev.notes : ''}`
      }));
    }
  }, [prefilledData]);

  const fetchProducts = async () => {
    try {
      const response = await fetch(`${BACKEND_URL}/api/products`);
      const data = await response.json();
      if (data.status === 'success') {
        setProducts(data.products);
      }
    } catch (error) {
      console.error('Failed to fetch products');
    }
  };

  // Search for existing customers
  const searchCustomers = async (searchTerm) => {
    if (!searchTerm || searchTerm.length < 2) {
      setExistingCustomers([]);
      return;
    }
    
    setSearchingCustomers(true);
    try {
      const response = await fetch(`${BACKEND_URL}/api/customers/search?q=${encodeURIComponent(searchTerm)}&limit=10`);
      const data = await response.json();
      if (data.status === 'success') {
        setExistingCustomers(data.customers || []);
        setShowCustomerDropdown(true);
      }
    } catch (error) {
      console.error('Failed to search customers');
    } finally {
      setSearchingCustomers(false);
    }
  };

  // Debounced customer search
  useEffect(() => {
    const timer = setTimeout(() => {
      if (customerSearchTerm) {
        searchCustomers(customerSearchTerm);
      }
    }, 300);
    return () => clearTimeout(timer);
  }, [customerSearchTerm]);

  // Select existing customer
  const selectExistingCustomer = (customer) => {
    // Determine address - use billing_address if address is empty
    const effectiveAddress = customer.address || customer.billing_address || '';
    const effectiveCity = customer.city || customer.billing_city || '';
    const effectiveState = customer.state || customer.billing_state || '';
    const effectivePincode = customer.pincode || customer.billing_pincode || '';
    
    setCustomerDetails({
      ...customerDetails,
      customer_type: customer.gst_number ? 'B2B' : 'B2C',
      name: customer.name || '',
      phone: customer.phone || '',
      alternate_phones: customer.alternate_phones || [],
      email: customer.email || '',
      gst_number: customer.gst_number || '',
      msme_udyam_number: customer.msme_udyam_number || '',
      billing_name: customer.billing_name || customer.name || '',
      billing_address: customer.billing_address || effectiveAddress,
      billing_city: customer.billing_city || effectiveCity,
      billing_state: customer.billing_state || effectiveState,
      billing_pincode: customer.billing_pincode || effectivePincode,
      shipping_same_as_billing: true,
      // Set legacy fields for backward compatibility
      address: effectiveAddress,
      city: effectiveCity,
      state: effectiveState,
      pincode: effectivePincode
    });
    setCustomerSearchTerm('');
    setShowCustomerDropdown(false);
    setExistingCustomers([]);
  };

  const fetchStores = async () => {
    try {
      const response = await fetch(`${BACKEND_URL}/api/invoices/offline/stores`);
      const data = await response.json();
      if (data.status === 'success') {
        setStores(data.stores);
        // If storeOnly mode with propStoreId, don't auto-select first store
        // Let the propStoreId effect handle the selection
        if (!storeOnly && data.stores.length > 0 && !selectedStore) {
          setSelectedStore(data.stores[0]);
          setInvoiceDetails({ ...invoiceDetails, store_code: data.stores[0].code });
        }
      }
    } catch (error) {
      console.error('Failed to fetch stores:', error);
    }
  };

  const fetchHSNCodes = async () => {
    try {
      const response = await fetch(`${BACKEND_URL}/api/hsn/?active_only=true`);
      const data = await response.json();
      setHsnCodes(data);
    } catch (error) {
      console.error('Failed to fetch HSN codes');
    }
  };

  const showMessage = (type, text) => {
    setMessage({ type, text });
    setTimeout(() => setMessage({ type: '', text: '' }), 5000);
  };

  // Intelligent HSN code suggestion based on product name
  const fetchHsnSuggestion = async (productName, index) => {
    if (!productName || productName.length < 2) {
      setHsnSuggestions(prev => ({ ...prev, [index]: null }));
      return;
    }
    
    try {
      const response = await fetch(`${BACKEND_URL}/api/hsn/suggest?product_name=${encodeURIComponent(productName)}`);
      const data = await response.json();
      
      if (data.suggestions && data.suggestions.length > 0) {
        setHsnSuggestions(prev => ({ ...prev, [index]: data.suggestions }));
        
        // Auto-select top suggestion if there's a strong match and no HSN set yet
        const topSuggestion = data.suggestions[0];
        const currentItem = invoiceItems[index];
        if (!currentItem?.hsn_code && topSuggestion.match_score >= 50) {
          // Auto-set HSN code and GST rate
          const newItems = [...invoiceItems];
          newItems[index] = {
            ...newItems[index],
            hsn_code: topSuggestion.code,
            tax_rate: topSuggestion.gst_rate || 18.0
          };
          setInvoiceItems(newItems);
        }
      } else {
        setHsnSuggestions(prev => ({ ...prev, [index]: [] }));
      }
    } catch (error) {
      console.error('Error fetching HSN suggestions:', error);
    }
  };

  // Apply HSN suggestion to item
  const applyHsnSuggestion = (index, suggestion) => {
    const newItems = [...invoiceItems];
    newItems[index] = {
      ...newItems[index],
      hsn_code: suggestion.code,
      tax_rate: suggestion.gst_rate || 18.0
    };
    setInvoiceItems(newItems);
    setHsnSuggestions(prev => ({ ...prev, [index]: null }));
  };

  // Fetch HSN suggestion for new product modal
  const fetchNewProductHsnSuggestion = async (productName) => {
    if (!productName || productName.length < 2) {
      setNewProductHsnSuggestions([]);
      return;
    }
    
    try {
      const response = await fetch(`${BACKEND_URL}/api/hsn/suggest?product_name=${encodeURIComponent(productName)}`);
      const data = await response.json();
      
      if (data.suggestions && data.suggestions.length > 0) {
        setNewProductHsnSuggestions(data.suggestions);
        
        // Auto-select top suggestion if high confidence and no HSN set
        const topSuggestion = data.suggestions[0];
        if (!newProduct.hsn_code && topSuggestion.match_score >= 50) {
          setNewProduct(prev => ({ ...prev, hsn_code: topSuggestion.code }));
        }
      } else {
        setNewProductHsnSuggestions([]);
      }
    } catch (error) {
      console.error('Error fetching HSN suggestions for new product:', error);
    }
  };

  const handleProductSelect = async (index, productId) => {
    const product = products.find(p => p.id === productId);
    if (product) {
      // Find HSN code and its GST rate
      const productHsn = product.hsn_code || '';
      const hsnData = hsnCodes.find(h => h.code === productHsn);
      const gstRate = hsnData?.gst_rate || 18.0; // Default to 18% if not found
      
      // Check for serial tracking
      let hasSerialTracking = false;
      let availableSerials = [];
      
      try {
        const serialCheckResponse = await fetch(
          `${BACKEND_URL}/api/grn/serial-inventory/check-product/${productId}${selectedStore?.code ? `?store_code=${selectedStore.code}` : ''}`
        );
        const serialCheckData = await serialCheckResponse.json();
        
        if (serialCheckData.status === 'success' && serialCheckData.has_serial_tracking) {
          hasSerialTracking = true;
          
          // Fetch available serials
          const serialsResponse = await fetch(
            `${BACKEND_URL}/api/grn/serial-inventory/product/${productId}/available${selectedStore?.code ? `?store_code=${selectedStore.code}` : ''}`
          );
          const serialsData = await serialsResponse.json();
          
          if (serialsData.status === 'success') {
            availableSerials = serialsData.serials || [];
          }
        }
      } catch (error) {
        console.error('Error checking serial tracking:', error);
      }
      
      const newItems = [...invoiceItems];
      newItems[index] = {
        ...newItems[index],
        product_id: product.id,
        product_name: product.name,
        rate: product.price || 0,
        hsn_code: productHsn,
        tax_rate: gstRate,
        available_stock: product.current_stock || 0,
        stock_warning: product.current_stock <= 0 ? 'OUT_OF_STOCK' : 
                       product.current_stock <= (product.reorder_level || 5) ? 'LOW_STOCK' : null,
        has_serial_tracking: hasSerialTracking,
        serial_numbers: [],
        available_serials: availableSerials
      };
      setInvoiceItems(newItems);
    }
  };

  const getFilteredProducts = (searchTerm) => {
    if (!searchTerm) return products;
    const term = searchTerm.toLowerCase();
    return products.filter(p => 
      p.name.toLowerCase().includes(term) ||
      p.brand?.toLowerCase().includes(term) ||
      p.model_number?.toLowerCase().includes(term)
    );
  };

  const handleScanAutofillFileSelect = (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    const validTypes = ['.pdf', '.png', '.jpg', '.jpeg', '.webp'];
    const ext = file.name.toLowerCase().substring(file.name.lastIndexOf('.'));
    if (!validTypes.includes(ext)) {
      setMessage({ type: 'error', text: 'Please upload a PDF or image file (PNG, JPG, WEBP)' });
      return;
    }
    setScanAutofillFile(file);
  };

  const applyScannedDataToForm = (extracted) => {
    const cust = extracted.customer || {};
    setCustomerDetails(prev => ({
      ...prev,
      name: cust.name || prev.name,
      phone: cust.phone || prev.phone,
      email: cust.email || prev.email,
      gst_number: cust.gstin || prev.gst_number,
      billing_address: cust.billing_address || prev.billing_address,
      billing_city: cust.billing_city || prev.billing_city,
      billing_state: cust.billing_state || prev.billing_state,
      billing_pincode: cust.billing_pincode || prev.billing_pincode,
      address: cust.billing_address || prev.address,
      city: cust.billing_city || prev.city,
      state: cust.billing_state || prev.state,
      pincode: cust.billing_pincode || prev.pincode,
    }));

    const items = (extracted.items || []).map(it => {
      const taxRate = parseFloat(it.tax_rate) || 18;
      const unitTaxable = parseFloat(it.unit_price) || 0;
      // This form's "Rate" field is GST-inclusive (see calculateItemTotal), but the
      // AI scanner extracts the taxable (exclusive) per-unit amount, so convert here.
      const inclusiveRate = Math.round(unitTaxable * (1 + taxRate / 100) * 100) / 100;
      return {
        product_id: '',
        product_name: it.product_name || '',
        hsn_code: it.hsn_code || '',
        quantity: parseInt(it.quantity) || 1,
        rate: inclusiveRate,
        discount: parseFloat(it.discount_percent) || 0,
        tax_rate: taxRate,
        has_serial_tracking: false,
        serial_numbers: [],
        available_serials: [],
        manual_serials: ''
      };
    });
    if (items.length > 0) {
      setInvoiceItems(items);
    }

    const paymentModeMap = { 'cash': 'cash', 'upi': 'upi', 'card': 'card', 'bank transfer': 'bank_transfer', 'credit': 'credit' };
    const rawMode = (extracted.payment_mode || '').toLowerCase().trim();

    setInvoiceDetails(prev => ({
      ...prev,
      payment_mode: paymentModeMap[rawMode] || prev.payment_mode,
      delivery_charges: parseFloat(extracted.delivery_charges) || prev.delivery_charges,
      notes: extracted.notes || prev.notes
    }));
  };

  const handleScanAutofillSubmit = async () => {
    if (!scanAutofillFile) {
      setMessage({ type: 'error', text: 'Please select a file first' });
      return;
    }
    setScanningAutofill(true);
    try {
      const formData = new FormData();
      formData.append('file', scanAutofillFile);
      formData.append('store_code', selectedStore?.code || invoiceDetails.store_code || '');

      const response = await fetch(`${BACKEND_URL}/api/tally-import/scan-sales-order`, {
        method: 'POST',
        body: formData
      });
      const data = await response.json();

      if (data.status === 'success') {
        applyScannedDataToForm(data.extracted_data);
        setMessage({ type: 'success', text: 'Form auto-filled from the scanned document. Please review before saving.' });
        setShowScanAutofillModal(false);
        setScanAutofillFile(null);
      } else {
        setMessage({ type: 'error', text: data.detail || data.message || 'Scan failed. Please try again or enter details manually.' });
      }
    } catch (error) {
      console.error('Scan autofill error:', error);
      setMessage({ type: 'error', text: 'Failed to scan file' });
    } finally {
      setScanningAutofill(false);
    }
  };

  const addItem = () => {
    setInvoiceItems([...invoiceItems, {
      product_id: '',
      product_name: '',
      hsn_code: '',
      quantity: 1,
      rate: 0,
      discount: 0,
      tax_rate: 18.0,
      has_serial_tracking: false,
      serial_numbers: [],
      available_serials: [],
      manual_serials: ''
    }]);
  };

  const removeItem = (index) => {
    if (invoiceItems.length > 1) {
      setInvoiceItems(invoiceItems.filter((_, i) => i !== index));
    }
  };

  const updateItem = (index, field, value) => {
    const newItems = [...invoiceItems];
    newItems[index][field] = value;
    setInvoiceItems(newItems);
  };

  // GST number's state code determines CGST+SGST vs IGST. '29' = Karnataka (intra-state).
  // When no GST number is entered, default to intra-state (CGST+SGST).
  const isInterStateGst = () => {
    const gstNumber = (customerDetails.gst_number || '').trim();
    if (!gstNumber) return false;
    return gstNumber.substring(0, 2) !== '29';
  };

  const calculateItemTotal = (item) => {
    // Price is GST-inclusive, need to reverse calculate
    const inclusivePrice = item.rate * item.quantity;
    const discountAmount = (inclusivePrice * item.discount) / 100;
    const finalPrice = inclusivePrice - discountAmount;
    
    // Reverse calculate taxable amount from GST-inclusive price
    // Formula: Taxable Amount = Inclusive Price / (1 + GST Rate/100)
    const taxRate = item.tax_rate || 18;
    const taxableAmount = finalPrice / (1 + taxRate / 100);
    const taxAmount = finalPrice - taxableAmount;
    const interState = isInterStateGst();
    
    return {
      grossAmount: inclusivePrice,
      discountAmount: discountAmount,
      taxableAmount: taxableAmount,
      taxAmount: taxAmount,
      cgst: interState ? 0 : taxAmount / 2,
      sgst: interState ? 0 : taxAmount / 2,
      igst: interState ? taxAmount : 0,
      total: finalPrice
    };
  };

  const calculateTotals = () => {
    let totalTaxableAmount = 0;
    let totalCgst = 0;
    let totalSgst = 0;
    let totalIgst = 0;
    let totalTaxAmount = 0;
    let totalAmount = 0;
    
    invoiceItems.forEach(item => {
      const itemCalc = calculateItemTotal(item);
      totalTaxableAmount += itemCalc.taxableAmount;
      totalCgst += itemCalc.cgst;
      totalSgst += itemCalc.sgst;
      totalIgst += itemCalc.igst;
      totalTaxAmount += itemCalc.taxAmount;
      totalAmount += itemCalc.total;
    });
    
    const discountAmount = (totalAmount * invoiceDetails.discount) / 100;
    const finalTotal = totalAmount - discountAmount + invoiceDetails.delivery_charges + invoiceDetails.round_off;
    
    return {
      taxableAmount: totalTaxableAmount,
      cgst: totalCgst,
      sgst: totalSgst,
      igst: totalIgst,
      totalTax: totalTaxAmount,
      itemsTotal: totalAmount,
      discountAmount,
      deliveryCharges: invoiceDetails.delivery_charges,
      roundOff: invoiceDetails.round_off,
      finalTotal
    };
  };

  // Handle opening the Add Product modal
  const openAddProductModal = (itemIndex) => {
    setAddProductForIndex(itemIndex);
    setNewProduct({
      name: '',
      brand: '',
      model_number: '',
      price: 0,
      hsn_code: '',
      category: '',
      description: '',
      current_stock: 0
    });
    // Reset manual HSN mode
    setManualHsnMode(false);
    setManualHsnGstRate(18);
    setNewProductHsnSuggestions([]);
    setShowAddProductModal(true);
  };

  // Handle creating a new product
  const handleCreateProduct = async () => {
    if (!newProduct.name || !newProduct.price || !newProduct.hsn_code) {
      showMessage('error', 'Please fill in product name, price, and HSN code');
      return;
    }

    setAddProductLoading(true);
    try {
      // If manual HSN mode and HSN doesn't exist in our list, save it first
      let gstRate = 18.0;
      const existingHsn = hsnCodes.find(h => h.code === newProduct.hsn_code);
      
      if (manualHsnMode && !existingHsn) {
        // Save the manual HSN code to the database
        try {
          const hsnResponse = await fetch(`${BACKEND_URL}/api/hsn/`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              code: newProduct.hsn_code,
              description: `HSN ${newProduct.hsn_code} - ${newProduct.category || newProduct.name}`,
              gst_rate: manualHsnGstRate,
              category: newProduct.category || 'Uncategorized',
              is_active: true
            })
          });
          
          if (hsnResponse.ok) {
            // Refresh HSN codes list
            await fetchHSNCodes();
            gstRate = manualHsnGstRate;
          }
        } catch (hsnError) {
          console.log('HSN code might already exist or failed to save:', hsnError);
        }
        gstRate = manualHsnGstRate;
      } else if (existingHsn) {
        gstRate = existingHsn.gst_rate || 18.0;
      }

      const response = await fetch(`${BACKEND_URL}/api/products`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ...newProduct,
          id: `PROD-${Date.now()}`,
          price: parseFloat(newProduct.price),
          current_stock: parseInt(newProduct.current_stock) || 0
        })
      });

      const data = await response.json();

      if (response.ok) {
        // Refresh products list
        await fetchProducts();
        
        // Find the newly created product and select it
        if (addProductForIndex !== null) {
          const newItems = [...invoiceItems];
          newItems[addProductForIndex] = {
            ...newItems[addProductForIndex],
            product_id: data.product?.id || data.id,
            product_name: newProduct.name,
            rate: parseFloat(newProduct.price),
            hsn_code: newProduct.hsn_code,
            tax_rate: gstRate,
            available_stock: parseInt(newProduct.current_stock) || 0
          };
          setInvoiceItems(newItems);
        }

        showMessage('success', `Product "${newProduct.name}" created successfully!`);
        setShowAddProductModal(false);
        // Reset manual HSN mode
        setManualHsnMode(false);
        setManualHsnGstRate(18);
      } else {
        showMessage('error', data.detail || 'Failed to create product');
      }
    } catch (error) {
      showMessage('error', 'Error creating product: ' + error.message);
    } finally {
      setAddProductLoading(false);
    }
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    
    // Validation
    if (!invoiceDetails.store_code) {
      showMessage('error', 'Please select a store');
      return;
    }

    // Check for required customer details - accept either legacy 'address' or 'billing_address'
    const hasAddress = customerDetails.address || customerDetails.billing_address;
    if (!customerDetails.name || !customerDetails.phone || !hasAddress) {
      showMessage('error', 'Please fill all required customer details (Name, Phone, Address)');
      return;
    }

    if (invoiceItems.some(item => !item.product_name || !item.hsn_code)) {
      showMessage('error', 'Please fill all item details including HSN codes');
      return;
    }

    // Validate serial numbers for serial-tracked products
    const serialErrors = [];
    invoiceItems.forEach((item, index) => {
      if (item.has_serial_tracking && item.available_serials && item.available_serials.length > 0) {
        const selectedCount = item.serial_numbers?.length || 0;
        if (selectedCount !== item.quantity) {
          serialErrors.push(`${item.product_name}: Select ${item.quantity} serial number(s) (${selectedCount} selected)`);
        }
      }
    });
    
    if (serialErrors.length > 0) {
      showMessage('error', 'Serial Number Required:\n' + serialErrors.join('\n'));
      return;
    }

    setLoading(true);

    try {
      const { itemsTotal } = calculateTotals();
      
      const adminUser = JSON.parse(localStorage.getItem('admin_user') || '{}');
      const storeUser = JSON.parse(localStorage.getItem('storeUser') || '{}');
      
      // Prepare split payments data
      const validPayments = invoiceDetails.payments.filter(p => parseFloat(p.amount) > 0);
      const totalAdvance = validPayments.reduce((sum, p) => sum + parseFloat(p.amount), 0);
      const balanceDue = totals.finalTotal - totalAdvance;
      
      const payload = {
        customer: customerDetails,
        items: invoiceItems,
        payment_mode: validPayments.length > 0 ? validPayments[0].mode : 'cash',  // Primary payment mode
        subtotal: itemsTotal,
        discount: invoiceDetails.discount,
        delivery_charges: invoiceDetails.delivery_charges,
        round_off: invoiceDetails.round_off,
        coupon_code: invoiceDetails.coupon_code || null,
        notes: invoiceDetails.notes || null,
        created_by: adminUser.email || storeUser.email || 'admin',
        document_type: invoiceDetails.document_type,
        is_cod: invoiceDetails.is_cod,
        is_pod: invoiceDetails.is_pod,
        order_source: invoiceDetails.order_source || null,
        // Split payment details
        payment_details: {
          payments: validPayments,
          total_advance: totalAdvance,
          balance_due: balanceDue,
          is_advance: totalAdvance > 0 && totalAdvance < totals.finalTotal,
          advance_amount: totalAdvance
        },
        store_code: invoiceDetails.store_code,
        // For SO delivery scheduling
        expected_delivery_date: invoiceDetails.expected_delivery_date || null,
        immediate_delivery: invoiceDetails.immediate_delivery
      };

      const response = await fetch(`${BACKEND_URL}/api/invoices/offline/create`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const data = await response.json();

      if (response.ok && data.status === 'success') {
        const docLabel = data.document_type === 'sales_order' ? 'Sales Order' : 'Invoice';
        let message = `${docLabel} ${data.invoice_number} created successfully! Total: ₹${data.total_amount.toLocaleString()}`;
        
        // Add payment info
        if (totalAdvance > 0) {
          message += `\n\n💰 Payment Received: ₹${totalAdvance.toLocaleString()}`;
          if (balanceDue > 0) {
            message += `\n📋 Balance Due: ₹${balanceDue.toLocaleString()}`;
          }
        }
        
        // Add stock warnings if any
        if (data.stock_warnings && data.stock_warnings.length > 0) {
          const warningText = data.stock_warnings.map(w => 
            `${w.product_name}: ${w.warning} (Stock: ${w.current_stock})`
          ).join(', ');
          message += `\n\n⚠️ Stock Alerts: ${warningText}`;
        }
        
        showMessage('success', message);
        
        // If there's an advance payment, create a payment receipt
        if (totalAdvance > 0 && data.document_type === 'sales_order') {
          try {
            await fetch(`${BACKEND_URL}/api/vouchers/so-payment/create`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                so_id: data.invoice_id,
                payments: validPayments.map(p => ({
                  mode: p.mode,
                  amount: parseFloat(p.amount),
                  reference: p.reference || null
                })),
                remarks: 'Advance payment at SO creation',
                collected_by: storeUser.name || adminUser.name || 'Staff'
              })
            });
          } catch (err) {
            console.error('Error creating payment receipt:', err);
          }
        }
        
        // Store created invoice with full data for document actions
        setCreatedInvoice({
          id: data.invoice_id,
          invoice_number: data.invoice_number,
          document_type: data.document_type,
          customer: customerDetails,
          total_amount: data.total_amount
        });
        
        // Scroll to top to show action buttons
        window.scrollTo({ top: 0, behavior: 'smooth' });
        
        // Reset form after a delay to show success message
        setTimeout(() => {
          setCustomerDetails({
            customer_type: 'B2C',
            name: '', phone: '', alternate_phones: [], email: '', gst_number: '', msme_udyam_number: '',
            billing_name: '', billing_address: '', billing_city: '', billing_state: '', billing_pincode: '',
            shipping_same_as_billing: true, shipping_name: '', shipping_address: '', shipping_city: '', shipping_state: '', shipping_pincode: '',
            address: '', city: '', state: '', pincode: '', location_link: ''
          });
          setInvoiceItems([{
            product_id: '', product_name: '', hsn_code: '',
            quantity: 1, rate: 0, discount: 0, tax_rate: 18.0
          }]);
          setInvoiceDetails({
            payment_mode: 'cash', discount: 0, delivery_charges: 0,
            round_off: 0, coupon_code: '', notes: '', document_type: 'invoice', store_code: invoiceDetails.store_code,
            is_cod: false, is_pod: false, order_source: '', payment_details: null,
            payments: [{ mode: 'upi', amount: '', reference: '' }],
            total_advance: 0,
            expected_delivery_date: '', immediate_delivery: false
          });
        }, 1000);
      } else {
        // Handle validation errors from Pydantic (array of objects) or string errors
        let errorMessage = 'Failed to create invoice';
        if (data.detail) {
          if (typeof data.detail === 'string') {
            errorMessage = data.detail;
          } else if (Array.isArray(data.detail)) {
            // Pydantic validation errors
            errorMessage = data.detail.map(err => 
              `${err.loc ? err.loc.join('.') : 'Field'}: ${err.msg}`
            ).join(', ');
          } else if (typeof data.detail === 'object') {
            errorMessage = JSON.stringify(data.detail);
          }
        }
        showMessage('error', errorMessage);
      }
    } catch (error) {
      showMessage('error', 'Error: ' + error.message);
    } finally {
      setLoading(false);
    }
  };

  const totals = calculateTotals();

  return (
    <div className="p-6 bg-gray-50 min-h-screen">
      {/* Header */}
      <div className="mb-6">
        <h1 className="text-3xl font-bold text-gray-900 flex items-center gap-3">
          <Receipt className="w-8 h-8 text-emerald-700" />
          Create Offline Invoice
        </h1>
        <p className="text-gray-600 mt-2">Generate invoices for walk-in and offline customers</p>
      </div>

      {/* Message */}
      {message.text && (
        <div className={`mb-4 p-4 rounded-lg whitespace-pre-wrap ${
          message.type === 'success' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'
        }`}>
          {typeof message.text === 'string' ? message.text : JSON.stringify(message.text)}
        </div>
      )}

      {/* Document Actions - Show after invoice creation */}
      {createdInvoice && message.type === 'success' && (
        <div className="mb-6 bg-gradient-to-r from-green-50 to-emerald-50 border-2 border-green-300 rounded-lg shadow-lg p-6">
          <div className="mb-4">
            <h3 className="text-lg font-bold text-green-900 mb-2">
              🎉 {createdInvoice.document_type === 'sales_order' ? 'Sales Order' : 'Invoice'} Created Successfully!
            </h3>
            <p className="text-gray-700">
              <strong>Document #:</strong> {createdInvoice.invoice_number} | <strong>Amount:</strong> ₹{createdInvoice.total_amount?.toLocaleString()}
            </p>
          </div>
          <div className="border-t border-green-200 pt-4">
            <p className="text-sm text-gray-600 mb-3 font-medium">Share or print this document:</p>
            <DocumentActions 
              document={createdInvoice} 
              documentType="invoice"
            />
          </div>
          <button
            onClick={() => setCreatedInvoice(null)}
            className="mt-4 text-sm text-gray-600 hover:text-gray-800 underline"
          >
            Create another invoice
          </button>
        </div>
      )}

      <form onSubmit={handleSubmit}>
        <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
          {/* Left Column - Customer & Items */}
          <div className="lg:col-span-2 space-y-6">
            {/* Store Selection */}
            <div className="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-lg shadow-md p-6 border-2 border-blue-200">
              <h2 className="text-xl font-semibold mb-4 flex items-center justify-between gap-2 text-blue-900">
                <span className="flex items-center gap-2">
                  <MapPin className="w-5 h-5 text-blue-600" />
                  Select Store
                  {isStoreLocked && <Lock className="w-4 h-4 text-gray-500" title="Store is locked" />}
                </span>
                {(selectedStore || invoiceDetails.store_code) && (
                  <button
                    type="button"
                    onClick={() => setShowScanAutofillModal(true)}
                    className="flex items-center gap-2 px-3 py-1.5 bg-purple-600 text-white rounded-lg hover:bg-purple-700 text-sm font-medium"
                  >
                    <Sparkles className="w-4 h-4" />
                    Scan & Autofill from PDF
                  </button>
                )}
              </h2>
              {isStoreLocked && selectedStore ? (
                <div className="p-4 bg-white rounded-lg border border-blue-200">
                  <div className="flex items-center gap-2 mb-2">
                    <span className="px-2 py-1 bg-blue-100 text-blue-700 text-xs rounded font-medium">Your Store</span>
                  </div>
                  <p className="text-lg font-semibold text-gray-800">{selectedStore.name}</p>
                  <p className="text-sm text-gray-600">{selectedStore.address}, {selectedStore.city} - {selectedStore.pincode}</p>
                  <p className="text-sm text-gray-600">📞 {selectedStore.phone}</p>
                  <p className="text-sm text-gray-600">✉️ {selectedStore.email}</p>
                  <div className="mt-3 p-2 bg-amber-50 rounded-lg border border-amber-200">
                    <p className="text-xs text-gray-600">Next {invoiceDetails.document_type === 'sales_order' ? 'Sales Order' : 'Invoice'} #:</p>
                    <p className="text-lg font-bold text-amber-700 font-mono">
                      {loadingDocNumber ? '...' : (nextDocumentNumber || 'Loading...')}
                    </p>
                  </div>
                </div>
              ) : (
                <>
                  <select
                    value={invoiceDetails.store_code}
                    onChange={(e) => {
                      const store = stores.find(s => s.code === e.target.value);
                      setSelectedStore(store);
                      setInvoiceDetails({...invoiceDetails, store_code: e.target.value});
                    }}
                    className="w-full px-4 py-3 border-2 border-blue-300 rounded-lg focus:ring-2 focus:ring-blue-500 bg-white text-lg font-medium"
                    required
                    disabled={isStoreLocked}
                  >
                    <option value="">-- Select Store --</option>
                    {stores.map(store => (
                      <option key={store.code} value={store.code}>
                        {store.name} - {store.type}
                      </option>
                    ))}
                  </select>
                  {selectedStore && (
                    <div className="mt-4 p-4 bg-white rounded-lg border border-blue-200">
                      <p className="text-sm font-semibold text-gray-700">{selectedStore.name}</p>
                      <p className="text-sm text-gray-600">{selectedStore.address}, {selectedStore.city} - {selectedStore.pincode}</p>
                      <p className="text-sm text-gray-600">📞 {selectedStore.phone}</p>
                      <p className="text-sm text-gray-600">✉️ {selectedStore.email}</p>
                      <div className="mt-3 p-2 bg-amber-50 rounded-lg border border-amber-200">
                        <p className="text-xs text-gray-600">Next {invoiceDetails.document_type === 'sales_order' ? 'Sales Order' : 'Invoice'} #:</p>
                        <p className="text-lg font-bold text-amber-700 font-mono">
                          {loadingDocNumber ? '...' : (nextDocumentNumber || 'Loading...')}
                        </p>
                      </div>
                    </div>
                  )}
                </>
              )}
            </div>

            {/* Customer Details */}
            <div className="bg-white rounded-lg shadow p-6">
              <h2 className="text-xl font-semibold mb-4 flex items-center gap-2">
                <User className="w-5 h-5 text-emerald-700" />
                Customer Details
              </h2>
              
              {/* Customer Search */}
              <div className="mb-4 relative">
                <label className="block text-sm font-medium text-gray-700 mb-1">
                  Search Existing Customer
                </label>
                <div className="relative">
                  <input
                    type="text"
                    value={customerSearchTerm}
                    onChange={(e) => setCustomerSearchTerm(e.target.value)}
                    onFocus={() => customerSearchTerm.length >= 2 && setShowCustomerDropdown(true)}
                    className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-emerald-500 pr-10"
                    placeholder="Type name, phone, or email to search..."
                  />
                  {searchingCustomers && (
                    <div className="absolute right-3 top-1/2 transform -translate-y-1/2">
                      <div className="animate-spin h-4 w-4 border-2 border-emerald-500 border-t-transparent rounded-full"></div>
                    </div>
                  )}
                </div>
                
                {/* Customer Dropdown */}
                {showCustomerDropdown && existingCustomers.length > 0 && (
                  <div className="absolute z-20 w-full mt-1 bg-white border rounded-lg shadow-lg max-h-64 overflow-y-auto">
                    {existingCustomers.map((cust, idx) => (
                      <button
                        key={idx}
                        type="button"
                        onClick={() => selectExistingCustomer(cust)}
                        className="w-full text-left px-4 py-3 hover:bg-emerald-50 border-b border-gray-100 last:border-b-0"
                      >
                        <div className="font-medium text-gray-900">{cust.name}</div>
                        <div className="text-sm text-gray-500 flex gap-4">
                          <span>{cust.phone}</span>
                          {cust.email && <span>{cust.email}</span>}
                          {cust.gst_number && <span className="text-blue-600">GST: {cust.gst_number}</span>}
                        </div>
                      </button>
                    ))}
                  </div>
                )}
                
                {showCustomerDropdown && customerSearchTerm.length >= 2 && existingCustomers.length === 0 && !searchingCustomers && (
                  <div className="absolute z-20 w-full mt-1 bg-white border rounded-lg shadow-lg p-4 text-center text-gray-500">
                    No existing customer found. Enter details below to create new.
                  </div>
                )}
              </div>
              
              {/* B2B / B2C Toggle */}
              <div className="mb-4">
                <label className="block text-sm font-medium text-gray-700 mb-2">Customer Type *</label>
                <div className="flex gap-2">
                  <button
                    type="button"
                    onClick={() => setCustomerDetails({...customerDetails, customer_type: 'B2C'})}
                    className={`flex-1 flex items-center justify-center gap-2 px-4 py-3 rounded-lg border-2 transition-all ${
                      customerDetails.customer_type === 'B2C' 
                        ? 'border-emerald-500 bg-emerald-50 text-emerald-700' 
                        : 'border-gray-200 hover:border-gray-300'
                    }`}
                  >
                    <User className="w-5 h-5" />
                    <span className="font-medium">B2C</span>
                    <span className="text-xs text-gray-500">(Individual)</span>
                  </button>
                  <button
                    type="button"
                    onClick={() => setCustomerDetails({...customerDetails, customer_type: 'B2B'})}
                    className={`flex-1 flex items-center justify-center gap-2 px-4 py-3 rounded-lg border-2 transition-all ${
                      customerDetails.customer_type === 'B2B' 
                        ? 'border-blue-500 bg-blue-50 text-blue-700' 
                        : 'border-gray-200 hover:border-gray-300'
                    }`}
                  >
                    <CreditCard className="w-5 h-5" />
                    <span className="font-medium">B2B</span>
                    <span className="text-xs text-gray-500">(Business)</span>
                  </button>
                </div>
              </div>
              
              <div className="grid grid-cols-2 gap-4">
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">
                    {customerDetails.customer_type === 'B2B' ? 'Company Name *' : 'Customer Name *'}
                  </label>
                  <input
                    type="text"
                    value={customerDetails.name}
                    onChange={(e) => setCustomerDetails({...customerDetails, name: e.target.value})}
                    className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-emerald-500"
                    placeholder={customerDetails.customer_type === 'B2B' ? 'Company/Business name' : 'Customer name'}
                    required
                  />
                </div>
                
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">Primary Phone *</label>
                  <input
                    type="tel"
                    value={customerDetails.phone}
                    onChange={(e) => setCustomerDetails({...customerDetails, phone: e.target.value})}
                    className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-emerald-500"
                    placeholder="10-digit mobile number"
                    pattern="[0-9]{10}"
                    required
                  />
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">
                    Alternate Phone(s)
                    <button
                      type="button"
                      onClick={() => setCustomerDetails({
                        ...customerDetails,
                        alternate_phones: [...(customerDetails.alternate_phones || []), '']
                      })}
                      className="ml-2 text-xs text-emerald-600 hover:text-emerald-800"
                    >
                      + Add Number
                    </button>
                  </label>
                  {customerDetails.alternate_phones && customerDetails.alternate_phones.length > 0 ? (
                    <div className="space-y-2">
                      {customerDetails.alternate_phones.map((altPhone, idx) => (
                        <div key={idx} className="flex gap-2">
                          <input
                            type="tel"
                            value={altPhone}
                            onChange={(e) => {
                              const newPhones = [...customerDetails.alternate_phones];
                              newPhones[idx] = e.target.value;
                              setCustomerDetails({...customerDetails, alternate_phones: newPhones});
                            }}
                            className="flex-1 px-3 py-2 border rounded-lg focus:ring-2 focus:ring-emerald-500"
                            placeholder="Alternate number"
                          />
                          <button
                            type="button"
                            onClick={() => {
                              const newPhones = customerDetails.alternate_phones.filter((_, i) => i !== idx);
                              setCustomerDetails({...customerDetails, alternate_phones: newPhones});
                            }}
                            className="px-3 py-2 text-red-500 hover:bg-red-50 rounded-lg"
                          >
                            <X className="w-4 h-4" />
                          </button>
                        </div>
                      ))}
                    </div>
                  ) : (
                    <p className="text-xs text-gray-500 py-2">Click "+ Add Number" to add alternate contacts</p>
                  )}
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">Email</label>
                  <input
                    type="email"
                    value={customerDetails.email}
                    onChange={(e) => setCustomerDetails({...customerDetails, email: e.target.value})}
                    className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-emerald-500"
                  />
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">GST Number</label>
                  <input
                    type="text"
                    value={customerDetails.gst_number}
                    onChange={(e) => setCustomerDetails({...customerDetails, gst_number: e.target.value.toUpperCase()})}
                    className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-emerald-500 uppercase font-mono"
                    placeholder="e.g., 29AABCA1234F1ZP"
                    maxLength={15}
                  />
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">MSME/Udyam Number</label>
                  <input
                    type="text"
                    value={customerDetails.msme_udyam_number}
                    onChange={(e) => setCustomerDetails({...customerDetails, msme_udyam_number: e.target.value})}
                    className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                    placeholder="e.g., UDYAM-KA-01-0123456"
                  />
                </div>
              </div>
              
              {/* Bill To Section */}
              <div className="mt-6 pt-4 border-t">
                <h3 className="font-semibold text-gray-800 mb-3 flex items-center gap-2">
                  <Receipt className="w-4 h-4" />
                  Bill To (Billing Address)
                </h3>
                <div className="grid grid-cols-2 gap-4">
                  <div className="col-span-2">
                    <label className="block text-sm font-medium text-gray-700 mb-1">Billing Name</label>
                    <input
                      type="text"
                      value={customerDetails.billing_name || customerDetails.name}
                      onChange={(e) => setCustomerDetails({...customerDetails, billing_name: e.target.value})}
                      className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-emerald-500"
                      placeholder="Leave blank to use customer name"
                    />
                  </div>
                  <div className="col-span-2">
                    <label className="block text-sm font-medium text-gray-700 mb-1">Street Address *</label>
                    <textarea
                      value={customerDetails.billing_address || customerDetails.address}
                      onChange={(e) => setCustomerDetails({
                        ...customerDetails, 
                        billing_address: e.target.value,
                        address: e.target.value // Keep legacy field updated
                      })}
                      className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-emerald-500"
                      rows="2"
                      required
                    ></textarea>
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-1">City *</label>
                    <input
                      type="text"
                      value={customerDetails.billing_city || customerDetails.city}
                      onChange={(e) => setCustomerDetails({
                        ...customerDetails, 
                        billing_city: e.target.value,
                        city: e.target.value
                      })}
                      className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-emerald-500"
                      required
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-1">State *</label>
                    <input
                      type="text"
                      value={customerDetails.billing_state || customerDetails.state}
                      onChange={(e) => setCustomerDetails({
                        ...customerDetails, 
                        billing_state: e.target.value,
                        state: e.target.value
                      })}
                      className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-emerald-500"
                      required
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-1">Pincode *</label>
                    <input
                      type="text"
                      value={customerDetails.billing_pincode || customerDetails.pincode}
                      onChange={(e) => setCustomerDetails({
                        ...customerDetails, 
                        billing_pincode: e.target.value,
                        pincode: e.target.value
                      })}
                      className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-emerald-500"
                      maxLength={6}
                      required
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-1">Location Link</label>
                    <input
                      type="url"
                      value={customerDetails.location_link}
                      onChange={(e) => setCustomerDetails({...customerDetails, location_link: e.target.value})}
                      className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-emerald-500"
                      placeholder="Google Maps link"
                    />
                  </div>
                </div>
              </div>
              
              {/* Ship To Section */}
              <div className="mt-6 pt-4 border-t">
                <div className="flex items-center justify-between mb-3">
                  <h3 className="font-semibold text-gray-800 flex items-center gap-2">
                    <MapPin className="w-4 h-4" />
                    Ship To (Delivery Address)
                  </h3>
                  <label className="flex items-center gap-2 cursor-pointer">
                    <input
                      type="checkbox"
                      checked={customerDetails.shipping_same_as_billing}
                      onChange={(e) => setCustomerDetails({...customerDetails, shipping_same_as_billing: e.target.checked})}
                      className="rounded text-emerald-600"
                    />
                    <span className="text-sm text-gray-600">Same as billing</span>
                  </label>
                </div>
                
                {!customerDetails.shipping_same_as_billing && (
                  <div className="grid grid-cols-2 gap-4">
                    <div className="col-span-2">
                      <label className="block text-sm font-medium text-gray-700 mb-1">Shipping Contact Name</label>
                      <input
                        type="text"
                        value={customerDetails.shipping_name}
                        onChange={(e) => setCustomerDetails({...customerDetails, shipping_name: e.target.value})}
                        className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                      />
                    </div>
                    <div className="col-span-2">
                      <label className="block text-sm font-medium text-gray-700 mb-1">Shipping Address *</label>
                      <textarea
                        value={customerDetails.shipping_address}
                        onChange={(e) => setCustomerDetails({...customerDetails, shipping_address: e.target.value})}
                        className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                        rows="2"
                        required
                      ></textarea>
                    </div>
                    <div>
                      <label className="block text-sm font-medium text-gray-700 mb-1">City *</label>
                      <input
                        type="text"
                        value={customerDetails.shipping_city}
                        onChange={(e) => setCustomerDetails({...customerDetails, shipping_city: e.target.value})}
                        className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                        required
                      />
                    </div>
                    <div>
                      <label className="block text-sm font-medium text-gray-700 mb-1">State *</label>
                      <input
                        type="text"
                        value={customerDetails.shipping_state}
                        onChange={(e) => setCustomerDetails({...customerDetails, shipping_state: e.target.value})}
                        className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                        required
                      />
                    </div>
                    <div>
                      <label className="block text-sm font-medium text-gray-700 mb-1">Pincode *</label>
                      <input
                        type="text"
                        value={customerDetails.shipping_pincode}
                        onChange={(e) => setCustomerDetails({...customerDetails, shipping_pincode: e.target.value})}
                        className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                        maxLength={6}
                        required
                      />
                    </div>
                    <div>
                      <label className="block text-sm font-medium text-gray-700 mb-1">Phone Number *</label>
                      <input
                        type="tel"
                        value={customerDetails.shipping_phone || ''}
                        onChange={(e) => setCustomerDetails({...customerDetails, shipping_phone: e.target.value})}
                        className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                        placeholder="Contact number for delivery"
                        maxLength={10}
                        required
                      />
                    </div>
                    <div className="col-span-2">
                      <label className="block text-sm font-medium text-gray-700 mb-1">Google Maps Link</label>
                      <input
                        type="url"
                        value={customerDetails.shipping_location_link || ''}
                        onChange={(e) => setCustomerDetails({...customerDetails, shipping_location_link: e.target.value})}
                        className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                        placeholder="Paste Google Maps link for delivery location"
                      />
                    </div>
                  </div>
                )}
                
                {customerDetails.shipping_same_as_billing && (
                  <p className="text-sm text-gray-500 italic">Shipping address will be same as billing address</p>
                )}
              </div>
            </div>

            {/* Invoice Items */}
            <div className="bg-white rounded-lg shadow p-6">
              <div className="flex justify-between items-center mb-4">
                <h2 className="text-xl font-semibold">Invoice Items</h2>
                <button
                  type="button"
                  onClick={addItem}
                  className="bg-emerald-700 text-white px-4 py-2 rounded-lg hover:bg-emerald-800 flex items-center gap-2"
                >
                  <Plus className="w-4 h-4" />
                  Add Item
                </button>
              </div>

              <div className="space-y-4">
                {invoiceItems.map((item, index) => (
                  <div key={index} className="border rounded-lg p-4 relative">
                    {invoiceItems.length > 1 && (
                      <button
                        type="button"
                        onClick={() => removeItem(index)}
                        className="absolute top-2 right-2 text-red-600 hover:bg-red-50 p-1 rounded"
                      >
                        <Trash2 className="w-4 h-4" />
                      </button>
                    )}
                    
                    <div className="grid grid-cols-6 gap-3">
                      <div className="col-span-4">
                        <label className="block text-xs font-medium text-gray-700 mb-1">Search & Select Product *</label>
                        <div className="relative">
                          <div className="flex gap-2">
                            <div className="flex-1 relative">
                              <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" />
                              <input
                                type="text"
                                value={productSearch[index] || ''}
                                onChange={(e) => {
                                  setProductSearch({...productSearch, [index]: e.target.value});
                                }}
                                className="w-full pl-10 pr-3 py-2 border rounded text-sm"
                                placeholder="Type model no, brand or product name to search..."
                              />
                              {/* Search Results Dropdown */}
                              {productSearch[index] && productSearch[index].length > 1 && (
                                <div className="absolute z-10 w-full mt-1 bg-white border rounded-lg shadow-lg max-h-60 overflow-y-auto">
                                  {getFilteredProducts(productSearch[index]).length === 0 ? (
                                    <div className="p-3 text-sm text-gray-500">No products found matching "{productSearch[index]}"</div>
                                  ) : (
                                    getFilteredProducts(productSearch[index]).slice(0, 10).map(product => (
                                      <div
                                        key={product.id}
                                        onClick={() => {
                                          handleProductSelect(index, product.id);
                                          setProductSearch({...productSearch, [index]: ''});
                                        }}
                                        className="p-3 hover:bg-emerald-50 cursor-pointer border-b last:border-b-0"
                                      >
                                        <div className="font-medium text-gray-900">{product.name}</div>
                                        <div className="text-xs text-gray-500 flex gap-2 mt-1">
                                          <span className="bg-blue-100 text-blue-700 px-1.5 py-0.5 rounded">{product.brand}</span>
                                          {product.model_number && <span className="bg-gray-100 text-gray-600 px-1.5 py-0.5 rounded">{product.model_number}</span>}
                                          <span className="text-emerald-600 font-medium">₹{product.price?.toLocaleString()}</span>
                                          <span className={`px-1.5 py-0.5 rounded ${product.current_stock > 0 ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}`}>
                                            Stock: {product.current_stock || 0}
                                          </span>
                                        </div>
                                      </div>
                                    ))
                                  )}
                                </div>
                              )}
                            </div>
                            {/* Dropdown for all products */}
                            <select
                              value={item.product_id || ''}
                              onChange={(e) => {
                                if (e.target.value) {
                                  handleProductSelect(index, e.target.value);
                                }
                              }}
                              className="w-48 px-3 py-2 border rounded text-sm bg-white"
                            >
                              <option value="">All Products ▼</option>
                              {products.map(product => (
                                <option key={product.id} value={product.id}>
                                  {product.model_number || product.name?.substring(0, 30)}
                                </option>
                              ))}
                            </select>
                            {/* Add New Product Button */}
                            <button
                              type="button"
                              onClick={() => openAddProductModal(index)}
                              className="px-3 py-2 bg-blue-600 text-white rounded text-sm hover:bg-blue-700 flex items-center gap-1 whitespace-nowrap"
                              title="Add new product to inventory"
                            >
                              <Package className="w-4 h-4" />
                              + New
                            </button>
                          </div>
                        </div>
                        <div className="text-xs mt-1">
                          {item.product_id ? (
                            <div>
                              <span className="text-green-600 font-medium">✓ Selected: {item.product_name}</span>
                              {item.stock_warning === 'OUT_OF_STOCK' && (
                                <div className="mt-1 bg-red-50 border border-red-200 rounded px-2 py-1 text-red-700 flex items-center gap-1">
                                  <span>⚠️</span>
                                  <span className="font-semibold">OUT OF STOCK</span> - Available: {item.available_stock || 0} units
                                </div>
                              )}
                              {item.stock_warning === 'LOW_STOCK' && (
                                <div className="mt-1 bg-orange-50 border border-orange-200 rounded px-2 py-1 text-orange-700 flex items-center gap-1">
                                  <span>⚠️</span>
                                  <span className="font-semibold">LOW STOCK</span> - Available: {item.available_stock || 0} units
                                </div>
                              )}
                              {!item.stock_warning && item.available_stock !== undefined && (
                                <div className="mt-1 text-gray-600">
                                  Stock available: {item.available_stock} units
                                </div>
                              )}
                            </div>
                          ) : (
                            <span className="text-gray-500">Start typing or select from dropdown</span>
                          )}
                        </div>
                      </div>

                      <div className="col-span-2">
                        <label className="block text-xs font-medium text-gray-700 mb-1">Product Name (Manual)</label>
                        <input
                          type="text"
                          value={item.product_name}
                          onChange={(e) => {
                            updateItem(index, 'product_name', e.target.value);
                            // Trigger intelligent HSN suggestion when typing product name manually
                            fetchHsnSuggestion(e.target.value, index);
                          }}
                          className="w-full px-3 py-2 border rounded text-sm"
                          placeholder="Custom product/service name"
                          required
                        />
                        <div className="text-xs text-gray-500 mt-1">
                          For custom items not in inventory
                        </div>
                        {/* HSN Suggestions Dropdown */}
                        {hsnSuggestions[index] && hsnSuggestions[index].length > 0 && !item.product_id && (
                          <div className="mt-2 p-2 bg-blue-50 border border-blue-200 rounded">
                            <div className="text-xs font-medium text-blue-800 mb-1">
                              💡 Suggested HSN Codes:
                            </div>
                            <div className="space-y-1">
                              {hsnSuggestions[index].slice(0, 3).map((suggestion, sIdx) => (
                                <button
                                  key={sIdx}
                                  type="button"
                                  onClick={() => applyHsnSuggestion(index, suggestion)}
                                  className={`w-full text-left px-2 py-1 rounded text-xs hover:bg-blue-100 transition-colors ${
                                    item.hsn_code === suggestion.code ? 'bg-blue-200' : 'bg-white'
                                  }`}
                                >
                                  <span className="font-semibold text-blue-700">{suggestion.code}</span>
                                  <span className="text-gray-600 ml-2">{suggestion.category || suggestion.description?.substring(0, 35)}</span>
                                  <span className="text-green-600 ml-2 font-medium">{suggestion.gst_rate}% GST</span>
                                </button>
                              ))}
                            </div>
                          </div>
                        )}
                      </div>

                    </div>

                    <div className="grid grid-cols-5 gap-3 mt-3">
                      <div>
                        <label className="block text-xs font-medium text-gray-700 mb-1">HSN Code *</label>
                        <div className="flex gap-1">
                          <input
                            type="text"
                            list={`hsn-list-${index}`}
                            value={item.hsn_code}
                            onChange={(e) => {
                              const value = e.target.value;
                              updateItem(index, 'hsn_code', value);
                              // Auto-set GST rate if it's a known HSN
                              const selectedHsn = hsnCodes.find(h => h.code === value);
                              if (selectedHsn && selectedHsn.gst_rate) {
                                updateItem(index, 'tax_rate', selectedHsn.gst_rate);
                              }
                            }}
                            className="w-full px-3 py-2 border rounded text-sm"
                            placeholder="Type or select HSN"
                            required
                          />
                          <datalist id={`hsn-list-${index}`}>
                            {hsnCodes.map(hsn => (
                              <option key={hsn.id} value={hsn.code}>
                                {hsn.description.substring(0, 40)}
                              </option>
                            ))}
                          </datalist>
                        </div>
                        {item.hsn_code && hsnCodes.find(h => h.code === item.hsn_code) && (
                          <div className="text-xs text-gray-500 mt-1">
                            {hsnCodes.find(h => h.code === item.hsn_code)?.description?.substring(0, 35)}...
                          </div>
                        )}
                        {item.hsn_code && !hsnCodes.find(h => h.code === item.hsn_code) && (
                          <div className="text-xs text-amber-600 mt-1">
                            Custom HSN code
                          </div>
                        )}
                      </div>

                      <div>
                        <label className="block text-xs font-medium text-gray-700 mb-1">Quantity *</label>
                        <input
                          type="number"
                          value={item.quantity}
                          onChange={(e) => updateItem(index, 'quantity', parseInt(e.target.value) || 1)}
                          className="w-full px-3 py-2 border rounded text-sm"
                          min="1"
                          required
                        />
                      </div>

                      <div>
                        <label className="block text-xs font-medium text-gray-700 mb-1">Rate (₹) * <span className="text-gray-500 font-normal">(incl. GST)</span></label>
                        <input
                          type="number"
                          value={item.rate}
                          onChange={(e) => updateItem(index, 'rate', parseFloat(e.target.value) || 0)}
                          className="w-full px-3 py-2 border rounded text-sm"
                          step="0.01"
                          required
                        />
                      </div>

                      <div>
                        <label className="block text-xs font-medium text-gray-700 mb-1">Tax Rate %</label>
                        <select
                          value={item.tax_rate}
                          onChange={(e) => updateItem(index, 'tax_rate', parseFloat(e.target.value) || 0)}
                          className="w-full px-3 py-2 border rounded text-sm"
                        >
                          <option value="0">0%</option>
                          <option value="5">5%</option>
                          <option value="12">12%</option>
                          <option value="18">18%</option>
                          <option value="28">28%</option>
                        </select>
                      </div>

                      <div>
                        <label className="block text-xs font-medium text-gray-700 mb-1">Discount %</label>
                        <input
                          type="number"
                          value={item.discount}
                          onChange={(e) => updateItem(index, 'discount', parseFloat(e.target.value) || 0)}
                          className="w-full px-3 py-2 border rounded text-sm"
                          step="0.01"
                          min="0"
                          max="100"
                        />
                      </div>
                    </div>

                    {/* Serial Number Section - Optional with Manual Entry */}
                    <div className="mt-3 p-3 bg-gray-50 border border-gray-200 rounded-lg">
                      {/* Toggle for Serial Tracking */}
                      <div className="flex items-center justify-between mb-2">
                        <label className="flex items-center gap-2 cursor-pointer">
                          <input
                            type="checkbox"
                            checked={item.has_serial_tracking || false}
                            onChange={(e) => {
                              const newItems = [...invoiceItems];
                              newItems[index].has_serial_tracking = e.target.checked;
                              if (!e.target.checked) {
                                newItems[index].serial_numbers = [];
                                newItems[index].manual_serials = '';
                              }
                              setInvoiceItems(newItems);
                            }}
                            className="w-4 h-4 text-blue-600 rounded focus:ring-blue-500"
                          />
                          <span className="text-xs font-medium text-gray-700">
                            This item requires Serial Number
                          </span>
                        </label>
                        {item.has_serial_tracking && item.serial_numbers?.length !== item.quantity && (
                          <span className="text-xs text-orange-600">
                            ⚠️ Enter {item.quantity} serial(s)
                          </span>
                        )}
                      </div>

                      {/* Serial Number Entry - Only shown when serial tracking is enabled */}
                      {item.has_serial_tracking && (
                        <div className="space-y-3">
                          {/* Available Serials from Inventory (if any) */}
                          {item.available_serials && item.available_serials.length > 0 && (
                            <div>
                              <label className="text-xs font-medium text-blue-800 mb-1 block">
                                Select from Inventory ({item.available_serials.length} available):
                              </label>
                              <div className="flex flex-wrap gap-2 max-h-24 overflow-y-auto p-2 bg-blue-50 rounded">
                                {item.available_serials.map((serial) => {
                                  const isSelected = item.serial_numbers?.includes(serial.serial_number);
                                  const canSelect = isSelected || (item.serial_numbers?.length || 0) < item.quantity;
                                  return (
                                    <button
                                      key={serial.serial_number}
                                      type="button"
                                      onClick={() => {
                                        const newItems = [...invoiceItems];
                                        const currentSerials = newItems[index].serial_numbers || [];
                                        
                                        if (isSelected) {
                                          newItems[index].serial_numbers = currentSerials.filter(s => s !== serial.serial_number);
                                        } else if (canSelect) {
                                          newItems[index].serial_numbers = [...currentSerials, serial.serial_number];
                                        }
                                        
                                        setInvoiceItems(newItems);
                                      }}
                                      disabled={!canSelect && !isSelected}
                                      className={`px-2 py-1 text-xs rounded border transition-all ${
                                        isSelected 
                                          ? 'bg-blue-600 text-white border-blue-600' 
                                          : canSelect
                                            ? 'bg-white text-blue-700 border-blue-300 hover:bg-blue-100'
                                            : 'bg-gray-100 text-gray-400 border-gray-200 cursor-not-allowed'
                                      }`}
                                      title={serial.warranty_months ? `Warranty: ${serial.warranty_months} months` : ''}
                                    >
                                      {serial.serial_number}
                                      {isSelected && ' ✓'}
                                    </button>
                                  );
                                })}
                              </div>
                            </div>
                          )}

                          {/* Manual Serial Entry */}
                          <div>
                            <label className="text-xs font-medium text-gray-700 mb-1 block">
                              {item.available_serials?.length > 0 ? 'Or enter manually:' : 'Enter Serial Number(s):'}
                            </label>
                            <div className="flex gap-2">
                              <input
                                type="text"
                                placeholder={item.quantity > 1 ? "Enter serial numbers separated by comma" : "Enter serial number"}
                                value={item.manual_serials || ''}
                                onChange={(e) => {
                                  const newItems = [...invoiceItems];
                                  newItems[index].manual_serials = e.target.value;
                                  
                                  // Parse manual serials and add to serial_numbers
                                  const manualList = e.target.value
                                    .split(',')
                                    .map(s => s.trim())
                                    .filter(s => s.length > 0);
                                  
                                  // Combine inventory-selected serials with manual ones
                                  const inventorySelected = (newItems[index].serial_numbers || [])
                                    .filter(sn => newItems[index].available_serials?.some(as => as.serial_number === sn));
                                  
                                  newItems[index].serial_numbers = [...new Set([...inventorySelected, ...manualList])];
                                  setInvoiceItems(newItems);
                                }}
                                className="flex-1 px-3 py-1.5 border rounded text-sm focus:ring-2 focus:ring-blue-500"
                              />
                            </div>
                            <p className="text-xs text-gray-500 mt-1">
                              {item.quantity > 1 
                                ? `For multiple units, separate with commas (e.g., SN001, SN002)` 
                                : 'Serial number will be recorded with this sale'}
                            </p>
                          </div>

                          {/* Selected Serials Summary */}
                          {item.serial_numbers?.length > 0 && (
                            <div className="flex flex-wrap gap-1 pt-2 border-t">
                              <span className="text-xs text-gray-500">Selected ({item.serial_numbers.length}/{item.quantity}):</span>
                              {item.serial_numbers.map((sn, snIdx) => (
                                <span 
                                  key={snIdx} 
                                  className="px-2 py-0.5 bg-green-100 text-green-700 text-xs rounded flex items-center gap-1"
                                >
                                  {sn}
                                  <button
                                    type="button"
                                    onClick={() => {
                                      const newItems = [...invoiceItems];
                                      newItems[index].serial_numbers = item.serial_numbers.filter((_, i) => i !== snIdx);
                                      // Also clear from manual input if present
                                      if (item.manual_serials?.includes(sn)) {
                                        const manualList = item.manual_serials.split(',').map(s => s.trim()).filter(s => s !== sn);
                                        newItems[index].manual_serials = manualList.join(', ');
                                      }
                                      setInvoiceItems(newItems);
                                    }}
                                    className="text-green-600 hover:text-red-600"
                                  >
                                    ×
                                  </button>
                                </span>
                              ))}
                            </div>
                          )}
                        </div>
                      )}

                      {/* No Serial Tracking Info */}
                      {!item.has_serial_tracking && (
                        <p className="text-xs text-gray-500">
                          Enable serial tracking to record individual unit serial numbers for warranty and service tracking.
                        </p>
                      )}
                    </div>

                    {/* Item GST Breakup */}
                    <div className="mt-3 p-3 bg-gray-50 rounded-lg">
                      {(() => {
                        const calc = calculateItemTotal(item);
                        const interState = isInterStateGst();
                        return (
                          <div className="grid grid-cols-6 gap-2 text-xs">
                            <div className="text-gray-600">
                              <div className="font-medium">Taxable Amt</div>
                              <div className="text-gray-900">₹{calc.taxableAmount.toFixed(2)}</div>
                            </div>
                            {interState ? (
                              <div className="text-gray-600">
                                <div className="font-medium">IGST @{item.tax_rate || 18}%</div>
                                <div className="text-gray-900">₹{calc.igst.toFixed(2)}</div>
                              </div>
                            ) : (
                              <>
                                <div className="text-gray-600">
                                  <div className="font-medium">CGST @{(item.tax_rate || 18)/2}%</div>
                                  <div className="text-gray-900">₹{calc.cgst.toFixed(2)}</div>
                                </div>
                                <div className="text-gray-600">
                                  <div className="font-medium">SGST @{(item.tax_rate || 18)/2}%</div>
                                  <div className="text-gray-900">₹{calc.sgst.toFixed(2)}</div>
                                </div>
                              </>
                            )}
                            <div className="text-gray-600">
                              <div className="font-medium">Total Tax</div>
                              <div className="text-gray-900">₹{calc.taxAmount.toFixed(2)}</div>
                            </div>
                            <div className="text-gray-600">
                              <div className="font-medium">Discount</div>
                              <div className="text-red-600">-₹{calc.discountAmount.toFixed(2)}</div>
                            </div>
                            <div className="text-right">
                              <div className="font-medium text-gray-600">Line Total</div>
                              <div className="text-lg font-bold text-emerald-700">₹{calc.total.toFixed(2)}</div>
                            </div>
                          </div>
                        );
                      })()}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>

          {/* Right Column - Payment & Summary */}
          <div className="space-y-6">
            {/* Payment Details */}
            <div className="bg-white rounded-lg shadow p-6">
              <h2 className="text-xl font-semibold mb-4 flex items-center gap-2">
                <CreditCard className="w-5 h-5 text-emerald-700" />
                Payment Details
              </h2>

              <div className="space-y-4">
                {/* Document Type Selection */}
                <div className="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
                  <label className="block text-sm font-semibold text-gray-900 mb-3">Document Type *</label>
                  <div className="space-y-2">
                    <label className="flex items-center gap-3 cursor-pointer">
                      <input
                        type="radio"
                        name="document_type"
                        value="invoice"
                        checked={invoiceDetails.document_type === 'invoice'}
                        onChange={(e) => setInvoiceDetails({...invoiceDetails, document_type: e.target.value})}
                        className="w-4 h-4 text-blue-600"
                      />
                      <div>
                        <span className="font-medium text-gray-900">Direct Invoice</span>
                        <p className="text-xs text-gray-600">For small appliances - Customer carries product immediately</p>
                      </div>
                    </label>
                    <label className="flex items-center gap-3 cursor-pointer">
                      <input
                        type="radio"
                        name="document_type"
                        value="sales_order"
                        checked={invoiceDetails.document_type === 'sales_order'}
                        onChange={(e) => setInvoiceDetails({...invoiceDetails, document_type: e.target.value})}
                        className="w-4 h-4 text-blue-600"
                      />
                      <div>
                        <span className="font-medium text-gray-900">Sales Order</span>
                        <p className="text-xs text-gray-600">For large appliances - Convert to invoice when ready for delivery</p>
                      </div>
                    </label>
                  </div>
                </div>

                {/* Expected Delivery Date - Show only for Sales Order */}
                {invoiceDetails.document_type === 'sales_order' && (
                  <div className="bg-blue-50 border border-blue-200 rounded-lg p-4 space-y-4">
                    <div>
                      <label className="block text-sm font-semibold text-gray-900 mb-2">Expected Delivery Date</label>
                      <input
                        type="date"
                        value={invoiceDetails.expected_delivery_date}
                        onChange={(e) => {
                          const selectedDate = e.target.value;
                          const today = new Date().toISOString().split('T')[0];
                          // Auto-uncheck immediate delivery if date is in future
                          const isFutureDate = selectedDate > today;
                          setInvoiceDetails({
                            ...invoiceDetails, 
                            expected_delivery_date: selectedDate,
                            immediate_delivery: isFutureDate ? false : invoiceDetails.immediate_delivery
                          });
                        }}
                        min={new Date().toISOString().split('T')[0]}
                        className="w-full px-3 py-2 border rounded-lg"
                      />
                      <p className="text-xs text-gray-500 mt-1">Select when customer expects delivery (future dates auto-disable immediate delivery)</p>
                    </div>
                    
                    <div className="flex items-center gap-3 pt-2 border-t border-blue-200">
                      <input
                        type="checkbox"
                        id="immediate_delivery"
                        checked={invoiceDetails.immediate_delivery}
                        onChange={(e) => setInvoiceDetails({...invoiceDetails, immediate_delivery: e.target.checked})}
                        className="w-4 h-4 text-blue-600 rounded"
                      />
                      <label htmlFor="immediate_delivery" className="text-sm text-gray-700">
                        <span className="font-medium">Immediate Delivery</span>
                        <span className="block text-xs text-gray-500">
                          {invoiceDetails.immediate_delivery 
                            ? "Will appear in Warehouse's 'SO to Invoice' for quick processing"
                            : "Will appear in Warehouse's 'Pending SOs' for later processing"
                          }
                        </span>
                      </label>
                    </div>
                  </div>
                )}

                {/* Split Payment Section */}
                <div className="bg-gradient-to-br from-green-50 to-emerald-50 border border-green-200 rounded-lg p-4">
                  <div className="flex items-center justify-between mb-3">
                    <h4 className="font-semibold text-green-900 flex items-center gap-2">
                      <DollarSign className="w-5 h-5" />
                      Payment Details
                    </h4>
                    {invoiceDetails.payments.length < 4 && (
                      <button
                        type="button"
                        onClick={() => setInvoiceDetails({
                          ...invoiceDetails,
                          payments: [...invoiceDetails.payments, { mode: 'upi', amount: '', reference: '' }]
                        })}
                        className="text-sm text-green-600 hover:text-green-700 flex items-center gap-1"
                      >
                        <Plus className="w-4 h-4" />
                        Add Split Payment
                      </button>
                    )}
                  </div>

                  {/* Payment Entries */}
                  <div className="space-y-3">
                    {invoiceDetails.payments.map((payment, idx) => (
                      <div key={idx} className="bg-white p-3 rounded-lg border border-green-100 shadow-sm">
                        <div className="flex items-center justify-between mb-2">
                          <span className="text-xs font-medium text-gray-500">Payment #{idx + 1}</span>
                          {invoiceDetails.payments.length > 1 && (
                            <button
                              type="button"
                              onClick={() => {
                                const newPayments = invoiceDetails.payments.filter((_, i) => i !== idx);
                                setInvoiceDetails({ ...invoiceDetails, payments: newPayments });
                              }}
                              className="text-red-500 hover:text-red-600 p-1"
                            >
                              <X className="w-4 h-4" />
                            </button>
                          )}
                        </div>
                        
                        <div className="grid grid-cols-3 gap-2">
                          {/* Payment Mode */}
                          <div>
                            <label className="block text-xs text-gray-500 mb-1">Mode</label>
                            <select
                              value={payment.mode}
                              onChange={(e) => {
                                const newPayments = [...invoiceDetails.payments];
                                newPayments[idx].mode = e.target.value;
                                setInvoiceDetails({ ...invoiceDetails, payments: newPayments });
                              }}
                              className="w-full px-2 py-1.5 text-sm border rounded-lg"
                            >
                              <option value="cash">Cash</option>
                              <option value="upi">UPI</option>
                              <option value="card">Card</option>
                              <option value="neft">NEFT/RTGS</option>
                              <option value="cheque">Cheque</option>
                            </select>
                          </div>
                          
                          {/* Amount */}
                          <div>
                            <label className="block text-xs text-gray-500 mb-1">Amount (₹)</label>
                            <input
                              type="number"
                              value={payment.amount}
                              onChange={(e) => {
                                const newPayments = [...invoiceDetails.payments];
                                newPayments[idx].amount = e.target.value;
                                // Calculate total advance
                                const totalAdvance = newPayments.reduce((sum, p) => sum + (parseFloat(p.amount) || 0), 0);
                                setInvoiceDetails({ ...invoiceDetails, payments: newPayments, total_advance: totalAdvance });
                              }}
                              className="w-full px-2 py-1.5 text-sm border rounded-lg"
                              placeholder="0"
                            />
                          </div>
                          
                          {/* Reference (for non-cash) */}
                          <div>
                            <label className="block text-xs text-gray-500 mb-1">
                              {payment.mode === 'cash' ? 'Remarks' : 'Reference #'}
                            </label>
                            <input
                              type="text"
                              value={payment.reference}
                              onChange={(e) => {
                                const newPayments = [...invoiceDetails.payments];
                                newPayments[idx].reference = e.target.value;
                                setInvoiceDetails({ ...invoiceDetails, payments: newPayments });
                              }}
                              className="w-full px-2 py-1.5 text-sm border rounded-lg"
                              placeholder={payment.mode === 'cash' ? 'Optional' : 'Txn ID'}
                            />
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>

                  {/* Payment Summary */}
                  <div className="mt-4 pt-3 border-t border-green-200">
                    <div className="flex justify-between items-center text-sm">
                      <span className="text-gray-600">Total Amount:</span>
                      <span className="font-semibold">₹{totals.finalTotal?.toLocaleString()}</span>
                    </div>
                    <div className="flex justify-between items-center text-sm mt-1">
                      <span className="text-green-600">Amount Received:</span>
                      <span className="font-semibold text-green-700">
                        ₹{invoiceDetails.total_advance?.toLocaleString() || 0}
                      </span>
                    </div>
                    <div className="flex justify-between items-center text-sm mt-1 pt-2 border-t border-green-100">
                      <span className={invoiceDetails.total_advance >= totals.finalTotal ? 'text-green-600' : 'text-orange-600'}>
                        Balance Due:
                      </span>
                      <span className={`font-bold ${invoiceDetails.total_advance >= totals.finalTotal ? 'text-green-700' : 'text-orange-600'}`}>
                        ₹{Math.max(0, (totals.finalTotal || 0) - (invoiceDetails.total_advance || 0)).toLocaleString()}
                      </span>
                    </div>
                    
                    {invoiceDetails.total_advance > 0 && invoiceDetails.total_advance < totals.finalTotal && (
                      <p className="text-xs text-orange-600 mt-2 flex items-center gap-1">
                        <AlertCircle className="w-3 h-3" />
                        This is an advance/part payment. Balance to be collected later.
                      </p>
                    )}
                    
                    {invoiceDetails.total_advance >= totals.finalTotal && invoiceDetails.total_advance > 0 && (
                      <p className="text-xs text-green-600 mt-2 flex items-center gap-1">
                        <Check className="w-3 h-3" />
                        Full payment received
                      </p>
                    )}
                  </div>
                </div>

                {/* Order Source / Origin */}
                <div className="bg-purple-50 border border-purple-200 rounded-lg p-4">
                  <label className="block text-sm font-semibold text-purple-900 mb-2">Order Source / Origin</label>
                  <select
                    value={invoiceDetails.order_source || ''}
                    onChange={(e) => setInvoiceDetails({...invoiceDetails, order_source: e.target.value})}
                    className="w-full px-3 py-2 border border-purple-200 rounded-lg bg-white"
                  >
                    <option value="">-- Select Source --</option>
                    <option value="walk_in">Walk-in Customer</option>
                    <option value="phone_call">Phone Call</option>
                    <option value="whatsapp">WhatsApp Inquiry</option>
                    <option value="website">Website Order</option>
                    <option value="google_ads">Google Ads</option>
                    <option value="facebook_ads">Facebook/Instagram Ads</option>
                    <option value="referral">Customer Referral</option>
                    <option value="repeat_customer">Repeat Customer</option>
                    <option value="dealer">Dealer/B2B</option>
                    <option value="exhibition">Exhibition/Event</option>
                    <option value="other">Other</option>
                  </select>
                  <p className="text-xs text-purple-600 mt-1">Track where your orders come from for better marketing insights</p>
                </div>

                {/* COD/POD Options */}
                <div className="col-span-2 bg-orange-50 border border-orange-200 rounded-lg p-4">
                  <h4 className="font-semibold text-gray-900 mb-3">Delivery Payment Options</h4>
                  <div className="grid grid-cols-2 gap-4">
                    <label className="flex items-start gap-3 cursor-pointer">
                      <input
                        type="checkbox"
                        checked={invoiceDetails.is_cod}
                        onChange={(e) => setInvoiceDetails({
                          ...invoiceDetails, 
                          is_cod: e.target.checked,
                          is_pod: e.target.checked ? false : invoiceDetails.is_pod
                        })}
                        className="mt-1 w-4 h-4 text-orange-600"
                      />
                      <div>
                        <span className="font-medium text-gray-900">Cash on Delivery (COD)</span>
                        <p className="text-xs text-gray-600">Payment will be collected in cash at delivery</p>
                      </div>
                    </label>
                    <label className="flex items-start gap-3 cursor-pointer">
                      <input
                        type="checkbox"
                        checked={invoiceDetails.is_pod}
                        onChange={(e) => setInvoiceDetails({
                          ...invoiceDetails, 
                          is_pod: e.target.checked,
                          is_cod: e.target.checked ? false : invoiceDetails.is_cod
                        })}
                        className="mt-1 w-4 h-4 text-orange-600"
                      />
                      <div>
                        <span className="font-medium text-gray-900">Payment on Delivery (POD)</span>
                        <p className="text-xs text-gray-600">Payment via Card/UPI at delivery</p>
                      </div>
                    </label>
                  </div>
                  {(invoiceDetails.is_cod || invoiceDetails.is_pod) && (
                    <div className="mt-3 text-sm text-orange-700 flex items-start gap-2">
                      <span>ℹ️</span>
                      <span>Payment will be collected by delivery person at the time of delivery</span>
                    </div>
                  )}
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">Discount (%)</label>
                  <input
                    type="number"
                    value={invoiceDetails.discount}
                    onChange={(e) => setInvoiceDetails({...invoiceDetails, discount: parseFloat(e.target.value) || 0})}
                    className="w-full px-3 py-2 border rounded-lg"
                    step="0.01"
                  />
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">Delivery Charges</label>
                  <input
                    type="number"
                    value={invoiceDetails.delivery_charges}
                    onChange={(e) => setInvoiceDetails({...invoiceDetails, delivery_charges: parseFloat(e.target.value) || 0})}
                    className="w-full px-3 py-2 border rounded-lg"
                    step="0.01"
                  />
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">Round Off</label>
                  <input
                    type="number"
                    value={invoiceDetails.round_off}
                    onChange={(e) => setInvoiceDetails({...invoiceDetails, round_off: parseFloat(e.target.value) || 0})}
                    className="w-full px-3 py-2 border rounded-lg"
                    step="0.01"
                  />
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">Coupon Code</label>
                  <input
                    type="text"
                    value={invoiceDetails.coupon_code}
                    onChange={(e) => setInvoiceDetails({...invoiceDetails, coupon_code: e.target.value})}
                    className="w-full px-3 py-2 border rounded-lg"
                    placeholder="Enter coupon code"
                  />
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">Notes</label>
                  <textarea
                    value={invoiceDetails.notes}
                    onChange={(e) => setInvoiceDetails({...invoiceDetails, notes: e.target.value})}
                    className="w-full px-3 py-2 border rounded-lg"
                    rows="3"
                    placeholder="Additional notes..."
                  ></textarea>
                </div>
              </div>
            </div>

            {/* Summary with GST Breakup */}
            <div className="bg-emerald-50 rounded-lg shadow p-6">
              <h2 className="text-xl font-semibold mb-4">Invoice Summary</h2>
              
              <div className="space-y-2">
                {/* Taxable Amount */}
                <div className="flex justify-between text-sm">
                  <span className="text-gray-600">Taxable Amount:</span>
                  <span>₹{totals.taxableAmount.toFixed(2)}</span>
                </div>
                
                {/* GST Breakup */}
                <div className="bg-white rounded-lg p-3 my-2 border border-emerald-200">
                  <div className="text-xs font-medium text-gray-500 mb-2">GST BREAKUP</div>
                  <div className="grid grid-cols-2 gap-2 text-sm">
                    {isInterStateGst() ? (
                      <div className="flex justify-between col-span-2">
                        <span className="text-gray-600">IGST:</span>
                        <span>₹{totals.igst.toFixed(2)}</span>
                      </div>
                    ) : (
                      <>
                        <div className="flex justify-between">
                          <span className="text-gray-600">CGST:</span>
                          <span>₹{totals.cgst.toFixed(2)}</span>
                        </div>
                        <div className="flex justify-between">
                          <span className="text-gray-600">SGST:</span>
                          <span>₹{totals.sgst.toFixed(2)}</span>
                        </div>
                      </>
                    )}
                  </div>
                  <div className="flex justify-between text-sm font-medium mt-2 pt-2 border-t border-emerald-100">
                    <span>Total Tax:</span>
                    <span className="text-emerald-700">₹{totals.totalTax.toFixed(2)}</span>
                  </div>
                </div>
                
                <div className="flex justify-between text-sm">
                  <span>Subtotal (incl. GST):</span>
                  <span>₹{totals.itemsTotal.toFixed(2)}</span>
                </div>
                
                {totals.discountAmount > 0 && (
                  <div className="flex justify-between text-sm text-red-600">
                    <span>Discount ({invoiceDetails.discount}%):</span>
                    <span>-₹{totals.discountAmount.toFixed(2)}</span>
                  </div>
                )}
                
                {invoiceDetails.delivery_charges > 0 && (
                  <div className="flex justify-between text-sm">
                    <span>Delivery Charges:</span>
                    <span>₹{invoiceDetails.delivery_charges.toFixed(2)}</span>
                  </div>
                )}
                
                {invoiceDetails.round_off !== 0 && (
                  <div className="flex justify-between text-sm">
                    <span>Round Off:</span>
                    <span>₹{invoiceDetails.round_off.toFixed(2)}</span>
                  </div>
                )}
                
                <div className="border-t-2 border-emerald-700 pt-3 mt-3">
                  <div className="flex justify-between text-xl font-bold">
                    <span>Grand Total:</span>
                    <span className="text-emerald-700">₹{totals.finalTotal.toFixed(2)}</span>
                  </div>
                </div>

                {/* E-Way Bill for amounts > ₹50,000 */}
                {totals.finalTotal > 50000 && (
                  <div className="mt-4 p-4 bg-amber-50 border border-amber-200 rounded-lg">
                    <div className="flex items-center gap-2 mb-2">
                      <span className="text-amber-600 font-medium">⚠️ E-Way Bill Required</span>
                    </div>
                    <p className="text-xs text-amber-700 mb-3">
                      Invoices above ₹50,000 require an E-Way Bill for transport. Auto-generate it, or enter the number manually if you already have one.
                    </p>
                    <div className="grid grid-cols-2 gap-3 mb-3">
                      <div>
                        <label className="block text-sm font-medium text-amber-800 mb-1">Vehicle Number *</label>
                        <input
                          type="text"
                          value={ewbVehicleNumber}
                          onChange={(e) => setEwbVehicleNumber(e.target.value.toUpperCase())}
                          className="w-full px-3 py-2 border border-amber-300 rounded-lg focus:ring-2 focus:ring-amber-500 bg-white"
                          placeholder="e.g., KA01AB1234"
                        />
                      </div>
                      <div>
                        <label className="block text-sm font-medium text-amber-800 mb-1">Approx. Distance (km) *</label>
                        <input
                          type="number"
                          value={ewbDistance}
                          onChange={(e) => setEwbDistance(e.target.value)}
                          className="w-full px-3 py-2 border border-amber-300 rounded-lg focus:ring-2 focus:ring-amber-500 bg-white"
                          placeholder="e.g., 10"
                        />
                      </div>
                    </div>
                    <div>
                      <label className="block text-sm font-medium text-amber-800 mb-1">E-Way Bill Number</label>
                      <div className="flex gap-2">
                        <input
                          type="text"
                          value={invoiceDetails.e_way_bill_number || ''}
                          onChange={(e) => setInvoiceDetails({...invoiceDetails, e_way_bill_number: e.target.value})}
                          className="flex-1 px-3 py-2 border border-amber-300 rounded-lg focus:ring-2 focus:ring-amber-500 bg-white"
                          placeholder="e.g., 1210234567891"
                          maxLength={15}
                        />
                        <button
                          type="button"
                          disabled={isGeneratingEwb}
                          onClick={async () => {
                            setIsGeneratingEwb(true);
                            setEwbError('');
                            try {
                              const res = await fetch(`${BACKEND_URL}/api/invoices/offline/generate-ewaybill`, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                  store_code: invoiceDetails.store_code,
                                  customer: customerDetails,
                                  items: invoiceItems,
                                  invoice_number: (nextDocumentNumber || 'PENDING').slice(-16),
                                  invoice_date: new Date().toLocaleDateString('en-GB'),
                                  delivery_charges: invoiceDetails.delivery_charges || 0,
                                  round_off: invoiceDetails.round_off || 0,
                                  vehicle_number: ewbVehicleNumber,
                                  transport_distance: ewbDistance ? parseInt(ewbDistance, 10) : null
                                })
                              });
                              const data = await res.json();
                              if (res.ok && data.success) {
                                setInvoiceDetails(prev => ({ ...prev, e_way_bill_number: String(data.ewb_no) }));
                              } else {
                                const detail = data.detail;
                                const errMsg = typeof detail === 'string'
                                  ? detail
                                  : Array.isArray(detail)
                                    ? detail.map(d => d.msg || JSON.stringify(d)).join('; ')
                                    : JSON.stringify(detail);
                                setEwbError(errMsg || 'Failed to generate E-Way Bill');
                              }
                            } catch (err) {
                              setEwbError('Network error while generating E-Way Bill');
                            } finally {
                              setIsGeneratingEwb(false);
                            }
                          }}
                          className="px-4 py-2 bg-amber-600 hover:bg-amber-700 disabled:bg-amber-300 text-white text-sm font-medium rounded-lg whitespace-nowrap"
                        >
                          {isGeneratingEwb ? 'Generating...' : 'Auto Generate'}
                        </button>
                      </div>
                      <p className="text-xs text-amber-600 mt-1">Leave blank if generating later</p>
                      {ewbError && <p className="text-xs text-red-600 mt-1">{ewbError}</p>}
                    </div>
                  </div>
                )}

                {/* E-Invoice for B2B Direct Invoice amounts > ₹50,000 */}
                {totals.finalTotal > 50000 && customerDetails.customer_type === 'B2B' && invoiceDetails.document_type === 'invoice' && (
                  <div className="mt-4 p-4 bg-blue-50 border border-blue-200 rounded-lg">
                    <div className="flex items-center gap-2 mb-2">
                      <span className="text-blue-700 font-medium">📄 E-Invoice (IRN)</span>
                    </div>
                    <p className="text-xs text-blue-700 mb-3">
                      B2B invoices above ₹50,000 require an E-Invoice (IRN) for GST compliance.
                    </p>
                    {einvoiceResult ? (
                      <div className="text-xs text-blue-900 bg-white border border-blue-200 rounded-lg p-3 space-y-1">
                        <p><span className="font-medium">IRN:</span> {einvoiceResult.irn}</p>
                        <p><span className="font-medium">Ack No:</span> {einvoiceResult.ack_no}</p>
                        <p><span className="font-medium">Ack Date:</span> {einvoiceResult.ack_date}</p>
                      </div>
                    ) : (
                      <button
                        type="button"
                        disabled={isGeneratingEinvoice}
                        onClick={async () => {
                          setIsGeneratingEinvoice(true);
                          setEinvoiceError('');
                          try {
                            const res = await fetch(`${BACKEND_URL}/api/invoices/offline/generate-einvoice`, {
                              method: 'POST',
                              headers: { 'Content-Type': 'application/json' },
                              body: JSON.stringify({
                                store_code: invoiceDetails.store_code,
                                customer: customerDetails,
                                items: invoiceItems,
                                invoice_number: (nextDocumentNumber || 'PENDING').slice(-16),
                                invoice_date: new Date().toLocaleDateString('en-GB'),
                                delivery_charges: invoiceDetails.delivery_charges || 0,
                                round_off: invoiceDetails.round_off || 0
                              })
                            });
                            const data = await res.json();
                            if (res.ok && data.success) {
                              setEinvoiceResult(data);
                            } else {
                              const detail = data.detail;
                              const errMsg = typeof detail === 'string'
                                ? detail
                                : Array.isArray(detail)
                                  ? detail.map(d => d.msg || JSON.stringify(d)).join('; ')
                                  : JSON.stringify(detail);
                              setEinvoiceError(errMsg || 'Failed to generate E-Invoice');
                            }
                          } catch (err) {
                            setEinvoiceError('Network error while generating E-Invoice');
                          } finally {
                            setIsGeneratingEinvoice(false);
                          }
                        }}
                        className="w-full px-4 py-2 bg-blue-600 hover:bg-blue-700 disabled:bg-blue-300 text-white text-sm font-medium rounded-lg"
                      >
                        {isGeneratingEinvoice ? 'Generating...' : 'Auto Generate E-Invoice'}
                      </button>
                    )}
                    {einvoiceError && <p className="text-xs text-red-600 mt-1">{einvoiceError}</p>}
                  </div>
                )}
              </div>

              <button
                type="submit"
                disabled={loading}
                className="w-full mt-6 bg-emerald-700 text-white px-6 py-3 rounded-lg hover:bg-emerald-800 disabled:bg-gray-400 flex items-center justify-center gap-2"
              >
                {loading ? (
                  <>
                    <div className="animate-spin rounded-full h-5 w-5 border-2 border-white border-t-transparent"></div>
                    Creating...
                  </>
                ) : (
                  <>
                    <Save className="w-5 h-5" />
                    Create Invoice
                  </>
                )}
              </button>
            </div>
          </div>
        </div>
      </form>

      {/* Add New Product Modal */}
      {/* Scan & Autofill from PDF Modal */}
      {showScanAutofillModal && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
          <div className="bg-white rounded-xl w-full max-w-lg shadow-2xl">
            <div className="p-6 border-b flex items-center justify-between bg-gradient-to-r from-purple-600 to-indigo-600 text-white rounded-t-xl">
              <h2 className="text-xl font-semibold flex items-center gap-2">
                <Sparkles className="w-5 h-5" />
                Scan & Autofill from PDF
              </h2>
              <button onClick={() => { setShowScanAutofillModal(false); setScanAutofillFile(null); }} className="text-white/80 hover:text-white">
                <X className="w-5 h-5" />
              </button>
            </div>

            <div className="p-6 space-y-4">
              <div className="bg-purple-50 rounded-lg p-4 text-sm text-purple-800">
                <p className="font-medium mb-2">How this works:</p>
                <ol className="list-decimal list-inside space-y-1">
                  <li>Upload a PDF or photo of the invoice/bill</li>
                  <li>AI reads the customer details, items, and payment info</li>
                  <li>This form auto-fills — review and edit before saving</li>
                </ol>
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">
                  Upload Document
                </label>
                <input
                  type="file"
                  ref={scanAutofillFileInputRef}
                  accept=".pdf,.png,.jpg,.jpeg,.webp"
                  onChange={handleScanAutofillFileSelect}
                  className="hidden"
                />
                <div
                  onClick={() => scanAutofillFileInputRef.current?.click()}
                  className="border-2 border-dashed border-purple-300 rounded-lg p-6 text-center cursor-pointer hover:border-purple-500 hover:bg-purple-50 transition-colors"
                >
                  {scanAutofillFile ? (
                    <div className="flex items-center justify-center gap-2 text-purple-700">
                      <Camera className="w-6 h-6" />
                      <span className="font-medium">{scanAutofillFile.name}</span>
                      <button
                        onClick={(e) => { e.stopPropagation(); setScanAutofillFile(null); }}
                        className="ml-2 text-red-500 hover:text-red-700"
                      >
                        <X className="w-4 h-4" />
                      </button>
                    </div>
                  ) : (
                    <>
                      <Camera className="w-10 h-10 mx-auto mb-2 text-purple-400" />
                      <p className="text-gray-600">Click to upload PDF or image</p>
                      <p className="text-xs text-gray-400 mt-1">Supported: PDF, PNG, JPG, WEBP</p>
                    </>
                  )}
                </div>
              </div>
            </div>

            <div className="p-6 border-t flex justify-end gap-3">
              <button
                onClick={() => { setShowScanAutofillModal(false); setScanAutofillFile(null); }}
                className="px-4 py-2 border rounded-lg hover:bg-gray-50"
              >
                Cancel
              </button>
              <button
                onClick={handleScanAutofillSubmit}
                disabled={scanningAutofill || !scanAutofillFile}
                className="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 disabled:opacity-50 flex items-center gap-2"
              >
                {scanningAutofill ? (
                  <>
                    <RefreshCw className="w-4 h-4 animate-spin" />
                    Scanning with AI...
                  </>
                ) : (
                  <>
                    <Sparkles className="w-4 h-4" />
                    Scan Document
                  </>
                )}
              </button>
            </div>
          </div>
        </div>
      )}

      {showAddProductModal && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
          <div className="bg-white rounded-lg shadow-xl w-full max-w-lg mx-4 max-h-[90vh] overflow-y-auto">
            <div className="bg-blue-600 text-white p-4 rounded-t-lg flex justify-between items-center">
              <h3 className="text-lg font-semibold flex items-center gap-2">
                <Package className="w-5 h-5" />
                Add New Product
              </h3>
              <button
                type="button"
                onClick={() => setShowAddProductModal(false)}
                className="text-white hover:bg-blue-700 p-1 rounded"
              >
                <X className="w-5 h-5" />
              </button>
            </div>
            
            <div className="p-6 space-y-4">
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Product Name *</label>
                <input
                  type="text"
                  value={newProduct.name}
                  onChange={(e) => {
                    setNewProduct({...newProduct, name: e.target.value});
                    // Trigger intelligent HSN suggestion
                    fetchNewProductHsnSuggestion(e.target.value);
                  }}
                  className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                  placeholder="e.g., Bosch Built-in Oven 60cm"
                  required
                />
                {/* HSN Suggestions for New Product */}
                {newProductHsnSuggestions.length > 0 && (
                  <div className="mt-2 p-2 bg-blue-50 border border-blue-200 rounded">
                    <div className="text-xs font-medium text-blue-800 mb-1">
                      💡 Suggested HSN Codes based on product name:
                    </div>
                    <div className="space-y-1">
                      {newProductHsnSuggestions.slice(0, 3).map((suggestion, sIdx) => (
                        <button
                          key={sIdx}
                          type="button"
                          onClick={() => {
                            setNewProduct({...newProduct, hsn_code: suggestion.code});
                            setNewProductHsnSuggestions([]);
                          }}
                          className={`w-full text-left px-2 py-1 rounded text-xs hover:bg-blue-100 transition-colors ${
                            newProduct.hsn_code === suggestion.code ? 'bg-blue-200 border border-blue-400' : 'bg-white'
                          }`}
                        >
                          <span className="font-semibold text-blue-700">{suggestion.code}</span>
                          <span className="text-gray-600 ml-2">{suggestion.category || suggestion.description?.substring(0, 30)}</span>
                          <span className="text-green-600 ml-2 font-medium">{suggestion.gst_rate}% GST</span>
                        </button>
                      ))}
                    </div>
                  </div>
                )}
              </div>

              <div className="grid grid-cols-2 gap-4">
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">Brand</label>
                  <input
                    type="text"
                    value={newProduct.brand}
                    onChange={(e) => setNewProduct({...newProduct, brand: e.target.value})}
                    className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                    placeholder="e.g., Bosch, Siemens"
                  />
                </div>
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">Model Number</label>
                  <input
                    type="text"
                    value={newProduct.model_number}
                    onChange={(e) => setNewProduct({...newProduct, model_number: e.target.value})}
                    className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                    placeholder="e.g., HBA534BS0"
                  />
                </div>
              </div>

              <div className="grid grid-cols-2 gap-4">
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">Selling Price (₹) *</label>
                  <input
                    type="number"
                    value={newProduct.price}
                    onChange={(e) => setNewProduct({...newProduct, price: e.target.value})}
                    className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                    placeholder="Price incl. GST"
                    required
                    step="0.01"
                    min="0"
                  />
                </div>
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">Opening Stock</label>
                  <input
                    type="number"
                    value={newProduct.current_stock}
                    onChange={(e) => setNewProduct({...newProduct, current_stock: e.target.value})}
                    className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                    placeholder="Initial stock quantity"
                    min="0"
                  />
                </div>
              </div>

              <div>
                <div className="flex items-center justify-between mb-1">
                  <label className="block text-sm font-medium text-gray-700">HSN Code *</label>
                  <button
                    type="button"
                    onClick={() => {
                      setManualHsnMode(!manualHsnMode);
                      if (!manualHsnMode) {
                        // Switching to manual mode - clear the selected HSN
                        setNewProduct({...newProduct, hsn_code: ''});
                      }
                    }}
                    className="text-xs text-blue-600 hover:text-blue-800 underline"
                  >
                    {manualHsnMode ? 'Select from list' : 'Enter manually'}
                  </button>
                </div>
                
                {manualHsnMode ? (
                  // Manual HSN entry mode
                  <div className="space-y-2">
                    <input
                      type="text"
                      value={newProduct.hsn_code}
                      onChange={(e) => setNewProduct({...newProduct, hsn_code: e.target.value})}
                      className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                      placeholder="Enter HSN code (e.g., 85081100)"
                      required
                      maxLength={8}
                    />
                    <div className="flex items-center gap-2">
                      <label className="text-xs text-gray-600">GST Rate:</label>
                      <select
                        value={manualHsnGstRate}
                        onChange={(e) => setManualHsnGstRate(parseFloat(e.target.value))}
                        className="px-2 py-1 border rounded text-sm"
                      >
                        <option value={0}>0%</option>
                        <option value={5}>5%</option>
                        <option value={12}>12%</option>
                        <option value={18}>18%</option>
                        <option value={28}>28%</option>
                      </select>
                    </div>
                    <p className="text-xs text-amber-600">
                      Note: Manually entered HSN codes will be added to the system
                    </p>
                  </div>
                ) : (
                  // Dropdown selection mode
                  <>
                    <select
                      value={newProduct.hsn_code}
                      onChange={(e) => setNewProduct({...newProduct, hsn_code: e.target.value})}
                      className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                      required
                    >
                      <option value="">-- Select HSN Code --</option>
                      {hsnCodes.map(hsn => (
                        <option key={hsn.id || hsn.code} value={hsn.code}>
                          {hsn.code} - {hsn.description?.substring(0, 40)}{hsn.description?.length > 40 ? '...' : ''} ({hsn.gst_rate}%)
                        </option>
                      ))}
                    </select>
                    {newProduct.hsn_code && (
                      <p className="text-xs text-gray-500 mt-1">
                        GST Rate: {hsnCodes.find(h => h.code === newProduct.hsn_code)?.gst_rate || 18}%
                      </p>
                    )}
                  </>
                )}
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Category</label>
                <input
                  type="text"
                  value={newProduct.category}
                  onChange={(e) => setNewProduct({...newProduct, category: e.target.value})}
                  className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                  placeholder="e.g., Built-in Ovens, Refrigerators"
                />
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Description</label>
                <textarea
                  value={newProduct.description}
                  onChange={(e) => setNewProduct({...newProduct, description: e.target.value})}
                  className="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                  rows="2"
                  placeholder="Brief product description"
                ></textarea>
              </div>

              <div className="flex gap-3 pt-4">
                <button
                  type="button"
                  onClick={() => setShowAddProductModal(false)}
                  className="flex-1 px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50"
                >
                  Cancel
                </button>
                <button
                  type="button"
                  onClick={handleCreateProduct}
                  disabled={addProductLoading}
                  className="flex-1 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 disabled:bg-gray-400 flex items-center justify-center gap-2"
                >
                  {addProductLoading ? (
                    <>
                      <div className="animate-spin rounded-full h-4 w-4 border-2 border-white border-t-transparent"></div>
                      Creating...
                    </>
                  ) : (
                    <>
                      <Plus className="w-4 h-4" />
                      Create & Select
                    </>
                  )}
                </button>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

export default OfflineInvoiceCreation;

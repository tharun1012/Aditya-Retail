import React, { useEffect, useState } from 'react';
import axios from 'axios';
import { Wallet } from 'lucide-react';

const API = process.env.REACT_APP_BACKEND_URL;
const cache = new Map();
let queue = new Set();
let waiters = [];
let timer = null;

const load = (id) => new Promise((resolve) => {
  if (cache.has(id)) return resolve(cache.get(id));
  queue.add(id);
  waiters.push([id, resolve]);
  if (!timer) {
    timer = setTimeout(async () => {
      const ids = [...queue];
      const w = waiters;
      queue = new Set(); waiters = []; timer = null;
      try {
        const r = await axios.post(`${API}/api/offers/summary`, { product_ids: ids });
        const map = r.data?.summary || {};
        ids.forEach((i) => cache.set(i, map[i] || null));
      } catch (e) { /* don't cache failures */ }
      w.forEach(([i, res]) => res(cache.has(i) ? cache.get(i) : null));
    }, 50);
  }
});

// Shows the offer exactly as stored (Pine Labs data): title + amount verbatim.
const OfferTag = ({ productId }) => {
  const [data, setData] = useState(null);
  useEffect(() => {
    let alive = true;
    if (productId) load(productId).then((d) => alive && setData(d));
    return () => { alive = false; };
  }, [productId]);
  if (!data || !data.top) return null;
  const o = data.top;
  const amt = o.amount_upto
    ? (o.amount_type === 'percentage' ? `${o.amount_upto}% off` : `Upto ₹${Number(o.amount_upto).toLocaleString('en-IN')}`)
    : null;
  return (
    <div data-testid="offer-tag" className="-mt-2 mb-3 flex items-start gap-1.5 rounded-md border border-amber-200 bg-amber-50 px-2 py-1 text-[11px] text-amber-800">
      <Wallet className="w-3 h-3 mt-0.5 shrink-0" />
      <div className="min-w-0">
        <div className="font-semibold line-clamp-2">{o.description || (amt ? amt + ' · ' : '') + o.title}</div>
        {data.count > 1 && <div className="text-[10px] text-amber-700">+{data.count - 1} more offer{data.count > 2 ? 's' : ''}</div>}
      </div>
    </div>
  );
};

export default OfferTag;

import React, { useState, useEffect } from 'react';
import { BACKEND_URL } from '../config/api';
import { useNavigate, useParams, useLocation } from 'react-router-dom';
import { 
  FileText, Save, ArrowLeft, User, MapPin, Package, IndianRupee,
  Plus, Trash2, AlertCircle, CheckCircle, X, Edit, RefreshCw
} from 'lucide-react';

const EditSalesOrder = ({ isStoreView = false, returnPath = null }) => {
  const navigate = useNavigate();
  const location = useLocation();
  const { orderId } = useParams();
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [order, setOrder] = useState(null);
  const [message, setMessage] = useState({ type: '', text: '' });
  const [products, setProducts] = useState([]);
  const [hsnCodes, setHsnCodes] = useState([]);
  
  // Get user info based on view type
  const adminUser = JSON.parse(localStorage.getItem('adminUser') || '{}');
  const storeData = JSON.parse(localStorage.getItem('storeData') || '{}');
  const currentUser = isStoreView ? storeData : adminUser;

  // Editable state
  const [customerDetails, setCustomerDetails] = useState({});
  const [items, setItems] = useState([]);
  const [invoiceDetails, setInvoiceDetails] = useState({});
  
  // Back navigation based on view type
  const handleBack = () => {
    const target = returnPath || location.state?.returnPath;
    if (target) {
      navigate(target, { state: location.state?.returnState });
    } else if (isStoreView) {
      navigate('/store/orders');
    } else {
      navigate('/admin/sales-orders');
    }
  };

  useEffect(() => {
    fetchOrder();
    fetchProducts();
    fetchHsnCodes();
  }, [orderId]);

  const fetchOrder = async () => {
    setLoading(true);
    try {
      // First try direct fetch by ID
      let foundOrder = null;
      
      const directResponse = await fetch(`${BACKEND_URL}/api/invoices/offline/${orderId}`);
      if (directResponse.ok) {
        const directData = await directResponse.json();
        if (directData.status === 'success' && directData.invoice) {
          foundOrder = directData.invoice;
        } else if (directData && directData.id) {
          foundOrder = directData;
        }
      }
      
      // Fallback to search if direct fetch fails
      if (!foundOrder) {
        const searchResponse = await fetch(`${BACKEND_URL}/api/invoices/offline/?search=${orderId}&limit=100`);
        const searchData = await searchResponse.json();
        
        if (searchData.status === 'success' && searchData.invoices?.length > 0) {
          foundOrder = searchData.invoices.find(inv => inv.id === orderId || inv.invoice_number === orderId);
        }
      }
      
      if (foundOrder) {
        setOrder(foundOrder);
        setCustomerDetails(foundOrder.customer || {
          name: foundOrder.customer_name,
          phone: foundOrder.customer_phone,
          email: foundOrder.customer_email,
          address: foundOrder.customer_address,
          gstin: foundOrder.customer_gst
        });
        setItems(foundOrder.items || []);
        setInvoiceDetails({
          payment_mode: foundOrder.payment_mode,
          discount: foundOrder.discount_percentage || 0,
          delivery_charges: foundOrder.delivery_charges || 0,
          round_off: foundOrder.round_off || 0,
          notes: foundOrder.notes || '',
          order_source: foundOrder.order_source || '',
          document_type: foundOrder.document_type || 'invoice',
          expected_delivery_date: foundOrder.expected_delivery_date || '',
          immediate_delivery: foundOrder.immediate_delivery !== undefined ? foundOrder.immediate_delivery : true
        });
      } else {
        setMessage({ type: 'error', text: 'Order not found. It may have been deleted or converted.' });
      }
    } catch (error) {
      console.error('Error fetching order:', error);
      setMessage({ type: 'error', text: 'Failed to fetch order: ' + error.message });
    } finally {
      setLoading(false);
    }
  };

  const fetchProducts = async () => {
    try {
      const response = await fetch(`${BACKEND_URL}/api/products/`);
      const data = await response.json();
      setProducts(data.products || data || []);
    } catch (error) {
      console.error('Error fetching products:', error);
    }
  };

  const fetchHsnCodes = async () => {
    try {
      const response = await fetch(`${BACKEND_URL}/api/hsn/?active_only=true`);
      const data = await response.json();
      setHsnCodes(data || []);
    } catch (error) {
      console.error('Error fetching HSN codes:', error);
    }
  };

  const updateItem = (index, field, value) => {
    const newItems = [...items];
    newItems[index] = { ...newItems[index], [field]: value };
    setItems(newItems);
  };

  const addItem = () => {
    setItems([...items, {
      product_id: '',
      product_name: '',
      hsn_code: '',
      quantity: 1,
      rate: 0,
      discount: 0,
      tax_rate: 18
    }]);
  };

  const removeItem = (index) => {
    if (items.length > 1) {
      setItems(items.filter((_, i) => i !== index));
    }
  };

  const calculateTotals = () => {
    let itemsTotal = 0;
    let taxTotal = 0;
    let taxableTotal = 0;

    items.forEach(item => {
      const inclusivePrice = (item.rate || 0) * (item.quantity || 1);
      const itemDiscount = (inclusivePrice * (item.discount || 0)) / 100;
      const finalPrice = inclusivePrice - itemDiscount;
      
      const taxRate = item.tax_rate || 18;
      const taxableAmount = finalPrice / (1 + taxRate / 100);
      const taxAmount = finalPrice - taxableAmount;
      
      itemsTotal += finalPrice;
      taxTotal += taxAmount;
      taxableTotal += taxableAmount;
    });

    const discountAmount = (itemsTotal * (invoiceDetails.discount || 0)) / 100;
    const finalTotal = itemsTotal - discountAmount + (invoiceDetails.delivery_charges || 0) + (invoiceDetails.round_off || 0);

    return {
      itemsTotal: Math.round(itemsTotal * 100) / 100,
      taxTotal: Math.round(taxTotal * 100) / 100,
      taxableTotal: Math.round(taxableTotal * 100) / 100,
      discountAmount: Math.round(discountAmount * 100) / 100,
      finalTotal: Math.round(finalTotal * 100) / 100
    };
  };

  const handleSave = async () => {
    setSaving(true);
    try {
      const payload = {
        customer: customerDetails,
        items: items.map(item => ({
          product_id: item.product_id,
          product_name: item.product_name,
          hsn_code: item.hsn_code,
          quantity: parseInt(item.quantity) || 1,
          rate: parseFloat(item.rate) || 0,
          discount: parseFloat(item.discount) || 0,
          tax_rate: parseFloat(item.tax_rate) || 18
        })),
        payment_mode: invoiceDetails.payment_mode,
        discount: invoiceDetails.discount,
        delivery_charges: invoiceDetails.delivery_charges,
        round_off: invoiceDetails.round_off,
        notes: invoiceDetails.notes,
        order_source: invoiceDetails.order_source,
        expected_delivery_date: invoiceDetails.expected_delivery_date || null,
        immediate_delivery: invoiceDetails.immediate_delivery,
        edited_by: adminUser.email || 'admin'
      };

      const storeToken = localStorage.getItem('storeToken');
      const response = await fetch(`${BACKEND_URL}/api/invoices/offline/${order.id}`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          ...(storeToken ? { 'Authorization': `Bearer ${storeToken}` } : {})
        },
        body: JSON.stringify(payload)
      });

      const data = await response.json();

      if (data.status === 'success') {
        setMessage({ type: 'success', text: 'Order updated successfully' });
        setTimeout(() => handleBack(), 1500);
      } else {
        setMessage({ type: 'error', text: data.detail || 'Failed to update order' });
      }
    } catch (error) {
      setMessage({ type: 'error', text: 'Error updating order' });
    } finally {
      setSaving(false);
    }
  };

  const totals = calculateTotals();

  if (loading) {
    return (
      <div className="min-h-screen bg-gray-50 flex items-center justify-center">
        <RefreshCw className="w-8 h-8 animate-spin text-blue-600" />
      </div>
    );
  }

  if (!order) {
    return (
      <div className="min-h-screen bg-gray-50 p-6">
        <div className="text-center py-12">
          <AlertCircle className="w-16 h-16 text-red-300 mx-auto mb-4" />
          <h3 className="text-lg font-medium text-gray-900">Order not found</h3>
          <button onClick={handleBack} className="mt-4 text-blue-600 hover:underline">
            Back to Orders
          </button>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gray-50 p-6" data-testid="edit-sales-order">
      {/* Header */}
      <div className="flex items-center justify-between mb-6">
        <div className="flex items-center gap-4">
          <button
            onClick={handleBack}
            className="p-2 text-gray-600 hover:bg-white rounded-lg"
          >
            <ArrowLeft className="w-5 h-5" />
          </button>
          <div>
            <h1 className="text-2xl font-bold text-gray-900 flex items-center gap-2">
              <Edit className="w-7 h-7 text-blue-600" />
              Edit Sales Order
            </h1>
            <p className="text-gray-600">{order.invoice_number}</p>
          </div>
        </div>
        <button
          onClick={handleSave}
          disabled={saving}
          className="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 flex items-center gap-2 disabled:opacity-50"
          data-testid="save-order-btn"
        >
          <Save className="w-4 h-4" />
          {saving ? 'Saving...' : 'Save Changes'}
        </button>
      </div>

      {/* Message */}
      {message.text && (
        <div className={`mb-4 p-4 rounded-lg flex items-center gap-2 ${
          message.type === 'success' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'
        }`}>
          {message.type === 'success' ? <CheckCircle className="w-5 h-5" /> : <AlertCircle className="w-5 h-5" />}
          {message.text}
        </div>
      )}

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {/* Customer Details */}
        <div className="lg:col-span-2 space-y-6">
          <div className="bg-white rounded-xl shadow-sm p-6">
            <h2 className="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
              <User className="w-5 h-5 text-blue-600" />
              Customer Details
            </h2>

            {/* B2B / B2C Toggle */}
            <div className="mb-4">
              <label className="block text-sm font-medium text-gray-700 mb-2">Customer Type</label>
              <div className="flex gap-2">
                <button
                  type="button"
                  onClick={() => setCustomerDetails({...customerDetails, customer_type: 'B2C'})}
                  className={`flex-1 flex items-center justify-center gap-2 px-4 py-3 rounded-lg border-2 transition-all ${
                    customerDetails.customer_type === 'B2C'
                      ? 'border-emerald-500 bg-emerald-50 text-emerald-700'
                      : 'border-gray-200 hover:border-gray-300'
                  }`}
                >
                  <span className="font-medium">B2C</span>
                  <span className="text-xs text-gray-500">(Individual)</span>
                </button>
                <button
                  type="button"
                  onClick={() => setCustomerDetails({...customerDetails, customer_type: 'B2B'})}
                  className={`flex-1 flex items-center justify-center gap-2 px-4 py-3 rounded-lg border-2 transition-all ${
                    customerDetails.customer_type === 'B2B'
                      ? 'border-blue-500 bg-blue-50 text-blue-700'
                      : 'border-gray-200 hover:border-gray-300'
                  }`}
                >
                  <span className="font-medium">B2B</span>
                  <span className="text-xs text-gray-500">(Business)</span>
                </button>
              </div>
            </div>

            <div className="grid grid-cols-2 gap-4">
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Name *</label>
                <input
                  type="text"
                  value={customerDetails.name || ''}
                  onChange={(e) => setCustomerDetails({...customerDetails, name: e.target.value})}
                  className="w-full px-3 py-2 border rounded-lg"
                />
              </div>
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Phone *</label>
                <input
                  type="tel"
                  value={customerDetails.phone || ''}
                  onChange={(e) => setCustomerDetails({...customerDetails, phone: e.target.value})}
                  className="w-full px-3 py-2 border rounded-lg"
                />
              </div>
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Email</label>
                <input
                  type="email"
                  value={customerDetails.email || ''}
                  onChange={(e) => setCustomerDetails({...customerDetails, email: e.target.value})}
                  className="w-full px-3 py-2 border rounded-lg"
                />
              </div>
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">GST Number</label>
                <input
                  type="text"
                  value={customerDetails.gst_number || ''}
                  onChange={(e) => setCustomerDetails({...customerDetails, gst_number: e.target.value})}
                  className="w-full px-3 py-2 border rounded-lg"
                />
              </div>
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">MSME/Udyam Number</label>
                <input
                  type="text"
                  value={customerDetails.msme_udyam_number || ''}
                  onChange={(e) => setCustomerDetails({...customerDetails, msme_udyam_number: e.target.value})}
                  className="w-full px-3 py-2 border rounded-lg"
                  placeholder="e.g., UDYAM-KA-01-0123456"
                />
              </div>
              <div className="col-span-2">
                <label className="block text-sm font-medium text-gray-700 mb-1">Address</label>
                <input
                  type="text"
                  value={customerDetails.address || customerDetails.billing_address || ''}
                  onChange={(e) => setCustomerDetails({...customerDetails, address: e.target.value, billing_address: e.target.value})}
                  className="w-full px-3 py-2 border rounded-lg"
                />
              </div>
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">City</label>
                <input
                  type="text"
                  value={customerDetails.city || customerDetails.billing_city || ''}
                  onChange={(e) => setCustomerDetails({...customerDetails, city: e.target.value, billing_city: e.target.value})}
                  className="w-full px-3 py-2 border rounded-lg"
                />
              </div>
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">State</label>
                <input
                  type="text"
                  value={customerDetails.state || customerDetails.billing_state || ''}
                  onChange={(e) => setCustomerDetails({...customerDetails, state: e.target.value, billing_state: e.target.value})}
                  className="w-full px-3 py-2 border rounded-lg"
                />
              </div>
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Pincode</label>
                <input
                  type="text"
                  value={customerDetails.pincode || customerDetails.billing_pincode || ''}
                  onChange={(e) => setCustomerDetails({...customerDetails, pincode: e.target.value, billing_pincode: e.target.value})}
                  className="w-full px-3 py-2 border rounded-lg"
                />
              </div>
            </div>
          </div>

          {/* Items */}
          <div className="bg-white rounded-xl shadow-sm p-6">
            <div className="flex items-center justify-between mb-4">
              <h2 className="text-lg font-semibold text-gray-900 flex items-center gap-2">
                <Package className="w-5 h-5 text-green-600" />
                Items
              </h2>
              <button
                onClick={addItem}
                className="px-3 py-1 text-sm bg-green-100 text-green-700 rounded-lg hover:bg-green-200 flex items-center gap-1"
              >
                <Plus className="w-4 h-4" />
                Add Item
              </button>
            </div>

            <div className="space-y-4">
              {items.map((item, index) => (
                <div key={index} className="border rounded-lg p-4 bg-gray-50">
                  <div className="grid grid-cols-6 gap-3">
                    <div className="col-span-3">
                      <label className="block text-xs font-medium text-gray-700 mb-1">Product Name</label>
                      <input
                        type="text"
                        value={item.product_name || ''}
                        onChange={(e) => updateItem(index, 'product_name', e.target.value)}
                        className="w-full px-3 py-2 border rounded text-sm"
                      />
                    </div>
                    <div>
                      <label className="block text-xs font-medium text-gray-700 mb-1">HSN Code</label>
                      <select
                        value={item.hsn_code || ''}
                        onChange={(e) => updateItem(index, 'hsn_code', e.target.value)}
                        className="w-full px-3 py-2 border rounded text-sm"
                      >
                        <option value="">Select</option>
                        {hsnCodes.map(h => (
                          <option key={h.code} value={h.code}>{h.code}</option>
                        ))}
                      </select>
                    </div>
                    <div>
                      <label className="block text-xs font-medium text-gray-700 mb-1">Qty</label>
                      <input
                        type="number"
                        min="1"
                        value={item.quantity || 1}
                        onChange={(e) => updateItem(index, 'quantity', parseInt(e.target.value) || 1)}
                        className="w-full px-3 py-2 border rounded text-sm"
                      />
                    </div>
                    <div className="flex items-end">
                      <button
                        onClick={() => removeItem(index)}
                        disabled={items.length <= 1}
                        className="p-2 text-red-500 hover:bg-red-50 rounded disabled:opacity-50"
                      >
                        <Trash2 className="w-4 h-4" />
                      </button>
                    </div>
                    <div className="col-span-2">
                      <label className="block text-xs font-medium text-gray-700 mb-1">Rate (incl. GST)</label>
                      <input
                        type="number"
                        value={item.rate || 0}
                        onChange={(e) => updateItem(index, 'rate', parseFloat(e.target.value) || 0)}
                        className="w-full px-3 py-2 border rounded text-sm"
                      />
                    </div>
                    <div>
                      <label className="block text-xs font-medium text-gray-700 mb-1">Tax Rate %</label>
                      <select
                        value={item.tax_rate || 18}
                        onChange={(e) => updateItem(index, 'tax_rate', parseFloat(e.target.value))}
                        className="w-full px-3 py-2 border rounded text-sm"
                      >
                        <option value="0">0%</option>
                        <option value="5">5%</option>
                        <option value="12">12%</option>
                        <option value="18">18%</option>
                        <option value="28">28%</option>
                      </select>
                    </div>
                    <div>
                      <label className="block text-xs font-medium text-gray-700 mb-1">Discount %</label>
                      <input
                        type="number"
                        min="0"
                        max="100"
                        value={item.discount || 0}
                        onChange={(e) => updateItem(index, 'discount', parseFloat(e.target.value) || 0)}
                        className="w-full px-3 py-2 border rounded text-sm"
                      />
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        {/* Summary & Options */}
        <div className="space-y-6">
          <div className="bg-white rounded-xl shadow-sm p-6">
            <h2 className="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
              <IndianRupee className="w-5 h-5 text-amber-600" />
              Order Summary
            </h2>
            
            <div className="space-y-3">
              <div className="flex justify-between text-sm">
                <span className="text-gray-600">Taxable Amount</span>
                <span>₹{totals.taxableTotal.toLocaleString()}</span>
              </div>
              <div className="flex justify-between text-sm">
                <span className="text-gray-600">GST (CGST + SGST)</span>
                <span>₹{totals.taxTotal.toLocaleString()}</span>
              </div>
              <div className="flex justify-between text-sm">
                <span className="text-gray-600">Items Total</span>
                <span>₹{totals.itemsTotal.toLocaleString()}</span>
              </div>
              
              <hr />
              
              <div className="space-y-2">
                <div className="flex items-center gap-2">
                  <span className="text-sm text-gray-600 w-24">Discount %</span>
                  <input
                    type="number"
                    min="0"
                    max="100"
                    value={invoiceDetails.discount || 0}
                    onChange={(e) => setInvoiceDetails({...invoiceDetails, discount: parseFloat(e.target.value) || 0})}
                    className="flex-1 px-2 py-1 border rounded text-sm"
                  />
                </div>
                <div className="flex items-center gap-2">
                  <span className="text-sm text-gray-600 w-24">Delivery ₹</span>
                  <input
                    type="number"
                    min="0"
                    value={invoiceDetails.delivery_charges || 0}
                    onChange={(e) => setInvoiceDetails({...invoiceDetails, delivery_charges: parseFloat(e.target.value) || 0})}
                    className="flex-1 px-2 py-1 border rounded text-sm"
                  />
                </div>
                <div className="flex items-center gap-2">
                  <span className="text-sm text-gray-600 w-24">Round Off ₹</span>
                  <input
                    type="number"
                    value={invoiceDetails.round_off || 0}
                    onChange={(e) => setInvoiceDetails({...invoiceDetails, round_off: parseFloat(e.target.value) || 0})}
                    className="flex-1 px-2 py-1 border rounded text-sm"
                  />
                </div>
              </div>
              
              <hr />
              
              <div className="flex justify-between text-lg font-bold">
                <span>Grand Total</span>
                <span className="text-green-600">₹{totals.finalTotal.toLocaleString()}</span>
              </div>
            </div>
          </div>

          {/* Order Options */}
          <div className="bg-white rounded-xl shadow-sm p-6">
            <h3 className="font-semibold text-gray-900 mb-4">Order Options</h3>
            
            <div className="space-y-4">
              <div className="bg-yellow-50 border border-yellow-200 rounded-lg p-3">
                <span className="text-xs font-medium text-gray-500 block mb-1">Document Type</span>
                <span className="font-medium text-gray-900">
                  {invoiceDetails.document_type === 'sales_order' ? 'Sales Order' : 'Direct Invoice'}
                </span>
              </div>

              {invoiceDetails.document_type === 'sales_order' && (
                <div className="bg-blue-50 border border-blue-200 rounded-lg p-4 space-y-4">
                  <div>
                    <label className="block text-sm font-semibold text-gray-900 mb-2">Expected Delivery Date</label>
                    <input
                      type="date"
                      value={invoiceDetails.expected_delivery_date || ''}
                      onChange={(e) => {
                        const selectedDate = e.target.value;
                        const today = new Date().toISOString().split('T')[0];
                        const isFutureDate = selectedDate > today;
                        setInvoiceDetails({
                          ...invoiceDetails,
                          expected_delivery_date: selectedDate,
                          immediate_delivery: isFutureDate ? false : invoiceDetails.immediate_delivery
                        });
                      }}
                      className="w-full px-3 py-2 border rounded-lg"
                    />
                  </div>

                  <div className="flex items-center gap-3 pt-2 border-t border-blue-200">
                    <input
                      type="checkbox"
                      id="immediate_delivery"
                      checked={!!invoiceDetails.immediate_delivery}
                      onChange={(e) => setInvoiceDetails({...invoiceDetails, immediate_delivery: e.target.checked})}
                      className="w-4 h-4 text-blue-600 rounded"
                    />
                    <label htmlFor="immediate_delivery" className="text-sm text-gray-700">
                      <span className="font-medium">Immediate Delivery</span>
                      <span className="block text-xs text-gray-500">
                        {invoiceDetails.immediate_delivery
                          ? "Will appear in Warehouse's 'SO to Invoice' for quick processing"
                          : "Will appear in Warehouse's 'Pending SOs' for later processing"}
                      </span>
                    </label>
                  </div>
                </div>
              )}

              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Payment Mode</label>
                <select
                  value={invoiceDetails.payment_mode || 'cash'}
                  onChange={(e) => setInvoiceDetails({...invoiceDetails, payment_mode: e.target.value})}
                  className="w-full px-3 py-2 border rounded-lg"
                >
                  <option value="cash">Cash</option>
                  <option value="card">Card</option>
                  <option value="upi">UPI</option>
                  <option value="neft">NEFT/RTGS</option>
                  <option value="cheque">Cheque</option>
                </select>
              </div>
              
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Order Source</label>
                <select
                  value={invoiceDetails.order_source || ''}
                  onChange={(e) => setInvoiceDetails({...invoiceDetails, order_source: e.target.value})}
                  className="w-full px-3 py-2 border rounded-lg"
                >
                  <option value="">-- Select --</option>
                  <option value="walk_in">Walk-in</option>
                  <option value="phone_call">Phone Call</option>
                  <option value="whatsapp">WhatsApp</option>
                  <option value="website">Website</option>
                  <option value="google_ads">Google Ads</option>
                  <option value="facebook_ads">Facebook Ads</option>
                  <option value="referral">Referral</option>
                  <option value="repeat_customer">Repeat Customer</option>
                </select>
              </div>
              
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Notes</label>
                <textarea
                  value={invoiceDetails.notes || ''}
                  onChange={(e) => setInvoiceDetails({...invoiceDetails, notes: e.target.value})}
                  className="w-full px-3 py-2 border rounded-lg"
                  rows={3}
                  placeholder="Additional notes..."
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};

export default EditSalesOrder;

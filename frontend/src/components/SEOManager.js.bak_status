import React, { useState, useEffect } from 'react';
import { BACKEND_URL } from '../config/api';
import { useNavigate } from 'react-router-dom';
import { Search, Save, RefreshCw, AlertCircle, CheckCircle, Edit2, Globe, FileText, ArrowLeft, Trash2 } from 'lucide-react';


const SEOManager = () => {
  const navigate = useNavigate();
  const [pages, setPages] = useState([]);
  const [selectedPage, setSelectedPage] = useState(null);
  const [saving, setSaving] = useState(false);
  const [message, setMessage] = useState({ type: '', text: '' });
  const [formData, setFormData] = useState({
    page_path: '',
    page_type: 'page',
    title: '',
    description: '',
    keywords: '',
    h1_tag: '',
    canonical_url: '',
    og_image: '',
    schema_type: 'WebPage'
  });

  const pageTypes = [
    { value: 'page', label: 'Static Page' },
    { value: 'product', label: 'Product Page' },
    { value: 'category', label: 'Category Page' },
    { value: 'collection', label: 'Collection Page' }
  ];

  const schemaTypes = [
    'WebPage',
    'Product',
    'Organization',
    'Article',
    'BreadcrumbList',
    'FAQPage',
    'ContactPage'
  ];

  useEffect(() => {
    fetchPages();
  }, []);

  const authHeaders = (extra = {}) => {
    const keys = ['storeToken', 'admin_token', 'adminToken', 'token', 'userToken'];
    const k = keys.find(x => localStorage.getItem(x));
    return k ? { ...extra, Authorization: `Bearer ${localStorage.getItem(k)}` } : extra;
  };

  const fetchPages = async () => {
    try {
      const response = await fetch(`${BACKEND_URL}/api/seo-settings`, { headers: authHeaders() });
      const data = await response.json();
      setPages(data.pages || []);
    } catch (error) {
      console.error('Error fetching SEO pages:', error);
      showMessage('error', 'Failed to load SEO settings');
    }
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    setSaving(true);

    try {
      const method = selectedPage ? 'PUT' : 'POST';
      const url = selectedPage 
        ? `${BACKEND_URL}/api/seo-settings/${selectedPage.id}`
        : `${BACKEND_URL}/api/seo-settings`;

      const response = await fetch(url, {
        method,
        headers: authHeaders({ 'Content-Type': 'application/json' }),
        body: JSON.stringify(formData)
      });

      const data = await response.json();

      if (data.status === 'success') {
        showMessage('success', selectedPage ? 'SEO settings updated successfully' : 'SEO settings created successfully');
        fetchPages();
        resetForm();
      } else {
        showMessage('error', data.message || data.detail || 'Failed to save SEO settings');
      }
    } catch (error) {
      console.error('Error saving SEO settings:', error);
      showMessage('error', 'Failed to save SEO settings');
    } finally {
      setSaving(false);
    }
  };

  const handleDelete = async (page) => {
    if (!window.confirm(`Delete SEO entry for ${page.page_path}?`)) return;
    try {
      const response = await fetch(`${BACKEND_URL}/api/seo-settings/${page.id}`, {
        method: 'DELETE',
        headers: authHeaders()
      });
      const data = await response.json();
      if (data.status === 'success') {
        showMessage('success', 'Deleted');
        fetchPages();
        resetForm();
      } else {
        showMessage('error', data.detail || data.message || 'Delete failed');
      }
    } catch (error) {
      showMessage('error', 'Delete failed');
    }
  };

  const handleEdit = (page) => {
    setSelectedPage(page);
    setFormData({
      page_path: page.page_path || '',
      page_type: page.page_type || 'page',
      title: page.title || '',
      description: page.description || '',
      keywords: page.keywords || '',
      h1_tag: page.h1_tag || '',
      canonical_url: page.canonical_url || '',
      og_image: page.og_image || '',
      schema_type: page.schema_type || 'WebPage'
    });
  };

  const resetForm = () => {
    setSelectedPage(null);
    setFormData({
      page_path: '',
      page_type: 'page',
      title: '',
      description: '',
      keywords: '',
      h1_tag: '',
      canonical_url: '',
      og_image: '',
      schema_type: 'WebPage'
    });
  };

  const showMessage = (type, text) => {
    setMessage({ type, text });
    setTimeout(() => setMessage({ type: '', text: '' }), 5000);
  };

  const handleInputChange = (e) => {
    const { name, value } = e.target;
    setFormData(prev => ({
      ...prev,
      [name]: value
    }));
  };

  return (
    <div className="p-6 bg-gray-50 min-h-screen">
      {/* Back Button */}
      <button
        onClick={() => navigate('/admin')}
        className="flex items-center px-4 py-2 mb-6 text-gray-700 bg-white hover:bg-gray-100 rounded-lg transition-all border border-gray-300 hover:border-gray-400 shadow-sm"
        data-testid="back-to-dashboard-btn"
      >
        <ArrowLeft className="h-5 w-5 mr-2" />
        <span className="font-medium">Back to Dashboard</span>
      </button>

      {/* Header */}
      <div className="mb-6">
        <h1 className="text-3xl font-bold text-gray-900 flex items-center gap-3">
          <Globe className="w-8 h-8 text-blue-700" />
          SEO Manager
        </h1>
        <p className="text-gray-600 mt-2">Manage meta tags, titles, and descriptions for all pages</p>
      </div>

      {/* Message Alert */}
      {message.text && (
        <div className={`mb-6 p-4 rounded-lg flex items-center gap-3 ${
          message.type === 'success' ? 'bg-green-50 text-green-800 border border-green-200' : 'bg-red-50 text-red-800 border border-red-200'
        }`}>
          {message.type === 'success' ? <CheckCircle className="w-5 h-5" /> : <AlertCircle className="w-5 h-5" />}
          {message.text}
        </div>
      )}

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {/* Form Section */}
        <div className="lg:col-span-2">
          <div className="bg-white rounded-lg shadow-lg p-6">
            <div className="flex justify-between items-center mb-6">
              <h2 className="text-xl font-bold text-gray-900">
                {selectedPage ? 'Edit SEO Settings' : 'Add New SEO Settings'}
              </h2>
              {selectedPage && (
                <button
                  onClick={resetForm}
                  className="text-blue-600 hover:text-blue-800 flex items-center gap-2"
                >
                  <RefreshCw className="w-4 h-4" />
                  Clear
                </button>
              )}
            </div>

            <form onSubmit={handleSubmit} className="space-y-6">
              {/* Page Path */}
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">
                  Page Path <span className="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  name="page_path"
                  value={formData.page_path}
                  onChange={handleInputChange}
                  placeholder="/category/washing-machines"
                  required
                  className="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-600"
                />
                <p className="text-xs text-gray-500 mt-1">E.g., /, /about, /category/washing-machines</p>
              </div>

              {/* Page Type */}
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">
                  Page Type
                </label>
                <select
                  name="page_type"
                  value={formData.page_type}
                  onChange={handleInputChange}
                  className="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-600"
                >
                  {pageTypes.map(type => (
                    <option key={type.value} value={type.value}>{type.label}</option>
                  ))}
                </select>
              </div>

              {/* Title */}
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">
                  Page Title <span className="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  name="title"
                  value={formData.title}
                  onChange={handleInputChange}
                  placeholder="Buy Washing Machines Online | Best Prices | Aditya Retail"
                  required
                  maxLength="60"
                  className="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-600"
                />
                <p className="text-xs text-gray-500 mt-1">
                  {formData.title.length}/60 characters (optimal: 50-60)
                </p>
              </div>

              {/* Description */}
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">
                  Meta Description <span className="text-red-500">*</span>
                </label>
                <textarea
                  name="description"
                  value={formData.description}
                  onChange={handleInputChange}
                  placeholder="Shop premium washing machines from Bosch, Siemens. Front load, top load with best prices, warranty & free delivery."
                  required
                  maxLength="160"
                  rows="3"
                  className="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-600"
                />
                <p className="text-xs text-gray-500 mt-1">
                  {formData.description.length}/160 characters (optimal: 150-160)
                </p>
              </div>

              {/* Keywords */}
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">
                  Keywords
                </label>
                <input
                  type="text"
                  name="keywords"
                  value={formData.keywords}
                  onChange={handleInputChange}
                  placeholder="washing machine, front load, bosch, siemens"
                  className="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-600"
                />
                <p className="text-xs text-gray-500 mt-1">Comma-separated keywords</p>
              </div>

              {/* H1 Tag */}
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">
                  H1 Tag
                </label>
                <input
                  type="text"
                  name="h1_tag"
                  value={formData.h1_tag}
                  onChange={handleInputChange}
                  placeholder="Premium Washing Machines"
                  className="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-600"
                />
              </div>

              {/* Canonical URL */}
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">
                  Canonical URL
                </label>
                <input
                  type="text"
                  name="canonical_url"
                  value={formData.canonical_url}
                  onChange={handleInputChange}
                  placeholder="https://www.adityaretail.com/category/washing-machines"
                  className="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-600"
                />
              </div>

              {/* OG Image */}
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">
                  Open Graph Image URL
                </label>
                <input
                  type="text"
                  name="og_image"
                  value={formData.og_image}
                  onChange={handleInputChange}
                  placeholder="https://www.adityaretail.com/images/og-image.jpg"
                  className="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-600"
                />
              </div>

              {/* Schema Type */}
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">
                  Schema Type
                </label>
                <select
                  name="schema_type"
                  value={formData.schema_type}
                  onChange={handleInputChange}
                  className="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-600"
                >
                  {schemaTypes.map(type => (
                    <option key={type} value={type}>{type}</option>
                  ))}
                </select>
              </div>

              {/* Submit Button */}
              <button
                type="submit"
                disabled={saving}
                className="w-full bg-blue-700 text-white py-3 rounded-lg hover:bg-blue-800 transition-colors flex items-center justify-center gap-2 disabled:bg-gray-300"
              >
                {saving ? (
                  <>
                    <RefreshCw className="w-5 h-5 animate-spin" />
                    Saving...
                  </>
                ) : (
                  <>
                    <Save className="w-5 h-5" />
                    {selectedPage ? 'Update SEO Settings' : 'Create SEO Settings'}
                  </>
                )}
              </button>
            </form>
          </div>
        </div>

        {/* Pages List */}
        <div className="lg:col-span-1">
          <div className="bg-white rounded-lg shadow-lg p-6">
            <h2 className="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
              <FileText className="w-5 h-5" />
              Managed Pages ({pages.length})
            </h2>

            <div className="space-y-2 max-h-[600px] overflow-y-auto">
              {pages.length === 0 ? (
                <p className="text-gray-500 text-center py-8">No pages configured yet</p>
              ) : (
                pages.map((page) => (
                  <div
                    key={page.id}
                    className="border border-gray-200 rounded-lg p-3 hover:shadow-md transition-shadow cursor-pointer"
                    onClick={() => handleEdit(page)}
                  >
                    <div className="flex justify-between items-start mb-2">
                      <div className="flex-1">
                        <div className="font-semibold text-gray-900 text-sm truncate">
                          {page.page_path}
                        </div>
                        <div className="text-xs text-gray-500 mt-1">
                          {page.page_type}
                        </div>
                      </div>
                      <div className="flex items-center gap-2">
                        <button
                          onClick={(e) => {
                            e.stopPropagation();
                            handleEdit(page);
                          }}
                          className="text-blue-600 hover:text-blue-800"
                          title="Edit"
                        >
                          <Edit2 className="w-4 h-4" />
                        </button>
                        <button
                          onClick={(e) => {
                            e.stopPropagation();
                            handleDelete(page);
                          }}
                          className="text-red-600 hover:text-red-800"
                          title="Delete"
                        >
                          <Trash2 className="w-4 h-4" />
                        </button>
                      </div>
                    </div>
                    <div className="text-xs text-gray-600 line-clamp-2">
                      {page.title}
                    </div>
                  </div>
                ))
              )}
            </div>
          </div>

          {/* SEO Tips */}
          <div className="bg-blue-50 rounded-lg p-4 mt-4 border border-blue-200">
            <h3 className="font-bold text-blue-900 mb-2">SEO Best Practices</h3>
            <ul className="text-xs text-blue-800 space-y-1">
              <li>• Title: 50-60 characters</li>
              <li>• Description: 150-160 characters</li>
              <li>• Include primary keywords</li>
              <li>• Make it compelling</li>
              <li>• Use unique content per page</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  );
};

export default SEOManager;

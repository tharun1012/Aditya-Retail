// Helper: Generate combined homepage schemas (Organization + Website + LocalBusiness)
export const getHomepageSchemas = () => [
  organizationSchema,
  websiteSchema,
  localBusinessSchema
];

// Helper: Render multiple schemas as JSON-LD script tags content
export const schemasToJsonLd = (schemas) => {
  return schemas.filter(Boolean).map(s => JSON.stringify(s));
};

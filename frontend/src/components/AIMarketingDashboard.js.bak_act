import React, { useState, useEffect } from 'react';
import { BACKEND_URL } from '../config/api';
import { useNavigate } from 'react-router-dom';
import { Target, TrendingUp, Zap, Play, Pause, Settings, BarChart3, Calendar, DollarSign, Users, CheckCircle, Activity, Sparkles, X as CloseIcon, ArrowLeft } from 'lucide-react';


const AIMarketingDashboard = () => {
  const navigate = useNavigate();
  const [automationStatus, setAutomationStatus] = useState('loading');
  const [progress, setProgress] = useState(null);
  const [campaigns, setCampaigns] = useState([]);
  const [loadingCampaigns, setLoadingCampaigns] = useState(true);
  const [selectedCampaign, setSelectedCampaign] = useState(null);
  const [targets, setTargets] = useState({
    monthly_leads: 100,
    monthly_revenue: 2000000,
    conversion_rate: 15,
    cost_per_lead: 500
  });
  const [showSettings, setShowSettings] = useState(false);

  useEffect(() => {
    fetchAutomationStatus();
    fetchProgress();
    fetchCampaigns();
    
    // Refresh every 5 minutes
    const interval = setInterval(() => {
      fetchProgress();
      fetchCampaigns();
    }, 300000);
    
    return () => clearInterval(interval);
  }, []);

  const fetchAutomationStatus = async () => {
    try {
      const response = await fetch(`${BACKEND_URL}/api/marketing-automation/status`);
      const data = await response.json();
      setAutomationStatus(data.status);
    } catch (error) {
      console.error('Error fetching status:', error);
      setAutomationStatus('unknown');
    }
  };

  const fetchProgress = async () => {
    try {
      const response = await fetch(`${BACKEND_URL}/api/marketing-automation/progress`);
      const data = await response.json();
      setProgress(data);
    } catch (error) {
      console.error('Error fetching progress:', error);
    }
  };

  const fetchCampaigns = async () => {
    try {
      setLoadingCampaigns(true);
      const response = await fetch(`${BACKEND_URL}/api/marketing-campaigns`);
      const data = await response.json();
      if (data.status === 'success') {
        setCampaigns(data.campaigns || []);
      }
    } catch (error) {
      console.error('Error fetching campaigns:', error);
    } finally {
      setLoadingCampaigns(false);
    }
  };

  const handleActivate = async () => {
    try {
      const response = await fetch(`${BACKEND_URL}/api/marketing-automation/activate`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ targets })
      });
      
      const data = await response.json();
      if (data.status === 'success') {
        alert('✅ AI Marketing Agent Activated!');
        setAutomationStatus('active');
        fetchProgress();
      }
    } catch (error) {
      console.error('Error activating:', error);
      alert('Failed to activate automation');
    }
  };

  const handleUpdateTargets = async () => {
    try {
      const response = await fetch(`${BACKEND_URL}/api/marketing-automation/targets`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(targets)
      });
      
      if (response.ok) {
        alert('✅ Targets Updated Successfully!');
        setShowSettings(false);
        fetchProgress();
      }
    } catch (error) {
      console.error('Error updating targets:', error);
      alert('Failed to update targets');
    }
  };

  return (
    <div className="p-6 bg-gray-50 min-h-screen">
      {/* Back Button */}
      <button
        onClick={() => navigate('/admin')}
        className="flex items-center px-4 py-2 mb-6 text-gray-700 bg-white hover:bg-gray-100 rounded-lg transition-all border border-gray-300 hover:border-gray-400 shadow-sm"
        data-testid="back-to-dashboard-btn"
      >
        <ArrowLeft className="h-5 w-5 mr-2" />
        <span className="font-medium">Back to Dashboard</span>
      </button>

      {/* Header */}
      <div className="mb-6">
        <h1 className="text-3xl font-bold text-gray-900 flex items-center gap-3">
          <Zap className="w-8 h-8 text-purple-600" />
          Autonomous AI Marketing Agent
        </h1>
        <p className="text-gray-600 mt-2">24/7 automated lead generation and campaign management</p>
      </div>

      {/* Status Banner */}
      <div className={`rounded-lg p-6 mb-6 ${
        automationStatus === 'active' ? 'bg-green-50 border-2 border-green-500' :
        automationStatus === 'paused' ? 'bg-yellow-50 border-2 border-yellow-500' :
        'bg-gray-50 border-2 border-gray-300'
      }`}>
        <div className="flex items-center justify-between">
          <div className="flex items-center gap-4">
            {automationStatus === 'active' ? (
              <>
                <div className="bg-green-500 p-3 rounded-full">
                  <Activity className="w-6 h-6 text-white animate-pulse" />
                </div>
                <div>
                  <h3 className="text-xl font-bold text-green-900">AI Agent is ACTIVE</h3>
                  <p className="text-green-700">Running autonomous marketing campaigns 24/7</p>
                </div>
              </>
            ) : automationStatus === 'paused' ? (
              <>
                <div className="bg-yellow-500 p-3 rounded-full">
                  <Pause className="w-6 h-6 text-white" />
                </div>
                <div>
                  <h3 className="text-xl font-bold text-yellow-900">AI Agent is PAUSED</h3>
                  <p className="text-yellow-700">Click Activate to resume automation</p>
                </div>
              </>
            ) : (
              <>
                <div className="bg-gray-400 p-3 rounded-full">
                  <Zap className="w-6 h-6 text-white" />
                </div>
                <div>
                  <h3 className="text-xl font-bold text-gray-900">AI Agent Not Started</h3>
                  <p className="text-gray-700">Configure targets and activate to begin</p>
                </div>
              </>
            )}
          </div>
          
          <div className="flex gap-3">
            <button
              onClick={() => {
                const campaignsSection = document.getElementById('campaigns-section');
                if (campaignsSection) {
                  campaignsSection.scrollIntoView({ behavior: 'smooth' });
                }
              }}
              className="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 flex items-center gap-2"
            >
              <Target className="w-4 h-4" />
              View Campaigns ({campaigns.length})
            </button>
            <button
              onClick={() => setShowSettings(true)}
              className="px-4 py-2 bg-white border-2 border-gray-300 rounded-lg hover:bg-gray-50 flex items-center gap-2"
            >
              <Settings className="w-4 h-4" />
              Configure
            </button>
            {automationStatus !== 'active' && (
              <button
                onClick={handleActivate}
                className="px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 flex items-center gap-2 font-semibold"
              >
                <Play className="w-4 h-4" />
                Activate AI Agent
              </button>
            )}
          </div>
        </div>
      </div>

      {/* Monthly Progress */}
      {progress && (
        <div className="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
          {/* Leads Progress */}
          <div className="bg-white rounded-lg shadow-lg p-6">
            <div className="flex items-center justify-between mb-4">
              <div className="flex items-center gap-3">
                <div className="bg-blue-100 p-3 rounded-lg">
                  <Users className="w-6 h-6 text-blue-600" />
                </div>
                <div>
                  <h3 className="text-lg font-bold text-gray-900">Monthly Leads</h3>
                  <p className="text-sm text-gray-600">{progress.month}</p>
                </div>
              </div>
            </div>
            
            <div className="mb-4">
              <div className="flex justify-between mb-2">
                <span className="text-3xl font-bold text-blue-600">{progress.leads_generated}</span>
                <span className="text-lg text-gray-600">/ {progress.target_leads}</span>
              </div>
              <div className="w-full bg-gray-200 rounded-full h-3">
                <div 
                  className="bg-blue-600 h-3 rounded-full transition-all"
                  style={{ width: `${Math.min(progress.leads_percentage, 100)}%` }}
                ></div>
              </div>
              <p className="text-sm text-gray-600 mt-2">{progress.leads_percentage.toFixed(1)}% of target achieved</p>
            </div>
            
            {progress.leads_percentage >= 100 && (
              <div className="bg-green-50 border border-green-200 rounded-lg p-3 flex items-center gap-2">
                <CheckCircle className="w-5 h-5 text-green-600" />
                <span className="text-sm text-green-800 font-medium">Target Achieved! 🎉</span>
              </div>
            )}
          </div>

          {/* Revenue Progress */}
          <div className="bg-white rounded-lg shadow-lg p-6">
            <div className="flex items-center justify-between mb-4">
              <div className="flex items-center gap-3">
                <div className="bg-green-100 p-3 rounded-lg">
                  <DollarSign className="w-6 h-6 text-green-600" />
                </div>
                <div>
                  <h3 className="text-lg font-bold text-gray-900">Monthly Revenue</h3>
                  <p className="text-sm text-gray-600">{progress.month}</p>
                </div>
              </div>
            </div>
            
            <div className="mb-4">
              <div className="flex justify-between mb-2">
                <span className="text-3xl font-bold text-green-600">₹{(progress.revenue_generated / 100000).toFixed(1)}L</span>
                <span className="text-lg text-gray-600">/ ₹{(progress.target_revenue / 100000).toFixed(0)}L</span>
              </div>
              <div className="w-full bg-gray-200 rounded-full h-3">
                <div 
                  className="bg-green-600 h-3 rounded-full transition-all"
                  style={{ width: `${Math.min(progress.revenue_percentage, 100)}%` }}
                ></div>
              </div>
              <p className="text-sm text-gray-600 mt-2">{progress.revenue_percentage.toFixed(1)}% of target achieved</p>
            </div>
            
            {progress.revenue_percentage >= 100 && (
              <div className="bg-green-50 border border-green-200 rounded-lg p-3 flex items-center gap-2">
                <CheckCircle className="w-5 h-5 text-green-600" />
                <span className="text-sm text-green-800 font-medium">Target Achieved! 🎉</span>
              </div>
            )}
          </div>
        </div>
      )}

      {/* AI Generated Campaigns */}
      <div id="campaigns-section" className="bg-white rounded-lg shadow-lg p-6 mb-6">
        <div className="flex items-center justify-between mb-6">
          <h3 className="text-xl font-bold text-gray-900 flex items-center gap-2">
            <Target className="w-6 h-6 text-purple-600" />
            AI-Generated Marketing Campaigns
          </h3>
          <span className="px-3 py-1 bg-purple-100 text-purple-800 rounded-full text-sm font-medium">
            {campaigns.length} Active Campaigns
          </span>
        </div>

        {loadingCampaigns ? (
          <div className="text-center py-8">
            <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-purple-600 mx-auto"></div>
            <p className="text-gray-600 mt-4">Loading campaigns...</p>
          </div>
        ) : campaigns.length === 0 ? (
          <div className="text-center py-8 bg-gray-50 rounded-lg">
            <Target className="w-16 h-16 text-gray-400 mx-auto mb-4" />
            <p className="text-gray-600">No campaigns generated yet. They will be created automatically by the AI agent.</p>
          </div>
        ) : (
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
            {campaigns.map((campaign, index) => (
              <div 
                key={campaign.id || index}
                className="border rounded-lg p-4 hover:shadow-md transition-all cursor-pointer bg-gradient-to-br from-white to-purple-50"
                onClick={() => setSelectedCampaign(campaign)}
              >
                {/* Campaign Header */}
                <div className="flex items-start justify-between mb-3">
                  <div className="flex-1">
                    <h4 className="font-bold text-gray-900 text-lg mb-1">{campaign.campaign_name}</h4>
                    <p className="text-sm text-gray-600">{campaign.product_name}</p>
                  </div>
                  <span className={`px-2 py-1 rounded text-xs font-medium ${
                    campaign.status === 'active' ? 'bg-green-100 text-green-800' :
                    campaign.status === 'paused' ? 'bg-yellow-100 text-yellow-800' :
                    'bg-gray-100 text-gray-800'
                  }`}>
                    {campaign.status}
                  </span>
                </div>

                {/* Campaign Content */}
                <div className="bg-white rounded-lg p-3 mb-3">
                  <div className="text-sm mb-2">
                    <span className="font-semibold text-purple-900">Headline:</span>
                    <p className="text-gray-700 mt-1">{campaign.content?.headline}</p>
                  </div>
                  <div className="text-sm">
                    <span className="font-semibold text-purple-900">Description:</span>
                    <p className="text-gray-700 mt-1">{campaign.content?.description}</p>
                  </div>
                </div>

                {/* Campaign Metrics */}
                <div className="grid grid-cols-3 gap-2 mb-3">
                  <div className="bg-blue-50 rounded p-2 text-center">
                    <p className="text-xs text-blue-600 font-medium">Budget</p>
                    <p className="text-sm font-bold text-blue-900">₹{campaign.budget?.toLocaleString()}</p>
                  </div>
                  <div className="bg-green-50 rounded p-2 text-center">
                    <p className="text-xs text-green-600 font-medium">Target Leads</p>
                    <p className="text-sm font-bold text-green-900">{campaign.expected_metrics?.leads_per_month}</p>
                  </div>
                  <div className="bg-orange-50 rounded p-2 text-center">
                    <p className="text-xs text-orange-600 font-medium">CPL</p>
                    <p className="text-sm font-bold text-orange-900">₹{campaign.expected_metrics?.cost_per_lead}</p>
                  </div>
                </div>

                {/* Channels */}
                <div className="flex flex-wrap gap-1">
                  {campaign.channels?.map((channel, i) => (
                    <span key={i} className="px-2 py-1 bg-purple-100 text-purple-700 rounded text-xs">
                      {channel}
                    </span>
                  ))}
                </div>

                {/* View Details */}
                <button className="mt-3 w-full text-sm text-purple-600 hover:text-purple-800 font-medium flex items-center justify-center gap-1">
                  <span>View Full Campaign Details</span>
                  <span>→</span>
                </button>
              </div>
            ))}
          </div>
        )}
      </div>

      {/* How It Works */}
      <div className="bg-white rounded-lg shadow-lg p-6 mb-6">
        <h3 className="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
          <BarChart3 className="w-6 h-6 text-purple-600" />
          How Autonomous Marketing Works
        </h3>
        
        <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div className="text-center">
            <div className="bg-blue-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-3">
              <Calendar className="w-8 h-8 text-blue-600" />
            </div>
            <h4 className="font-bold mb-2">Daily (9 AM)</h4>
            <p className="text-sm text-gray-600">
              Creates campaigns, optimizes performance, tracks progress
            </p>
          </div>
          
          <div className="text-center">
            <div className="bg-green-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-3">
              <TrendingUp className="w-8 h-8 text-green-600" />
            </div>
            <h4 className="font-bold mb-2">Weekly (Monday)</h4>
            <p className="text-sm text-gray-600">
              Analyzes performance, adjusts strategy, reallocates budget
            </p>
          </div>
          
          <div className="text-center">
            <div className="bg-purple-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-3">
              <Target className="w-8 h-8 text-purple-600" />
            </div>
            <h4 className="font-bold mb-2">Monthly (1st)</h4>
            <p className="text-sm text-gray-600">
              Generates report, evaluates targets, plans next month
            </p>
          </div>
        </div>
      </div>

      {/* Campaign Details Modal */}
      {selectedCampaign && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
          <div className="bg-white rounded-xl max-w-4xl w-full max-h-[90vh] overflow-y-auto p-6">
            <div className="flex items-center justify-between mb-6">
              <h2 className="text-2xl font-bold text-gray-900">Campaign Details</h2>
              <button
                onClick={() => setSelectedCampaign(null)}
                className="text-gray-400 hover:text-gray-600"
              >
                <CloseIcon className="w-6 h-6" />
              </button>
            </div>

            {/* Campaign Overview */}
            <div className="bg-purple-50 rounded-lg p-4 mb-6">
              <h3 className="text-xl font-bold text-purple-900 mb-2">{selectedCampaign.campaign_name}</h3>
              <p className="text-gray-700 mb-2"><strong>Product:</strong> {selectedCampaign.product_name}</p>
              <p className="text-gray-700"><strong>Target Audience:</strong> {selectedCampaign.target_audience}</p>
            </div>

            {/* Ad Content */}
            <div className="mb-6">
              <h3 className="text-lg font-bold text-gray-900 mb-3 flex items-center gap-2">
                <Sparkles className="w-5 h-5 text-purple-600" />
                Ad Content
              </h3>
              <div className="bg-white border-2 border-purple-200 rounded-lg p-4">
                <div className="mb-4">
                  <label className="text-sm font-bold text-purple-900">Headline:</label>
                  <p className="text-lg font-semibold text-gray-900 mt-1">{selectedCampaign.content?.headline}</p>
                </div>
                <div className="mb-4">
                  <label className="text-sm font-bold text-purple-900">Description:</label>
                  <p className="text-gray-700 mt-1">{selectedCampaign.content?.description}</p>
                </div>
                <div className="mb-4">
                  <label className="text-sm font-bold text-purple-900">Call to Action:</label>
                  <p className="text-gray-900 font-medium mt-1">{selectedCampaign.content?.call_to_action}</p>
                </div>
                <div className="bg-green-50 rounded p-3">
                  <label className="text-sm font-bold text-green-900">Special Offer:</label>
                  <p className="text-green-800 font-medium mt-1">{selectedCampaign.content?.offer}</p>
                </div>
              </div>
            </div>

            {/* Targeting Details */}
            <div className="mb-6">
              <h3 className="text-lg font-bold text-gray-900 mb-3 flex items-center gap-2">
                <Target className="w-5 h-5 text-blue-600" />
                Targeting Strategy
              </h3>
              <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div className="bg-blue-50 rounded-lg p-4">
                  <h4 className="font-bold text-blue-900 mb-2">Demographics</h4>
                  <ul className="space-y-1">
                    {selectedCampaign.targeting?.demographics?.map((demo, i) => (
                      <li key={i} className="text-sm text-gray-700">• {demo}</li>
                    ))}
                  </ul>
                </div>
                <div className="bg-green-50 rounded-lg p-4">
                  <h4 className="font-bold text-green-900 mb-2">Interests</h4>
                  <ul className="space-y-1">
                    {selectedCampaign.targeting?.interests?.map((interest, i) => (
                      <li key={i} className="text-sm text-gray-700">• {interest}</li>
                    ))}
                  </ul>
                </div>
                <div className="bg-orange-50 rounded-lg p-4">
                  <h4 className="font-bold text-orange-900 mb-2">Keywords</h4>
                  <div className="flex flex-wrap gap-2">
                    {selectedCampaign.targeting?.keywords?.map((keyword, i) => (
                      <span key={i} className="px-2 py-1 bg-orange-200 text-orange-900 rounded text-sm">
                        {keyword}
                      </span>
                    ))}
                  </div>
                </div>
                <div className="bg-purple-50 rounded-lg p-4">
                  <h4 className="font-bold text-purple-900 mb-2">Target Locations</h4>
                  <div className="flex flex-wrap gap-2">
                    {selectedCampaign.targeting?.locations?.map((location, i) => (
                      <span key={i} className="px-2 py-1 bg-purple-200 text-purple-900 rounded text-sm">
                        {location}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            {/* Campaign Metrics */}
            <div className="mb-6">
              <h3 className="text-lg font-bold text-gray-900 mb-3 flex items-center gap-2">
                <BarChart3 className="w-5 h-5 text-green-600" />
                Expected Performance
              </h3>
              <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div className="bg-white border rounded-lg p-4 text-center">
                  <p className="text-sm text-gray-600 mb-1">Monthly Budget</p>
                  <p className="text-2xl font-bold text-gray-900">₹{selectedCampaign.budget?.toLocaleString()}</p>
                </div>
                <div className="bg-white border rounded-lg p-4 text-center">
                  <p className="text-sm text-gray-600 mb-1">Target Leads</p>
                  <p className="text-2xl font-bold text-green-600">{selectedCampaign.expected_metrics?.leads_per_month}</p>
                </div>
                <div className="bg-white border rounded-lg p-4 text-center">
                  <p className="text-sm text-gray-600 mb-1">Cost Per Lead</p>
                  <p className="text-2xl font-bold text-orange-600">₹{selectedCampaign.expected_metrics?.cost_per_lead}</p>
                </div>
                <div className="bg-white border rounded-lg p-4 text-center">
                  <p className="text-sm text-gray-600 mb-1">Conversion Rate</p>
                  <p className="text-2xl font-bold text-purple-600">{selectedCampaign.expected_metrics?.conversion_rate}%</p>
                </div>
              </div>
            </div>

            {/* Marketing Channels */}
            <div>
              <h3 className="text-lg font-bold text-gray-900 mb-3">Marketing Channels</h3>
              <div className="flex flex-wrap gap-3">
                {selectedCampaign.channels?.map((channel, i) => (
                  <div key={i} className="bg-gradient-to-r from-purple-500 to-blue-500 text-white px-4 py-2 rounded-lg font-medium">
                    {channel}
                  </div>
                ))}
              </div>
            </div>

            <div className="mt-6 flex justify-end">
              <button
                onClick={() => setSelectedCampaign(null)}
                className="px-6 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300"
              >
                Close
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Settings Modal */}
      {showSettings && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
          <div className="bg-white rounded-xl max-w-2xl w-full p-6">
            <h2 className="text-2xl font-bold mb-6">Configure Monthly Targets</h2>
            
            <div className="space-y-4">
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">
                  Monthly Leads Target
                </label>
                <input
                  type="number"
                  value={targets.monthly_leads}
                  onChange={(e) => setTargets({...targets, monthly_leads: parseInt(e.target.value)})}
                  className="w-full px-4 py-2 border rounded-lg"
                />
              </div>
              
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">
                  Monthly Revenue Target (₹)
                </label>
                <input
                  type="number"
                  value={targets.monthly_revenue}
                  onChange={(e) => setTargets({...targets, monthly_revenue: parseInt(e.target.value)})}
                  className="w-full px-4 py-2 border rounded-lg"
                />
              </div>
              
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">
                  Target Conversion Rate (%)
                </label>
                <input
                  type="number"
                  value={targets.conversion_rate}
                  onChange={(e) => setTargets({...targets, conversion_rate: parseFloat(e.target.value)})}
                  className="w-full px-4 py-2 border rounded-lg"
                />
              </div>
              
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">
                  Cost Per Lead (₹)
                </label>
                <input
                  type="number"
                  value={targets.cost_per_lead}
                  onChange={(e) => setTargets({...targets, cost_per_lead: parseFloat(e.target.value)})}
                  className="w-full px-4 py-2 border rounded-lg"
                />
              </div>
            </div>
            
            <div className="flex justify-end gap-3 mt-6">
              <button
                onClick={() => setShowSettings(false)}
                className="px-4 py-2 border rounded-lg hover:bg-gray-50"
              >
                Cancel
              </button>
              <button
                onClick={handleUpdateTargets}
                className="px-6 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700"
              >
                Save Targets
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

export default AIMarketingDashboard;

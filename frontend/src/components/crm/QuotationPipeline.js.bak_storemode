import React, { useState, useEffect, useCallback, useMemo } from 'react';
import { BACKEND_URL } from '../../config/api';
import { Card, CardContent } from '../ui/card';
import { FileText, Phone, Mail, CalendarClock, Trophy, TrendingUp, Wallet, X, Download } from 'lucide-react';
import { STAGES, timeAgo } from './leadUtils';

const inr = (n) => new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 }).format(Number(n) || 0);
const todayStr = () => new Date().toLocaleDateString('en-CA');
const isClosed = (q) => q.crm_stage === 'won' || q.crm_stage === 'lost';
const isOverdue = (q) => !!q.crm_follow_up_date && q.crm_follow_up_date < todayStr() && !isClosed(q);
const statusCls = (s) => (s === 'sent' ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-600');

const StatCard = ({ icon, bg, value, valueCls, label }) => (
  <Card>
    <CardContent className="p-4 flex items-center gap-3">
      <div className={`p-2.5 rounded-lg ${bg}`}>{icon}</div>
      <div>
        <p className={`text-2xl font-bold ${valueCls}`}>{value}</p>
        <p className="text-xs text-gray-500">{label}</p>
      </div>
    </CardContent>
  </Card>
);

export const QuotationPipeline = ({ searchTerm = '', viewMode = 'pipeline' }) => {
  const [items, setItems] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');
  const [selectedId, setSelectedId] = useState(null);
  const [draft, setDraft] = useState({ notes: '', followUp: '' });
  const [saving, setSaving] = useState(false);

  const load = useCallback(async () => {
    try {
      const res = await fetch(`${BACKEND_URL}/api/quotations/crm/pipeline`);
      const data = await res.json();
      if (!res.ok) throw new Error(data.detail || 'Failed to load quotations');
      setItems(data.quotations || []);
      setError('');
    } catch (e) {
      setError(e.message || 'Failed to load quotations');
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => { load(); }, [load]);

  const save = async (id, payload) => {
    const res = await fetch(`${BACKEND_URL}/api/quotations/${id}/crm-stage`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    if (!res.ok) throw new Error('Save failed');
  };

  const moveStage = async (id, stage) => {
    setItems((prev) => prev.map((q) => (q.id === id ? { ...q, crm_stage: stage } : q)));
    try { await save(id, { crm_stage: stage }); } catch (e) { setError('Could not save the stage change'); load(); }
  };

  const openQuote = (q) => {
    setSelectedId(q.id);
    setDraft({ notes: q.crm_notes || '', followUp: q.crm_follow_up_date || '' });
  };

  const saveDetails = async () => {
    setSaving(true);
    try {
      await save(selectedId, { crm_notes: draft.notes, follow_up_date: draft.followUp });
      setItems((prev) => prev.map((q) => (q.id === selectedId ? { ...q, crm_notes: draft.notes, crm_follow_up_date: draft.followUp || null } : q)));
      setError('');
    } catch (e) {
      setError('Could not save the details');
    }
    setSaving(false);
  };

  const term = (searchTerm || '').trim().toLowerCase();
  const visible = useMemo(() => {
    if (!term) return items;
    return items.filter((q) => [q.quotation_number, q.customer_name, q.customer_phone, q.customer_email, q.crm_notes]
      .some((v) => (v || '').toString().toLowerCase().includes(term)));
  }, [items, term]);
  const selectedQ = items.find((q) => q.id === selectedId) || null;

  const stats = useMemo(() => {
    const sum = (arr) => arr.reduce((s, q) => s + (Number(q.amount) || 0), 0);
    const open = visible.filter((q) => !isClosed(q));
    const won = visible.filter((q) => q.crm_stage === 'won');
    const lost = visible.filter((q) => q.crm_stage === 'lost');
    const closed = won.length + lost.length;
    return {
      total: visible.length,
      openValue: sum(open),
      won: won.length,
      wonValue: sum(won),
      winRate: closed ? Math.round((won.length / closed) * 100) : 0,
    };
  }, [visible]);

  const stageSelect = (q, cls) => (
    <select
      value={q.crm_stage}
      onClick={(e) => e.stopPropagation()}
      onChange={(e) => moveStage(q.id, e.target.value)}
      className={cls}
      data-testid={`quotation-stage-select-${q.id}`}
    >
      {STAGES.map((s) => <option key={s.key} value={s.key}>{s.label}</option>)}
    </select>
  );

  if (loading) return <div className="text-center py-12 text-gray-500 text-sm">Loading quotations...</div>;

  return (
    <div data-testid="quotation-pipeline">
      {error && (
        <div className="mb-4 px-4 py-2 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700">{error}</div>
      )}
      <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <StatCard icon={<FileText className="w-5 h-5 text-orange-600" />} bg="bg-orange-100" value={stats.total} valueCls="text-gray-900" label="Total Quotations" />
        <StatCard icon={<Wallet className="w-5 h-5 text-blue-600" />} bg="bg-blue-100" value={inr(stats.openValue)} valueCls="text-blue-600" label="Open Pipeline Value" />
        <StatCard icon={<Trophy className="w-5 h-5 text-green-600" />} bg="bg-green-100" value={stats.won} valueCls="text-green-600" label={`Won · ${inr(stats.wonValue)}`} />
        <StatCard icon={<TrendingUp className="w-5 h-5 text-purple-600" />} bg="bg-purple-100" value={`${stats.winRate}%`} valueCls="text-purple-600" label="Win Rate (won of closed)" />
      </div>

      {viewMode === 'pipeline' ? (
        <div className="flex gap-4 overflow-x-auto pb-4" data-testid="quotation-kanban-board">
          {STAGES.map((stage) => {
            const list = visible.filter((q) => q.crm_stage === stage.key);
            const total = list.reduce((s, q) => s + (Number(q.amount) || 0), 0);
            return (
              <div key={stage.key} className="flex-shrink-0 w-72" data-testid={`quotation-column-${stage.key}`}>
                <div className={`px-3 py-2 rounded-t-lg border ${stage.headerClass}`}>
                  <div className="flex items-center justify-between">
                    <span className="font-semibold text-sm">{stage.label}</span>
                    <span className="text-xs font-bold bg-white/70 px-2 py-0.5 rounded-full">{list.length}</span>
                  </div>
                  <div className="text-[11px] opacity-80 mt-0.5">{inr(total)}</div>
                </div>
                <div className="bg-gray-50 border border-t-0 border-gray-200 rounded-b-lg p-2 space-y-2 min-h-[200px] max-h-[600px] overflow-y-auto">
                  {list.length === 0 && <p className="text-xs text-gray-400 text-center py-6">No quotations</p>}
                  {list.map((q) => (
                    <div
                      key={q.id}
                      onClick={() => openQuote(q)}
                      className="bg-white rounded-lg border border-gray-200 p-3 cursor-pointer hover:shadow-md hover:border-orange-300 transition-shadow"
                      data-testid={`quotation-card-${q.id}`}
                    >
                      <div className="flex items-start justify-between gap-2">
                        <span className="font-semibold text-sm text-orange-600 truncate">{q.quotation_number || '-'}</span>
                        <span className={`px-1.5 py-0.5 rounded text-[10px] font-semibold ${statusCls(q.status)}`}>{q.status || 'draft'}</span>
                      </div>
                      <div className="mt-1 text-sm text-gray-900 truncate">{q.customer_name || 'Unknown'}</div>
                      {q.customer_phone && (
                        <div className="flex items-center gap-1 text-xs text-gray-600"><Phone className="w-3 h-3" />{q.customer_phone}</div>
                      )}
                      <div className="mt-1.5 text-sm font-bold text-gray-900">{inr(q.amount)}</div>
                      {q.crm_follow_up_date && (
                        <div className={`mt-1 inline-flex items-center gap-1 text-[11px] px-1.5 py-0.5 rounded ${isOverdue(q) ? 'bg-red-100 text-red-700' : 'bg-amber-50 text-amber-700'}`}>
                          <CalendarClock className="w-3 h-3" />{isOverdue(q) ? 'Overdue ' : 'Follow-up '}{q.crm_follow_up_date}
                        </div>
                      )}
                      <div className="mt-1 text-[10px] text-gray-400">{q.store_code} · {timeAgo(q.created_at)}</div>
                      {stageSelect(q, 'mt-2 w-full text-xs border border-gray-200 rounded px-1.5 py-1 text-gray-600 bg-gray-50')}
                    </div>
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      ) : (
        <Card>
          <CardContent className="pt-4">
            <div className="overflow-x-auto">
              <table className="w-full" data-testid="quotations-table">
                <thead>
                  <tr className="border-b text-left text-xs font-semibold text-gray-500 uppercase">
                    <th className="py-3 px-3">Quotation #</th>
                    <th className="py-3 px-3">Customer</th>
                    <th className="py-3 px-3">Contact</th>
                    <th className="py-3 px-3">Amount</th>
                    <th className="py-3 px-3">Stage</th>
                    <th className="py-3 px-3">Follow-up</th>
                    <th className="py-3 px-3">Created</th>
                    <th className="py-3 px-3 text-right">PDF</th>
                  </tr>
                </thead>
                <tbody>
                  {visible.length === 0 && (
                    <tr><td colSpan={8} className="text-center py-8 text-sm text-gray-400">No quotations found</td></tr>
                  )}
                  {visible.map((q) => (
                    <tr key={q.id} className="border-b hover:bg-gray-50 cursor-pointer" onClick={() => openQuote(q)}>
                      <td className="py-3 px-3 text-sm font-semibold text-orange-600">{q.quotation_number || '-'}</td>
                      <td className="py-3 px-3 text-sm text-gray-900">{q.customer_name || 'Unknown'}</td>
                      <td className="py-3 px-3 text-xs text-gray-600">{q.customer_phone}<div>{q.customer_email}</div></td>
                      <td className="py-3 px-3 text-sm font-medium text-gray-900">{inr(q.amount)}</td>
                      <td className="py-3 px-3">{stageSelect(q, 'text-xs border border-gray-200 rounded px-2 py-1 bg-white')}</td>
                      <td className={`py-3 px-3 text-xs ${isOverdue(q) ? 'text-red-600 font-semibold' : 'text-gray-600'}`}>{q.crm_follow_up_date || '-'}</td>
                      <td className="py-3 px-3 text-xs text-gray-500">{timeAgo(q.created_at)}</td>
                      <td className="py-3 px-3 text-right">
                        <a href={`${BACKEND_URL}/api/quotations/${q.id}/pdf`} target="_blank" rel="noreferrer" onClick={(e) => e.stopPropagation()} className="text-xs text-blue-600 hover:underline">PDF</a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </CardContent>
        </Card>
      )}

      {selectedQ && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4" onClick={() => setSelectedId(null)}>
          <div className="bg-white rounded-xl shadow-xl w-full max-w-lg p-5" onClick={(e) => e.stopPropagation()} data-testid="quotation-detail">
            <div className="flex items-start justify-between">
              <div>
                <h3 className="text-lg font-bold text-orange-600">{selectedQ.quotation_number}</h3>
                <p className="text-xs text-gray-500">{selectedQ.store_name || selectedQ.store_code} · {selectedQ.created_at ? new Date(selectedQ.created_at).toLocaleDateString('en-IN') : ''}</p>
              </div>
              <button onClick={() => setSelectedId(null)} className="text-gray-400 hover:text-gray-700"><X className="w-5 h-5" /></button>
            </div>
            <div className="mt-3 text-sm text-gray-800 space-y-1">
              <div className="font-medium">{selectedQ.customer_name || 'Unknown'}</div>
              {selectedQ.customer_phone && <div className="flex items-center gap-1.5 text-gray-600"><Phone className="w-3.5 h-3.5" />{selectedQ.customer_phone}</div>}
              {selectedQ.customer_email && <div className="flex items-center gap-1.5 text-gray-600"><Mail className="w-3.5 h-3.5" />{selectedQ.customer_email}</div>}
              <div className="pt-1 text-xl font-bold text-gray-900">{inr(selectedQ.amount)} <span className="text-xs font-normal text-gray-500">· {selectedQ.item_count || 0} items · {selectedQ.status || 'draft'}</span></div>
            </div>
            <div className="mt-4 grid grid-cols-2 gap-3">
              <label className="text-xs text-gray-600">Stage
                {stageSelect(selectedQ, 'mt-1 w-full text-sm border border-gray-300 rounded px-2 py-1.5 bg-white')}
              </label>
              <label className="text-xs text-gray-600">Follow-up date
                <input type="date" value={draft.followUp} onChange={(e) => setDraft({ ...draft, followUp: e.target.value })} className="mt-1 w-full text-sm border border-gray-300 rounded px-2 py-1.5" data-testid="quotation-followup-input" />
              </label>
            </div>
            <label className="block mt-3 text-xs text-gray-600">Notes
              <textarea rows={3} value={draft.notes} onChange={(e) => setDraft({ ...draft, notes: e.target.value })} placeholder="Call notes, objections, next steps..." className="mt-1 w-full text-sm border border-gray-300 rounded px-2 py-1.5" data-testid="quotation-notes-input" />
            </label>
            <div className="mt-4 flex items-center justify-between">
              <a href={`${BACKEND_URL}/api/quotations/${selectedQ.id}/pdf`} target="_blank" rel="noreferrer" className="flex items-center gap-1 text-sm text-blue-600 hover:underline"><Download className="w-4 h-4" />PDF</a>
              <div className="flex gap-2">
                <button onClick={() => setSelectedId(null)} className="px-4 py-2 text-sm border border-gray-300 rounded-lg hover:bg-gray-50">Close</button>
                <button onClick={saveDetails} disabled={saving} className="px-4 py-2 text-sm bg-orange-600 text-white rounded-lg hover:bg-orange-700 disabled:opacity-50" data-testid="quotation-save-btn">{saving ? 'Saving...' : 'Save'}</button>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

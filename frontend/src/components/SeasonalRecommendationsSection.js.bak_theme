import React, { useState, useEffect } from 'react';
import { BACKEND_URL } from '../config/api';
import { 
  Snowflake, Sun, Cloud, Sparkles, Gift, Heart, 
  Flame, Wind, Home, PartyPopper
} from 'lucide-react';
import ProductCard from './ProductCard';


const SeasonalRecommendationsSection = ({ onViewProduct, onAddToCart, onAISalesChat }) => {
  const [recommendations, setRecommendations] = useState([]);
  const [loading, setLoading] = useState(true);
  const [seasonInfo, setSeasonInfo] = useState({
    season: '',
    festival: '',
    icon: Sun,
    theme: {},
    message: ''
  });

  useEffect(() => {
    detectSeasonAndFestival();
    fetchSeasonalRecommendations();
  }, []);

  const detectSeasonAndFestival = () => {
    const now = new Date();
    const month = now.getMonth() + 1; // 1-12
    const day = now.getDate();
    
    let season = '';
    let festival = '';
    let icon = Sun;
    let theme = {};
    let message = '';
    let searchCategories = [];

    // Detect Season (India)
    if (month >= 3 && month <= 5) {
      season = 'Summer';
      icon = Sun;
      theme = { from: 'from-orange-400', to: 'to-red-500', bg: 'bg-orange-50' };
      message = 'Beat the heat with cooling solutions';
      searchCategories = ['Air Conditioner', 'Cooler', 'Fan', 'Refrigerator', 'Water Dispenser'];
    } else if (month >= 6 && month <= 9) {
      season = 'Monsoon';
      icon = Cloud;
      theme = { from: 'from-blue-400', to: 'to-indigo-500', bg: 'bg-blue-50' };
      message = 'Stay dry and fresh this monsoon';
      searchCategories = ['Dryer', 'Hair Dryer', 'Room Heater', 'Dehumidifier', 'Washing Machine'];
    } else if (month >= 10 && month <= 11) {
      season = 'Autumn';
      icon = Wind;
      theme = { from: 'from-amber-400', to: 'to-orange-500', bg: 'bg-amber-50' };
      message = 'Prepare for the festive season';
      searchCategories = ['Kitchen Appliances', 'Mixer', 'Oven', 'Microwave', 'Dishwasher'];
    } else {
      season = 'Winter';
      icon = Snowflake;
      theme = { from: 'from-cyan-400', to: 'to-blue-500', bg: 'bg-cyan-50' };
      message = 'Warm up your home this winter';
      searchCategories = ['Room Heater', 'Geyser', 'Water Heater', 'Induction', 'Coffee Maker'];
    }

    // Detect Festivals
    if (month === 12 && day >= 20) {
      festival = 'Christmas';
      icon = Gift;
      theme = { from: 'from-red-500', to: 'to-green-500', bg: 'bg-red-50' };
      message = 'Perfect gifts for Christmas 🎄';
      searchCategories = ['Oven', 'Microwave', 'Coffee Maker', 'Mixer', 'Kitchen Appliances'];
    } else if (month === 10 || month === 11) {
      festival = 'Diwali';
      icon = Sparkles;
      theme = { from: 'from-yellow-400', to: 'to-orange-500', bg: 'bg-yellow-50' };
      message = 'Illuminate your home this Diwali 🪔';
      searchCategories = ['Kitchen Appliances', 'Vacuum Cleaner', 'Air Purifier', 'Chimney'];
    } else if (month === 3 && day >= 15 && day <= 25) {
      festival = 'Holi';
      icon = PartyPopper;
      theme = { from: 'from-pink-400', to: 'to-purple-500', bg: 'bg-pink-50' };
      message = 'Colorful celebrations need cleaning power';
      searchCategories = ['Washing Machine', 'Dryer', 'Vacuum Cleaner'];
    } else if (month === 2 && day === 14) {
      festival = 'Valentine\'s Day';
      icon = Heart;
      theme = { from: 'from-pink-500', to: 'to-red-500', bg: 'bg-pink-50' };
      message = 'Show love with perfect gifts 💝';
      searchCategories = ['Coffee Maker', 'Microwave', 'Kitchen Appliances'];
    } else if (month === 1 && day <= 15) {
      festival = 'New Year';
      icon = PartyPopper;
      theme = { from: 'from-blue-400', to: 'to-purple-500', bg: 'bg-blue-50' };
      message = 'Start the year with new appliances';
      searchCategories = ['Kitchen Appliances', 'Vacuum Cleaner', 'Air Purifier'];
    }

    setSeasonInfo({
      season: festival || season,
      festival,
      icon,
      theme,
      message,
      searchCategories
    });
  };

  const fetchSeasonalRecommendations = async () => {
    try {
      // Call seasonal recommendations endpoint
      const response = await fetch(`${BACKEND_URL}/api/ai-recommendations/seasonal-recommendations`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          season: seasonInfo.season,
          month: new Date().getMonth() + 1,
          festival: seasonInfo.festival
        })
      });

      const data = await response.json();
      
      if (data.status === 'success' && data.recommendations) {
        setRecommendations(data.recommendations.slice(0, 8));
      } else {
        // Fallback: Filter products by season
        await fetchFallbackSeasonalProducts();
      }
    } catch (error) {
      console.error('Error fetching seasonal recommendations:', error);
      await fetchFallbackSeasonalProducts();
    } finally {
      setLoading(false);
    }
  };

  const fetchFallbackSeasonalProducts = async () => {
    try {
      const response = await fetch(`${BACKEND_URL}/api/products`);
      const data = await response.json();
      
      if (data.status === 'success' && data.products) {
        // Get all active products
        const activeProducts = data.products.filter(p => p.is_active !== false);
        
        // Filter by season/festival appropriate categories
        let seasonal = activeProducts.filter(p => {
          const category = (p.category || '').toLowerCase();
          const name = (p.name || '').toLowerCase();
          
          return seasonInfo.searchCategories?.some(searchCat => 
            category.includes(searchCat.toLowerCase()) || 
            name.includes(searchCat.toLowerCase())
          );
        });
        
        // If not enough products found, include all brands' products with good discounts or new arrivals
        if (seasonal.length < 8) {
          const additionalProducts = activeProducts
            .filter(p => !seasonal.find(s => s.id === p.id))
            .sort((a, b) => {
              // Prioritize new products and discounted items
              const aScore = (a.is_new ? 10 : 0) + (a.original_price && a.price < a.original_price ? 5 : 0);
              const bScore = (b.is_new ? 10 : 0) + (b.original_price && b.price < b.original_price ? 5 : 0);
              return bScore - aScore;
            });
          
          seasonal = [...seasonal, ...additionalProducts].slice(0, 8);
        }
        
        // Ensure brand diversity
        const diverseProducts = [];
        const brandCounts = {};
        
        for (const product of seasonal) {
          const brand = product.brand || 'Unknown';
          brandCounts[brand] = (brandCounts[brand] || 0);
          
          if (brandCounts[brand] < 3 && diverseProducts.length < 8) {
            diverseProducts.push(product);
            brandCounts[brand]++;
          }
        }
        
        // Fill remaining slots
        if (diverseProducts.length < 8) {
          const remaining = seasonal.filter(p => !diverseProducts.find(d => d.id === p.id));
          for (const p of remaining) {
            if (diverseProducts.length < 8) diverseProducts.push(p);
          }
        }
        
        setRecommendations(diverseProducts);
      }
    } catch (error) {
      console.error('Fallback seasonal products error:', error);
    }
  };

  if (loading) {
    return (
      <div className="py-16 bg-white">
        <div className="max-w-7xl mx-auto px-4">
          <div className="animate-pulse">
            <div className="h-8 bg-gray-200 rounded w-64 mb-8"></div>
            <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
              {[...Array(4)].map((_, i) => (
                <div key={i} className="h-96 bg-gray-200 rounded-lg"></div>
              ))}
            </div>
          </div>
        </div>
      </div>
    );
  }

  if (recommendations.length === 0) return null;

  const Icon = seasonInfo.icon;

  return (
    <section className={`py-16 ${seasonInfo.theme.bg} border-t border-b`}>
      <div className="max-w-7xl mx-auto px-4">
        {/* Section Header */}
        <div className="flex items-center justify-between mb-12">
          <div className="flex items-center space-x-4">
            <div className={`p-3 bg-gradient-to-r ${seasonInfo.theme.from} ${seasonInfo.theme.to} rounded-full shadow-lg`}>
              <Icon className="h-8 w-8 text-white" />
            </div>
            <div>
              <div className="flex items-center space-x-2">
                <h2 className="text-4xl font-bold text-gray-900">
                  {seasonInfo.season} Essentials
                </h2>
                {seasonInfo.festival && (
                  <span className="text-3xl">
                    {seasonInfo.festival === 'Christmas' && '🎄'}
                    {seasonInfo.festival === 'Diwali' && '🪔'}
                    {seasonInfo.festival === 'Holi' && '🎨'}
                    {seasonInfo.festival === 'Valentine\'s Day' && '💝'}
                    {seasonInfo.festival === 'New Year' && '🎉'}
                  </span>
                )}
              </div>
              <p className="text-gray-600 mt-1">{seasonInfo.message}</p>
            </div>
          </div>
          <div className="hidden md:flex items-center space-x-2">
            <span className={`bg-gradient-to-r ${seasonInfo.theme.from} ${seasonInfo.theme.to} text-white px-4 py-2 rounded-full text-sm font-bold shadow-lg`}>
              {seasonInfo.festival ? 'Festival Special' : 'Season Special'}
            </span>
          </div>
        </div>

        {/* Seasonal Banner */}
        <div className={`mb-8 bg-gradient-to-r ${seasonInfo.theme.from} ${seasonInfo.theme.to} rounded-2xl p-6 text-white shadow-xl`}>
          <div className="flex items-center justify-between">
            <div className="flex items-center space-x-4">
              <Icon className="h-12 w-12" />
              <div>
                <h3 className="text-2xl font-bold mb-1">
                  {seasonInfo.festival ? `${seasonInfo.festival} Special Offers` : `Best for ${seasonInfo.season}`}
                </h3>
                <p className="text-white/90">
                  {seasonInfo.festival 
                    ? 'Exclusive deals on festival essentials - Limited time only!' 
                    : `Must-have appliances for ${seasonInfo.season.toLowerCase()} season`}
                </p>
              </div>
            </div>
            <div className="hidden lg:block">
              <div className="bg-white/20 backdrop-blur-sm px-6 py-3 rounded-xl border border-white/30">
                <p className="text-sm font-semibold">AI Curated Selection</p>
                <p className="text-xs text-white/80">Based on seasonal needs</p>
              </div>
            </div>
          </div>
        </div>

        {/* Products Grid */}
        <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
          {recommendations.map((product, index) => (
            <div key={product.id} className="relative group">
              {/* Seasonal Badge */}
              {index === 0 && (
                <div className="absolute -top-2 -left-2 z-10">
                  <div className={`bg-gradient-to-r ${seasonInfo.theme.from} ${seasonInfo.theme.to} text-white px-3 py-1 rounded-full text-xs font-bold shadow-lg flex items-center space-x-1`}>
                    <Icon className="h-3 w-3" />
                    <span>Must Buy</span>
                  </div>
                </div>
              )}
              <ProductCard
                product={product}
                onViewProduct={onViewProduct}
                onAddToCart={onAddToCart}
                onAISalesChat={onAISalesChat}
              />
            </div>
          ))}
        </div>

        {/* Additional Info */}
        <div className="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
          <div className={`${seasonInfo.theme.bg} border-2 border-current rounded-xl p-6 text-center`}>
            <Icon className="h-10 w-10 mx-auto mb-3 text-gray-700" />
            <h4 className="font-bold text-gray-900 mb-2">Season Perfect</h4>
            <p className="text-sm text-gray-600">
              Specially selected for {seasonInfo.season.toLowerCase()} needs
            </p>
          </div>
          <div className={`${seasonInfo.theme.bg} border-2 border-current rounded-xl p-6 text-center`}>
            <Sparkles className="h-10 w-10 mx-auto mb-3 text-gray-700" />
            <h4 className="font-bold text-gray-900 mb-2">AI Powered</h4>
            <p className="text-sm text-gray-600">
              Smart recommendations based on weather & trends
            </p>
          </div>
          <div className={`${seasonInfo.theme.bg} border-2 border-current rounded-xl p-6 text-center`}>
            <Gift className="h-10 w-10 mx-auto mb-3 text-gray-700" />
            <h4 className="font-bold text-gray-900 mb-2">Special Offers</h4>
            <p className="text-sm text-gray-600">
              Exclusive seasonal discounts & combos
            </p>
          </div>
        </div>
      </div>
    </section>
  );
};

export default SeasonalRecommendationsSection;

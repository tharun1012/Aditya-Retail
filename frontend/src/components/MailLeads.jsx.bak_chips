import { useEffect, useState, useCallback } from "react";
import { BACKEND_URL } from "../config/api";

const BRANDS = ["All Mail", "Bosch", "Siemens"];
const STORES = [
  { code: "all", label: "All Stores" },
  { code: "BNS", label: "Banaswadi" },
  { code: "DAS", label: "Dasarahalli" },
  { code: "ARM", label: "Bosch Brand Store" },
];
const STATUSES = ["New", "Contacted", "Qualified", "Negotiation", "Won", "Lost"];

export default function MailLeads({ storeMode = false }) {
  const [leads, setLeads] = useState([]);
  const [brand, setBrand] = useState("All Mail");
  const [store, setStore] = useState("all");
  const [view, setView] = useState("pipeline");
  const [q, setQ] = useState("");
  const [selectedId, setSelectedId] = useState(null);

  const base = storeMode ? `${BACKEND_URL}/api/leads/store/mail` : `${BACKEND_URL}/api/mail-leads`;
  const load = useCallback(async () => {
    const r = await fetch(base, {
      headers: storeMode ? { Authorization: `Bearer ${localStorage.getItem('storeToken') || ''}` } : {},
    });
    if (r.ok) setLeads(await r.json());
  }, [base, storeMode]);
  useEffect(() => { load(); }, [load]);

  const setStatus = async (id, status) => {
    await fetch(`${base}/${id}/status`, {
      method: "PATCH",
      headers: { "Content-Type": "application/json",
                 ...(storeMode ? { Authorization: `Bearer ${localStorage.getItem('storeToken') || ''}` } : {}) },
      body: JSON.stringify({ status }),
    });
    load();
  };

  const count = (b) => (b === "All Mail" ? leads.length : leads.filter((l) => l.brand === b).length);
  const storeCount = (code) => (code === "all" ? leads.length : leads.filter((l) => l.store_code === code).length);
  const shown = leads
    .filter((l) => brand === "All Mail" || l.brand === brand)
    .filter((l) => store === "all" || l.store_code === store)
    .filter((l) => !q || [l.name, l.phone, l.email, l.message, l.product_category].join(" ").toLowerCase().includes(q.toLowerCase()));

  const card = (l) => (
    <div key={l.id} onClick={() => setSelectedId(l.id)} data-testid={`mail-card-${l.id}`} className="bg-white border rounded-lg p-3 text-xs space-y-1 cursor-pointer hover:shadow-md">
      <div className="flex justify-between items-start">
        <span className="font-semibold text-sm">{l.name}</span>
        {l.is_hot && <span className="text-[10px] px-1.5 py-0.5 rounded bg-red-50 text-red-600 border border-red-200">HOT</span>}
      </div>
      <div>{l.phone} · <a onClick={(e) => e.stopPropagation()} className="text-green-600" href={`https://wa.me/91${l.phone.slice(-10)}`} target="_blank" rel="noreferrer">WhatsApp</a></div>
      <div>{l.email}</div>
      <div className="flex gap-1 flex-wrap">
        <span className="px-1.5 py-0.5 rounded bg-slate-100">{l.brand}</span>
        {l.store_name && <span className="px-1.5 py-0.5 rounded bg-teal-50">{l.store_name}</span>}
        {l.product_category && <span className="px-1.5 py-0.5 rounded bg-blue-50">{l.product_category}</span>}
        {l.enquiry_type && <span className="px-1.5 py-0.5 rounded bg-amber-50">{l.enquiry_type}</span>}
        {l.timeline && <span className="px-1.5 py-0.5 rounded bg-red-50">{l.timeline}</span>}
        {l.repeat_enquiry && <span className="px-1.5 py-0.5 rounded bg-purple-50">Repeat enquiry</span>}
      </div>
      {l.message && <div className="text-slate-600">"{l.message}"</div>}
      <div className="text-slate-400">{new Date(l.received_at).toLocaleString()}</div>
      <select onClick={(e) => e.stopPropagation()} className="w-full border rounded p-1" value={l.status} onChange={(e) => setStatus(l.id, e.target.value)}>
        {STATUSES.map((s) => <option key={s}>{s}</option>)}
      </select>
    </div>
  );

  return (
    <div>
      <div className="flex gap-2 mb-3 items-center flex-wrap">
        {BRANDS.map((b) => (
          <button key={b} onClick={() => setBrand(b)}
            className={`px-3 py-1 rounded-md text-sm border ${brand === b ? "bg-slate-900 text-white" : "bg-white"}`}>
            {b} <span className="ml-1 text-xs opacity-70">{count(b)}</span>
          </button>
        ))}
      </div>
      <div className="flex gap-2 mb-3 items-center flex-wrap">
        {STORES.map((st) => (
          <button key={st.code} onClick={() => setStore(st.code)}
            data-testid={`mail-store-${st.code}`}
            className={`px-3 py-1 rounded-md text-sm border ${store === st.code ? "bg-teal-700 text-white" : "bg-white"}`}>
            {st.label} <span className="ml-1 text-xs opacity-70">{storeCount(st.code)}</span>
          </button>
        ))}
        <input className="ml-auto border rounded px-3 py-1 text-sm w-64" placeholder="Search mail leads..."
          value={q} onChange={(e) => setQ(e.target.value)} />
        <button onClick={() => setView(view === "pipeline" ? "table" : "pipeline")} className="px-3 py-1 border rounded text-sm">
          {view === "pipeline" ? "Table" : "Pipeline"}
        </button>
      </div>
      {view === "pipeline" ? (
        <div className="flex gap-3 overflow-x-auto pb-3">
          {STATUSES.map((s) => {
            const col = shown.filter((l) => l.status === s);
            return (
              <div key={s} className="min-w-[240px] w-[240px] bg-slate-50 border rounded-lg p-2">
                <div className="text-sm font-medium mb-2 flex justify-between"><span>{s}</span><span>{col.length}</span></div>
                <div className="space-y-2">
                  {col.length ? col.map(card) : <div className="text-xs text-center text-slate-400 py-6">No leads</div>}
                </div>
              </div>
            );
          })}
        </div>
      ) : (
        <table className="w-full text-sm bg-white border rounded-lg">
          <thead><tr className="text-left border-b">
            {["Name","Phone","Email","Store","Brand","Product","Enquiry","Timeline","Status","Received"].map((h) => <th key={h} className="p-2">{h}</th>)}
          </tr></thead>
          <tbody>{shown.map((l) => (
            <tr key={l.id} onClick={() => setSelectedId(l.id)} className="border-b cursor-pointer hover:bg-slate-50">
              <td className="p-2">{l.name}</td><td className="p-2">{l.phone}</td><td className="p-2">{l.email}</td>
              <td className="p-2">{l.store_name}</td><td className="p-2">{l.brand}</td><td className="p-2">{l.product_category}</td>
              <td className="p-2">{l.enquiry_type || l.message}</td><td className="p-2">{l.timeline}</td>
              <td className="p-2">{l.status}</td><td className="p-2">{new Date(l.received_at).toLocaleString()}</td>
            </tr>))}
          </tbody>
        </table>
      )}
      {leads.find((x) => x.id === selectedId) && (
        <MailLeadPanel storeMode={storeMode}
          key={selectedId}
          lead={leads.find((x) => x.id === selectedId)}
          onClose={() => setSelectedId(null)}
          onChanged={load}
          onStatus={setStatus}
        />
      )}
    </div>
  );
}

function MailLeadPanel({ lead, onClose, onChanged, onStatus, storeMode = false }) {
  const [assignee, setAssignee] = useState(lead.assigned_to || "");
  const [note, setNote] = useState("");
  const [follow, setFollow] = useState(lead.follow_up_at ? lead.follow_up_at.slice(0, 16) : "");

  const call = async (path, method, body) => {
    await fetch(`${BACKEND_URL}/api/${storeMode ? "leads/store/mail" : "mail-leads"}/${lead.id}/${path}`, {
      method,
      headers: { "Content-Type": "application/json",
                 ...(storeMode ? { Authorization: `Bearer ${localStorage.getItem('storeToken') || ''}` } : {}) },
      body: JSON.stringify(body),
    });
    onChanged();
  };

  const row = (k, v) => (
    <div className="flex justify-between gap-3 py-1.5 border-b last:border-0">
      <span className="text-slate-500">{k}</span>
      <span className="font-medium text-right break-words max-w-[60%]">{v || "—"}</span>
    </div>
  );

  const wa = lead.phone ? `https://wa.me/91${lead.phone.slice(-10)}` : null;

  return (
    <div className="fixed inset-0 z-50 flex justify-end" data-testid="mail-lead-panel">
      <div className="absolute inset-0 bg-black/40" onClick={onClose} />
      <div className="relative w-full max-w-md bg-white h-full overflow-y-auto shadow-xl p-5 text-sm space-y-5">
        <div className="flex justify-between items-start">
          <div>
            <div className="flex items-center gap-2 flex-wrap">
              <h2 className="text-lg font-semibold">{lead.name}</h2>
              <span className="text-[10px] px-1.5 py-0.5 rounded bg-slate-100">{lead.brand}</span>
              {lead.is_hot && <span className="text-[10px] px-1.5 py-0.5 rounded bg-red-50 text-red-600 border border-red-200">HOT</span>}
              {lead.repeat_enquiry && <span className="text-[10px] px-1.5 py-0.5 rounded bg-purple-50">Repeat enquiry</span>}
            </div>
            <div className="text-xs text-slate-400 mt-1">
              {lead.store_name} · {new Date(lead.received_at).toLocaleString()}
            </div>
          </div>
          <button onClick={onClose} className="text-slate-500 text-xl leading-none px-2">×</button>
        </div>

        <div className="flex gap-2">
          <a href={`tel:${lead.phone}`} className="flex-1 text-center bg-green-600 text-white rounded-md py-2 font-medium">Call {lead.phone}</a>
          {wa && <a href={wa} target="_blank" rel="noreferrer" className="px-4 py-2 rounded-md border border-green-600 text-green-700 font-medium">WhatsApp</a>}
        </div>

        <div>
          <div className="text-xs font-semibold text-slate-500 mb-2">PIPELINE STAGE</div>
          <div className="flex gap-2 flex-wrap">
            {STATUSES.map((st) => (
              <button key={st} onClick={() => onStatus(lead.id, st)}
                className={`px-3 py-1 rounded-full text-xs border ${lead.status === st ? "bg-blue-600 text-white border-blue-600" : "bg-white"}`}>
                {st}
              </button>
            ))}
          </div>
        </div>

        <div>
          <div className="text-xs font-semibold text-slate-500 mb-2">DETAILS</div>
          <div className="bg-slate-50 rounded-lg px-3">
            {row("Email", lead.email)}
            {row("Brand", lead.brand)}
            {row("Store", lead.store_name)}
            {row("Product category", lead.product_category)}
            {row("Enquiry type", lead.enquiry_type)}
            {row("Timeline", lead.timeline)}
            {row("Assigned to", lead.assigned_to || "Unassigned")}
            {row("Source", "Email (Singleinterface)")}
            {lead.store_address && row("Query from", lead.store_address)}
          </div>
        </div>

        {lead.message && (
          <div>
            <div className="text-xs font-semibold text-slate-500 mb-2">CUSTOMER MESSAGE</div>
            <div className="bg-amber-50 border border-amber-100 rounded-lg p-3">{lead.message}</div>
          </div>
        )}

        {lead.extra_fields && lead.extra_fields.length > 0 && (
          <div>
            <div className="text-xs font-semibold text-slate-500 mb-2">OTHER FIELDS</div>
            <ul className="list-disc pl-5 text-slate-600">{lead.extra_fields.map((f, i) => <li key={i}>{f}</li>)}</ul>
          </div>
        )}

        <div>
          <div className="text-xs font-semibold text-slate-500 mb-2">ASSIGN TO TEAM MEMBER</div>
          <div className="flex gap-2">
            <input className="flex-1 border rounded px-3 py-2" placeholder="e.g., Ramesh" value={assignee} onChange={(e) => setAssignee(e.target.value)} />
            <button onClick={() => call("assign", "PATCH", { assigned_to: assignee })} className="px-4 py-2 bg-slate-900 text-white rounded">Assign</button>
          </div>
        </div>

        <div>
          <div className="text-xs font-semibold text-slate-500 mb-2">ADD NOTE</div>
          <textarea className="w-full border rounded p-2" rows={3} placeholder="Called customer, will confirm tomorrow..." value={note} onChange={(e) => setNote(e.target.value)} />
          <button disabled={!note.trim()} onClick={async () => { await call("notes", "POST", { text: note }); setNote(""); }}
            className="mt-2 px-4 py-2 bg-blue-600 text-white rounded disabled:opacity-40">Save Note</button>
          {lead.notes && lead.notes.length > 0 && (
            <div className="mt-3 space-y-2">
              {[...lead.notes].reverse().map((n, i) => (
                <div key={i} className="bg-slate-50 rounded p-2 text-xs">
                  <div>{n.text}</div>
                  <div className="text-slate-400 mt-1">{new Date(n.at).toLocaleString()}</div>
                </div>
              ))}
            </div>
          )}
        </div>

        <div>
          <div className="text-xs font-semibold text-slate-500 mb-2">SCHEDULE FOLLOW-UP</div>
          <div className="flex gap-2">
            <input type="datetime-local" className="flex-1 border rounded px-3 py-2" value={follow} onChange={(e) => setFollow(e.target.value)} />
            <button onClick={() => call("followup", "PATCH", { follow_up_at: follow || null })} className="px-4 py-2 bg-slate-900 text-white rounded">Set</button>
          </div>
          {lead.follow_up_at && <div className="text-xs text-slate-500 mt-2">Next follow-up: {new Date(lead.follow_up_at).toLocaleString()}</div>}
        </div>
      </div>
    </div>
  );
}

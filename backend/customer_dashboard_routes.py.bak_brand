# ============================================
# MY INVOICES
# ============================================

@router.get("/my-invoices")
async def get_my_invoices(
    user_id: str,
    page: int = 1,
    limit: int = 20,
    database = Depends(get_db)
):
    """Get all invoices associated with the customer"""
    try:
        user = await database.users.find_one({"$or": [{"id": user_id}, {"user_id": user_id}]})
        if not user:
            raise HTTPException(status_code=404, detail="User not found")
        
        user_email = (user.get("email") or "").lower()
        user_phone = user.get("phone", "")
        
        # Query invoices by customer email or phone
        query = {
            "document_type": "invoice",
            "$or": []
        }
        
        if user_email:
            query["$or"].append({"customer.email": {"$regex": f"^{user_email}$", "$options": "i"}})
        if user_phone:
            query["$or"].append({"customer.phone": user_phone})
        
        if not query["$or"]:
            return {
                "status": "success",
                "invoices": [],
                "total": 0,
                "page": page,
                "pages": 0
            }
        
        skip = (page - 1) * limit
        total = await database.offline_invoices.count_documents(query)
        
        invoices = await database.offline_invoices.find(
            query,
            {
                "_id": 0,
                "id": 1,
                "invoice_number": 1,
                "total_amount": 1,
                "status": 1,
                "payment_status": 1,
                "payment_mode": 1,
                "items": 1,
                "store_details": 1,
                "created_at": 1,
                "delivery_assigned_at": 1,
                "delivered_at": 1
            }
        ).sort("created_at", -1).skip(skip).limit(limit).to_list(None)
        
        # Simplify items for display
        for inv in invoices:
            inv["items_summary"] = [
                {"name": item.get("product_name"), "qty": item.get("quantity")}
                for item in inv.get("items", [])[:3]
            ]
            inv["items_count"] = len(inv.get("items", []))
            if inv["items_count"] > 3:
                inv["items_summary"].append({"name": f"+{inv['items_count'] - 3} more", "qty": ""})
        
        return {
            "status": "success",
            "invoices": invoices,
            "total": total,
            "page": page,
            "pages": (total + limit - 1) // limit
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@router.get("/my-invoices/{invoice_id}/download")
async def download_my_invoice(invoice_id: str, user_id: str, database = Depends(get_db)):
    """Download invoice PDF"""
    from fastapi.responses import StreamingResponse
    from invoice_pdf_generator import generate_invoice_pdf
    from io import BytesIO
    
    try:
        user = await database.users.find_one({"$or": [{"id": user_id}, {"user_id": user_id}]})
        if not user:
            raise HTTPException(status_code=404, detail="User not found")
        
        user_email = (user.get("email") or "").lower()
        user_phone = user.get("phone", "")
        
        # Get the invoice
        invoice = await database.offline_invoices.find_one({"id": invoice_id})
        if not invoice:
            raise HTTPException(status_code=404, detail="Invoice not found")
        
        # Verify ownership
        customer = invoice.get("customer", {})
        customer_email = (customer.get("email") or "").lower()
        customer_phone = customer.get("phone", "")
        
        ownership_verified = False
        if user_email and customer_email and user_email == customer_email:
            ownership_verified = True
        elif user_phone and customer_phone and user_phone == customer_phone:
            ownership_verified = True
        
        if not ownership_verified:
            raise HTTPException(status_code=403, detail="Access denied")
        
        # Remove MongoDB _id
        invoice.pop("_id", None)
        
        # Generate PDF
        pdf_bytes = generate_invoice_pdf(invoice, "offline")
        
        buffer = BytesIO(pdf_bytes)
        filename = f"{invoice.get('invoice_number', 'Invoice')}.pdf"
        
        return StreamingResponse(
            buffer,
            media_type="application/pdf",
            headers={
                "Content-Disposition": f"attachment; filename={filename}"
            }
        )
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

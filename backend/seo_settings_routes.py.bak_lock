"""
SEO Settings Management Routes
Allows marketing team to manage meta tags, GA, GSC from admin panel
"""
from fastapi import APIRouter, HTTPException, Depends
from typing import Optional
from pydantic import BaseModel
from database import get_db
from datetime import datetime, timezone
import re, uuid

router = APIRouter(prefix="/seo-settings", tags=["SEO Settings"])

class SEOSettings(BaseModel):
    page_type: str  # homepage, category, product, default
    page_key: Optional[str] = None  # category name or product ID
    meta_title: str
    meta_description: str
    meta_keywords: Optional[str] = None
    og_title: Optional[str] = None
    og_description: Optional[str] = None
    og_image: Optional[str] = None

class AnalyticsSettings(BaseModel):
    google_analytics_id: Optional[str] = None  # GA4 Measurement ID
    google_tag_manager_id: Optional[str] = None  # GTM ID
    facebook_pixel_id: Optional[str] = None
    google_search_console_verification: Optional[str] = None  # Verification code

class SEOPage(BaseModel):
    page_path: str
    page_type: str = "page"
    title: str
    description: str
    keywords: Optional[str] = ""
    h1_tag: Optional[str] = ""
    canonical_url: Optional[str] = ""
    og_image: Optional[str] = ""
    schema_type: Optional[str] = "WebPage"
    status: Optional[str] = "live"      # live | draft
    source: Optional[str] = "manual"    # manual | ai

def norm_path(p: str) -> str:
    p = re.sub(r'^https?://[^/]+', '', (p or '').strip())
    p = p.split('?')[0].split('#')[0]
    if not p.startswith('/'):
        p = '/' + p
    if len(p) > 1:
        p = p.rstrip('/')
    return p.lower()

@router.get("")
async def list_seo_pages(db = Depends(get_db)):
    pages = await db.seo_pages.find({}, {"_id": 0}).sort("updated_at", -1).to_list(5000)
    return {"status": "success", "pages": pages}

@router.get("/by-path")
async def seo_by_path(path: str, db = Depends(get_db)):
    """Public: live override for a URL path (drafts never served)"""
    doc = await db.seo_pages.find_one(
        {"page_path": norm_path(path), "status": {"$ne": "draft"}}, {"_id": 0})
    return {"status": "success", "seo": doc}

@router.post("")
async def upsert_seo_page(page: SEOPage, db = Depends(get_db)):
    data = page.dict()
    data["page_path"] = norm_path(data["page_path"])
    data["updated_at"] = datetime.now(timezone.utc).isoformat()
    existing = await db.seo_pages.find_one({"page_path": data["page_path"]})
    if existing:
        await db.seo_pages.update_one({"page_path": data["page_path"]}, {"$set": data})
        return {"status": "success", "message": "SEO settings updated"}
    data["id"] = str(uuid.uuid4())
    data["created_at"] = data["updated_at"]
    await db.seo_pages.insert_one(data)
    return {"status": "success", "message": "SEO settings created"}

@router.put("/{page_id}")
async def update_seo_page(page_id: str, page: SEOPage, db = Depends(get_db)):
    data = page.dict()
    data["page_path"] = norm_path(data["page_path"])
    data["updated_at"] = datetime.now(timezone.utc).isoformat()
    clash = await db.seo_pages.find_one({"page_path": data["page_path"], "id": {"$ne": page_id}})
    if clash:
        raise HTTPException(status_code=409, detail="Another entry already uses this path")
    res = await db.seo_pages.update_one({"id": page_id}, {"$set": data})
    if res.matched_count == 0:
        raise HTTPException(status_code=404, detail="Not found")
    return {"status": "success", "message": "SEO settings updated"}

@router.delete("/{page_id}")
async def delete_seo_page(page_id: str, db = Depends(get_db)):
    res = await db.seo_pages.delete_one({"id": page_id})
    if res.deleted_count == 0:
        raise HTTPException(status_code=404, detail="Not found")
    return {"status": "success", "message": "Deleted"}

# Analytics Settings
@router.get("/analytics/config")
async def get_analytics_config(db = Depends(get_db)):
    """Get analytics configuration"""
    try:
        config = await db.site_config.find_one({"config_type": "analytics"}, {"_id": 0})
        
        if not config:
            return {
                "status": "success",
                "config": {
                    "google_analytics_id": None,
                    "google_tag_manager_id": None,
                    "facebook_pixel_id": None,
                    "google_search_console_verification": None
                }
            }
        
        return {
            "status": "success",
            "config": config
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@router.post("/analytics/config")
async def update_analytics_config(config: AnalyticsSettings, db = Depends(get_db)):
    """Update analytics configuration"""
    try:
        config_dict = config.dict()
        config_dict["config_type"] = "analytics"
        config_dict["updated_at"] = datetime.now(timezone.utc).isoformat()
        
        existing = await db.site_config.find_one({"config_type": "analytics"})
        
        if existing:
            await db.site_config.update_one(
                {"config_type": "analytics"},
                {"$set": config_dict}
            )
            message = "Analytics configuration updated"
        else:
            config_dict["created_at"] = datetime.now(timezone.utc).isoformat()
            await db.site_config.insert_one(config_dict)
            message = "Analytics configuration created"
        
        return {
            "status": "success",
            "message": message
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

# ==================== WAREHOUSE-ACCESSIBLE DELIVERY PERSON ENDPOINTS ====================

@router.post("/delivery-person/create-from-warehouse")
async def create_delivery_person_from_warehouse(person: DeliveryPersonCreate):
    """Create delivery person account (accessible from warehouse without admin token)"""
    try:
        # Check if email already exists
        existing_user = await db.admin_users.find_one({"email": person.email})
        if existing_user:
            raise HTTPException(status_code=400, detail="Email already registered")
        
        # Hash password
        hashed_password = hash_password(person.password)
        
        # Create delivery person document
        delivery_person_doc = {
            "id": str(uuid.uuid4()),
            "email": person.email,
            "password": hashed_password,
            "full_name": person.full_name,
            "phone": person.phone,
            "vehicle_number": person.vehicle_number or "",
            "address": person.address or "",
            "role": "delivery_person",
            "is_active": True,
            "created_at": datetime.utcnow().isoformat(),
            "created_by": "warehouse",
            "permissions": {
                "can_view_assigned_deliveries": True,
                "can_update_delivery_status": True,
                "can_upload_delivery_proof": True,
                "can_collect_payment": True
            }
        }
        
        await db.admin_users.insert_one(delivery_person_doc)
        
        # Remove password from response
        delivery_person_doc.pop("password")
        delivery_person_doc.pop("_id", None)
        
        return {
            "status": "success",
            "message": "Delivery person created successfully",
            "delivery_person": delivery_person_doc
        }
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@router.get("/delivery-persons/list")
async def list_delivery_persons_public():
    """List all delivery persons (accessible without admin token for warehouse use)"""
    try:
        delivery_persons = await db.admin_users.find(
            {"role": "delivery_person"},
            {"password": 0, "_id": 0}
        ).to_list(None)
        
        return {
            "status": "success",
            "delivery_persons": delivery_persons,
            "count": len(delivery_persons)
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@router.put("/delivery-person/{person_id}/update")
async def update_delivery_person(person_id: str, updates: dict):
    """Update delivery person details"""
    try:
        # Remove fields that shouldn't be updated directly
        updates.pop("id", None)
        updates.pop("_id", None)
        updates.pop("role", None)
        updates.pop("created_at", None)
        
        # If password is being updated, hash it
        if "password" in updates and updates["password"]:
            updates["password"] = hash_password(updates["password"])
        else:
            updates.pop("password", None)
        
        updates["updated_at"] = datetime.utcnow().isoformat()
        
        result = await db.admin_users.update_one(
            {"id": person_id, "role": "delivery_person"},
            {"$set": updates}
        )
        
        if result.matched_count == 0:
            raise HTTPException(status_code=404, detail="Delivery person not found")
        
        # Get updated document
        updated_person = await db.admin_users.find_one(
            {"id": person_id},
            {"password": 0, "_id": 0}
        )
        
        return {
            "status": "success",
            "message": "Delivery person updated successfully",
            "delivery_person": updated_person
        }
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@router.delete("/delivery-person/{person_id}/delete")
async def delete_delivery_person(person_id: str):
    """Delete/deactivate delivery person"""
    try:
        # Soft delete - just mark as inactive
        result = await db.admin_users.update_one(
            {"id": person_id, "role": "delivery_person"},
            {"$set": {"is_active": False, "updated_at": datetime.utcnow().isoformat()}}
        )
        
        if result.matched_count == 0:
            raise HTTPException(status_code=404, detail="Delivery person not found")
        
        return {
            "status": "success",
            "message": "Delivery person deactivated successfully"
        }
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

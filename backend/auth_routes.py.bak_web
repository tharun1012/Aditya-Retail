@router.post("/unified-login")
async def unified_login(credentials: AdminLogin):
    """
    Unified login endpoint that checks all user types:
    1. Customer (users collection)
    2. Admin (admin_users collection)
    3. Store User (store_users collection)
    4. Company Admin (admins collection)
    Supports login by email, username, or phone
    Returns role and appropriate redirect path
    """
    import hashlib
    
    def hash_password_sha256(password: str) -> str:
        return hashlib.sha256(password.encode()).hexdigest()
    
    try:
        login_id = credentials.email.lower().strip()  # Can be email, username, or phone
        
        # Build query to check email, username, or phone
        def build_user_query(login_identifier):
            """Build a query that checks email, username, or phone"""
            return {"$or": [
                {"email": login_identifier},
                {"username": login_identifier},
                {"phone": login_identifier}
            ]}
        
        # 1. Try Customer Login first
        customer = await db.users.find_one(build_user_query(login_id))
        if customer and customer.get("password"):
            if verify_password(credentials.password, customer["password"]):
                access_token = create_access_token(
                    data={"sub": customer.get("email", login_id), "user_id": customer["id"], "role": "customer"}
                )
                return {
                    "status": "success",
                    "access_token": access_token,
                    "user_type": "customer",
                    "redirect_path": "/my-account",
                    "user": {
                        "id": customer["id"],
                        "email": customer.get("email", ""),
                        "first_name": customer.get("first_name", customer.get("name", "").split()[0] if customer.get("name") else ""),
                        "last_name": customer.get("last_name", " ".join(customer.get("name", "").split()[1:]) if customer.get("name") else ""),
                        "phone": customer.get("phone", ""),
                        "role": "customer"
                    }
                }
        
        # 2. Try Admin/Delivery Person Login (both are in admin_users collection)
        admin = await db.admin_users.find_one(build_user_query(login_id))
        if admin:
            if verify_password(credentials.password, admin["password"]):
                if not admin.get("is_active", True):
                    raise HTTPException(status_code=401, detail="Account is inactive")
                
                access_token = create_access_token(
                    data={"sub": admin.get("email", login_id), "role": admin["role"], "user_id": admin.get("id")}
                )
                
                await db.admin_users.update_one(
                    {"id": admin["id"]},
                    {"$set": {"last_login": datetime.utcnow().isoformat()}}
                )
                
                admin.pop("password", None)
                admin.pop("_id", None)
                
                # Determine redirect based on role
                user_role = admin.get("role", "admin")
                if user_role == "delivery_person":
                    # Delivery person - redirect to delivery dashboard
                    return {
                        "status": "success",
                        "access_token": access_token,
                        "user_type": "delivery_person",
                        "redirect_path": "/delivery-dashboard",
                        "user": admin
                    }
                else:
                    # Admin, super_admin, manager, etc - redirect to admin
                    return {
                        "status": "success",
                        "access_token": access_token,
                        "user_type": "admin",
                        "redirect_path": "/admin",
                        "user": admin
                    }
        
        # 3. Try Store User Login
        store_user = await db.store_users.find_one({
            "$and": [
                {"is_active": True},
                build_user_query(login_id)
            ]
        })
        if store_user:
            if store_user["password_hash"] == hash_password_sha256(credentials.password):
                store = await db.stores.find_one({"id": store_user["store_id"]}, {"_id": 0})
                
                token = str(uuid.uuid4())
                await db.store_sessions.update_one(
                    {"user_id": store_user["id"]},
                    {"$set": {
                        "token": token,
                        "store_id": store_user["store_id"],
                        "created_at": datetime.utcnow()
                    }},
                    upsert=True
                )
                
                await db.store_users.update_one(
                    {"id": store_user["id"]},
                    {"$set": {"last_login": datetime.utcnow()}}
                )
                
                return {
                    "status": "success",
                    "access_token": token,
                    "user_type": "store",
                    "redirect_path": "/store/dashboard",
                    "user": {
                        "id": store_user["id"],
                        "email": store_user.get("email", ""),
                        "username": store_user.get("username", ""),
                        "first_name": store_user.get("first_name", ""),
                        "last_name": store_user.get("last_name", ""),
                        "role": store_user["role"],
                        "store_id": store_user["store_id"],
                        "store_code": store_user["store_code"],
                        "store_name": store_user["store_name"]
                    },
                    "store": store
                }
        
        # 4. Try Company Admin Login (admins collection - created via Admin User Management)
        company_admin = await db.admins.find_one({
            "$and": [
                {"is_active": True},
                build_user_query(login_id)
            ]
        })
        if company_admin:
            if company_admin.get("password") == hash_password_sha256(credentials.password):
                admin_identifier = company_admin.get("email") or company_admin.get("username") or login_id
                access_token = create_access_token(
                    data={"sub": admin_identifier, "role": company_admin["role"], "user_id": company_admin.get("id")}
                )
                
                await db.admins.update_one(
                    {"id": company_admin.get("id")},
                    {"$set": {"last_login": datetime.utcnow().isoformat()}}
                )
                
                company_admin.pop("password", None)
                company_admin.pop("_id", None)
                
                # Redirect to admin dashboard
                redirect_path = "/admin"
                
                return {
                    "status": "success",
                    "access_token": access_token,
                    "user_type": "company_admin",
                    "redirect_path": redirect_path,
                    "user": company_admin
                }
        
        # No matching user found
        raise HTTPException(status_code=401, detail="Invalid email or password")
        
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@router.get("/me-jwt")
async def get_current_user_info(current_user: dict = Depends(get_current_user)):
    """Get current user information (JWT-based auth)"""
    current_user.pop("password", None)
    current_user.pop("_id", None)
    return {
        "status": "success",
        "user": current_user
    }

@router.get("/users")
async def list_admin_users(
    current_user: dict = Depends(get_current_user)
):
    """List all admin users (requires admin or super_admin role)"""
    try:
        if current_user["role"] not in ["super_admin", "admin"]:
            raise HTTPException(status_code=403, detail="Admin access required")
        
        users = await db.admin_users.find({}, {"password": 0, "_id": 0}).to_list(None)
        
        return {
            "status": "success",
            "users": users,
            "count": len(users)
        }
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@router.put("/users/{user_id}")
async def update_admin_user(
    user_id: str,
    updates: AdminUpdate,
    current_user: dict = Depends(require_super_admin)
):
    """Update admin user (super_admin only)"""
    try:
        # Build update document
        update_doc = {}
        if updates.full_name is not None:
            update_doc["full_name"] = updates.full_name
        if updates.role is not None:
            update_doc["role"] = updates.role
        if updates.is_active is not None:
            update_doc["is_active"] = updates.is_active
        
        if not update_doc:
            raise HTTPException(status_code=400, detail="No updates provided")
        
        update_doc["updated_at"] = datetime.utcnow().isoformat()
        
        result = await db.admin_users.update_one(
            {"id": user_id},
            {"$set": update_doc}
        )
        
        if result.matched_count == 0:
            raise HTTPException(status_code=404, detail="User not found")
        
        return {
            "status": "success",
            "message": "User updated successfully"
        }
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@router.put("/users/{user_id}/permissions")
async def update_user_permissions(
    user_id: str,
    permissions: PermissionsUpdate,
    current_user: dict = Depends(require_super_admin)
):
    """Update user permissions (super_admin only)"""
    try:
        result = await db.admin_users.update_one(
            {"id": user_id},
            {"$set": {
                "permissions": permissions.dict(),
                "updated_at": datetime.utcnow().isoformat()
            }}
        )
        
        if result.matched_count == 0:
            raise HTTPException(status_code=404, detail="User not found")
        
        return {
            "status": "success",
            "message": "Permissions updated successfully"
        }
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@router.delete("/users/{user_id}")
async def delete_admin_user(
    user_id: str,
    current_user: dict = Depends(require_super_admin)
):
    """Delete admin user (super_admin only)"""
    try:
        # Prevent deleting yourself
        if current_user["id"] == user_id:
            raise HTTPException(status_code=400, detail="Cannot delete your own account")
        
        result = await db.admin_users.delete_one({"id": user_id})
        
        if result.deleted_count == 0:
            raise HTTPException(status_code=404, detail="User not found")
        
        return {
            "status": "success",
            "message": "User deleted successfully"
        }
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@router.post("/delivery-person/create")
async def create_delivery_person(
    person: DeliveryPersonCreate,
    current_user: dict = Depends(get_current_user)
):
    """Create delivery person account (admin/super_admin only)"""
    try:
        # Check if user has admin permissions
        if current_user.get("role") not in ["super_admin", "admin"]:
            raise HTTPException(status_code=403, detail="Admin access required")
        
        # Check if email already exists
        existing_user = await db.admin_users.find_one({"email": person.email})
        if existing_user:
            raise HTTPException(status_code=400, detail="Email already registered")
        
        # Hash password
        hashed_password = hash_password(person.password)
        
        # Create delivery person document
        delivery_person_doc = {
            "id": str(uuid.uuid4()),
            "email": person.email,
            "password": hashed_password,
            "full_name": person.full_name,
            "phone": person.phone,
            "vehicle_number": person.vehicle_number,
            "address": person.address,
            "role": "delivery_person",
            "is_active": True,
            "created_at": datetime.utcnow().isoformat(),
            "created_by": current_user.get("email"),
            "permissions": {
                "can_view_assigned_deliveries": True,
                "can_update_delivery_status": True,
                "can_upload_delivery_proof": True,
                "can_collect_payment": True
            }
        }
        
        await db.admin_users.insert_one(delivery_person_doc)
        
        # Remove password from response
        delivery_person_doc.pop("password")
        delivery_person_doc.pop("_id", None)
        
        return {
            "status": "success",
            "message": "Delivery person created successfully",
            "delivery_person": delivery_person_doc
        }
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@router.get("/delivery-persons")
async def list_delivery_persons(
    current_user: dict = Depends(get_current_user)
):
    """List all delivery persons (admin/super_admin only)"""
    try:
        # Check if user has admin permissions
        if current_user.get("role") not in ["super_admin", "admin"]:

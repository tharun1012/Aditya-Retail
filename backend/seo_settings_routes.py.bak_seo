"""
SEO Settings Management Routes
Allows marketing team to manage meta tags, GA, GSC from admin panel
"""
from fastapi import APIRouter, HTTPException, Depends
from typing import Optional
from pydantic import BaseModel
from database import get_db
from datetime import datetime, timezone

router = APIRouter(prefix="/seo-settings", tags=["SEO Settings"])

class SEOSettings(BaseModel):
    page_type: str  # homepage, category, product, default
    page_key: Optional[str] = None  # category name or product ID
    meta_title: str
    meta_description: str
    meta_keywords: Optional[str] = None
    og_title: Optional[str] = None
    og_description: Optional[str] = None
    og_image: Optional[str] = None

class AnalyticsSettings(BaseModel):
    google_analytics_id: Optional[str] = None  # GA4 Measurement ID
    google_tag_manager_id: Optional[str] = None  # GTM ID
    facebook_pixel_id: Optional[str] = None
    google_search_console_verification: Optional[str] = None  # Verification code

@router.get("/")
async def get_all_seo_settings(db = Depends(get_db)):
    """Get all SEO settings"""
    try:
        settings = await db.seo_settings.find({}, {"_id": 0}).to_list(1000)
        return {
            "status": "success",
            "settings": settings
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@router.get("/{page_type}")
async def get_seo_settings(page_type: str, page_key: Optional[str] = None, db = Depends(get_db)):
    """Get SEO settings for a specific page"""
    try:
        query = {"page_type": page_type}
        if page_key:
            query["page_key"] = page_key
        
        settings = await db.seo_settings.find_one(query, {"_id": 0})
        
        if not settings:
            return {
                "status": "success",
                "settings": None,
                "message": "No custom settings found, using defaults"
            }
        
        return {
            "status": "success",
            "settings": settings
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@router.post("/")
async def create_or_update_seo_settings(settings: SEOSettings, db = Depends(get_db)):
    """Create or update SEO settings"""
    try:
        query = {"page_type": settings.page_type}
        if settings.page_key:
            query["page_key"] = settings.page_key
        
        existing = await db.seo_settings.find_one(query)
        
        settings_dict = settings.dict()
        settings_dict["updated_at"] = datetime.now(timezone.utc).isoformat()
        
        if existing:
            # Update
            await db.seo_settings.update_one(query, {"$set": settings_dict})
            message = "SEO settings updated successfully"
        else:
            # Create
            settings_dict["created_at"] = datetime.now(timezone.utc).isoformat()
            await db.seo_settings.insert_one(settings_dict)
            message = "SEO settings created successfully"
        
        return {
            "status": "success",
            "message": message
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@router.delete("/{page_type}")
async def delete_seo_settings(page_type: str, page_key: Optional[str] = None, db = Depends(get_db)):
    """Delete SEO settings"""
    try:
        query = {"page_type": page_type}
        if page_key:
            query["page_key"] = page_key
        
        result = await db.seo_settings.delete_one(query)
        
        if result.deleted_count == 0:
            raise HTTPException(status_code=404, detail="Settings not found")
        
        return {
            "status": "success",
            "message": "SEO settings deleted successfully"
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

# Analytics Settings
@router.get("/analytics/config")
async def get_analytics_config(db = Depends(get_db)):
    """Get analytics configuration"""
    try:
        config = await db.site_config.find_one({"config_type": "analytics"}, {"_id": 0})
        
        if not config:
            return {
                "status": "success",
                "config": {
                    "google_analytics_id": None,
                    "google_tag_manager_id": None,
                    "facebook_pixel_id": None,
                    "google_search_console_verification": None
                }
            }
        
        return {
            "status": "success",
            "config": config
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@router.post("/analytics/config")
async def update_analytics_config(config: AnalyticsSettings, db = Depends(get_db)):
    """Update analytics configuration"""
    try:
        config_dict = config.dict()
        config_dict["config_type"] = "analytics"
        config_dict["updated_at"] = datetime.now(timezone.utc).isoformat()
        
        existing = await db.site_config.find_one({"config_type": "analytics"})
        
        if existing:
            await db.site_config.update_one(
                {"config_type": "analytics"},
                {"$set": config_dict}
            )
            message = "Analytics configuration updated"
        else:
            config_dict["created_at"] = datetime.now(timezone.utc).isoformat()
            await db.site_config.insert_one(config_dict)
            message = "Analytics configuration created"
        
        return {
            "status": "success",
            "message": message
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

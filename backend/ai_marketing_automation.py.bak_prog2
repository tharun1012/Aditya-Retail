# AI Marketing Automation & CRM System for Aditya Retail
# Autonomous lead generation, customer tracking, and follow-up system

import asyncio
import uuid
from datetime import datetime, timedelta
from motor.motor_asyncio import AsyncIOMotorClient
from dotenv import load_dotenv
import os
import json
from typing import Dict, List, Optional
import requests

load_dotenv()

MONGO_URL = os.environ.get('MONGO_URL')
DB_NAME = os.environ.get('DB_NAME')

class AIMarketingAgent:
    """Autonomous AI Marketing Agent for Lead Generation"""
    
    def __init__(self):
        self.client = AsyncIOMotorClient(MONGO_URL)
        self.db = self.client[DB_NAME]
        self.agent_name = "AI Marketing Agent"
        self.targets = {
            "monthly_leads": 100,
            "monthly_revenue": 2000000,  # 20 Lakhs
            "conversion_rate": 15,  # 15%
            "cost_per_lead": 500
        }

    async def set_monthly_targets(self, leads: int, revenue: int, conversion_rate: float, cost_per_lead: float):
        """Set monthly targets for AI marketing agent"""
        self.targets = {
            "monthly_leads": leads,
            "monthly_revenue": revenue,
            "conversion_rate": conversion_rate,
            "cost_per_lead": cost_per_lead
        }
        
        # Save targets to database
        await self.db.marketing_targets.update_one(
            {"type": "monthly_targets"},
            {"$set": {
                "targets": self.targets,
                "updated_at": datetime.utcnow(),
                "set_by": "admin"
            }},
            upsert=True
        )
        
        print(f"✅ Marketing Targets Set:")
        print(f"  Monthly Leads: {leads}")
        print(f"  Monthly Revenue: ₹{revenue:,}")
        print(f"  Conversion Rate: {conversion_rate}%")
        print(f"  Cost Per Lead: ₹{cost_per_lead}")

    async def generate_marketing_campaigns(self):
        """Generate marketing campaigns based on actual products from all brands"""
        
        # Get premium products from all brands (Siemens, Bosch, Hindware)
        # Get mix of products from each brand
        siemens_products = await self.db.products.find({
            "brand": "Siemens",
            "price": {"$gt": 20000}
        }, {"_id": 0}).limit(7).to_list(7)
        
        bosch_products = await self.db.products.find({
            "brand": "Bosch",
            "price": {"$gt": 20000}
        }, {"_id": 0}).limit(7).to_list(7)
        
        hindware_products = await self.db.products.find({
            "brand": "Hindware",
            "price": {"$gt": 5000}
        }, {"_id": 0}).limit(6).to_list(6)
        
        # Combine all products
        all_products = siemens_products + bosch_products + hindware_products
        
        print(f"📊 Generating campaigns for: {len(siemens_products)} Siemens, {len(bosch_products)} Bosch, {len(hindware_products)} Hindware products")
        
        campaigns = []
        
        for product in all_products:
            # Extract series from specifications or name
            series = product.get("specifications", {}).get("Series", "")
            if not series:
                # Try to extract from name (e.g., "iQ700" from product name)
                name_parts = product.get("name", "").split()
                for part in name_parts:
                    if "iQ" in part or "Series" in part:
                        series = part
                        break
                if not series:
                    series = product.get("brand", "Premium")
            
            # Get highlights for marketing
            highlights = product.get("highlights", [])
            if highlights and len(highlights) > 0:
                marketing_text = ", ".join(highlights[:3])
            else:
                key_features = product.get("key_features", [])
                if key_features:
                    marketing_text = ", ".join(key_features[:3])
                else:
                    marketing_text = product.get("short_description", product.get("description", "")[:150])
            
            # Target audience based on price
            if product["price"] > 100000:
                target_audience = "Ultra-premium home owners, Luxury kitchen enthusiasts"
            elif product["price"] > 50000:
                target_audience = "Premium home owners, Modern kitchen enthusiasts"
            else:
                target_audience = "Mid-premium home owners, Quality-conscious buyers"
            
            # Create targeted campaigns for each product
            campaign = {
                "id": str(uuid.uuid4()),
                "product_id": product["id"],
                "product_name": product["name"],
                "campaign_name": f"{product['brand']} {product['category']} - {series} Campaign",
                "target_audience": target_audience,
                "budget": int(product["price"] * 0.05),  # 5% of product price as campaign budget
                "channels": ["Google Ads", "Facebook Ads", "Instagram", "WhatsApp", "Email"],
                "campaign_type": "product_focused",
                "status": "active",
                "created_at": datetime.utcnow(),
                "targeting": {
                    "demographics": ["Age: 25-55", "Income: 5L+ annually", "Location: Metro cities"],
                    "interests": [
                        "Home appliances",
                        "Premium brands",
                        f"{product['brand']} products" if product.get('brand') else "Premium appliances",
                        "Smart homes",
                        "Modern kitchens"
                    ],
                    "keywords": [
                        series if series else product.get("brand", ""),
                        product.get("brand", ""),
                        product.get("category", ""),
                        product.get("model_number", ""),
                        "premium appliances"
                    ],
                    "locations": ["Mumbai", "Delhi", "Bangalore", "Chennai", "Pune", "Hyderabad"]
                },
                "content": {
                    "headline": f"Experience {series} Excellence" if series else f"Premium {product.get('brand', '')} {product.get('category', '')}",
                    "description": marketing_text,
                    "call_to_action": "Book Free Demo Today",
                    "offer": ""
                },
                "expected_metrics": {
                    "leads_per_month": max(5, int(self.targets["monthly_leads"] / min(len(all_products), 20))),
                    "cost_per_lead": self.targets["cost_per_lead"],
                    "conversion_rate": self.targets["conversion_rate"]
                }
            }
            campaigns.append(campaign)

        # Save campaigns to database
        if campaigns:
            await self.db.marketing_campaigns.delete_many({"campaign_type": "product_focused"})
            await self.db.marketing_campaigns.insert_many(campaigns)
            
        print(f"✅ Generated {len(campaigns)} Marketing Campaigns from actual products")
        return campaigns

    async def track_campaign_performance(self):
        """Track and analyze campaign performance"""
        
        # Get active campaigns
        campaigns = await self.db.marketing_campaigns.find({"status": "active"}).to_list(length=None)
        
        performance_summary = {
            "total_campaigns": len(campaigns),
            "total_budget": sum(c.get("budget", 0) for c in campaigns),
            "expected_monthly_leads": sum(c.get("expected_metrics", {}).get("leads_per_month", 0) for c in campaigns),
            "status": "monitoring",
            "last_updated": datetime.utcnow()
        }
        
        # Save performance tracking
        await self.db.marketing_performance.update_one(
            {"type": "campaign_summary"},
            {"$set": performance_summary},
            upsert=True
        )
        
        return performance_summary

    async def track_monthly_progress(self):
        """Track progress towards monthly targets"""
        # Get current month start
        now = datetime.utcnow()
        month_start = datetime(now.year, now.month, 1)
        
        # Get leads generated this month
        leads_count = await self.db.leads.count_documents({
            "created_at": {"$gte": month_start}
        })
        
        # Get revenue this month
        orders = await self.db.orders.find({
            "created_at": {"$gte": month_start.isoformat()},
            "status": {"$in": ["completed", "paid"]}
        }, {"_id": 0}).to_list(1000)
        
        revenue = sum(order.get("total", 0) for order in orders)
        
        # Get targets
        targets_doc = await self.db.marketing_targets.find_one({"type": "monthly_targets"})
        targets = targets_doc.get("targets") if targets_doc else self.targets
        
        progress = {
            "target_leads": targets["monthly_leads"],
            "leads_generated": leads_count,
            "leads_percentage": (leads_count / targets["monthly_leads"] * 100) if targets["monthly_leads"] > 0 else 0,
            "target_revenue": targets["monthly_revenue"],
            "revenue_generated": revenue,
            "revenue_percentage": (revenue / targets["monthly_revenue"] * 100) if targets["monthly_revenue"] > 0 else 0,
            "month": now.strftime("%B %Y")
        }
        
        return progress
    
    async def optimize_campaigns(self):
        """Optimize running campaigns based on performance"""
        # Get active campaigns
        campaigns = await self.db.marketing_campaigns.find({
            "status": "active"
        }, {"_id": 0}).to_list(1000)
        
        updates = 0
        
        for campaign in campaigns:
            # Simple optimization: increase budget for high-performing campaigns
            # In production, this would connect to actual ad platforms
            
            # Simulate performance metrics
            performance_score = 0.7  # Placeholder
            
            if performance_score > 0.8:
                # High performance - increase budget by 20%
                current_budget = campaign.get("budget", 1000)
                new_budget = current_budget * 1.2
                
                await self.db.marketing_campaigns.update_one(
                    {"id": campaign["id"]},
                    {"$set": {
                        "budget": new_budget,
                        "last_optimized": datetime.utcnow().isoformat(),
                        "optimization_note": "Budget increased due to high performance"
                    }}
                )
                updates += 1
            elif performance_score < 0.3:
                # Low performance - decrease budget or pause
                await self.db.marketing_campaigns.update_one(
                    {"id": campaign["id"]},
                    {"$set": {
                        "status": "paused",
                        "last_optimized": datetime.utcnow().isoformat(),
                        "optimization_note": "Paused due to low performance"
                    }}
                )
                updates += 1
        
        return {
            "campaigns_reviewed": len(campaigns),
            "campaigns_updated": updates,
            "timestamp": datetime.utcnow().isoformat()
        }
    
    async def generate_daily_report(self):
        """Generate daily performance report"""
        today = datetime.utcnow().date()
        
        # Get today's leads
        today_leads = await self.db.leads.count_documents({
            "created_at": {"$gte": datetime.combine(today, datetime.min.time())}
        })
        
        # Get today's orders
        today_orders = await self.db.orders.find({
            "created_at": {"$gte": datetime.combine(today, datetime.min.time()).isoformat()}
        }, {"_id": 0}).to_list(1000)
        
        today_revenue = sum(order.get("total", 0) for order in today_orders)
        
        report = {
            "date": today.isoformat(),
            "leads_captured": today_leads,
            "orders_created": len(today_orders),
            "revenue_generated": today_revenue,
            "avg_order_value": today_revenue / len(today_orders) if today_orders else 0
        }
        
        return report
    
    async def weekly_performance_analysis(self):
        """Analyze weekly performance"""
        # Get last 7 days data
        week_ago = datetime.utcnow() - timedelta(days=7)
        
        leads = await self.db.leads.count_documents({
            "created_at": {"$gte": week_ago}
        })
        
        orders = await self.db.orders.find({
            "created_at": {"$gte": week_ago.isoformat()}
        }, {"_id": 0}).to_list(1000)
        
        revenue = sum(order.get("total", 0) for order in orders)
        
        return {
            "period": "last_7_days",
            "leads": leads,
            "orders": len(orders),
            "revenue": revenue,
            "conversion_rate": (len(orders) / leads * 100) if leads > 0 else 0
        }
    
    async def adjust_weekly_strategy(self, analysis):
        """Adjust marketing strategy based on weekly analysis"""
        changes_made = 0
        
        # If conversion rate is low, adjust targeting
        if analysis["conversion_rate"] < 10:
            # Adjust campaign targeting to focus on higher quality leads
            changes_made += 1
        
        # If revenue is below target, increase budget on top campaigns
        weekly_target = self.targets["monthly_revenue"] / 4
        if analysis["revenue"] < weekly_target:
            changes_made += 1
        
        return {
            "changes_made": changes_made,
            "timestamp": datetime.utcnow().isoformat()
        }
    
    async def generate_monthly_report(self):
        """Generate comprehensive monthly report"""
        now = datetime.utcnow()
        month_start = datetime(now.year, now.month, 1)
        
        # Get month data
        leads = await self.db.leads.count_documents({
            "created_at": {"$gte": month_start}
        })
        
        orders = await self.db.orders.find({
            "created_at": {"$gte": month_start.isoformat()}
        }, {"_id": 0}).to_list(10000)
        
        revenue = sum(order.get("total", 0) for order in orders)
        
        # Get targets
        targets_doc = await self.db.marketing_targets.find_one({"type": "monthly_targets"})
        targets = targets_doc.get("targets") if targets_doc else self.targets
        
        report = {
            "month": now.strftime("%B %Y"),
            "timestamp": now.isoformat(),
            "targets": targets,
            "actuals": {
                "leads": leads,
                "orders": len(orders),
                "revenue": revenue,
                "conversion_rate": (len(orders) / leads * 100) if leads > 0 else 0
            },
            "achievement": {
                "leads_percentage": (leads / targets["monthly_leads"] * 100) if targets["monthly_leads"] > 0 else 0,
                "revenue_percentage": (revenue / targets["monthly_revenue"] * 100) if targets["monthly_revenue"] > 0 else 0
            }
        }
        
        return report

class AICRMAgent:
    """Autonomous AI CRM Agent for Lead Tracking and Follow-ups"""
    
    def __init__(self):
        self.client = AsyncIOMotorClient(MONGO_URL)
        self.db = self.client[DB_NAME]
        self.agent_name = "AI CRM Agent"

    async def capture_lead(self, source: str, lead_data: Dict):
        """Capture lead from various sources"""
        
        lead = {
            "id": str(uuid.uuid4()),
            "source": source,  # "website", "facebook", "google", "referral", "manual"
            "name": lead_data.get("name"),
            "email": lead_data.get("email"),
            "phone": lead_data.get("phone"),
            "product_interest": lead_data.get("product_interest"),
            "budget_range": lead_data.get("budget_range"),
            "timeline": lead_data.get("timeline", "Within 30 days"),
            "status": "new",
            "score": self._calculate_lead_score(lead_data),
            "created_at": datetime.utcnow(),
            "last_contact": None,
            "follow_up_count": 0,
            "next_follow_up": datetime.utcnow() + timedelta(hours=1),  # Follow up in 1 hour
            "notes": [],
            "assigned_agent": "AI CRM Agent"
        }
        
        # Insert lead
        result = await self.db.leads.insert_one(lead)
        
        # Schedule immediate follow-up
        await self._schedule_follow_up(lead["id"], "immediate")
        
        print(f"✅ New Lead Captured: {lead['name']} from {source} (Score: {lead['score']})")
        return lead["id"]

    def _calculate_lead_score(self, lead_data: Dict) -> int:
        """Calculate lead score based on various factors"""
        score = 50  # Base score
        
        # Budget scoring
        budget = lead_data.get("budget_range", "")
        if "2L+" in budget or "high" in budget.lower():
            score += 30
        elif "1L-2L" in budget or "medium" in budget.lower():
            score += 20
        elif "50K-1L" in budget:
            score += 10
        
        # Product interest scoring
        product_interest = lead_data.get("product_interest", "").lower()
        if "iq700" in product_interest or "premium" in product_interest:
            score += 25
        elif "iq500" in product_interest:
            score += 20
        elif "iq300" in product_interest:
            score += 15
        
        # Timeline scoring
        timeline = lead_data.get("timeline", "").lower()
        if "immediate" in timeline or "asap" in timeline:
            score += 20
        elif "week" in timeline:
            score += 15
        elif "month" in timeline:
            score += 10
        
        # Source scoring
        source = lead_data.get("source", "").lower()
        if source == "referral":
            score += 15
        elif source == "website":
            score += 10
        
        return min(100, max(0, score))  # Keep score between 0-100

    async def process_follow_ups(self):
        """Process scheduled follow-ups automatically"""
        
        # Get leads due for follow-up
        current_time = datetime.utcnow()
        due_leads = await self.db.leads.find({
            "next_follow_up": {"$lte": current_time},
            "status": {"$in": ["new", "contacted", "interested", "warm"]}
        }).to_list(length=None)
        
        follow_up_results = []
        
        for lead in due_leads:
            # Simulate AI follow-up
            follow_up_result = await self._execute_follow_up(lead)
            follow_up_results.append(follow_up_result)
            
        print(f"✅ Processed {len(follow_up_results)} follow-ups")
        return follow_up_results

    async def _execute_follow_up(self, lead: Dict):
        """Execute AI-powered follow-up"""
        
        follow_up_count = lead.get("follow_up_count", 0) + 1
        
        # Determine follow-up strategy based on count and lead score
        if follow_up_count == 1:
            strategy = "welcome_call"
            message = f"Welcome call to {lead['name']} regarding {lead.get('product_interest', 'Siemens appliances')}"
            next_follow_up = datetime.utcnow() + timedelta(days=2)
            
        elif follow_up_count == 2:
            strategy = "product_demo"
            message = f"Product demonstration offer for {lead.get('product_interest', 'premium appliances')}"
            next_follow_up = datetime.utcnow() + timedelta(days=3)
            
        elif follow_up_count == 3:
            strategy = "special_offer"
            message = "Special pricing and free installation offer"
            next_follow_up = datetime.utcnow() + timedelta(days=5)
            
        elif follow_up_count <= 5:
            strategy = "nurture_campaign"
            message = "Educational content and product benefits"
            next_follow_up = datetime.utcnow() + timedelta(days=7)
            
        else:
            strategy = "long_term_nurture"
            message = "Monthly check-in and new product updates"
            next_follow_up = datetime.utcnow() + timedelta(days=30)

        # Update lead with follow-up
        follow_up_note = {
            "timestamp": datetime.utcnow(),
            "type": strategy,
            "message": message,
            "agent": "AI CRM Agent",
            "method": "automated"
        }
        
        # Simulate lead response (in real implementation, this would be actual engagement data)
        response_probability = max(0.1, (lead["score"] / 100) - (follow_up_count * 0.05))
        status_change = None
        
        if follow_up_count <= 3 and lead["score"] > 70:
            status_change = "warm"
        elif follow_up_count <= 5 and lead["score"] > 50:
            status_change = "contacted"
        else:
            status_change = "cold"

        # Update lead in database
        await self.db.leads.update_one(
            {"id": lead["id"]},
            {
                "$set": {
                    "follow_up_count": follow_up_count,
                    "last_contact": datetime.utcnow(),
                    "next_follow_up": next_follow_up,
                    "status": status_change or lead["status"]
                },
                "$push": {"notes": follow_up_note}
            }
        )
        
        return {
            "lead_id": lead["id"],
            "lead_name": lead["name"],
            "strategy": strategy,
            "follow_up_count": follow_up_count,
            "status": status_change or lead["status"]
        }

    async def _schedule_follow_up(self, lead_id: str, urgency: str = "normal"):
        """Schedule follow-up based on urgency"""
        
        if urgency == "immediate":
            next_time = datetime.utcnow() + timedelta(hours=1)
        elif urgency == "high":
            next_time = datetime.utcnow() + timedelta(hours=4)
        elif urgency == "normal":
            next_time = datetime.utcnow() + timedelta(days=1)
        else:
            next_time = datetime.utcnow() + timedelta(days=3)
        
        await self.db.leads.update_one(
            {"id": lead_id},
            {"$set": {"next_follow_up": next_time}}
        )

    async def generate_crm_reports(self):
        """Generate CRM performance reports"""
        
        # Get lead statistics
        total_leads = await self.db.leads.count_documents({})
        new_leads = await self.db.leads.count_documents({"status": "new"})
        warm_leads = await self.db.leads.count_documents({"status": "warm"})
        cold_leads = await self.db.leads.count_documents({"status": "cold"})
        
        # Calculate conversion funnel
        current_month = datetime.utcnow().replace(day=1, hour=0, minute=0, second=0, microsecond=0)
        monthly_leads = await self.db.leads.count_documents({"created_at": {"$gte": current_month}})
        
        report = {
            "total_leads": total_leads,
            "monthly_leads": monthly_leads,
            "lead_distribution": {
                "new": new_leads,
                "warm": warm_leads,
                "cold": cold_leads
            },
            "conversion_funnel": {
                "leads": monthly_leads,
                "warm_rate": round((warm_leads / max(1, total_leads)) * 100, 2),
                "estimated_conversions": round(monthly_leads * 0.15, 0)  # 15% conversion rate
            },
            "generated_at": datetime.utcnow()
        }
        
        return report

class AIMarketingCRMOrchestrator:
    """Orchestrates AI Marketing and CRM agents to work together"""
    
    def __init__(self):
        self.marketing_agent = AIMarketingAgent()
        self.crm_agent = AICRMAgent()

    async def setup_complete_system(self, targets: Dict):
        """Setup complete AI marketing and CRM system"""
        
        print("🚀 Setting up AI Marketing & CRM Automation System...")
        print("=" * 60)
        
        # Set marketing targets
        await self.marketing_agent.set_monthly_targets(
            leads=targets.get("monthly_leads", 100),
            revenue=targets.get("monthly_revenue", 2000000),
            conversion_rate=targets.get("conversion_rate", 15),
            cost_per_lead=targets.get("cost_per_lead", 500)
        )
        
        # Generate marketing campaigns
        campaigns = await self.marketing_agent.generate_marketing_campaigns()
        
        # Track performance
        performance = await self.marketing_agent.track_campaign_performance()
        
        print(f"\n📊 System Setup Complete:")
        print(f"  Marketing Campaigns: {performance['total_campaigns']}")
        print(f"  Expected Monthly Leads: {performance['expected_monthly_leads']}")
        print(f"  Total Campaign Budget: ₹{performance['total_budget']:,}")
        
        return {
            "campaigns": len(campaigns),
            "expected_leads": performance['expected_monthly_leads'],
            "total_budget": performance['total_budget']
        }

    async def simulate_lead_generation(self, num_leads: int = 10):
        """Simulate lead generation for testing"""
        
        print(f"\n🎯 Simulating {num_leads} leads for testing...")
        
        # Sample lead data for simulation
        sample_leads = [
            {
                "name": "Rajesh Kumar", "email": "rajesh@email.com", "phone": "+91-9876543210",
                "product_interest": "Siemens iQ700 Oven", "budget_range": "2L+", "timeline": "Within 2 weeks",
                "source": "website"
            },
            {
                "name": "Priya Sharma", "email": "priya@email.com", "phone": "+91-9876543211", 
                "product_interest": "Siemens Dishwasher", "budget_range": "50K-1L", "timeline": "Within 1 month",
                "source": "facebook"
            },
            {
                "name": "Amit Patel", "email": "amit@email.com", "phone": "+91-9876543212",
                "product_interest": "Siemens iQ500 Refrigerator", "budget_range": "1L-2L", "timeline": "Immediate", 
                "source": "referral"
            },
            {
                "name": "Sneha Reddy", "email": "sneha@email.com", "phone": "+91-9876543213",
                "product_interest": "Siemens Induction Hob", "budget_range": "1L-2L", "timeline": "Within 1 week",
                "source": "google"
            },
            {
                "name": "Vikram Singh", "email": "vikram@email.com", "phone": "+91-9876543214",
                "product_interest": "Premium Kitchen Setup", "budget_range": "2L+", "timeline": "Within 1 month",
                "source": "website"
            }
        ]
        
        generated_leads = []
        for i in range(min(num_leads, len(sample_leads))):
            lead_data = sample_leads[i % len(sample_leads)]
            lead_data["name"] = f"{lead_data['name']} {i+1}"  # Make names unique
            
            lead_id = await self.crm_agent.capture_lead(lead_data["source"], lead_data)
            generated_leads.append(lead_id)
            
        return generated_leads

    async def run_daily_automation(self):
        """Run daily AI automation tasks"""
        
        print("🤖 Running Daily AI Marketing & CRM Automation...")
        
        # Process follow-ups
        follow_ups = await self.crm_agent.process_follow_ups()
        
        # Generate reports
        crm_report = await self.crm_agent.generate_crm_reports()
        marketing_performance = await self.marketing_agent.track_campaign_performance()
        
        print(f"\n📈 Daily Automation Results:")
        print(f"  Follow-ups Processed: {len(follow_ups)}")
        print(f"  Total Leads in System: {crm_report['total_leads']}")
        print(f"  Monthly Leads: {crm_report['monthly_leads']}")
        print(f"  Warm Leads: {crm_report['lead_distribution']['warm']}")
        print(f"  Expected Conversions: {crm_report['conversion_funnel']['estimated_conversions']}")
        
        return {
            "follow_ups": len(follow_ups),
            "crm_report": crm_report,
            "marketing_performance": marketing_performance
        }

async def main():
    """Main function to demonstrate AI Marketing & CRM system"""
    
    # Initialize orchestrator
    orchestrator = AIMarketingCRMOrchestrator()
    
    # Setup system with targets
    targets = {
        "monthly_leads": 100,
        "monthly_revenue": 2000000,  # 20 Lakhs
        "conversion_rate": 15,
        "cost_per_lead": 500
    }
    
    try:
        # Setup complete system
        setup_result = await orchestrator.setup_complete_system(targets)
        
        # Simulate some leads for testing
        leads = await orchestrator.simulate_lead_generation(5)
        
        # Run automation
        automation_result = await orchestrator.run_daily_automation()
        
        print("\n🎉 AI Marketing & CRM System Ready!")
        print("The system will now work autonomously 24/7 to:")
        print("  • Generate targeted marketing campaigns")
        print("  • Capture leads from multiple sources") 
        print("  • Automatically follow up with prospects")
        print("  • Track performance against targets")
        print("  • Provide intelligent lead scoring and nurturing")
        
    except Exception as e:
        print(f"❌ Error setting up system: {e}")

if __name__ == "__main__":
    asyncio.run(main())
